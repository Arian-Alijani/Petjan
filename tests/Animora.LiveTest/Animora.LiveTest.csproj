<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Animora.LiveTest — operator-run console tool that drives the LIVE central server
    with REAL HTTP requests, for (A) per-feature correctness/sync and (B) capacity/load
    with read-only remote hardware monitoring. NOT a gated unit test: it is run by hand
    from the operator's machine against a dedicated test tenant. See README.md.

    It composes the REAL production client stack (Animora.Sync.Custom transport +
    Animora.Application dispatch + Animora.Persistence.Sqlite replica), so every request
    is byte-identical to what a real desktop sends. No new third-party dependency: the
    remote monitor shells out to the system `ssh` binary.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Not an IsTestProject: it must never run in `dotnet test`/CI gates. -->
    <RootNamespace>Animora.LiveTest</RootNamespace>
    <AssemblyName>animora-livetest</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real production client stack (same binaries the desktop ships). -->
    <ProjectReference Include="..\..\src\Animora.Sync.Custom\Animora.Sync.Custom.csproj" />
    <ProjectReference Include="..\..\src\Animora.Client.Services\Animora.Client.Services.csproj" />
    <ProjectReference Include="..\..\src\Animora.Application\Animora.Application.csproj" />
    <ProjectReference Include="..\..\src\Animora.Persistence.Sqlite\Animora.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Animora.Infrastructure.Local\Animora.Infrastructure.Local.csproj" />
    <ProjectReference Include="..\..\src\Animora.Contracts\Animora.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Animora.Contracts.Wire\Animora.Contracts.Wire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
