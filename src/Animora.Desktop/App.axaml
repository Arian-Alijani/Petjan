<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Animora.Desktop.Localization"
             xmlns:shell="using:Animora.Desktop.Shell"
             xmlns:dashboard="using:Animora.Desktop.Pages.Dashboard"
             x:Class="Animora.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Colors.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Spacing.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Elevation.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Typography.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Icons.axaml" />
                <!-- ControlThemes (e.g. Button's {x:Type Button} theme) are
                     resources, looked up implicitly by TargetType — they
                     belong in Resources, not Styles. -->
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Controls/Button.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Phase 04: localization converters, usable from any binding via
                 {StaticResource PersianDigitsConverter} / {StaticResource JalaliDateConverter}. -->
            <loc:PersianDigitsConverter x:Key="PersianDigitsConverter" />
            <loc:JalaliDateConverter x:Key="JalaliDateConverter" />

            <!-- Phase 05: resolves an icon resource key string to its Geometry,
                 so the data-driven sidebar can bind icons by key. -->
            <shell:IconKeyConverter x:Key="IconKeyConverter" />

            <!-- Maps a Contracts DashboardTone to the Desktop Tone enum, so KPI
                 StatCards can colour their icon tile per tone (teal/lilac/info/danger). -->
            <dashboard:ToneConverter x:Key="ToneConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <!-- Phase 05: convention-based ViewModel -> View resolution, used by the
         shell's ContentControl to render the current page. -->
    <Application.DataTemplates>
        <shell:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Application-wide default font: Vazirmatn (bundled).
             Phase 04: RTL is set once here at the single top-level location
             (CONVENTIONS.md §4) so every descendant mirrors by default,
             matching <html dir="rtl"> in the reference. -->
        <Style Selector="TopLevel">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <!-- Phase 03: shared selector-based styles (icon Path look, card). -->
        <StyleInclude Source="avares://Animora.Desktop/Resources/Controls/IconStyle.axaml" />
        <StyleInclude Source="avares://Animora.Desktop/Resources/Controls/Card.axaml" />
    </Application.Styles>

</Application>
