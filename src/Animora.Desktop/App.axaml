<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Animora.Desktop.Localization"
             xmlns:shell="using:Animora.Desktop.Shell"
             xmlns:dashboard="using:Animora.Desktop.Pages.Dashboard"
             xmlns:vx="using:Animora.Desktop.Pages.Vaccination"
             xmlns:ap="using:Animora.Desktop.Pages.Appointments"
             x:Class="Animora.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Colors.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Spacing.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Elevation.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Typography.axaml" />
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Theme/Icons.axaml" />
                <!-- ControlThemes (e.g. Button's {x:Type Button} theme) are
                     resources, looked up implicitly by TargetType — they
                     belong in Resources, not Styles. -->
                <ResourceInclude Source="avares://Animora.Desktop/Resources/Controls/Button.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Phase 04: localization converters, usable from any binding via
                 {StaticResource PersianDigitsConverter} / {StaticResource JalaliDateConverter}. -->
            <loc:PersianDigitsConverter x:Key="PersianDigitsConverter" />
            <loc:JalaliDateConverter x:Key="JalaliDateConverter" />

            <!-- Phase 05: resolves an icon resource key string to its Geometry,
                 so the data-driven sidebar can bind icons by key. -->
            <shell:IconKeyConverter x:Key="IconKeyConverter" />

            <!-- Maps a Contracts DashboardTone to the Desktop Tone enum, so KPI
                 StatCards can colour their icon tile per tone (teal/lilac/info/danger). -->
            <dashboard:ToneConverter x:Key="ToneConverter" />

            <!-- Phase 12: resolves the vaccination timeline dot's active flag to
                 the vaccine-accent stroke vs the neutral hairline (vx-shot / line). -->
            <vx:BoolToShotBrushConverter x:Key="BoolToBrushConverter" />

            <!-- Phase 13: converts an HTML hex accent (e.g. "#0d9488") to a brush
                 for the appointments type/doctor chips and event-card accents. -->
            <ap:HexBrushConverter x:Key="HexBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <!-- Phase 05: convention-based ViewModel -> View resolution, used by the
         shell's ContentControl to render the current page. The ViewLocator is
         NOT declared here: it takes an injected ViewCache, so it is resolved
         from DI and added to App.DataTemplates in code (App.axaml.cs,
         OnFrameworkInitializationCompleted) — a XAML-instantiated template
         cannot receive that dependency. -->

    <Application.Styles>
        <!-- Animora's surface/ink tokens currently define a light palette only.
             Do not mix those fixed light surfaces with OS-selected dark Fluent
             input, placeholder, popup and interaction-state resources. -->
        <FluentTheme />

        <!-- Application-wide default font: Vazirmatn (bundled).
             Phase 04: RTL is set once here at the single top-level location
             (CONVENTIONS.md §4) so every descendant mirrors by default,
             matching <html dir="rtl"> in the reference. -->
        <Style Selector="TopLevel">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <!-- The upstream static faces do not all share the same legacy family
             name. Select the exact embedded FILE for every effective weight,
             rather than asking Avalonia/Skia to group a directory by preferred
             family name. This is intentionally applied to both TextBlock and
             ContentPresenter (the latter draws string content in templates).
             See Typography.axaml for the Windows-specific failure mode. -->
        <Style Selector="TextBlock[FontWeight=Medium]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyMedium}" />
        </Style>
        <Style Selector="TextBlock[FontWeight=SemiBold]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilySemiBold}" />
        </Style>
        <Style Selector="TextBlock[FontWeight=Bold]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyBold}" />
        </Style>
        <Style Selector="TextBlock[FontWeight=ExtraBold]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyExtraBold}" />
        </Style>
        <Style Selector="TextBlock[FontWeight=Black]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyBlack}" />
        </Style>
        <Style Selector="ContentPresenter[FontWeight=Medium]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyMedium}" />
        </Style>
        <Style Selector="ContentPresenter[FontWeight=SemiBold]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilySemiBold}" />
        </Style>
        <Style Selector="ContentPresenter[FontWeight=Bold]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyBold}" />
        </Style>
        <Style Selector="ContentPresenter[FontWeight=ExtraBold]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyExtraBold}" />
        </Style>
        <Style Selector="ContentPresenter[FontWeight=Black]">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyBlack}" />
        </Style>

        <!-- Global TextBox focus treatment. The default Fluent accent paints an
             off-brand dark state on focus (the "black box" the user spotted when
             clicking a search field). Force every TextBox — search boxes and
             inputs alike — to the Animora brand focus look: panel background,
             brand border, brand caret/selection. Page-level styles that set a
             custom background (e.g. transparent inner search inputs) still win
             because they are applied closer to the control. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource MutedBrush}" />
        </Style>
        <!-- Fluent sets Foreground again on hover/focus/disabled. Override those
             states too, not just the resting control, for every text/number field. -->
        <Style Selector="TextBox:pointerover, TextBox:focus, TextBox:focus-within">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBox:disabled">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBox /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="TextElement.Foreground"
                    Value="{ReflectionBinding $parent[TextBox].Foreground}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource InputHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>
        <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>

        <!-- Select fields share the same readable palette, including the string
             selection rendered by Fluent's internal ContentControl. Bind to the
             owning control so page-specific ink/brand overrides still apply. -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="ComboBox:disabled">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground"
                    Value="{ReflectionBinding $parent[ComboBox].Foreground}" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background, ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource InputHoverBrush}" />
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>

        <!-- Reserve a stable scrollbar gutter instead of Fluent's auto-hiding
             overlay. Applies equally to page, dialog, list and text-input viewers. -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <!-- Keep scrollbar chrome on the physical right without changing the
             Persian content direction (including viewers with explicit LTR content). -->
        <Style Selector="ScrollViewer /template/ Grid">
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style Selector="ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
            <Setter Property="FlowDirection"
                    Value="{ReflectionBinding $parent[ScrollViewer].FlowDirection}" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="14" />
            <Setter Property="MinHeight" Value="14" />
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="{StaticResource Bg2Brush}" />
            <Setter Property="Stroke" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Muted2Brush}" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- A slim rounded visual inside the full 14px draggable hit target. -->
        <Style Selector="ScrollBar /template/ Thumb /template/ Border">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border">
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb /template/ Border">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed /template/ Border">
            <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
        </Style>

        <!-- Phase 03: shared selector-based styles (icon Path look, card). -->
        <StyleInclude Source="avares://Animora.Desktop/Resources/Controls/IconStyle.axaml" />
        <StyleInclude Source="avares://Animora.Desktop/Resources/Controls/Card.axaml" />

        <!-- D42: dashboard quick-tile styles declared once (typed accent/soft bindings). -->
        <StyleInclude Source="avares://Animora.Desktop/Resources/Controls/QuickTile.axaml" />

        <!-- Phase 25: Finance workspace styles (.pagebar/.pb-seg, KPI/mini cards,
             highlight bar, list rows, donut legend, heatmap). Scoped to the
             FinancePageView subtree so they never leak to other screens. -->
        <StyleInclude Source="avares://Animora.Desktop/Resources/Controls/FinanceStyles.axaml" />
    </Application.Styles>

</Application>
