<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="using:Animora.Desktop.Pages.Appointments"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Appointments.AppointmentsCalendarView"
             x:Name="Root"
             x:DataType="ap:AppointmentsCalendarViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- primary tab (pb-seg lg) -->
        <Style Selector="Button.ap-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ap-tab:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.ap-tab.is-active">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- view switch (seg) -->
        <Style Selector="Button.ap-seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ap-seg:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.ap-seg.is-active">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- filter chip -->
        <Style Selector="Button.ap-chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.ap-chip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.ap-chip TextBlock.cnt">
            <Setter Property="Foreground" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.ap-chip.is-active, Button.ap-chip.is-active:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.ap-chip.is-active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.ap-chip.is-active TextBlock.cnt">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
        </Style>

        <!-- small icon button (nav-btn) -->
        <Style Selector="Button.ap-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ap-icon:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.ap-icon:pressed">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>

        <!-- «امروز» button — same height/radius family as the arrow frame and the view switch -->
        <Style Selector="Button.ap-today">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ap-today:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.ap-today:pressed">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>

        <!-- search field -->
        <Style Selector="TextBox.ap-search">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="32,6,34,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.ap-search:focus">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>
        <Style Selector="TextBox.ap-search:pointerover">
            <Setter Property="Background" Value="{StaticResource InputHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="26,22,26,40" Spacing="16">

            <!-- ═══ page header ═══ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="تقویم نوبت‌ها" FontSize="26" FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Bottom">
                    <Button Classes="outline" Command="{Binding ExportCalendarCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource IconDownload}" />
                            <TextBlock Text="خروجی" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding OpenBookingCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="17" Height="17" Stroke="White"
                                  Data="{StaticResource IconCalendarPlus}" />
                            <TextBlock Text="ثبت نوبت جدید" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ unified toolbar (pagebar) — same anatomy as Patients/Owners:
                 tier 1 tabs (fill) + 420px search, tier 2 type+doctor filters
                 on ONE row, tier 3 date navigation + view switch. ═══ -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius}"
                    BoxShadow="{StaticResource ShadowCard}"
                    Padding="14,12">
                <StackPanel Spacing="12">

                    <!-- tier 1 · tabs (stretch) + search (fixed 420) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Background="{StaticResource Bg2Brush}" CornerRadius="12"
                                Padding="3" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Classes="ap-tab" Classes.is-active="{Binding IsCalendarTab}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="cal"
                                        ToolTip.Tip="میان‌بر: ۱">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconCalendar}" />
                                        <TextBlock Text="تقویم" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Classes="ap-tab" Classes.is-active="{Binding IsQueueTab}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="queue"
                                        ToolTip.Tip="میان‌بر: ۲">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconList}" />
                                        <TextBlock Text="نوبت‌های پیش رو" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" HorizontalAlignment="Stretch" Classes="ap-tab" Classes.is-active="{Binding IsHistoryTab}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="hist"
                                        ToolTip.Tip="میان‌بر: ۳">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconClock}" />
                                        <TextBlock Text="تاریخچه" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" HorizontalAlignment="Stretch" Classes="ap-tab" Classes.is-active="{Binding IsSettingsTab}"
                                        Command="{Binding SelectTabCommand}" CommandParameter="settings">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconTools}" />
                                        <TextBlock Text="تنظیمات" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- search (.pb-search) -->
                        <Grid Grid.Column="1" Width="420" MinWidth="200" VerticalAlignment="Stretch">
                            <TextBox x:Name="SearchBox" Classes="ap-search"
                                     PlaceholderText="جستجوی بیمار، مالک یا پزشک…"
                                     Text="{Binding SearchQueryText, Mode=TwoWay}"
                                     KeyDown="OnSearchKeyDown" />
                            <Path Classes="icon" Width="16" Height="16" Margin="13,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Stroke="{StaticResource MutedBrush}"
                                  Data="{StaticResource IconSearch}" />
                            <Button Classes="ap-icon" Width="20" Height="20" Margin="0,0,9,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="10"
                                    Background="{StaticResource Brand50Brush}"
                                    Foreground="{StaticResource Brand700Brush}"
                                    IsVisible="{Binding HasSearchValue}"
                                    Command="{Binding ClearSearchCommand}"
                                    ToolTip.Tip="پاک کردن">
                                <Path Classes="icon" Width="11" Height="11"
                                      Stroke="{StaticResource Brand700Brush}" StrokeThickness="3"
                                      Data="{StaticResource IconX}" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- tier 2 · appointment type + doctor, ONE row (calendar only) -->
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                            Padding="0,12,0,0" IsVisible="{Binding ShowCalendarChrome}">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="نوع نوبت" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TypeChips}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ap:AppointmentTypeChipViewModel">
                                        <Button Classes="ap-chip" Classes.is-active="{Binding IsActive}"
                                                Command="{Binding #Root.((ap:AppointmentsCalendarViewModel)DataContext).ToggleTypeCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{Binding Type.Accent, Converter={StaticResource HexBrushConverter}}" />
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Classes="cnt" Text="{Binding CountText}" FontSize="10.5" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Column="2" Width="1" Height="22" Background="{StaticResource LineBrush}"
                                    VerticalAlignment="Center" Margin="4,0" />

                            <TextBlock Grid.Column="3" Text="پزشک" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <ItemsControl Grid.Column="4" ItemsSource="{Binding DoctorChips}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ap:AppointmentDoctorChipViewModel">
                                        <Button Classes="ap-chip" Classes.is-active="{Binding IsActive}"
                                                Command="{Binding #Root.((ap:AppointmentsCalendarViewModel)DataContext).ToggleDoctorCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border Width="20" Height="20" CornerRadius="10"
                                                        Background="{Binding Doctor.Accent, Converter={StaticResource HexBrushConverter}}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="ExtraBold"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding ShortName}" />
                                                <TextBlock Classes="cnt" Text="{Binding CountText}" FontSize="10.5" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Grid.Column="5" VerticalAlignment="Center" Classes="ap-chip"
                                    Command="{Binding ToggleHideCancelCommand}">
                                <TextBlock Text="پنهان‌کردن لغوشده‌ها" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- tier 3 · date navigation + view switch (calendar only) -->
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                            Padding="0,12,0,0" IsVisible="{Binding ShowCalendarChrome}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RangeMainText}" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="{Binding RangeSubText}" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource Bg2Brush}" CornerRadius="11"
                                    Padding="3" VerticalAlignment="Center"
                                    IsVisible="{Binding !CalendarModeIsDayOnly}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="ap-seg" Classes.is-active="{Binding IsDayView}"
                                            Command="{Binding SetViewCommand}" CommandParameter="day">
                                        <TextBlock Text="روز" />
                                    </Button>
                                    <Button Classes="ap-seg" Classes.is-active="{Binding IsWeekView}"
                                            Command="{Binding SetViewCommand}" CommandParameter="week">
                                        <TextBlock Text="هفته" />
                                    </Button>
                                    <Button Classes="ap-seg" Classes.is-active="{Binding IsMonthViewMode}"
                                            Command="{Binding SetViewCommand}" CommandParameter="month">
                                        <TextBlock Text="ماه" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="2" Height="34">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <!-- RTL: «قبلی» sits on the right and points right, «بعدی» on the left pointing left
                                             (same convention as the booking panel and history calendars). -->
                                        <Button Classes="ap-icon" Width="32" Height="28" Command="{Binding StepPreviousCommand}"
                                                ToolTip.Tip="بازه قبلی">
                                            <Path Classes="icon" Width="16" Height="16"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  Data="{StaticResource IconChevronRight}" />
                                        </Button>
                                        <Border Width="1" Margin="0,6" Background="{StaticResource Line2Brush}" />
                                        <Button Classes="ap-icon" Width="32" Height="28" Command="{Binding StepNextCommand}"
                                                ToolTip.Tip="بازه بعدی">
                                            <Path Classes="icon" Width="16" Height="16"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  Data="{StaticResource IconChevronLeft}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Button Command="{Binding GoTodayCommand}" Classes="ap-today"
                                        ToolTip.Tip="بازگشت به امروز (T)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="14" Height="14"
                                              Stroke="{StaticResource Brand600Brush}"
                                              Data="{StaticResource IconClock}" />
                                        <TextBlock Text="امروز" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ═══ tab bodies — lazily instantiated: only the active tab is realised.
                 Previously all three (calendar + queue + history) were stacked in the
                 visual tree and toggled with IsVisible, so every tab was built,
                 measured and arranged (and kept its full subtree in memory) even
                 while hidden. LazyTabHost builds only the active tab and caches it,
                 so heavy tabs no longer inflate the first-open cost. ═══ -->
            <controls:LazyTabHost ActiveKey="{Binding ActiveTab}">
                <!-- ── calendar ── -->
                <controls:LazyTab Key="cal">
                    <DataTemplate x:DataType="ap:AppointmentsCalendarViewModel">
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLg}"
                                BoxShadow="{StaticResource ShadowCard}" ClipToBounds="True">
                            <!-- Inner day/week/month grids are also lazily hosted: only the
                                 selected grid is built instead of all three at once. -->
                            <controls:LazyTabHost ActiveKey="{Binding ViewMode}">
                                <controls:LazyTab Key="day">
                                    <DataTemplate x:DataType="ap:AppointmentsCalendarViewModel">
                                        <ap:DayGridView />
                                    </DataTemplate>
                                </controls:LazyTab>
                                <controls:LazyTab Key="week">
                                    <DataTemplate x:DataType="ap:AppointmentsCalendarViewModel">
                                        <ap:WeekGridView />
                                    </DataTemplate>
                                </controls:LazyTab>
                                <controls:LazyTab Key="month">
                                    <DataTemplate x:DataType="ap:AppointmentsCalendarViewModel">
                                        <ap:MonthGridView />
                                    </DataTemplate>
                                </controls:LazyTab>
                            </controls:LazyTabHost>
                        </Border>
                    </DataTemplate>
                </controls:LazyTab>

                <!-- ── queue ── -->
                <controls:LazyTab Key="queue">
                    <DataTemplate x:DataType="ap:AppointmentsCalendarViewModel">
                        <ap:AppointmentsQueueTabView />
                    </DataTemplate>
                </controls:LazyTab>

                <!-- ── history ── -->
                <controls:LazyTab Key="hist">
                    <DataTemplate x:DataType="ap:AppointmentsCalendarViewModel">
                        <ap:AppointmentsHistoryTabView />
                    </DataTemplate>
                </controls:LazyTab>

                <!-- ── settings ── -->
                <controls:LazyTab Key="settings">
                    <DataTemplate x:DataType="ap:AppointmentsCalendarViewModel">
                        <ap:AppointmentsSettingsTabView />
                    </DataTemplate>
                </controls:LazyTab>
            </controls:LazyTabHost>

        </StackPanel>
    </ScrollViewer>
</UserControl>
