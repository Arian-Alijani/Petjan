<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Shared styles for the appointments day/week time grid + the event card,
      transcribed from Animora-UI/assets/appointments.css (.tg-*, .ev, .mv-*).
      Loaded once by each grid sub-view. Recurring classes live here; per-item
      colours are bound from the item ViewModels.
    -->

    <!-- time-grid shell -->
    <!-- Fill all available height (no fixed 640 cap) so the calendar is not
         compressed; keep a sensible minimum so the grid stays usable. -->
    <Style Selector="ScrollViewer.tg-wrap">
        <Setter Property="MinHeight" Value="480" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- hour row -->
    <Style Selector="Border.tg-hour">
        <Setter Property="Height" Value="78" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
    </Style>
    <Style Selector="Border.tg-hour.first">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.tg-gutter-hour">
        <Setter Property="Height" Value="78" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- column (doctor / day) -->
    <Style Selector="Border.tg-col">
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.tg-col.off">
        <Setter Property="Background" Value="#fbfcfe" />
    </Style>

    <!-- header cell -->
    <Style Selector="Border.tg-hcell">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.tg-hcell.today">
        <Setter Property="BorderThickness" Value="1,0,0,2" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
    </Style>
    <Style Selector="Border.tg-hcell.off">
        <Setter Property="Background" Value="#fafbfe" />
    </Style>
    <Style Selector="Border.tg-hcell.first">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ═══ event card ═══
         The Button is a transparent, borderless hit target; the painted body is the
         inner "ev-surface" Border, which carries the tinted background, rounded
         corners and the elevation/separator ring. (BoxShadow is a Border property,
         not a Button property, so the shadow must live on the surface.) The white
         ring + soft drop shadow lift each card off the grid; the .overlap variant
         strengthens them so several cards sharing one row read as distinct cards. -->
    <Style Selector="Button.ev-card">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <!-- the Button's own hover wash must stay off so the tinted surface shows through unchanged -->
    <Style Selector="Button.ev-card:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- painted card body: rounded, clipped, with a hairline white ring + gentle drop
         shadow (offsetX offsetY blur spread colour). -->
    <Style Selector="Border.ev-surface">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="BoxShadow" Value="0 0 0 1 #FFFFFFFF, 0 1 3 0 #22101828" />
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <!-- hover: lift the card so the one under the pointer stands out from its neighbours -->
    <Style Selector="Button.ev-card:pointerover Border.ev-surface">
        <Setter Property="BoxShadow" Value="0 0 0 1.5 #FFFFFFFF, 0 6 14 -3 #33101828" />
    </Style>
    <Style Selector="Button.ev-card:pressed Border.ev-surface">
        <Setter Property="BoxShadow" Value="0 0 0 1 #FFFFFFFF, 0 2 5 -1 #28101828" />
    </Style>

    <!-- tier paddings live on the surface (inside the ring) so the shadow is never clipped -->
    <Style Selector="Button.ev-card.tier-xs Border.ev-surface">
        <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Button.ev-card.tier-sm Border.ev-surface">
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Button.ev-card.tier-md Border.ev-surface">
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style Selector="Button.ev-card.booster">
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.ev-card.cancelled">
        <Setter Property="Opacity" Value="0.62" />
    </Style>

    <!-- ═══ overlap: a card that shares its time slot with others (multi-lane cluster) ═══
         Give its surface a bolder white separator ring (2px) and a deeper shadow so
         adjacent cards in the same row read as clearly separate, layered cards rather
         than one crowded block. The hover state lifts the focused card above the cluster. -->
    <Style Selector="Button.ev-card.overlap Border.ev-surface">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BoxShadow" Value="0 0 0 2 #FFFFFFFF, 0 3 8 -1 #30101828" />
    </Style>
    <Style Selector="Button.ev-card.overlap:pointerover Border.ev-surface">
        <Setter Property="BoxShadow" Value="0 0 0 2 #FFFFFFFF, 0 10 20 -4 #40101828" />
    </Style>
    <Style Selector="Button.ev-card.overlap:pressed Border.ev-surface">
        <Setter Property="BoxShadow" Value="0 0 0 2 #FFFFFFFF, 0 3 8 -2 #30101828" />
    </Style>

    <!-- ═══ drag/selection box (drag-to-create a new range / drag-to-move a card) ═══
         The controller (TimeGridDragController) shows this Border and drives its
         Height + Margin to follow the pointer in real time, so those two properties
         are deliberately left WITHOUT transitions (a transition there would make the
         box lag behind the cursor). Only the fade/scale entrance (Opacity +
         RenderTransform) is animated, which reads as a smooth, standard pop-in. -->
    <Style Selector="Border.tg-dragbox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="50%,0%" />
        <Setter Property="RenderTransform" Value="scaleY(0.94)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.16"
                                               Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <!-- visible state: the controller adds the "visible" class, which triggers the pop-in.
         Opacity is driven purely by this class (idle = 0, visible = 1) so adding/removing it
         always fades cleanly, independent of the creating/moving look. -->
    <Style Selector="Border.tg-dragbox.visible">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scaleY(1)" />
    </Style>

    <!-- creating a new range: soft brand-tinted fill with a solid brand edge -->
    <Style Selector="Border.tg-dragbox.creating">
        <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
    </Style>
    <!-- moving an existing card: a lighter brand ghost so it reads as a reschedule preview -->
    <Style Selector="Border.tg-dragbox.moving">
        <Setter Property="Background" Value="{StaticResource Brand100Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
    </Style>
    <!-- the move ghost settles a touch under full opacity so the grid shows through it -->
    <Style Selector="Border.tg-dragbox.moving.visible">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- the live "HH:MM – HH:MM" label centred in the box -->
    <Style Selector="TextBlock.tg-dragbox-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brand600Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- month chips -->
    <Style Selector="Button.mv-chip">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>
</Styles>
