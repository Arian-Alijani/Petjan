<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="using:Animora.Desktop.Pages.Appointments"
             x:Class="Animora.Desktop.Pages.Appointments.WeekGridView"
             x:DataType="ap:AppointmentsCalendarViewModel">
    <!-- Week view: the shared, fully data-bound time grid (seven day columns,
         Friday closed, live "now" line on today). No code-behind rebuild. -->
    <ap:TimeGridSurface />
</UserControl>
