<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="using:Animora.Desktop.Pages.Appointments"
             x:Class="Animora.Desktop.Pages.Appointments.DayGridView"
             x:DataType="ap:AppointmentsCalendarViewModel">
