<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:patients="using:Animora.Desktop.Pages.Patients"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Patients.OwnerSheetView"
             x:Name="Root"
             x:DataType="patients:OwnerSheetViewModel"
             FlowDirection="RightToLeft">

    <!-- Owner Sheet — re-draws Animora-UI/patients.html #drawerRoot (.sheet.owner-sheet)
         + patients-page.js renderOwnerSheet. Rendered as a page (this phase wires
         Phase 08's OpenOwner command to INavigationService, per the phase task). -->
    <UserControl.Styles>
        <Style Selector="TextBlock.odk">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.odv">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.odv.empty">
            <Setter Property="Foreground" Value="{StaticResource Muted2Brush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- section label (matches PetFile panelhead typography) -->
        <Style Selector="TextBlock.odsec">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- card shell (mirrors PetFile .panel) -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.panelhead">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style Selector="Border.odrow">
            <Setter Property="Padding" Value="16,15" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.copyable[IsPointerOver=True]">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Border.copyable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.odrow:last-child">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- hover affordance on list rows -->
        <Style Selector="Button.odlist">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.odlist:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>

        <Style Selector="Button.odbtn">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.odbtn.primary">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.odsm">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <!-- danger variant of .odbtn (delete owner): red text/border, soft red wash on hover -->
        <Style Selector="Button.odbtn.danger">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="Button.odbtn.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
        </Style>
        <!-- per-row trash icon button inside the pet roster (quiet until hovered) -->
        <Style Selector="Button.rowdel">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.rowdel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{StaticResource BgBrush}">

        <!-- sheet-body — page sized to match PetFileView (single scroll, 1120 max, 22/20 margins) -->
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="22,20,22,24" MaxWidth="1120">

                <!-- ══ hero (modern gradient — consistent with PetFileView) ══ -->
                <Border CornerRadius="22" Padding="24,22" Margin="0,0,0,16" ClipToBounds="True">
                    <Border.Background>
                        <RadialGradientBrush Center="88%,-30%" GradientOrigin="88%,-30%"
                                             RadiusX="130%" RadiusY="150%">
                            <GradientStop Color="#14b8a6" Offset="0" />
                            <GradientStop Color="#104a43" Offset="0.55" />
                            <GradientStop Color="#0c3631" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <Border Grid.Column="0" Width="84" Height="84" CornerRadius="26"
                                Background="{Binding ToneBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="30"
                                       FontWeight="ExtraBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="27" FontWeight="ExtraBold"
                                       Foreground="White" />
                            <TextBlock Text="{Binding FileText}" FontSize="12" Foreground="#a9ccc6" />
                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,11,0,0">
                                <Border CornerRadius="20" Padding="11,5" Background="#1CFFFFFF"
                                        BorderBrush="#24FFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="13" Height="13" Stroke="#eaf6f3"
                                              Data="{StaticResource IconUser}" />
                                        <TextBlock Text="{Binding GenderLabel}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="#eaf6f3" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="20" Padding="11,5" Background="#1CFFFFFF"
                                        BorderBrush="#24FFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="13" Height="13" Stroke="#eaf6f3"
                                              Data="{StaticResource IconHistory}" />
                                        <TextBlock Text="{Binding SinceText}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="#eaf6f3" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="20" Padding="11,5"
                                        Background="#2E88D6AB" BorderBrush="#4C58D6AB" BorderThickness="1"
                                        IsVisible="{Binding IsEditing}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="13" Height="13" Stroke="#c9f4e5"
                                              Data="{StaticResource IconEdit}" />
                                        <TextBlock Text="حالت ویرایش" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="#c9f4e5" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Width="40" Height="40" Padding="0" CornerRadius="12"
                                VerticalAlignment="Top" Background="#1FFFFFFF" BorderBrush="#33FFFFFF"
                                BorderThickness="1" Command="{Binding CloseCommand}" ToolTip.Tip="بستن پرونده">
                            <Path Classes="icon" Width="16" Height="16" Stroke="White"
                                  Data="{StaticResource IconX}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- od-grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="16" RowSpacing="18">

                    <!-- identity -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="10">
                        <TextBlock Classes="odsec" Text="اطلاعات هویتی" />
                        <Border Classes="panel">
                            <StackPanel>
                                <Border Classes="odrow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="نام" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding EditFirstName}"
                                                   IsVisible="{Binding IsEditing}" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding FirstName}"
                                                   IsVisible="{Binding IsViewing}" />
                                    </Grid>
                                </Border>
                                <Border Classes="odrow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="نام خانوادگی" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding EditLastName}"
                                                   IsVisible="{Binding IsEditing}" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding LastName}"
                                                   IsVisible="{Binding IsViewing}" />
                                    </Grid>
                                </Border>
                                <Border Classes="odrow copyable" Tag="{Binding NationalIdText}" PointerPressed="OnCopyRowPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="کد ملی" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding NationalIdText}"
                                                   IsVisible="{Binding IsViewing}" />
                                        <TextBox Grid.Column="1" Text="{Binding EditNationalId}" Width="240"
                                                 HorizontalAlignment="Left" IsVisible="{Binding IsEditing}"
                                                 FontSize="12.5" Padding="10,7" CornerRadius="9" />
                                        <Path Grid.Column="2" Classes="icon copyicon" Width="14" Height="14"
                                              Stroke="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                              IsVisible="{Binding IsViewing}"
                                              Data="{StaticResource IconCopy}" />
                                    </Grid>
                                </Border>
                                <Border Classes="odrow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="جنسیت" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding GenderLabel}"
                                                   IsVisible="{Binding IsViewing}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Left" IsVisible="{Binding IsEditing}">
                                            <RadioButton GroupName="ogender" Content="خانم"
                                                         IsChecked="{Binding EditIsFemale}" />
                                            <RadioButton GroupName="ogender" Content="آقا"
                                                         IsChecked="{Binding !EditIsFemale}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="odrow copyable" Tag="{Binding File}" PointerPressed="OnCopyRowPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="شماره پرونده" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding File}" />
                                        <Path Grid.Column="2" Classes="icon copyicon" Width="14" Height="14"
                                              Stroke="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                              IsVisible="{Binding IsViewing}"
                                              Data="{StaticResource IconCopy}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- contact -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="10">
                        <TextBlock Classes="odsec" Text="راه‌های ارتباطی" />
                        <Border Classes="panel">
                            <StackPanel>
                                <Border Classes="odrow copyable" Tag="{Binding Mobile1Text}" PointerPressed="OnCopyRowPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="موبایل اول" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding Mobile1Text}"
                                                   IsVisible="{Binding IsViewing}" />
                                        <TextBox Grid.Column="1" Text="{Binding EditMobile1}" Width="240"
                                                 HorizontalAlignment="Left" IsVisible="{Binding IsEditing}"
                                                 FontSize="12.5" Padding="10,7" CornerRadius="9" />
                                        <Path Grid.Column="2" Classes="icon copyicon" Width="14" Height="14"
                                              Stroke="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                              IsVisible="{Binding IsViewing}"
                                              Data="{StaticResource IconCopy}" />
                                    </Grid>
                                </Border>
                                <Border Classes="odrow copyable" Tag="{Binding Mobile2Text}" PointerPressed="OnCopyRowPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="موبایل دوم" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding Mobile2Text}"
                                                   IsVisible="{Binding IsViewing}" />
                                        <TextBox Grid.Column="1" Text="{Binding EditMobile2}" Width="240"
                                                 HorizontalAlignment="Left" IsVisible="{Binding IsEditing}"
                                                 FontSize="12.5" Padding="10,7" CornerRadius="9" />
                                        <Path Grid.Column="2" Classes="icon copyicon" Width="14" Height="14"
                                              Stroke="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                              IsVisible="{Binding IsViewing}"
                                              Data="{StaticResource IconCopy}" />
                                    </Grid>
                                </Border>
                                <Border Classes="odrow copyable" Tag="{Binding PhoneText}" PointerPressed="OnCopyRowPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="تلفن ثابت" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding PhoneText}"
                                                   IsVisible="{Binding IsViewing}" />
                                        <TextBox Grid.Column="1" Text="{Binding EditPhone}" Width="240"
                                                 HorizontalAlignment="Left" IsVisible="{Binding IsEditing}"
                                                 FontSize="12.5" Padding="10,7" CornerRadius="9" />
                                        <Path Grid.Column="2" Classes="icon copyicon" Width="14" Height="14"
                                              Stroke="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                              IsVisible="{Binding IsViewing}"
                                              Data="{StaticResource IconCopy}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- address (span) -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10">
                        <TextBlock Classes="odsec" Text="نشانی و نحوه آشنایی" />
                        <Border Classes="panel">
                            <StackPanel>
                                <Border Classes="odrow copyable" Tag="{Binding AddressText}" PointerPressed="OnCopyRowPressed">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="آدرس"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding AddressText}"
                                                   TextWrapping="Wrap" TextAlignment="Left" />
                                        <Path Grid.Column="2" Classes="icon copyicon" Width="14" Height="14"
                                              Stroke="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                              IsVisible="{Binding IsViewing}"
                                              Data="{StaticResource IconCopy}" />
                                    </Grid>
                                </Border>
                                <Border Classes="odrow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Classes="odk" Text="نحوه آشنایی" />
                                        <TextBlock Grid.Column="1" Classes="odv" Text="{Binding ReferralText}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- pets (span) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="odsec" Text="حیوانات" />
                                <Border Background="{StaticResource Bg2Brush}" CornerRadius="7"
                                        MinWidth="20" Height="20" Padding="6,0">
                                    <TextBlock Text="{Binding PetsCountText}" FontSize="11"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource Ink2Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="odbtn odsm" Command="{Binding AddPetCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="افزودن حیوان" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Classes="panel">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Pets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="patients:OwnerSheetPetRowViewModel">
                                            <Button Classes="odlist"
                                                    Command="{Binding #Root.((patients:OwnerSheetViewModel)DataContext).OpenPetCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="42,*,Auto,Auto,Auto" ColumnSpacing="13">
                                                    <Border Grid.Column="0" Width="42" Height="42"
                                                            CornerRadius="13" Background="{Binding ToneBrush}">
                                                        <Path Classes="icon" Width="20" Height="20"
                                                              Stroke="White"
                                                              Data="{Binding SpeciesIconKey, Converter={StaticResource IconKeyConverter}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                        <TextBlock Text="{Binding SubText}" FontSize="12"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <controls:Badge Grid.Column="2" Text="{Binding StatusText}"
                                                                    Tone="{Binding StatusTone}"
                                                                    VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Classes="rowdel" VerticalAlignment="Center"
                                                            Command="{Binding #Root.((patients:OwnerSheetViewModel)DataContext).DeletePetCommand}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="حذف حیوان">
                                                        <Path Classes="icon" Width="14" Height="14"
                                                              Stroke="{StaticResource DangerBrush}"
                                                              Data="{StaticResource IconTrash}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Path Grid.Column="4" Classes="icon" Width="15"
                                                          Height="15"
                                                          Stroke="{StaticResource Muted2Brush}"
                                                          Data="{StaticResource IconChevronLeft}"
                                                          VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="حیوانی برای این مالک ثبت نشده است"
                                           IsVisible="{Binding !HasPets}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Padding="22" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- invoices (span) -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Classes="odsec" Text="فاکتورها" />
                            <Border Background="{StaticResource Bg2Brush}" CornerRadius="7"
                                    MinWidth="20" Height="20" Padding="6,0">
                                <TextBlock Text="{Binding InvoicesCountText}" FontSize="11"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource Ink2Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Border Classes="panel">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Invoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="patients:OwnerInvoiceRowViewModel">
                                            <Button Classes="odlist"
                                                    Command="{Binding #Root.((patients:OwnerSheetViewModel)DataContext).OpenInvoiceCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="42,*,Auto,Auto,Auto" ColumnSpacing="14">
                                                    <Border Grid.Column="0" Width="42" Height="42"
                                                            CornerRadius="13"
                                                            Background="{StaticResource Brand50Brush}">
                                                        <Path Classes="icon" Width="20" Height="20"
                                                              Stroke="{StaticResource Brand700Brush}"
                                                              Data="{StaticResource IconReceipt}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                        <TextBlock Text="{Binding SubText}" FontSize="12"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                                    HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding TotalText}" FontSize="14.5"
                                                                       FontWeight="ExtraBold"
                                                                       Foreground="{StaticResource InkBrush}" />
                                                            <TextBlock Text="تومان" FontSize="11"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DueText}" FontSize="11.5"
                                                                   IsVisible="{Binding HasDue}"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <controls:Badge Grid.Column="3" Text="{Binding StateText}"
                                                                    Tone="{Binding StateTone}"
                                                                    VerticalAlignment="Center" />
                                                    <Path Grid.Column="4" Classes="icon" Width="15" Height="15"
                                                          Stroke="{StaticResource Muted2Brush}"
                                                          Data="{StaticResource IconChevronLeft}"
                                                          VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="فاکتوری ثبت نشده" IsVisible="{Binding !HasInvoices}"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Padding="22" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- sms (span) -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Classes="odsec" Text="پیامک‌های ارسال‌شده" />
                            <Border Background="{StaticResource Bg2Brush}" CornerRadius="7"
                                    MinWidth="20" Height="20" Padding="6,0">
                                <TextBlock Text="{Binding SmsCountText}" FontSize="11"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource Ink2Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Border Classes="panel">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SmsMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="patients:OwnerSmsRowViewModel">
                                            <Border Classes="odrow" Padding="16,13">
                                                <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="14">
                                                    <Border Grid.Column="0" Width="42" Height="42"
                                                            CornerRadius="13" VerticalAlignment="Top"
                                                            Background="{StaticResource Brand50Brush}">
                                                        <Path Classes="icon" Width="20" Height="20"
                                                              Stroke="{StaticResource Brand700Brush}"
                                                              Data="{StaticResource IconSms}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding Title}" FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                        <TextBlock Text="{Binding BodyText}"
                                                                   IsVisible="{Binding HasBody}"
                                                                   FontSize="12.5" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Ink2Brush}" />
                                                        <TextBlock Text="{Binding WhenText}" FontSize="12"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{StaticResource Bg2Brush}"
                                                            CornerRadius="8" Padding="9,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Channel}" FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource Ink2Brush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="پیامکی ارسال نشده" IsVisible="{Binding !HasSms}"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Padding="22" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- activity (span) -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10">
                        <TextBlock Classes="odsec" Text="خلاصه فعالیت" />
                        <Border Classes="panel">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                    <Border Grid.Column="0" Padding="12,18">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding VisitsCountText}" FontSize="20"
                                                       FontWeight="ExtraBold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="ویزیت ثبت‌شده" FontSize="12" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="12,18" BorderBrush="{StaticResource Line2Brush}"
                                            BorderThickness="1,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding VaccinesCountText}" FontSize="20"
                                                       FontWeight="ExtraBold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="واکسن تزریق‌شده" FontSize="12" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="12,18" BorderBrush="{StaticResource Line2Brush}"
                                            BorderThickness="1,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding InvoicesCountText}" FontSize="20"
                                                       FontWeight="ExtraBold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="فاکتور" FontSize="12" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Padding="12,18" BorderBrush="{StaticResource Line2Brush}"
                                            BorderThickness="1,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding PetsCountText}" FontSize="20"
                                                       FontWeight="ExtraBold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="حیوان فعال" FontSize="12" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Padding="12,18" BorderBrush="{StaticResource Line2Brush}"
                                            BorderThickness="1,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding LastActivityText}" FontSize="20"
                                                       FontWeight="ExtraBold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="آخرین فعالیت" FontSize="12" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="patients:OwnerActivityRowViewModel">
                                            <Border BorderBrush="{StaticResource Line2Brush}"
                                                    BorderThickness="0,1,0,0" Padding="16,12">
                                                <Grid ColumnDefinitions="36,*,Auto,Auto" ColumnSpacing="13">
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11"
                                                            Background="{StaticResource Bg2Brush}">
                                                        <Path Classes="icon" Width="17" Height="17"
                                                              Stroke="{StaticResource Ink2Brush}"
                                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                                                IsVisible="{Binding HasAmount}">
                                                        <TextBlock Text="{Binding AmountText}" FontSize="13.5"
                                                                   FontWeight="ExtraBold" HorizontalAlignment="Left"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                        <TextBlock Text="تومان" FontSize="10.5"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center"
                                                                MinWidth="84">
                                                        <controls:Badge Text="{Binding KindLabel}"
                                                                        Tone="{Binding KindTone}"
                                                                        HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding WhenText}" FontSize="11.5"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="فعالیتی ثبت نشده" IsVisible="{Binding !HasActivity}"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Padding="0,4,0,22" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- sheet-foot -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line2Brush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" Spacing="10" MaxWidth="1120"
                        HorizontalAlignment="Center">
                <Button Classes="odbtn primary" Height="42" Command="{Binding SaveCommand}"
                        IsVisible="{Binding IsEditing}" Width="210">
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                HorizontalAlignment="Center">
                        <Path Classes="icon" Width="15" Height="15" Stroke="White"
                              Data="{StaticResource IconCheck}" />
                        <TextBlock Text="ذخیره تغییرات" />
                    </StackPanel>
                </Button>
                <Button Classes="odbtn" Height="42" Command="{Binding CancelEditCommand}"
                        IsVisible="{Binding IsEditing}" Width="130">
                    <TextBlock Text="انصراف" HorizontalAlignment="Center" />
                </Button>
                <Button Classes="odbtn primary" Height="42" Command="{Binding EditCommand}"
                        IsVisible="{Binding IsViewing}" Width="210">
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                HorizontalAlignment="Center">
                        <Path Classes="icon" Width="15" Height="15" Stroke="White"
                              Data="{StaticResource IconEdit}" />
                        <TextBlock Text="ویرایش اطلاعات" />
                    </StackPanel>
                </Button>
                <Button Classes="odbtn" Height="42" Command="{Binding CloseCommand}"
                        IsVisible="{Binding IsViewing}" Width="130">
                    <TextBlock Text="بستن" HorizontalAlignment="Center" />
                </Button>
                <Button Classes="odbtn danger" Height="42" Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsViewing}" Width="150" ToolTip.Tip="حذف مالک و همه حیوانات او">
                    <StackPanel Orientation="Horizontal" Spacing="7"
                                HorizontalAlignment="Center">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource DangerBrush}"
                              Data="{StaticResource IconTrash}" />
                        <TextBlock Text="حذف مالک" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
