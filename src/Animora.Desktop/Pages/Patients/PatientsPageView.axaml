<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:patients="using:Animora.Desktop.Pages.Patients"
             xmlns:settings="using:Animora.Desktop.Pages.Patients.Settings"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Patients.PatientsPageView"
             x:Name="Root"
             x:DataType="patients:PatientsPageViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- Segmented switch (.pb-seg): a soft track with pill buttons; the
             active pill gets the reference's white fill + 2/8 shadow. -->
        <Style Selector="Border.seg">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Border.segitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Border.segitem.on">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowSegment}" />
        </Style>
        <Style Selector="Button.segtap">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="15,8" />
        </Style>
        <Style Selector="Button.segtap.lg">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,9" />
        </Style>
        <Style Selector="Button.segtap:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Compact square icon button used by the settings tab's inline
             edit/delete/confirm actions. -->
        <Style Selector="Button.iconbtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.iconbtn Path">
            <Setter Property="Stroke" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.iconbtn.sm">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Border.segitem Path">
            <Setter Property="Stroke" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Border.segitem.on Path">
            <Setter Property="Stroke" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Border.segitem.on TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>

        <!-- Filter chips (.pb-chip): pill outline; active = brand fill + white
             text + 2/8 brand shadow. -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Border.chip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Background" Value="#f6f8fb" />
        </Style>
        <Style Selector="Border.chip.on">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowChip}" />
        </Style>
        <Style Selector="Button.chiptap">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="13,6" />
        </Style>
        <Style Selector="Button.chiptap:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.chip Path">
            <Setter Property="Stroke" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Border.chip:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Border.chip:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Border.chip.on Path">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="Border.chip.on TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.chip.on Button.chiptap">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Chip count pill (.pb-chip .cnt). -->
        <Style Selector="Border.cnt">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <Style Selector="Border.cnt TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Border.chip.on Border.cnt">
            <Setter Property="Background" Value="#38FFFFFF" />
        </Style>
        <Style Selector="Border.chip.on Border.cnt TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Compact toolbar select (.pb-select). Themed to match the app's
             panel/brand palette instead of the default grey ComboBox chrome. -->
        <Style Selector="ComboBox.pbselect">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- keep the flat themed background across the ComboBox's own visual states
             (Avalonia's default template paints its own grey on hover/pressed). -->
        <Style Selector="ComboBox.pbselect /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ComboBox.pbselect:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>
        <Style Selector="ComboBox.pbselect:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>
        <Style Selector="ComboBox.pbselect:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>
        <Style Selector="ComboBox.pbselect:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <!-- chevron glyph colour -->
        <Style Selector="ComboBox.pbselect /template/ PathIcon">
            <Setter Property="Foreground" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="ComboBox.pbselect:pointerover /template/ PathIcon">
            <Setter Property="Foreground" Value="{StaticResource Brand600Brush}" />
        </Style>
        <!-- dropdown popup surface -->
        <Style Selector="ComboBox.pbselect /template/ Popup Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- dropdown items -->
        <Style Selector="ComboBox.pbselect ComboBoxItem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox.pbselect ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="ComboBox.pbselect ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>

        <!-- Pagination nav buttons (.pgbtn): minimal outlined pills matching
             the toolbar selects; brand tint on hover, dimmed when disabled. -->
        <Style Selector="Button.pgbtn">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pgbtn Path">
            <Setter Property="Stroke" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.pgbtn:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
        </Style>
        <Style Selector="Button.pgbtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.pgbtn:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.pgbtn:disabled">
            <Setter Property="Opacity" Value="0.42" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- Owner card / pet card hover affordances on the clickable surface. -->
        <Style Selector="Path.reveal">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Tiny footer buttons (.btn-tiny). -->
        <Style Selector="Button.tiny">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.tiny:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.tiny.add">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- Table cells. -->
        <Style Selector="TextBlock.th">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.nm">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.sb">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.overdue">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
        <!-- Owner card (.owner-card) / pet card (.pet-card) as a clickable
             surface; the active card gets the brand border, and the trailing
             chevron reveals on hover. -->
        <Style Selector="Button.cardlink">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <!-- Button exposes no BoxShadow property; the card shadow lives on the
             template's content-presenter surface (Avalonia idiom). -->
        <Style Selector="Button.cardlink /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
        </Style>
        <Style Selector="Button.cardlink:pointerover">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
        </Style>
        <Style Selector="Path.reveal">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Stroke" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.cardlink:pointerover Path.reveal">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>

        <!-- Owner card internals. -->
        <Style Selector="Border.gpill">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style Selector="Border.gpill TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Border.filebadge">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.filebadge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Border.tagpill">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.tagpill TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.ocline">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>

        <!-- Pet chip inside an owner card (.pet-chip) — a clickable row. -->
        <Style Selector="Button.petchip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.petchip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.petchip:pointerover Path.reveal">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>

        <!-- Sex dot (.sex-dot). -->
        <Style Selector="Border.sexdot">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Border.sexdot TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>

        <!-- Pet card internals (.pet-card). -->
        <Style Selector="Border.pkav">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowSegment}" />
        </Style>
        <Style Selector="Border.pkbreed">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="TextBlock.fv">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.fl">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Pets table (adapted from the reference's .pt-table: the same
             white card, header band, 12/16 cell padding and 11.5px muted
             uppercase-ish header). -->
        <Style Selector="TextBlock.ovcell">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.ovcell.overdue">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>

        <!-- Table row link (adapted .pt-table tbody tr) -->
        <Style Selector="Button.rowlink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.rowlink:pointerover Border">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
        </Style>

        <!-- Real row table (سطری): card shell, header band, row surface. -->
        <Style Selector="Border.rowtable">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.rowhead">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Border.rowtable ListBox.records">
            <Setter Property="MaxHeight" Value="560" />
        </Style>
        <Style Selector="Button.trow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.trow /template/ ContentPresenter#PART_ContentPresenter,
                         Button.trow:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.trow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.rowsurface">
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.trow:pointerover Border.rowsurface, Button.trow:focus-visible Border.rowsurface">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
        </Style>
        <Style Selector="Path.go">
            <Setter Property="Stroke" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.trow:pointerover Path.go">
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>

        <!-- Virtualized record lists (ListBox). The ListBox supplies the
             VirtualizingStackPanel + its own ScrollViewer so only visible rows
             are realized; these styles strip its default selection/hover chrome
             so the existing card/row visuals render unchanged. -->
        <!-- ListBox.records MaxHeight is REQUIRED: the shell wraps every page in
             a page-level ScrollViewer that measures content with infinite
             height, which would otherwise defeat virtualization. Capping the
             list makes it measure its own viewport and only realize the visible
             rows (it scrolls internally via its ScrollViewer). -->
        <Style Selector="ListBox.records">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxHeight" Value="600" />
        </Style>
        <Style Selector="ListBox.records ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.records ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.records ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- Root is a Grid with a `*` records row so the virtualized record lists
         below get a BOUNDED height and scroll internally. Inside the shell's
         page-level ScrollViewer an unbounded StackPanel would hand the inner
         VirtualizingStackPanel infinite height and defeat virtualization
         entirely (it would measure every row). Header/toolbar stay in row 0. -->
    <Grid RowDefinitions="Auto,*" Margin="26,22,26,40">

        <!-- Header + toolbar occupy the Auto row; the records list below gets
             the `*` row (bounded height) so its VirtualizingStackPanel works. -->
        <StackPanel Grid.Row="0">

        <!-- ── page header (.pt-head) ─────────────────────────────── -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Text="بیماران و سرپرستان" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsDirectorySection}">
                <Button Classes="outline" Command="{Binding ExportExcelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconDownload}" />
                        <TextBlock Text="خروجی" />
                    </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding AddNewOwnerPetCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16" Stroke="White"
                              Data="{StaticResource IconPlus}" />
                        <TextBlock Text="سرپرست و بیمار جدید" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── toolbar (.pagebar) ─────────────────────────────────── -->
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}"
                BoxShadow="{StaticResource ShadowCard}"
                Padding="14,12" Margin="0,0,0,16">
            <StackPanel Spacing="12">

                <!-- tier 1 · section tabs (owners / pets / settings) + search (end, directory only) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="seg" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
                            <Border Grid.Column="0" Classes="segitem" Classes.on="{Binding IsOwnersTabActive}">
                                <Button Classes="segtap lg" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="owners">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Data="{StaticResource IconUsers}" />
                                        <TextBlock Text="سرپرستان" FontSize="13.5" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border Grid.Column="1" Classes="segitem" Classes.on="{Binding IsPetsTabActive}">
                                <Button Classes="segtap lg" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="pets">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Data="{StaticResource IconPaw}" />
                                        <TextBlock Text="بیماران" FontSize="13.5" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <!-- clinic settings (species / breeds / file-opened SMS) -->
                            <Border Grid.Column="2" Classes="segitem" Classes.on="{Binding IsSettingsSection}">
                                <Button Classes="segtap lg" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding SetSectionCommand}" CommandParameter="settings"
                                        ToolTip.Tip="تنظیمات سرپرستان و بیماران">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Data="{StaticResource IconTag}" />
                                        <TextBlock Text="تنظیمات" FontSize="13.5" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- search field (.pb-search) -->
                    <Border Grid.Column="1" Width="360" MinWidth="200"
                            IsVisible="{Binding IsDirectorySection}"
                            Background="{StaticResource Bg2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="13,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                                  VerticalAlignment="Center"
                                  Stroke="{StaticResource MutedBrush}"
                                  Data="{StaticResource IconSearch}" IsHitTestVisible="False" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText}"
                                     PlaceholderText="جستجوی نام، سرپرست، پرونده، موبایل یا میکروچیپ…"
                                     FontSize="13" BorderThickness="0" Background="Transparent"
                                     Padding="0,10" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Width="20" Height="20" Padding="0"
                                    CornerRadius="999" Background="{StaticResource Brand50Brush}"
                                    BorderThickness="0" VerticalAlignment="Center"
                                    IsVisible="{Binding HasSearchText}"
                                    Command="{Binding ClearSearchCommand}">
                                <Path Classes="icon" Width="12" Height="12"
                                      Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconX}" />
                            </Button>
                        </Grid>
                    </Border>

                </Grid>

                <!-- tier 2 · species chips (start) + secondary controls (end) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                      IsVisible="{Binding IsDirectorySection}"
                      Margin="0,12,0,0">
                    <StackPanel Grid.Column="0">
                        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,-12,0,0">
                            <ItemsControl ItemsSource="{Binding SpeciesChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="patients:PatientsSpeciesChipViewModel">
                                        <Border Classes="chip" Classes.on="{Binding IsActive}" Margin="0,0,7,0">
                                            <Button Classes="chiptap"
                                                    Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).SetSpeciesCommand}"
                                                    CommandParameter="{Binding CommandValue}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Classes="icon" Width="14" Height="14"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                    <TextBlock Text="{Binding Label}" />
                                                    <Border Classes="cnt">
                                                        <TextBlock Text="{Binding CountText}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- trailing control cluster (.pb-tools) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResultCountText}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="22" Background="{StaticResource LineBrush}" />
                        <ComboBox Classes="pbselect" SelectedIndex="{Binding VaccineFilterIndex}">
                            <ComboBoxItem Content="واکسن: همه" />
                            <ComboBoxItem Content="دارای واکسن" />
                            <ComboBoxItem Content="بدون واکسن" />
                        </ComboBox>
                        <ComboBox Classes="pbselect" SelectedIndex="{Binding SortIndex}">
                            <ComboBoxItem Content="{Binding RecentSortLabel}" />
                            <ComboBoxItem Content="نام (الفبا)" />
                            <ComboBoxItem Content="{Binding AgeSortLabel}" />
                        </ComboBox>
                        <!-- records-per-page select (initial-load perf cap) -->
                        <ComboBox Classes="pbselect" MinWidth="120"
                                  ItemsSource="{Binding PageSizeOptions}"
                                  SelectedItem="{Binding SelectedPageSize}"
                                  ToolTip.Tip="تعداد نمایش در هر صفحه" />
                        <Border Classes="seg">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Border Classes="segitem" Classes.on="{Binding IsListView}">
                                    <Button Classes="segtap"
                                            Command="{Binding SetLayoutCommand}" CommandParameter="list">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Path Classes="icon" Width="16" Height="16"
                                                  Data="{StaticResource IconList}" />
                                            <TextBlock Text="سطری" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <Border Classes="segitem" Classes.on="{Binding IsGridView}">
                                    <Button Classes="segtap"
                                            Command="{Binding SetLayoutCommand}" CommandParameter="grid">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Path Classes="icon" Width="16" Height="16"
                                                  Data="{StaticResource IconGrid}" />
                                            <TextBlock Text="باکسی" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        </StackPanel>

        <!-- ── content (bounded row: only this area scrolls) ────────
             Four render combinations + a shared empty state, mirroring the
             reference's render(): owners/pets × list(rows)/grid(boxes).
             RTL: "start" = Right, "end" = Left.
             All four lists are ListBoxes (VirtualizingStackPanel + own
             ScrollViewer) so only visible rows are realized.
             Row 0 = the lists/empty-state; Row 1 = the pagination footer. -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsDirectorySection}">

        <!-- Detailed owner cards, virtualized in three-card rows. ItemsRepeater is gone in
             Avalonia 12 (see BoardingPageView) and no built-in WrapPanel/UniformGrid virtualizes,
             so virtualization stays at row granularity (a page is bounded to <=200 cards => <=67
             rows; only visible rows are realized). -->
        <ListBox Classes="records" ItemsSource="{Binding OwnerRows}"
                 IsVisible="{Binding ShowOwnersGrid}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="patients:OwnerCardRowViewModel">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="patients:OwnerCardViewModel">
                    <Button Classes="cardlink" HorizontalAlignment="Stretch" Margin="0,0,14,14"
                            Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).OpenOwnerCommand}"
                            CommandParameter="{Binding Owner}">
                        <StackPanel>
                            <!-- oc-top -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,16,16,12">
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14"
                                        Background="{Binding ToneBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="ExtraBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <Border Classes="gpill" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GenderLabel}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="filebadge">
                                            <TextBlock Text="{Binding FileText}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="patients:OwnerTagViewModel">
                                                    <Border Classes="tagpill" Background="{Binding Background}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Width="36" Height="36" Padding="0" CornerRadius="10"
                                        Background="{StaticResource PanelBrush}" BorderThickness="0"
                                        VerticalAlignment="Top" ToolTip.Tip="مشاهده پرونده"
                                        Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).OpenOwnerCommand}"
                                        CommandParameter="{Binding Owner}">
                                    <Path Classes="icon" Width="18" Height="18" Data="{StaticResource IconEye}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!-- oc-contact: 2-col grid of contact lines + a full-width address -->
                            <StackPanel Margin="16,0,16,12" Spacing="6">
                                <!-- Fixed-arity (4) contact lines: explicit 2x2 grid instead of a nested
                                     ItemsControl per card (PERFORMANCE.md §7 cheap visual tree). -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="7" Margin="0,0,0,6">
                                        <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center"
                                              Data="{Binding ContactLines[0].IconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Text="{Binding ContactLines[0].Value}" Classes="ocline" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="7" Margin="0,0,0,6">
                                        <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center"
                                              Data="{Binding ContactLines[1].IconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Text="{Binding ContactLines[1].Value}" Classes="ocline" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Spacing="7" Margin="0,0,0,6">
                                        <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center"
                                              Data="{Binding ContactLines[2].IconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Text="{Binding ContactLines[2].Value}" Classes="ocline" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="7" Margin="0,0,0,6">
                                        <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center"
                                              Data="{Binding ContactLines[3].IconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Text="{Binding ContactLines[3].Value}" Classes="ocline" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Top"
                                          Data="{StaticResource IconPin}" />
                                    <TextBlock Text="{Binding Address}" Classes="ocline" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <!-- oc-pets -->
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                                    Background="{StaticResource InsetBrush}" Padding="16,12,16,14">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9">
                                        <TextBlock Grid.Column="0" Text="{Binding PetCountText}" FontSize="11"
                                                   FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="tiny add"
                                                Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).AddPetCommand}"
                                                CommandParameter="{Binding Owner}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Path Classes="icon" Width="14" Height="14"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      Data="{StaticResource IconPlus}" />
                                                <TextBlock Text="افزودن حیوان" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Pets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="patients:OwnerPetChipViewModel">
                                                <Button Classes="petchip"
                                                        Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).OpenPetCommand}"
                                                        CommandParameter="{Binding Pet}">
                                                    <Grid ColumnDefinitions="34,*,Auto,Auto" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                                                                Background="{Binding ToneBrush}">
                                                            <Path Classes="icon" Width="18" Height="18" Stroke="White"
                                                                  Data="{Binding SpeciesIconKey, Converter={StaticResource IconKeyConverter}}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                                           Foreground="{StaticResource InkBrush}" />
                                                                <Border Classes="sexdot" Background="{Binding Sex.Background}">
                                                                    <TextBlock Text="{Binding Sex.Glyph}" Foreground="{Binding Sex.Foreground}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SubText}" FontSize="10.5"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </StackPanel>
                                                        <controls:Badge Grid.Column="2" VerticalAlignment="Center"
                                                                        Text="{Binding StatusText}" Tone="{Binding StatusTone}" />
                                                        <Path Grid.Column="3" Classes="icon reveal" Width="16" Height="16"
                                                              VerticalAlignment="Center" Data="{StaticResource IconChevronLeft}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- oc-foot -->
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" Padding="16,10">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Classes="tiny"
                                            Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).OpenOwnerCommand}"
                                            CommandParameter="{Binding Owner}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="icon" Width="14" Height="14"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  Data="{StaticResource IconFile}" />
                                            <TextBlock Text="پرونده سرپرست" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="tiny"
                                            Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).CallOwnerCommand}"
                                            CommandParameter="{Binding Owner}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="icon" Width="14" Height="14"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  Data="{StaticResource IconPhone}" />
                                            <TextBlock Text="تماس" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="3" Text="{Binding SinceText}" FontSize="11"
                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Detailed patient cards, virtualized in three-card rows. -->
        <ListBox Classes="records" ItemsSource="{Binding PetRows}"
                 IsVisible="{Binding ShowPetsGrid}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="patients:PetCardRowViewModel">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="patients:PetCardViewModel">
                    <Button Classes="cardlink" HorizontalAlignment="Stretch" Margin="0,0,14,14"
                            Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).OpenPetCommand}"
                            CommandParameter="{Binding Pet}">
                        <StackPanel>
                            <!-- pk-cover (74px) + overlapping pk-av -->
                            <Border Height="74" CornerRadius="18,18,0,0" ClipToBounds="False"
                                    Background="{Binding CoverBrush}">
                                <Grid>
                                    <controls:Badge HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="12,10,0,0"
                                                    Text="{Binding StatusText}" Tone="{Binding StatusTone}" />
                                    <Border Width="56" Height="56" CornerRadius="18"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="16,0,16,-22" Background="{Binding ToneBrush}"
                                            BorderBrush="White" BorderThickness="3"
                                            BoxShadow="{StaticResource ShadowSegment}">
                                        <Path Classes="icon" Width="26" Height="26" Stroke="White"
                                              Data="{Binding SpeciesIconKey, Converter={StaticResource IconKeyConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,12,16,14" Spacing="0">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <Border Classes="sexdot" Background="{Binding Sex.Background}">
                                        <TextBlock Text="{Binding Sex.Glyph}" Foreground="{Binding Sex.Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding CodeText}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                <Border Classes="pkbreed" HorizontalAlignment="Left" Margin="0,9,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="14" Height="14"
                                              Stroke="{StaticResource MutedBrush}"
                                              Data="{Binding SpeciesIconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Text="{Binding BreedText}" FontSize="11.5"
                                                   Foreground="{StaticResource Ink2Brush}" />
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                                        Margin="0,12,0,0" Padding="0,11,0,0">
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding AgeShortText}" Classes="fv" HorizontalAlignment="Center" />
                                            <TextBlock Text="سن" Classes="fl" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Classes="fv" HorizontalAlignment="Center">
                                                <Run Text="{Binding WeightText}" /><Run Text=" کیلو" FontSize="9" />
                                            </TextBlock>
                                            <TextBlock Text="وزن فعلی" Classes="fl" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <TextBlock Text="{Binding LastVisitText}" Classes="fv" FontSize="11.5"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="آخرین ویزیت" Classes="fl" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource Line2Brush}"
                                    BorderThickness="0,1,0,0" Padding="16,10">
                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8"
                                            Background="{Binding OwnerToneBrush}">
                                        <TextBlock Text="{Binding OwnerInitials}" FontSize="11" FontWeight="ExtraBold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding OwnerName}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Path Grid.Column="2" Classes="icon reveal" Width="16" Height="16"
                                          VerticalAlignment="Center" Data="{StaticResource IconChevronLeft}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ═══ Real row layout (سطری) ═══════════════════════════════════
             One record per row inside a single card: a sticky column header +
             a virtualized ListBox bound DIRECTLY to the filtered collection
             (no 3-card chunking). Header and rows share the same fixed/star
             column template so columns line up; no Auto columns are used for
             exactly that reason. -->

        <!-- Owners · rows -->
        <Border Classes="rowtable" IsVisible="{Binding ShowOwnersTable}">
            <StackPanel>
                <Border Classes="rowhead">
                    <Grid ColumnDefinitions="2.2*,1.5*,1.8*,1.2*,1.2*,96,28" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Classes="th" Text="سرپرست" />
                        <TextBlock Grid.Column="1" Classes="th" Text="تماس" />
                        <TextBlock Grid.Column="2" Classes="th" Text="حیوانات" />
                        <TextBlock Grid.Column="3" Classes="th" Text="آخرین ویزیت" />
                        <TextBlock Grid.Column="4" Classes="th" Text="عضویت" />
                        <TextBlock Grid.Column="5" Classes="th" Text="واکسن" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
                <ListBox Classes="records" ItemsSource="{Binding FilteredOwners}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="patients:OwnerCardViewModel">
                            <Button Classes="trow"
                                    Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).OpenOwnerCommand}"
                                    CommandParameter="{Binding Owner}">
                                <Border Classes="rowsurface">
                                    <Grid ColumnDefinitions="2.2*,1.5*,1.8*,1.2*,1.2*,96,28" ColumnSpacing="12">
                                        <!-- owner -->
                                        <Grid Grid.Column="0" ColumnDefinitions="40,*" ColumnSpacing="11">
                                            <Border Width="40" Height="40" CornerRadius="12"
                                                    Background="{Binding ToneBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Name}" Classes="nm" FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="sb" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding GenderLabel}" /><Run Text=" · " /><Run Text="{Binding FileText}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <!-- contact -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center"
                                                      Stroke="{StaticResource Muted2Brush}"
                                                      Data="{StaticResource IconMobile}" />
                                                <TextBlock Text="{Binding Owner.Mobile1}" Classes="ocline" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Owner.Phone, TargetNullValue=بدون تلفن ثابت}"
                                                       Classes="sb" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- pets -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding PetCountText}" Classes="nm" FontSize="12.5" />
                                            <TextBlock Text="{Binding PetsPreviewText}" Classes="sb"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- last visit -->
                                        <TextBlock Grid.Column="3" Text="{Binding LastVisitText}" Classes="ocline"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <!-- since -->
                                        <TextBlock Grid.Column="4" Text="{Binding SinceText}" Classes="sb"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <!-- vaccine -->
                                        <controls:Badge Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Text="{Binding VaccineStateText}" Tone="{Binding VaccineStateTone}"
                                                        ToolTip.Tip="وضعیت واکسن حیوانات" />
                                        <Path Grid.Column="6" Classes="icon go" Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="{StaticResource IconChevronLeft}" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Pets · rows -->
        <Border Classes="rowtable" IsVisible="{Binding ShowPetsTable}">
            <StackPanel>
                <Border Classes="rowhead">
                    <Grid ColumnDefinitions="2.2*,1.5*,1.8*,1.1*,1.4*,1.4*,96,28" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Classes="th" Text="بیمار" />
                        <TextBlock Grid.Column="1" Classes="th" Text="گونه و نژاد" />
                        <TextBlock Grid.Column="2" Classes="th" Text="سرپرست" />
                        <TextBlock Grid.Column="3" Classes="th" Text="سن و وزن" />
                        <TextBlock Grid.Column="4" Classes="th" Text="آخرین ویزیت" />
                        <TextBlock Grid.Column="5" Classes="th" Text="واکسن بعدی" />
                        <TextBlock Grid.Column="6" Classes="th" Text="وضعیت" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
                <ListBox Classes="records" ItemsSource="{Binding FilteredPets}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="patients:PetCardViewModel">
                            <Button Classes="trow"
                                    Command="{Binding #Root.((patients:PatientsPageViewModel)DataContext).OpenPetCommand}"
                                    CommandParameter="{Binding Pet}">
                                <Border Classes="rowsurface">
                                    <Grid ColumnDefinitions="2.2*,1.5*,1.8*,1.1*,1.4*,1.4*,96,28" ColumnSpacing="12">
                                        <!-- patient -->
                                        <Grid Grid.Column="0" ColumnDefinitions="40,*" ColumnSpacing="11">
                                            <Border Width="40" Height="40" CornerRadius="12"
                                                    Background="{Binding ToneBrush}" VerticalAlignment="Center">
                                                <Path Classes="icon" Width="20" Height="20" Stroke="White"
                                                      Data="{Binding SpeciesIconKey, Converter={StaticResource IconKeyConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" Classes="nm" FontSize="13.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Classes="sexdot" Background="{Binding Sex.Background}"
                                                            ToolTip.Tip="{Binding Sex.Title}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Sex.Glyph}" Foreground="{Binding Sex.Foreground}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CodeText}" Classes="sb" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- species / breed -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding SpeciesLabel}" Classes="ocline" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Breed}" Classes="sb" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- owner -->
                                        <Grid Grid.Column="2" ColumnDefinitions="26,*" ColumnSpacing="8">
                                            <Border Width="26" Height="26" CornerRadius="8"
                                                    Background="{Binding OwnerToneBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OwnerInitials}" Foreground="White" FontSize="10.5"
                                                           FontWeight="Bold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding OwnerName}" Classes="ocline" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding OwnerMobile}" Classes="sb" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- age / weight -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding AgeLongText}" Classes="ocline" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding WeightTableText}" Classes="sb" />
                                        </StackPanel>
                                        <!-- last visit -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding LastVisitText}" Classes="ocline" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastVisitType}" Classes="sb" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- next vaccine -->
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding NextVaccineText}" Classes="ovcell"
                                                       Classes.overdue="{Binding IsNextVaccineOverdue}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding NextVaccineName}" Classes="sb" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- status -->
                                        <controls:Badge Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Text="{Binding StatusText}" Tone="{Binding StatusTone}" />
                                        <Path Grid.Column="7" Classes="icon go" Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="{StaticResource IconChevronLeft}" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- empty state (.pt-empty) -->
        <Border IsVisible="{Binding ShowEmptyState}" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="18" Padding="20,64">
            <StackPanel HorizontalAlignment="Center" Spacing="0">
                <Border Width="58" Height="58" CornerRadius="20" Background="{StaticResource Bg2Brush}"
                        HorizontalAlignment="Center">
                    <Path Classes="icon" Width="26" Height="26" Stroke="{StaticResource Muted2Brush}"
                          Data="{StaticResource IconSearch}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,14,0,5" />
                <TextBlock Text="عبارت جستجو یا فیلترها را تغییر دهید." FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                <Button Classes="outline" HorizontalAlignment="Center" Command="{Binding ResetFiltersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="14" Height="14"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconX}" />
                        <TextBlock Text="پاک کردن فیلترها" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ── pagination footer ────────────────────────────────────────
             Only shown when the matches span more than one page. RTL: the
             "previous" control sits at the start (right) and points right
             (IconChevronRight); "next" sits at the end (left) and points left
             (IconChevronLeft) — same convention as the calendar stepper. -->
        <Border Grid.Row="1" IsVisible="{Binding ShowPagination}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}"
                BoxShadow="{StaticResource ShadowCard}"
                Padding="14,10" Margin="0,14,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- range caption (start / right) -->
                <TextBlock Grid.Column="0" Text="{Binding PageRangeText}" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />

                <!-- nav cluster (end / left) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="pgbtn" Command="{Binding PreviousPageCommand}"
                            ToolTip.Tip="صفحه قبل">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="16" Height="16"
                                  Data="{StaticResource IconChevronRight}" />
                            <TextBlock Text="قبلی" />
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource Bg2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageIndicatorText}" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Button Classes="pgbtn" Command="{Binding NextPageCommand}"
                            ToolTip.Tip="صفحه بعد">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="بعدی" />
                            <Path Classes="icon" Width="16" Height="16"
                                  Data="{StaticResource IconChevronLeft}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        </Grid>

        <!-- ── settings section (replaces the directory; opened from the toolbar button) ──
             Species/breeds and the "file opened" SMS sit side by side so nothing needs a long scroll;
             the ScrollViewer is only a fallback for very small windows. -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSettingsSection}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">

                <!-- settings header: title + back to the directory (replaces the old tab strip) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="تنظیمات سرپرستان و بیماران" FontSize="18" FontWeight="ExtraBold"
                                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="نوع حیوانات، نژادها و پیامک باز شدن پرونده" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="outline" Padding="14,8"
                            Command="{Binding SetSectionCommand}" CommandParameter="directory">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="14" Height="14"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource IconChevronRight}" />
                            <TextBlock Text="بازگشت به فهرست" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- two compact cards side by side: species & breeds (wider) | SMS -->
                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
                    <!-- card 1 · species & breeds -->
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}"
                            BoxShadow="{StaticResource ShadowCard}" Padding="18,16">
                        <StackPanel Spacing="14">

                            <!-- card header -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="{StaticResource Brand50Brush}">
                                        <Path Classes="icon" Width="18" Height="18"
                                              Stroke="{StaticResource Brand700Brush}"
                                              Data="{StaticResource IconPaw}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="نوع حیوانات و نژادها" FontSize="15"
                                                   FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="نوع حیوانات و نژادهای مربوط به هر کدام را اضافه، ویرایش یا حذف کنید."
                                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- add-species input -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" Background="{StaticResource Bg2Brush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="13,0">
                                    <TextBox Text="{Binding Settings.NewSpeciesName}"
                                             PlaceholderText="نام نوع حیوان جدید (مثلاً اسب)…"
                                             FontSize="13" BorderThickness="0" Background="Transparent"
                                             Padding="0,10" VerticalContentAlignment="Center" />
                                </Border>
                                <Button Grid.Column="1" Classes="primary"
                                        Command="{Binding Settings.AddSpeciesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="icon" Width="16" Height="16" Stroke="White"
                                              Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="افزودن نوع" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- species list -->
                            <ItemsControl ItemsSource="{Binding Settings.Species}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="settings:SpeciesSettingsItemViewModel">
                                        <Border Background="{StaticResource Bg2Brush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="14" Padding="16,14">
                                            <StackPanel Spacing="12">

                                                <!-- species header row -->
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                            Background="{StaticResource PanelBrush}"
                                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                                        <Path Classes="icon" Width="18" Height="18"
                                                              Stroke="{StaticResource Brand700Brush}"
                                                              Data="{StaticResource IconPaw}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- name (read mode) -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                                                                VerticalAlignment="Center" Margin="11,0,0,0"
                                                                IsVisible="{Binding !IsEditingName}">
                                                        <TextBlock Text="{Binding Name}" FontSize="14.5"
                                                                   FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Classes="cnt" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BreedCountText}" VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- name (edit mode) -->
                                                    <Border Grid.Column="1" Margin="11,0,0,0"
                                                            Background="{StaticResource PanelBrush}"
                                                            BorderBrush="{StaticResource Brand400Brush}" BorderThickness="1"
                                                            CornerRadius="10" Padding="11,0"
                                                            IsVisible="{Binding IsEditingName}">
                                                        <TextBox Text="{Binding DraftName}" FontSize="13.5"
                                                                 BorderThickness="0" Background="Transparent"
                                                                 Padding="0,8" VerticalContentAlignment="Center" />
                                                    </Border>

                                                    <!-- actions -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <Button Classes="iconbtn" ToolTip.Tip="ویرایش نام"
                                                                IsVisible="{Binding !IsEditingName}"
                                                                Command="{Binding BeginRenameCommand}">
                                                            <Path Classes="icon" Width="16" Height="16"
                                                                  Data="{StaticResource IconEdit}" />
                                                        </Button>
                                                        <Button Classes="iconbtn" ToolTip.Tip="حذف نوع"
                                                                IsVisible="{Binding !IsEditingName}"
                                                                Command="{Binding RemoveCommand}">
                                                            <Path Classes="icon" Width="16" Height="16"
                                                                  Stroke="{StaticResource DangerBrush}"
                                                                  Data="{StaticResource IconTrash}" />
                                                        </Button>
                                                        <Button Classes="iconbtn" ToolTip.Tip="ذخیره"
                                                                IsVisible="{Binding IsEditingName}"
                                                                Command="{Binding CommitRenameCommand}">
                                                            <Path Classes="icon" Width="16" Height="16"
                                                                  Stroke="{StaticResource OkBrush}"
                                                                  Data="{StaticResource IconCheck}" />
                                                        </Button>
                                                        <Button Classes="iconbtn" ToolTip.Tip="انصراف"
                                                                IsVisible="{Binding IsEditingName}"
                                                                Command="{Binding CancelRenameCommand}">
                                                            <Path Classes="icon" Width="16" Height="16"
                                                                  Data="{StaticResource IconX}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- breed chips -->
                                                <ItemsControl ItemsSource="{Binding Breeds}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="settings:BreedItemViewModel">
                                                            <Border Margin="0,0,8,8" CornerRadius="999"
                                                                    Background="{StaticResource PanelBrush}"
                                                                    BorderBrush="{StaticResource LineBrush}"
                                                                    BorderThickness="1" Padding="4,2">
                                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                                            VerticalAlignment="Center">
                                                                    <!-- read mode -->
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                               FontWeight="SemiBold" Margin="9,0,2,0"
                                                                               Foreground="{StaticResource Ink2Brush}"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding !IsEditing}" />
                                                                    <Button Classes="iconbtn sm" ToolTip.Tip="ویرایش نژاد"
                                                                            IsVisible="{Binding !IsEditing}"
                                                                            Command="{Binding $parent[ItemsControl].((settings:SpeciesSettingsItemViewModel)DataContext).BeginEditBreedCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <Path Classes="icon" Width="12" Height="12"
                                                                              Data="{StaticResource IconEdit}" />
                                                                    </Button>
                                                                    <Button Classes="iconbtn sm" ToolTip.Tip="حذف نژاد"
                                                                            IsVisible="{Binding !IsEditing}"
                                                                            Command="{Binding $parent[ItemsControl].((settings:SpeciesSettingsItemViewModel)DataContext).DeleteBreedCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <Path Classes="icon" Width="12" Height="12"
                                                                              Stroke="{StaticResource DangerBrush}"
                                                                              Data="{StaticResource IconX}" />
                                                                    </Button>
                                                                    <!-- edit mode -->
                                                                    <Border IsVisible="{Binding IsEditing}" CornerRadius="999"
                                                                            Background="{StaticResource Bg2Brush}"
                                                                            Padding="9,0" Margin="2,0,0,0">
                                                                        <TextBox Text="{Binding DraftName}" FontSize="12.5"
                                                                                 Width="110" BorderThickness="0"
                                                                                 Background="Transparent" Padding="0,5"
                                                                                 VerticalContentAlignment="Center" />
                                                                    </Border>
                                                                    <Button Classes="iconbtn sm" ToolTip.Tip="ذخیره"
                                                                            IsVisible="{Binding IsEditing}"
                                                                            Command="{Binding $parent[ItemsControl].((settings:SpeciesSettingsItemViewModel)DataContext).CommitEditBreedCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <Path Classes="icon" Width="12" Height="12"
                                                                              Stroke="{StaticResource OkBrush}"
                                                                              Data="{StaticResource IconCheck}" />
                                                                    </Button>
                                                                    <Button Classes="iconbtn sm" ToolTip.Tip="انصراف"
                                                                            IsVisible="{Binding IsEditing}"
                                                                            Command="{Binding $parent[ItemsControl].((settings:SpeciesSettingsItemViewModel)DataContext).CancelEditBreedCommand}"
                                                                            CommandParameter="{Binding}">
                                                                        <Path Classes="icon" Width="12" Height="12"
                                                                              Data="{StaticResource IconX}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- add breed -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                            CornerRadius="10" Padding="11,0">
                                                        <TextBox Text="{Binding NewBreedName}"
                                                                 PlaceholderText="افزودن نژاد جدید…"
                                                                 FontSize="12.5" BorderThickness="0" Background="Transparent"
                                                                 Padding="0,8" VerticalContentAlignment="Center" />
                                                    </Border>
                                                    <Button Grid.Column="1" Classes="outline"
                                                            Command="{Binding AddBreedCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Path Classes="icon" Width="14" Height="14"
                                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                                  Data="{StaticResource IconPlus}" />
                                                            <TextBlock Text="نژاد" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- card 2 · "file opened" SMS toggle (scaffold) -->
                    <Border Grid.Column="1" VerticalAlignment="Top" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}"
                            BoxShadow="{StaticResource ShadowCard}" Padding="18,16">
                        <StackPanel Spacing="14">

                            <!-- header + toggle -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                                        Background="{StaticResource Brand50Brush}">
                                    <Path Classes="icon" Width="18" Height="18"
                                          Stroke="{StaticResource Brand700Brush}"
                                          Data="{StaticResource IconSms}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="11,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="پیامک باز شدن پرونده" FontSize="15"
                                                   FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="999" Padding="8,2" VerticalAlignment="Center"
                                                Background="{StaticResource Bg2Brush}">
                                            <TextBlock Text="{Binding Settings.FileOpenedSmsStatusText}"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="هنگام ثبت پرونده جدید، پیامک اطلاع‌رسانی برای سرپرست ارسال می‌شود."
                                               FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.FileOpenedSmsEnabled}"
                                              OnContent="{x:Null}" OffContent="{x:Null}" />
                            </Grid>

                            <!-- message template (enabled only when the toggle is on) -->
                            <StackPanel Spacing="8" IsEnabled="{Binding Settings.FileOpenedSmsEnabled}"
                                        IsVisible="{Binding Settings.FileOpenedSmsEnabled}">
                                <TextBlock Text="متن پیامک" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink2Brush}" />
                                <Border Background="{StaticResource Bg2Brush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="13,4">
                                    <TextBox Text="{Binding Settings.FileOpenedSmsTemplate}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                             FontSize="13" BorderThickness="0" Background="Transparent"
                                             Padding="0,6" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                    <Button Classes="outline" Command="{Binding Settings.SaveSmsTemplateCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Path Classes="icon" Width="14" Height="14"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  Data="{StaticResource IconCheck}" />
                                            <TextBlock Text="ذخیره متن" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
