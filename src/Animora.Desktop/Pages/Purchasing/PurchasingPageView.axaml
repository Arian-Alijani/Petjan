<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:purch="using:Animora.Desktop.Pages.Purchasing"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Purchasing.PurchasingPageView"
             x:Name="Root"
             x:DataType="purch:PurchasingPageViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- Table header cell (.tbl thead th: muted 600, 12px, 12/16 padding,
             #fafbfa strip, hairline bottom rule). -->
        <Style Selector="TextBlock.th">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="16,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Table body cell (.tbl tbody td: 13px, 14/16 padding, hairline rule). -->
        <Style Selector="TextBlock.td">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Margin" Value="16,14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Row action icon button (.icon-btn: 36x36, radius 10, hairline border,
             white fill). -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="26,22,26,40">

        <!-- Page header (.page-header: flex, space-between, align flex-end,
             gap 20px, margin-bottom 18px). -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="زنجیره تأمین" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Brand600Brush}" Margin="0,0,0,2" />
                <TextBlock Text="فاکتور خرید و تأمین‌کنندگان" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="سفارش‌های خرید، بدهی‌ها و دریافت کالا را مدیریت کنید."
                           FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <Button Classes="primary" Command="{Binding NewPurchaseInvoiceCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16" Stroke="White"
                              Data="{StaticResource IconPlus}" />
                        <TextBlock Text="فاکتور خرید" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- KPI stat row (.grid-3c: three equal columns, 16px gap,
             margin-bottom 20px) — Phase 03 StatCard ×3, matching the reference's
             ۱۲٪↑ / ۴٪↓ / ۹٪↓ delta chips. -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="0,0,0,20">
            <controls:StatCard Grid.Column="0"
                               Icon="{Binding ActiveOrders.IconKey, Converter={StaticResource IconKeyConverter}}"
                               Value="{Binding ActiveOrders.Value}"
                               Label="{Binding ActiveOrders.Label}"
                               Delta="{Binding ActiveOrders.DeltaText}"
                               IsDeltaPositive="{Binding ActiveOrders.IsDeltaPositive}"
                               IconTone="{Binding ActiveOrders.Tone}" />
            <controls:StatCard Grid.Column="1"
                               Icon="{Binding MonthlyPurchases.IconKey, Converter={StaticResource IconKeyConverter}}"
                               Value="{Binding MonthlyPurchases.Value}"
                               Label="{Binding MonthlyPurchases.Label}"
                               Delta="{Binding MonthlyPurchases.DeltaText}"
                               IsDeltaPositive="{Binding MonthlyPurchases.IsDeltaPositive}"
                               IconTone="{Binding MonthlyPurchases.Tone}" />
            <controls:StatCard Grid.Column="2"
                               Icon="{Binding SupplierDebt.IconKey, Converter={StaticResource IconKeyConverter}}"
                               Value="{Binding SupplierDebt.Value}"
                               Label="{Binding SupplierDebt.Label}"
                               Delta="{Binding SupplierDebt.DeltaText}"
                               IsDeltaPositive="{Binding SupplierDebt.IsDeltaPositive}"
                               IconTone="{Binding SupplierDebt.Tone}" />
        </Grid>

        <!-- Purchase-orders table (.card > .tbl). -->
        <Border Classes="card">
            <StackPanel>
                <!-- thead row (8 columns: شماره / تأمین‌کننده / تاریخ / اقلام /
                     مبلغ کل / تسویه / وضعیت / action). -->
                <Grid ColumnDefinitions="1.2*,2*,1.2*,0.9*,2*,1.2*,1.2*,60"
                      Background="{StaticResource TableHeadBrush}">
                    <TextBlock Grid.Column="0" Classes="th" Text="شماره" />
                    <TextBlock Grid.Column="1" Classes="th" Text="تأمین‌کننده" />
                    <TextBlock Grid.Column="2" Classes="th" Text="تاریخ" />
                    <TextBlock Grid.Column="3" Classes="th" Text="اقلام" />
                    <TextBlock Grid.Column="4" Classes="th" Text="مبلغ کل" />
                    <TextBlock Grid.Column="5" Classes="th" Text="تسویه" />
                    <TextBlock Grid.Column="6" Classes="th" Text="وضعیت" />
                </Grid>

                <!-- tbody rows. -->
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="purch:PurchaseOrderRowViewModel">
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.2*,2*,1.2*,0.9*,2*,1.2*,1.2*,60">
                                    <TextBlock Grid.Column="0" Classes="td" Text="{Binding Number}"
                                               FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Column="1" Classes="td" Text="{Binding Supplier}" />
                                    <TextBlock Grid.Column="2" Classes="td" Text="{Binding OrderDate}" />
                                    <TextBlock Grid.Column="3" Classes="td" Text="{Binding ItemCountText}" />
                                    <TextBlock Grid.Column="4" Classes="td" Text="{Binding AmountText}" />
                                    <TextBlock Grid.Column="5" Classes="td" Text="{Binding Settlement}" />
                                    <controls:Badge Grid.Column="6"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="16,14"
                                                    Text="{Binding StatusLabel}"
                                                    Tone="{Binding StatusTone}" />
                                    <Button Grid.Column="7" Classes="icon-btn"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTip.Tip="اقدامات">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconMore}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
