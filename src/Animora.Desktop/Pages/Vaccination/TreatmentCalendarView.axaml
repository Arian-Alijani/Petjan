<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vx="using:Animora.Desktop.Pages.Vaccination"
             x:Class="Animora.Desktop.Pages.Vaccination.TreatmentCalendarView"
             x:Name="Root"
             x:DataType="vx:TreatmentCalendarViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <Style Selector="Border.cal-cell">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="Padding" Value="6,5" />
        </Style>
        <Style Selector="Border.cal-cell.friday">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Border.cal-cell.today">
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.cal-cell.selected">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Border.cal-blank">
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="104" />
        </Style>
        <Style Selector="Button.cal-hit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cal-hit:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.cal-pill">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="BorderThickness" Value="0,0,3,0" />
        </Style>
        <Style Selector="Border.cal-pill.done">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.kchip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.kchip.off">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.itype">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.itype.on">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14">
        <!-- ═══ header: month navigation + filters ═══ -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}"
                BoxShadow="{StaticResource ShadowCard}" Padding="14,12">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="mini" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="ماه قبل">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource MutedBrush}"
                                  Data="{StaticResource IconChevronRight}" />
                        </Button>
                        <TextBlock Text="{Binding MonthTitle}" FontSize="16" FontWeight="ExtraBold" MinWidth="130"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Classes="mini" Command="{Binding NextMonthCommand}" ToolTip.Tip="ماه بعد">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource MutedBrush}"
                                  Data="{StaticResource IconChevronLeft}" />
                        </Button>
                        <Button Classes="outline" Content="امروز" Command="{Binding GoTodayCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="2" Width="60" Height="3" IsIndeterminate="True"
                                 IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
                </Grid>
                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding KindFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vx:CalendarKindFilterViewModel">
                                    <Button Classes="kchip" Classes.off="{Binding !IsSelected}"
                                            Background="{Binding Wash}" BorderBrush="{Binding Brush}"
                                            Foreground="{Binding Brush}"
                                            Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).ToggleKindCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{Binding Brush}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                            <TextBlock Text="{Binding Label}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Grid.Column="1" Background="{StaticResource Bg2Brush}" CornerRadius="12" Padding="3">
                            <ItemsControl ItemsSource="{Binding ItemTypeFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vx:CalendarItemTypeFilterViewModel">
                                        <Button Classes="itype" Classes.on="{Binding IsSelected}" Content="{Binding Label}"
                                                Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).SetItemTypeCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ month grid ═══ -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}"
                BoxShadow="{StaticResource ShadowCard}" Padding="10">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Weekdays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vx:CalendarWeekdayHeader">
                            <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="Bold" TextAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vx:CalendarDayViewModel">
                            <Panel>
                                <Border Classes="cal-blank" IsVisible="{Binding IsBlank}" />
                                <Border Classes="cal-cell" IsVisible="{Binding !IsBlank}"
                                        Classes.friday="{Binding IsFriday}" Classes.today="{Binding IsToday}"
                                        Classes.selected="{Binding IsSelected}">
                                    <Button Classes="cal-hit"
                                            Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).SelectDayCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding DayText}" FontSize="12.5" FontWeight="ExtraBold"
                                                       HorizontalAlignment="Right" />
                                            <ItemsControl ItemsSource="{Binding Pills}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vx:CalendarEventViewModel">
                                                        <!-- a pill opens its own detail popup; the rest of the cell selects the day -->
                                                        <Button Classes="cal-hit" ToolTip.Tip="نمایش جزئیات"
                                                                Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).OpenDetailCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Border Classes="cal-pill" Classes.done="{Binding IsDone}"
                                                                    Background="{Binding Wash}" BorderBrush="{Binding Brush}"
                                                                    Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding PillText}" FontSize="10.5" FontWeight="Bold"
                                                                           Foreground="{Binding Brush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding MoreText}" IsVisible="{Binding HasMore}" FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ═══ selected day list ═══ -->
        <Border IsVisible="{Binding HasSelectedDay}" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}" BoxShadow="{StaticResource ShadowCard}" Padding="16,14">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding SelectedDayTitle}" FontSize="14.5" FontWeight="ExtraBold" />
                <TextBlock IsVisible="{Binding !HasSelectedDayEvents}" Text="برای این روز واکسن یا دارویی برنامه‌ریزی نشده است."
                           FontSize="12" Foreground="{StaticResource MutedBrush}" />
                <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vx:CalendarEventViewModel">
                            <Border Background="{Binding Wash}" BorderBrush="{Binding Brush}" BorderThickness="0,0,4,0"
                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="icon" Width="16" Height="16" Stroke="{Binding Brush}"
                                                  Data="{Binding ItemTypeIconKey, Converter={StaticResource IconKeyConverter}}" />
                                            <Button Classes="link" Padding="0" Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip.Tip="نمایش جزئیات"
                                                    Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).OpenDetailCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="ExtraBold" />
                                            </Button>
                                            <TextBlock Text="{Binding ItemTypeLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DosageText}" IsVisible="{Binding HasDosage}" FontSize="11.5"
                                                       Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="{StaticResource Ink2Brush}">
                                            <Run Text="{Binding PetName}" FontWeight="Bold" /><Run Text=" · " /><Run Text="{Binding SpeciesText}" /><Run Text=" · مالک: " /><Run Text="{Binding OwnerName}" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="13" Height="13" Stroke="{Binding Brush}"
                                                  Data="{Binding KindIconKey, Converter={StaticResource IconKeyConverter}}" />
                                            <TextBlock Text="{Binding KindLabel}" FontSize="11.5" FontWeight="Bold"
                                                       Foreground="{Binding Brush}" />
                                            <TextBlock Text="· یادآور پیامکی مالک" IsVisible="{Binding ShowsOwnerReminder}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <Button Classes="link" Padding="6,0" Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource Brand700Brush}" FontSize="11.5" FontWeight="Bold"
                                                    Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).OpenPetPlansCommand}"
                                                    CommandParameter="{Binding}" Content="برنامه‌های این بیمار" />
                                            <Button Classes="link" Padding="6,0" Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource Brand700Brush}" FontSize="11.5" FontWeight="Bold"
                                                    Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).OpenDetailCommand}"
                                                    CommandParameter="{Binding}" Content="جزئیات" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="outline" VerticalAlignment="Center"
                                            IsVisible="{Binding CanMarkDone}"
                                            Command="{Binding #Root.((vx:TreatmentCalendarViewModel)DataContext).MarkDoneCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource OkBrush}"
                                                  Data="{StaticResource IconCheckCircle}" />
                                            <TextBlock Text="انجام شد" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                IsVisible="{Binding IsDone}">
                                        <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource OkBrush}"
                                              Data="{StaticResource IconCheckCircle}" />
                                        <TextBlock Text="انجام‌شده" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
