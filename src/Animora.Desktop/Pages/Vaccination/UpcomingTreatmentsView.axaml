<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vx="using:Animora.Desktop.Pages.Vaccination"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Name="Root"
             x:Class="Animora.Desktop.Pages.Vaccination.UpcomingTreatmentsView"
             x:DataType="vx:UpcomingTreatmentsViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <StyleInclude Source="avares://Animora.Desktop/Pages/Appointments/CalendarNavStyles.axaml" />
        <!-- Same look as the «نوبت‌های پیش رو» tab of the main calendar (AppointmentsQueueTabView). -->
        <Style Selector="Button.qd">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="4,8,4,7" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.qd:pointerover">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.qd.is-active">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.qp-card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.qp-card:pointerover">
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
        </Style>
        <Style Selector="Button.ap-chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ap-chip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.ap-chip.is-active, Button.ap-chip.is-active:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.ap-chip.is-active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusLg}"
            BoxShadow="{StaticResource ShadowCard}" ClipToBounds="True"
            VerticalAlignment="Top">
        <StackPanel>

            <!-- day strip -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="16,14">
                <Button Grid.Column="0" Classes="cal-step" Command="{Binding ShiftWeekCommand}" CommandParameter="-1"
                        ToolTip.Tip="هفتهٔ قبل">
                    <Path Classes="icon" Data="{StaticResource IconChevronRight}" />
                </Button>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vx:UpcomingDayViewModel">
                            <Button Classes="qd" Classes.is-active="{Binding IsActive}"
                                    Command="{Binding #Root.((vx:UpcomingTreatmentsViewModel)DataContext).SelectDayCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DowText}" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource Muted2Brush}" />
                                    <TextBlock Text="{Binding DayText}" FontSize="15" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource Ink2Brush}" />
                                    <TextBlock Text="{Binding CountText}" FontSize="9.5" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource Brand700Brush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Classes="cal-step" Command="{Binding ShiftWeekCommand}" CommandParameter="1"
                        ToolTip.Tip="هفتهٔ بعد">
                    <Path Classes="icon" Data="{StaticResource IconChevronLeft}" />
                </Button>
            </Grid>

            <!-- header: date + KPIs + done toggle -->
            <Border Background="#fbfcfe" BorderBrush="{StaticResource Line2Brush}"
                    BorderThickness="0,1,0,1" Padding="16,14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="ExtraBold"
                                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource Brand600Brush}" CornerRadius="99"
                                Padding="9,3" IsVisible="{Binding IsToday}">
                            <TextBlock Text="امروز" FontSize="10.5" FontWeight="ExtraBold"
                                       Foreground="White" />
                        </Border>
                        <Button Classes="ap-chip" IsVisible="{Binding !IsToday}"
                                Command="{Binding GoTodayCommand}">
                            <TextBlock Text="برو به امروز" />
                        </Button>
                    </StackPanel>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Stats}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vx:UpcomingStatViewModel">
                                <Border Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                                        CornerRadius="99" Padding="11,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <controls:Badge Text="{Binding ValueText}" Tone="{Binding Tone}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressBar Width="50" Height="3" IsIndeterminate="True"
                                     IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
                        <Button Classes="ap-chip" Classes.is-active="{Binding IsDoneShown}"
                                Command="{Binding ToggleDoneCommand}">
                            <TextBlock Text="نمایش انجام‌شده‌ها" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- kind columns (clinic / home / boarding) -->
            <ItemsControl ItemsSource="{Binding Columns}" Margin="16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ColumnCount}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vx:UpcomingKindColumnViewModel">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1,4,1,1" CornerRadius="16"
                                BoxShadow="{StaticResource ShadowCard}" ClipToBounds="True"
                                Margin="7" MinHeight="320">
                            <StackPanel>
                                <!-- kind header -->
                                <Border Padding="14,12" BorderBrush="{StaticResource Line2Brush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="10"
                                                Background="{Binding Wash}" VerticalAlignment="Center">
                                            <Path Classes="icon" Width="16" Height="16" Stroke="{Binding Brush}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5"
                                                   FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CountText}" FontSize="14" FontWeight="ExtraBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource Brand600Brush}" />
                                            <TextBlock Text="مورد" FontSize="9" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource Muted2Brush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- cards -->
                                <ItemsControl ItemsSource="{Binding Cards}"
                                              IsVisible="{Binding !IsEmpty}" Margin="8,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vx:UpcomingCardViewModel">
                                            <Button Classes="qp-card" ToolTip.Tip="نمایش جزئیات"
                                                    Command="{Binding #Root.((vx:UpcomingTreatmentsViewModel)DataContext).OpenDetailCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
                                                            Background="{StaticResource Bg2Brush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IndexText}" FontSize="11"
                                                                   FontWeight="ExtraBold" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brand600Brush}" />
                                                    </Border>
                                                    <Path Grid.Column="1" Classes="icon" Width="16" Height="16"
                                                          VerticalAlignment="Center" Stroke="{Binding Brush}"
                                                          Data="{Binding TypeIconKey, Converter={StaticResource IconKeyConverter}}" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding PetName}" FontSize="12.5"
                                                                       FontWeight="ExtraBold"
                                                                       Foreground="{StaticResource InkBrush}" />
                                                            <Border Background="{StaticResource Bg2Brush}" CornerRadius="6"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding TypeLabel}" FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource MutedBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Line2}" FontSize="10.5"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <controls:Badge Grid.Column="3" Text="{Binding StatusLabel}"
                                                                    Tone="{Binding StatusTone}"
                                                                    VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- empty state -->
                                <StackPanel IsVisible="{Binding IsEmpty}" Spacing="6" Margin="16,32"
                                            HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="14"
                                            Background="{StaticResource Bg2Brush}"
                                            HorizontalAlignment="Center">
                                        <Path Classes="icon" Width="22" Height="22"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{StaticResource Muted2Brush}"
                                              Data="{StaticResource IconSyringe}" />
                                    </Border>
                                    <TextBlock Text="موردی ثبت نشده است" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding EmptyText}" FontSize="11.5"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>

                                <!-- footer CTA -->
                                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                                        Padding="12,10">
                                    <Button Background="{StaticResource Bg2Brush}" BorderThickness="0"
                                            CornerRadius="10" Height="36" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding #Root.((vx:UpcomingTreatmentsViewModel)DataContext).OpenAddCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14"
                                                  Stroke="{StaticResource Brand700Brush}"
                                                  Data="{StaticResource IconPlus}" />
                                            <TextBlock Text="ثبت دارو / واکسن" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource Brand700Brush}" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
