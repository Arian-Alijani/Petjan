<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vx="using:Animora.Desktop.Pages.Vaccination"
             xmlns:c="using:Animora.Contracts.Vaccination"
             xmlns:controls="using:Animora.Desktop.Controls"
             xmlns:ap="using:Animora.Desktop.Pages.Appointments"
             x:Name="Root"
             x:Class="Animora.Desktop.Pages.Vaccination.AddVaccineModalView"
             x:DataType="vx:AddVaccineModalViewModel"
             Width="580" MaxWidth="580" FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- Reuses the booking panel's patient-picker styles (pat-card / pat-opt / pat-empty / mini-chip). -->
        <StyleInclude Source="avares://Animora.Desktop/Pages/Appointments/BookingPanelStyles.axaml" />
        <Style Selector="Button.opt">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.opt.on">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="ToggleButton.wd">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.wd:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.kopt">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.kopt.on">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>
    <StackPanel>
        <Grid Margin="22,18,22,6" ColumnDefinitions="40,*,36" ColumnSpacing="12">
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{StaticResource Brand50Brush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource Brand700Brush}" Data="{StaticResource IconSyringe}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ثبت جدید" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brand600Brush}" />
                <TextBlock Text="ثبت دارو / واکسن بیمار" FontSize="18" FontWeight="ExtraBold" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Width="36" Height="36" Padding="8" Command="{Binding CancelCommand}" ToolTip.Tip="بستن">
                <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconX}" />
            </Button>
        </Grid>
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,8,22,20" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Text="بیمار" FontSize="12" Foreground="{StaticResource Ink2Brush}" />

                <!-- selected patient card -->
                <Border IsVisible="{Binding IsPatientCardVisible}" Classes="pat-card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                                Background="{Binding SelectedAvatarBrush}">
                            <Path Classes="icon" Width="24" Height="24" Stroke="White"
                                  Data="{Binding SelectedIconKey, Converter={StaticResource IconKeyConverter}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{Binding SelectedName}" FontSize="15" FontWeight="ExtraBold" />
                                <Border Background="{StaticResource Brand50Brush}" CornerRadius="99" Padding="8,2">
                                    <TextBlock Text="{Binding SelectedKind}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{StaticResource Brand700Brush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource MutedBrush}"
                                          Data="{StaticResource IconUsers}" />
                                    <TextBlock Text="{Binding SelectedOwner}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource Ink2Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource MutedBrush}"
                                          Data="{StaticResource IconPhone}" />
                                    <TextBlock Text="{Binding SelectedPhone}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="sm" Height="32" VerticalAlignment="Center"
                                Command="{Binding ChangePatientCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Width="14" Height="14"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      Data="{StaticResource IconSearch}" />
                                <TextBlock Text="تغییر بیمار" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- picker pane -->
                <StackPanel IsVisible="{Binding IsPatientSearchVisible}" Spacing="10">
                    <Panel>
                        <TextBox Classes="pat-search-input" Height="44" MaxLength="100"
                                 Padding="38,0,34,0" CornerRadius="12" FontSize="13"
                                 PlaceholderText="{Binding PatientSearchPlaceholder}"
                                 Text="{Binding QueryText, Mode=TwoWay}" />
                        <Path Classes="icon" Width="16" Height="16" Margin="12,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                              Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconSearch}" />
                        <Button Width="20" Height="20" CornerRadius="10" Padding="0" Margin="0,0,10,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{StaticResource Bg2Brush}" BorderThickness="0"
                                IsVisible="{Binding HasQuery}"
                                Command="{Binding ClearQueryCommand}" ToolTip.Tip="پاک کردن">
                            <Path Classes="icon" Width="11" Height="11" Stroke="{StaticResource MutedBrush}"
                                  StrokeThickness="3" Data="{StaticResource IconX}" />
                        </Button>
                    </Panel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding KindChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ap:BookingKindChipViewModel">
                                    <Button Classes="mini-chip" Classes.on="{Binding IsSelected}"
                                            Command="{Binding #Root.((vx:AddVaccineModalViewModel)DataContext).SelectKindCommand}"
                                            CommandParameter="{Binding Id}">
                                        <TextBlock Text="{Binding Label}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" Text="{Binding PatientResultCount}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsPatientSearching}" />

                    <!-- Bounded to 20 rows; never realizes the clinic's full patient list. -->
                    <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasPatientResults}">
                        <ItemsControl ItemsSource="{Binding PatientList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ap:BookingPatientOptionViewModel">
                                    <Button Classes="pat-opt" Classes.on="{Binding IsSelected}" Margin="0,0,0,6"
                                            Command="{Binding #Root.((vx:AddVaccineModalViewModel)DataContext).SelectPatientCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                                                    Background="{Binding AvatarBrush}">
                                                <Path Classes="icon" Width="18" Height="18" Stroke="White"
                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="Bold" />
                                                    <Border Grid.Column="1" Background="White"
                                                            BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                                                            CornerRadius="99" Padding="7,1">
                                                        <TextBlock Text="{Binding Kind}" FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                                                    <Path Classes="icon" Width="13" Height="13"
                                                          Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconUsers}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding OwnerName}" FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Phone}" FontSize="11.5"
                                                               FlowDirection="LeftToRight"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- hint / searching / empty -->
                    <Border Classes="pat-empty" IsVisible="{Binding ShowPatientSearchMessage}" Padding="16,12">
                        <StackPanel HorizontalAlignment="Center" Spacing="5">
                            <Path Classes="icon" Width="22" Height="22" Stroke="{StaticResource Muted2Brush}"
                                  Data="{StaticResource IconSearch}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PatientSearchMessage}" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <!-- item type -->
            <StackPanel Spacing="6">
                <TextBlock Text="چه چیزی ثبت می‌شود؟" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Classes="opt" Classes.on="{Binding IsVaccine}"
                            Command="{Binding SetItemTypeCommand}" CommandParameter="vaccine">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconSyringe}" />
                            <TextBlock Text="واکسن" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="opt" Classes.on="{Binding IsMedication}"
                            Command="{Binding SetItemTypeCommand}" CommandParameter="medication">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource IconFlask}" />
                            <TextBlock Text="دارو" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- what: name (typed or picked from stock) + dose -->
            <StackPanel Spacing="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding ItemLabel}" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding ItemName}" MaxLength="200" PlaceholderText="{Binding ItemPlaceholder}"
                                 Padding="12,10" CornerRadius="10" />
                        <Button Grid.Column="1" Classes="outline" Command="{Binding OpenStockPickerCommand}" ToolTip.Tip="انتخاب از اقلام انبار">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource InkBrush}" Data="{StaticResource IconBox}" />
                                <TextBlock Text="انتخاب از انبار" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasStockInfo}">
                        <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource Brand700Brush}" Data="{StaticResource IconBox}" />
                        <TextBlock Text="{Binding StockInfoText}" FontSize="11.5" Foreground="{StaticResource Brand700Brush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding ShowClinicCatalog}">
                    <TextBlock Text="یا از واکسن‌های ثبت‌شدهٔ کلینیک" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                    <ComboBox ItemsSource="{Binding Catalog}" SelectedItem="{Binding SelectedVaccine}" PlaceholderText="انتخاب از انبار واکسن (اختیاری)"
                              HorizontalAlignment="Stretch" Padding="12,8" CornerRadius="10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="c:VaccineCatalogEntry">
                                <TextBlock><Run Text="{Binding Name}" /><Run Text=" (" /><Run Text="{Binding Short}" /><Run Text=")" /></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="دوز / مقدار (اختیاری)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                    <TextBox Text="{Binding Dosage}" MaxLength="200" PlaceholderText="مثلاً ۰٫۵ میلی‌لیتر" Padding="12,10" CornerRadius="10" />
                </StackPanel>
            </StackPanel>

            <!-- kind -->
            <StackPanel Spacing="6">
                <TextBlock Text="نحوهٔ انجام" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                <ItemsControl ItemsSource="{Binding TreatmentKinds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vx:TreatmentKindOptionViewModel">
                            <Button Classes="kopt" Classes.on="{Binding IsSelected}" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{Binding Wash}" BorderBrush="{Binding Brush}" Foreground="{Binding Brush}"
                                    Command="{Binding #Root.((vx:AddVaccineModalViewModel)DataContext).SelectKindOptionCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <Path Classes="icon" Width="14" Height="14" Stroke="{Binding Brush}"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                    <TextBlock Text="{Binding Label}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsVisible="{Binding CanNotifyOwner}">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="یادآور پیامکی برای مالک" FontSize="12.5" FontWeight="Bold" />
                        <TextBlock Text="فقط به‌صورت پرچم ثبت می‌شود؛ ارسال پیامک واقعی انجام نمی‌شود" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyOwner}" OnContent="" OffContent="" />
                </Grid>
            </StackPanel>

            <!-- schedule -->
            <StackPanel Spacing="8">
                <TextBlock Text="زمان‌بندی" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                <ItemsControl ItemsSource="{Binding ScheduleOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vx:ScheduleTypeOptionViewModel">
                            <Button Classes="opt" Classes.on="{Binding IsSelected}" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                                    Command="{Binding #Root.((vx:AddVaccineModalViewModel)DataContext).SelectScheduleCommand}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Label}" TextAlignment="Center" TextWrapping="Wrap" FontSize="11.5" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="6" IsVisible="{Binding ShowStart}">
                        <TextBlock Text="{Binding StartLabel}" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                        <controls:JalaliDatePicker DateValue="{Binding StartDate, Mode=TwoWay}" Placeholder="انتخاب تاریخ" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding ShowRange}">
                        <TextBlock Text="تاریخ پایان" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                        <controls:JalaliDatePicker DateValue="{Binding EndDate, Mode=TwoWay}" Placeholder="انتخاب تاریخ" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <!-- every N days -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowEvery}">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="هر چند روز یک‌بار" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                        <TextBox Text="{Binding IntervalDays}" MaxLength="3" PlaceholderText="۲" Padding="12,10" CornerRadius="10" FlowDirection="LeftToRight" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="یا تعداد دفعات (به‌جای تاریخ پایان)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                        <TextBox Text="{Binding DoseCount}" MaxLength="3" PlaceholderText="مثلاً ۵" Padding="12,10" CornerRadius="10" FlowDirection="LeftToRight" />
                    </StackPanel>
                </Grid>

                <!-- specific dates -->
                <StackPanel Spacing="8" IsVisible="{Binding ShowSpecific}">
                    <TextBlock Text="افزودن تاریخ" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                    <controls:JalaliDatePicker DateValue="{Binding PendingDate, Mode=TwoWay}" Placeholder="هر تاریخ انتخاب‌شده به فهرست اضافه می‌شود" HorizontalAlignment="Stretch" />
                    <ItemsControl ItemsSource="{Binding SpecificDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vx:SpecificDayChipViewModel">
                                <Border Background="{StaticResource Brand50Brush}" CornerRadius="99" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Brand700Brush}" VerticalAlignment="Center" />
                                        <Button Width="18" Height="18" Padding="0" CornerRadius="9" Background="Transparent" BorderThickness="0"
                                                Command="{Binding #Root.((vx:AddVaccineModalViewModel)DataContext).RemoveSpecificDayCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="حذف">
                                            <Path Classes="icon" Width="10" Height="10" Stroke="{StaticResource Brand700Brush}" StrokeThickness="3" Data="{StaticResource IconX}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- weekdays -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowWeekly}">
                    <TextBlock Text="روزهای هفته" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                    <ItemsControl ItemsSource="{Binding Weekdays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vx:WeekdayToggleViewModel">
                                <ToggleButton Classes="wd" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" Padding="12,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- notes -->
            <StackPanel Spacing="6">
                <TextBlock Text="یادداشت (اختیاری)" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
                <TextBox Text="{Binding Notes}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                         PlaceholderText="توضیحات تکمیلی…" Padding="12,10" CornerRadius="10" />
            </StackPanel>

            <!-- validation / failure message -->
            <Border IsVisible="{Binding HasError}" Background="#FEF3F2" BorderBrush="#FDA29B" BorderThickness="1"
                    CornerRadius="10" Padding="12,9">
                <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        </ScrollViewer>
        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" Padding="22,14,22,20">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <Button Classes="ghost" Content="انصراف" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Content="ثبت و زمان‌بندی" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSubmitting}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
