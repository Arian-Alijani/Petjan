<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vx="using:Animora.Desktop.Pages.Vaccination"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Vaccination.VaccinationRecordDetailView"
             x:DataType="vx:VaccinationRecordDetailViewModel"
             Width="520" MaxWidth="520" FlowDirection="RightToLeft">
    <StackPanel>
        <Grid Margin="22,20,22,16" ColumnDefinitions="48,*,36" ColumnSpacing="12">
            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{Binding AvatarBrush}">
                <TextBlock Text="{Binding PetInitial}" FontSize="18" FontWeight="ExtraBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding PetName}" FontSize="17" FontWeight="ExtraBold" />
                <TextBlock Text="{Binding HeaderSub}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Width="36" Height="36" Padding="8" Command="{Binding CloseCommand}" ToolTip.Tip="بستن">
                <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconX}" />
            </Button>
        </Grid>
        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" />
        <StackPanel Margin="22,18" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:Badge Text="{Binding StatusText}" Tone="{Binding StatusTone}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource MutedBrush}"
                          Data="{Binding SmsIconKey, Converter={StaticResource IconKeyConverter}}" />
                    <TextBlock Text="{Binding SmsText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="مشخصات نوبت" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brand600Brush}" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9" ColumnSpacing="14">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="واکسن" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VaccineName}" FontWeight="Bold" FontSize="12.5" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="نوبت" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dose}" FontWeight="Bold" FontSize="12.5" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="سررسید بعدی" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DueDateText}" FontWeight="Bold" FontSize="12.5" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="آخرین تزریق" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastDateText}" FontWeight="Bold" FontSize="12.5" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="محل تزریق" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Site}" FontWeight="Bold" FontSize="12.5" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="شماره سری (Lot)" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Lot}" FontWeight="Bold" FontSize="12.5" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="دامپزشک" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding VetName}" FontWeight="Bold" FontSize="12.5" />
                <TextBlock Grid.Row="7" Grid.Column="0" Text="موبایل سرپرست" Foreground="{StaticResource MutedBrush}" FontSize="12.5" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Mobile}" FontWeight="Bold" FontSize="12.5" />
            </Grid>
            <TextBlock Text="پیشینه واکسیناسیون" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brand600Brush}" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Timeline}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vx:VaccinationTimelineItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                            <Ellipse Width="12" Height="12" StrokeThickness="2.5"
                                     Stroke="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}}"
                                     VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" />
                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Classes="primary" Content="ارسال پیامک یادآور" HorizontalAlignment="Stretch"
                        IsVisible="{Binding CanSendSms}" Command="{Binding SendSmsCommand}" />
                <Button Classes="outline" Content="ثبت انجام" IsVisible="{Binding CanMarkDone}" Command="{Binding MarkDoneCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
