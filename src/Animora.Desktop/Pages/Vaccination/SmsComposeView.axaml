<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vx="using:Animora.Desktop.Pages.Vaccination"
             x:Class="Animora.Desktop.Pages.Vaccination.SmsComposeView"
             x:DataType="vx:SmsComposeViewModel"
             x:Name="Root" Width="520" MaxWidth="520" FlowDirection="RightToLeft">
    <UserControl.Styles>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.chip.selected">
            <Setter Property="Background" Value="{StaticResource ShotBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ShotBrush}" />
        </Style>
    </UserControl.Styles>
    <StackPanel>
        <Grid Margin="22,18,22,6" ColumnDefinitions="40,*,36" ColumnSpacing="12">
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{StaticResource Brand50Brush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource Brand700Brush}" Data="{StaticResource IconSms}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="پیامک یادآور" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brand600Brush}" />
                <TextBlock Text="ارسال پیامک به سرپرست" FontSize="18" FontWeight="ExtraBold" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Width="36" Height="36" Padding="8" Command="{Binding CancelCommand}" ToolTip.Tip="بستن">
                <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconX}" />
            </Button>
        </Grid>
        <StackPanel Margin="22,8,22,20" Spacing="12">
            <Border Background="{StaticResource Bg2Brush}" CornerRadius="{StaticResource RadiusSm}" Padding="12,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{Binding AvatarBrush}">
                        <TextBlock Text="{Binding PetInitial}" FontWeight="ExtraBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" FontSize="13">
                            <Run Text="{Binding OwnerName}" /><Run Text=" · سرپرست " /><Run Text="{Binding PetName}" />
                        </TextBlock>
                        <TextBlock Text="{Binding OwnerMobile}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="قالب پیامک" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
            <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vx:SmsTemplateChipViewModel">
                        <Button Classes="chip" Margin="0,0,6,6" Padding="10,4" CornerRadius="20" FontSize="11"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding #Root.((vx:SmsComposeViewModel)DataContext).SelectTemplateCommand}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="پیش‌نمایش پیام" FontSize="12" Foreground="{StaticResource Ink2Brush}" />
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                    Padding="14" MinHeight="90">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#f7f6fd" />
                        <GradientStop Offset="1" Color="#ffffff" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="{Binding PreviewBody}" FontSize="12.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock HorizontalAlignment="Left" FontSize="11" Foreground="{StaticResource MutedBrush}">
                <Run Text="تعداد نویسه: " /><Run Text="{Binding CharacterCount}" FontWeight="Bold" Foreground="{StaticResource ShotBrush}" /><Run Text=" · " /><Run Text="{Binding SegmentCount}" FontWeight="Bold" Foreground="{StaticResource ShotBrush}" /><Run Text=" پیامک" />
            </TextBlock>
        </StackPanel>
        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" Padding="22,14,22,20">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                <Button Classes="ghost" Content="انصراف" Command="{Binding CancelCommand}" />
                <Button Classes="primary" Command="{Binding SendCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16" Stroke="White" Data="{StaticResource IconSms}" />
                        <TextBlock Text="ارسال پیامک" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
