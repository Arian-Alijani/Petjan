<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nt="using:Animora.Desktop.Pages.Notifications"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Notifications.ComposeNotificationView"
             x:DataType="nt:ComposeNotificationViewModel"
             x:CompileBindings="True"
             Width="620" MaxWidth="620" MaxHeight="760"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <Style Selector="TextBlock.fld">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style Selector="TextBox.inp">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="22,20,22,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="اعلان‌ها و پیام‌ها" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Brand600Brush}" LetterSpacing="1" Margin="0,0,0,4" />
                    <TextBlock Text="پیام جدید" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="مخاطب، نوع و متن پیام را مشخص کنید؛ ارسال می‌تواند فوری یا زمان‌بندی‌شده باشد."
                               FontSize="12.5" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0" CornerRadius="10"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip.Tip="بستن">
                    <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource MutedBrush}"
                          Data="{StaticResource IconX}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,18" Spacing="12">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="fld" Text="مخاطب" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="36"
                                  ItemsSource="{Binding Audiences}" SelectedItem="{Binding SelectedAudience}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="nt:NotificationAudienceOption">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="fld" Text="نوع پیام" />
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="36"
                                  ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="nt:NotificationKindOption">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="fld" Text="برچسب (اختیاری)" />
                        <TextBox Classes="inp" MaxLength="40" Text="{Binding Tag}" PlaceholderText="مثلاً نوروز" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="fld" Text="عنوان" />
                        <TextBox Classes="inp" MaxLength="200" Text="{Binding TitleText}" />
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Classes="fld" Text="متن پیام" />
                    <TextBox Classes="inp" MaxLength="2000" Text="{Binding BodyText}" AcceptsReturn="True"
                             MinHeight="110" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </StackPanel>

                <Border Background="{StaticResource Bg2Brush}" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="10">
                        <CheckBox IsChecked="{Binding IsScheduled}" Content="ارسال در زمان مشخص (پیام مناسبتی)" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowScheduleFields}">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fld" Text="تاریخ ارسال" />
                                <controls:JalaliDatePicker DateValue="{Binding ScheduleDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="fld" Text="ساعت (۲۴ ساعته)" />
                                <TextBox Classes="inp" MaxLength="5" Text="{Binding ScheduleTime}" PlaceholderText="۰۹:۰۰"
                                         FlowDirection="LeftToRight" />
                            </StackPanel>
                        </Grid>
                        <CheckBox IsChecked="{Binding HasExpiry}" Content="تعیین تاریخ انقضا" />
                        <StackPanel IsVisible="{Binding ShowExpiryField}">
                            <TextBlock Classes="fld" Text="نمایش داده شود تا پایان روز" />
                            <controls:JalaliDatePicker DateValue="{Binding ExpiryDate, Mode=TwoWay}" HorizontalAlignment="Left" Width="220" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error.Length}" TextWrapping="Wrap"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" Padding="22,14"
                Background="{StaticResource PanelBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding SendCommand}" IsEnabled="{Binding !IsSaving}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Width="16" Height="16" Stroke="White" Data="{StaticResource IconCheck}"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SendLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Content="انصراف" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
