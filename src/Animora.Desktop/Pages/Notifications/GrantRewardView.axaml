<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nt="using:Animora.Desktop.Pages.Notifications"
             xmlns:contracts="using:Animora.Contracts.Notifications"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Notifications.GrantRewardView"
             x:DataType="nt:GrantRewardViewModel"
             x:CompileBindings="True"
             Width="560" MaxWidth="560" MaxHeight="680"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <Style Selector="TextBlock.fld">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style Selector="TextBox.inp">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="22,20,22,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13" Background="#fff7e0" VerticalAlignment="Top">
                    <Path Classes="icon" Width="21" Height="21" Stroke="#b7791f" Data="{StaticResource IconSpark}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="اعطای جایزه" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="چند روز اشتراک رایگان برای یک کاربر ثبت می‌شود و پیام آن برایش ارسال می‌گردد."
                               FontSize="12.5" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Width="36" Height="36" Padding="0" CornerRadius="10"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip.Tip="بستن">
                    <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource MutedBrush}"
                          Data="{StaticResource IconX}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,18" Spacing="12">
                <StackPanel>
                    <TextBlock Classes="fld" Text="کاربر" />
                    <ComboBox HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="36"
                              ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                              PlaceholderText="انتخاب کاربر">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="contracts:NotificationRecipient">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RoleLabel}" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="fld" Text="تعداد روز اشتراک" />
                    <TextBox controls:InputGuard.Kind="Digits" MaxLength="4" Classes="inp" Text="{Binding DaysText}"
                             Width="160" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="fld" Text="دلیل / توضیح (اختیاری)" />
                    <TextBox Classes="inp" MaxLength="400" Text="{Binding Reason}" AcceptsReturn="True" MinHeight="80"
                             TextWrapping="Wrap" VerticalContentAlignment="Top"
                             PlaceholderText="مثلاً به‌خاطر معرفی یک کلینیک دیگر" />
                </StackPanel>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding Error.Length}" TextWrapping="Wrap"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" Padding="22,14"
                Background="{StaticResource PanelBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding GrantCommand}" IsEnabled="{Binding !IsSaving}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Width="16" Height="16" Stroke="White" Data="{StaticResource IconCheck}"
                              VerticalAlignment="Center" />
                        <TextBlock Text="ثبت جایزه و ارسال پیام" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Content="انصراف" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
