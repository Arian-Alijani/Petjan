<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nt="using:Animora.Desktop.Pages.Notifications"
             xmlns:controls="using:Animora.Desktop.Controls"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Pages.Notifications.NotificationsPageView"
             x:Name="Root"
             x:DataType="nt:NotificationsPageViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- filter chip (same look as the Cheques / History chips) -->
        <Style Selector="Button.nchip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.nchip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.nchip.on">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.nchip-sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="4,2" />
        </Style>

        <!-- message card: the whole card is one button so a click opens/marks it read -->
        <Style Selector="Button.ncard">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Button.ncard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ncard:pointerover Border.ncard-body">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
        </Style>
        <Style Selector="Border.ncard-body">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
        </Style>
        <Style Selector="Border.ncard-body.unread">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="26,22,26,40" Spacing="16">
        <!-- ═══ header ═══ -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Bottom">
                <TextBlock Text="اعلان‌ها و پیام‌ها" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" LetterSpacing="-0.4" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="unread-dot" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource DangerBrush}" IsVisible="{Binding HasUnread}" />
                    <TextBlock Text="{Binding UnreadText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <Button Classes="outline" Command="{Binding MarkAllReadCommand}" IsEnabled="{Binding HasUnread}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconCheck}" VerticalAlignment="Center" />
                        <TextBlock Text="خواندن همه" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="outline" Command="{Binding OpenGrantRewardCommand}" IsVisible="{Binding CanManage}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconSpark}" VerticalAlignment="Center" />
                        <TextBlock Text="اعطای جایزه" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding OpenComposeCommand}" IsVisible="{Binding CanManage}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Width="14" Height="14" Stroke="White"
                              Data="{StaticResource IconPlus}" VerticalAlignment="Center" />
                        <TextBlock Text="پیام جدید" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ filters ═══ -->
        <Border Classes="card" Padding="14,12">
            <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7">
                <ItemsControl ItemsSource="{Binding ScopeChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="nt:NotificationChipViewModel">
                            <Button Classes="nchip" Classes.on="{Binding IsActive}" Content="{Binding Label}"
                                    Command="{Binding #Root.((nt:NotificationsPageViewModel)DataContext).SetScopeCommand}"
                                    CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="nchip-sep" Height="22" />
                <ItemsControl ItemsSource="{Binding KindChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="nt:NotificationChipViewModel">
                            <Button Classes="nchip" Classes.on="{Binding IsActive}" Content="{Binding Label}"
                                    Command="{Binding #Root.((nt:NotificationsPageViewModel)DataContext).SetKindCommand}"
                                    CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </Border>

        <!-- ═══ message cards ═══ -->
        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="nt:NotificationItemViewModel">
                    <Button Classes="ncard"
                            Command="{Binding #Root.((nt:NotificationsPageViewModel)DataContext).OpenItemCommand}"
                            CommandParameter="{Binding}">
                        <Border Classes="ncard-body" Classes.unread="{Binding IsUnread}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="16,14">
                                <!-- kind icon tile -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13"
                                        Background="{Binding SoftBrush}" VerticalAlignment="Top">
                                    <Path Classes="icon" Width="21" Height="21" Stroke="{Binding AccentBrush}"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="999" Padding="9,2" Background="{Binding SoftBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TagText}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding AccentBrush}" />
                                            </Border>
                                            <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{StaticResource DangerBrush}" IsVisible="{Binding IsUnread}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RelativeTime}" FontSize="11.5"
                                                   Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Body}" FontSize="13" LineHeight="21"
                                               Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap"
                                               MaxLines="{Binding BodyMaxLines}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card" IsVisible="{Binding !HasItems}">
            <controls:EmptyState Margin="0,36"
                                 Icon="{StaticResource IconBell}"
                                 Title="{Binding EmptyTitle}"
                                 Subtitle="{Binding EmptySubtitle}" />
        </Border>
    </StackPanel>
</UserControl>
