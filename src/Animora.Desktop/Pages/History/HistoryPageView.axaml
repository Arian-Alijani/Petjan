<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hy="using:Animora.Desktop.Pages.History"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.History.HistoryPageView"
             x:Name="Root"
             x:DataType="hy:HistoryPageViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- ═══ Range chip (.hy-chip): pill outline; active = brand fill. ═══ -->
        <Style Selector="Button.hy-chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.hy-chip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.hy-chip.on">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ═══ Category chip (.hy-cat-chip) ═══ -->
        <Style Selector="Button.hy-cat-chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>
        <Style Selector="Button.hy-cat-chip:pointerover">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Muted2Brush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.hy-cat-chip.on">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- ═══ Summary bar (.hy-summary) ═══ -->
        <Style Selector="Border.hy-summary">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="10,10,0,0" />
            <Setter Property="Padding" Value="18,12" />
        </Style>
        <Style Selector="Border.hy-summary-sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>

        <!-- ═══ Ledger shell (.hy-ledger) ═══ -->
        <Style Selector="Border.hy-ledger">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0,0,10,10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.hy-ledger-head">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TextBlock.hcol-head">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.3" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- ═══ Day group header (.hy-day-group) ═══ -->
        <Style Selector="Border.hy-day-group">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
        <Style Selector="Border.hy-day-badge">
            <Setter Property="Background" Value="{StaticResource Line2Brush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
        </Style>

        <!-- ═══ Event row (.hy-row) ═══ -->
        <Style Selector="Border.hy-row">
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="16,11" />
        </Style>
        <!-- clickable row wrapper: flat (no button chrome), hand cursor, opens the record -->
        <Style Selector="Button.hy-row-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.hy-row-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.hy-row-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>

        <!-- ═══ Category icon badge (.hy-cat-badge) ═══ -->
        <Style Selector="Border.hy-cat-badge">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- ═══ Status chip (.hy-status) ═══ -->
        <Style Selector="Border.hy-status">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="9,3" />
        </Style>
        <Style Selector="Ellipse.hy-status-dot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
        </Style>

        <!-- ═══ Empty state (.hy-empty) ═══ -->
        <Style Selector="Border.hy-empty-icon">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- ═══ Compact toolbar select (.hy-select) ═══ -->
        <Style Selector="ComboBox.hy-select">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ComboBox.hy-select /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- ═══ Pager buttons (.hy-pager) ═══ -->
        <Style Selector="Button.hy-pager">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.hy-pager:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.hy-pager:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- Virtualized day-group feed (ListBox). MaxHeight is REQUIRED: the
             shell's page-level ScrollViewer measures content with infinite
             height, so without a cap the inner VirtualizingStackPanel would
             realize every day group (and all their nested rows). The nested
             Rows ItemsControl stays a normal panel — only the outer day-group
             list is virtualized. -->
        <Style Selector="ListBox.hy-ledger-body">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxHeight" Value="600" />
        </Style>
        <Style Selector="ListBox.hy-ledger-body ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.hy-ledger-body ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.hy-ledger-body ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="26,22,26,40">
        <!-- ═══ Page header (.page-header) ═══ -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" LetterSpacing="-0.4" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <Button Classes="outline" Command="{Binding ExportCsvCommand}" ToolTip.Tip="خروجی CSV">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconDownload}" VerticalAlignment="Center" />
                        <TextBlock Text="خروجی CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Toolbar (.hy-toolbar): search + range presets ═══ -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
                BorderThickness="1" CornerRadius="0,0,16,16"
                BoxShadow="{StaticResource ShadowCard}" Padding="14,12" Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" MinWidth="200" Background="{StaticResource Bg2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="13,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                                  VerticalAlignment="Center" Stroke="{StaticResource MutedBrush}"
                                  Data="{StaticResource IconSearch}" IsHitTestVisible="False" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText}" Background="Transparent"
                                     BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"
                                     PlaceholderText="{Binding SearchPlaceholder}" />
                            <Button Grid.Column="2" Width="20" Height="20" Padding="0" CornerRadius="999"
                                    Background="{StaticResource Brand50Brush}" BorderThickness="0"
                                    VerticalAlignment="Center" IsVisible="{Binding HasSearchValue}"
                                    Command="{Binding ClearSearchCommand}">
                                <Path Classes="icon" Width="11" Height="11"
                                      Stroke="{StaticResource Brand700Brush}" Data="{StaticResource IconX}" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding RangeChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="hy:HistoryRangeViewModel">
                                    <Button Classes="hy-chip" Classes.on="{Binding IsActive}"
                                            Content="{Binding Label}"
                                            Command="{Binding #Root.((hy:HistoryPageViewModel)DataContext).SetRangeCommand}"
                                            CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- tier 2 · kind chips + date range + sort/page controls -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                    <StackPanel Grid.Column="0">
                        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,-12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="hy-chip" Classes.on="{Binding AreAllKindsActive}"
                                        Margin="0,0,7,0" ToolTip.Tip="فعال‌سازی همهٔ فیلترها"
                                        Command="{Binding SelectAllKindsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="14" Height="14"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconCheck}" VerticalAlignment="Center" />
                                        <TextBlock Text="همه" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <ItemsControl ItemsSource="{Binding CategoryChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="hy:HistoryCategoryChipViewModel">
                                            <Button Classes="hy-cat-chip" Classes.on="{Binding IsActive}"
                                                    Margin="0,0,7,0" ToolTip.Tip="{Binding Label}"
                                                    Background="{Binding ChipBackground}"
                                                    BorderBrush="{Binding ChipBorder}"
                                                    Command="{Binding #Root.((hy:HistoryPageViewModel)DataContext).ToggleCategoryCommand}"
                                                    CommandParameter="{Binding Kind}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Classes="icon" Width="14" Height="14"
                                                          Stroke="{Binding ColorBrush}"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                               Foreground="{Binding LabelBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <controls:JalaliDatePicker Width="140" DateValue="{Binding FromDate, Mode=TwoWay}"
                                                   ToolTip.Tip="از تاریخ" />
                        <TextBlock Text="تا" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <controls:JalaliDatePicker Width="140" DateValue="{Binding ToDate, Mode=TwoWay}"
                                                   ToolTip.Tip="تا تاریخ" />
                        <Button Classes="hy-pager" Padding="10,7" Command="{Binding ClearRangeCommand}"
                                ToolTip.Tip="حذف بازهٔ تاریخ">
                            <Path Classes="icon" Width="12" Height="12"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource IconX}" />
                        </Button>

                        <Border Width="1" Height="22" Background="{StaticResource LineBrush}" />

                        <ComboBox Classes="hy-select" MinWidth="150" SelectedIndex="{Binding SortIndex}"
                                  ToolTip.Tip="مرتب‌سازی">
                            <ComboBoxItem Content="جدیدترین" />
                            <ComboBoxItem Content="قدیمی‌ترین" />
                            <ComboBoxItem Content="بیشترین مبلغ" />
                            <ComboBoxItem Content="کمترین مبلغ" />
                        </ComboBox>
                        <ComboBox Classes="hy-select" MinWidth="110" SelectedIndex="{Binding PageSizeIndex}"
                                  ToolTip.Tip="تعداد رکورد در صفحه">
                            <ComboBoxItem Content="۲۵ رکورد" />
                            <ComboBoxItem Content="۵۰ رکورد" />
                            <ComboBoxItem Content="۱۰۰ رکورد" />
                        </ComboBox>

                        <Button Classes="hy-pager" Command="{Binding ResetFiltersCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Width="13" Height="13"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      Data="{StaticResource IconRefresh}" />
                                <TextBlock Text="بازنشانی" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ Empty state ═══ -->
        <Grid IsVisible="{Binding IsEmpty}">
            <StackPanel>
                <Border Classes="hy-summary" HorizontalAlignment="Stretch">
                    <TextBlock Text="نتیجه‌ای یافت نشد" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" />
                </Border>
                <Border Classes="hy-ledger">
                    <StackPanel Margin="0,64,0,64" HorizontalAlignment="Center" Spacing="10">
                        <Border Classes="hy-empty-icon" HorizontalAlignment="Center">
                            <Path Classes="icon" Width="26" Height="26"
                                  Stroke="{StaticResource Muted2Brush}"
                                  Data="{StaticResource IconReceipt}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="رویدادی در این بازه ثبت نشده است" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource Ink2Brush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="بازه زمانی یا فیلتر را تغییر دهید." FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ Populated: summary bar + table + pager ═══ -->
        <StackPanel IsVisible="{Binding HasEvents}">
            <Border Classes="hy-summary">
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryCountText}" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Border Classes="hy-summary-sep" />
                    <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                        <Run Text="درآمد: " />
                        <Run Text="{Binding SummaryIncomeText}" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                    </TextBlock>
                    <Border Classes="hy-summary-sep" />
                    <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                        <Run Text="هزینه: " />
                        <Run Text="{Binding SummaryExpenseText}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </TextBlock>
                    <Border Classes="hy-summary-sep" />
                    <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                        <Run Text="خالص: " />
                        <Run Text="{Binding SummaryNetText}" FontWeight="Bold" Foreground="{Binding SummaryNetBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Classes="hy-ledger">
                <StackPanel>
                    <!-- header (.hy-ledger-head) -->
                    <Border Classes="hy-ledger-head">
                        <Grid ColumnDefinitions="36,80,*,150,130,120,120,110" ColumnSpacing="0">
                            <TextBlock Grid.Column="0" Classes="hcol-head" />
                            <TextBlock Grid.Column="1" Classes="hcol-head" Text="زمان" />
                            <TextBlock Grid.Column="2" Classes="hcol-head" Text="رویداد" />
                            <TextBlock Grid.Column="3" Classes="hcol-head" Text="موجودیت" />
                            <TextBlock Grid.Column="4" Classes="hcol-head" Text="کاربر / انجام‌دهنده" />
                            <TextBlock Grid.Column="5" Classes="hcol-head" Text="مبلغ" />
                            <TextBlock Grid.Column="6" Classes="hcol-head" Text="وضعیت" />
                            <TextBlock Grid.Column="7" Classes="hcol-head" Text="دسته" />
                        </Grid>
                    </Border>

                    <!-- day groups (virtualized outer list; nested Rows stay a
                         normal panel) -->
                    <ListBox Classes="hy-ledger-body" ItemsSource="{Binding DayGroups}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="hy:HistoryDayGroupViewModel">
                                <StackPanel>
                                    <Border Classes="hy-day-group">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="{Binding HeaderText}"
                                                       FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{StaticResource Ink2Brush}" />
                                            <Border Grid.Column="1" Classes="hy-day-badge" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CountText}" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding NetText}" FontSize="12"
                                                       FontWeight="Bold" Foreground="{Binding NetBrush}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasNet}" />
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="hy:HistoryEventRowViewModel">
                                                <Button Classes="hy-row-btn" Command="{Binding OpenCommand}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        ToolTip.Tip="{Binding Title}">
                                                <Border Classes="hy-row">
                                                    <Grid ColumnDefinitions="36,80,*,150,130,120,120,110" ColumnSpacing="0">
                                                        <Border Grid.Column="0" Classes="hy-cat-badge"
                                                                Background="{Binding BadgeBrush}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Path Classes="icon" Width="15" Height="15"
                                                                  Stroke="{Binding BadgeIconBrush}"
                                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Time}"
                                                                   FontSize="12" Margin="4,0"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="2" Margin="4,0" Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource InkBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       IsVisible="{Binding HasDetail}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Entity}" Margin="4,0"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource Ink2Brush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <!-- کاربر / انجام‌دهنده (actor) -->
                                                        <StackPanel Grid.Column="4" Margin="4,0" Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ActorName}" FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Ink2Brush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ActorRole}" FontSize="11"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="5" Text="{Binding AmountText}" Margin="4,0"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="{Binding AmountBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="6" Classes="hy-status"
                                                                Background="{Binding StatusBgBrush}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Ellipse Classes="hy-status-dot"
                                                                         Fill="{Binding StatusBrush}"
                                                                         VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="7" CornerRadius="20" Padding="8,3"
                                                                BorderThickness="1"
                                                                BorderBrush="{Binding CategoryColorBrush}"
                                                                Background="{Binding CategoryBgBrush}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding CategoryColorBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- pager (.hy-pager) -->
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto,Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="1" Classes="hy-pager" Command="{Binding PrevPageCommand}"
                                    IsEnabled="{Binding HasPrev}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{StaticResource IconChevronRight}" />
                                    <TextBlock Text="قبلی" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="2" MinWidth="88" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageText}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{StaticResource Ink2Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="3" Classes="hy-pager" HorizontalAlignment="Left"
                                    Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="بعدی" />
                                    <Path Classes="icon" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{StaticResource IconChevronLeft}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
