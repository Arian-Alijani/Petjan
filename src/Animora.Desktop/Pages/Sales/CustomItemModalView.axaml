<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sales="using:Animora.Desktop.Pages.Sales"
             x:Class="Animora.Desktop.Pages.Sales.CustomItemModalView"
             x:Name="Root"
             x:DataType="sales:CustomItemModalViewModel"
             Width="520"
             MaxWidth="520"
             FlowDirection="RightToLeft">

    <!-- Custom-item modal — re-draws Animora-UI/assets/sale-page.js
         openCustomItemModal (.sw-modal.sw-confirm.sw-modal-custom). Values from
         sale.css (.sw-custom-form/-field/-row/-preview). -->
    <UserControl.Styles>
        <Style Selector="TextBlock.ci-lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBox.ci-inp">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.ci-inp.name">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.ci-btn">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- head -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="22,20,22,8">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13"
                    Background="{StaticResource Bg2Brush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource MutedBrush}"
                      Data="{StaticResource IconEdit}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="افزودن آیتم دلخواه" FontSize="17" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="برای کالا یا خدمتی که در لیست آماده وجود ندارد." FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <StackPanel Margin="22,4,22,12" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Classes="ci-lbl" Text="نام آیتم" />
                <TextBox Classes="ci-inp name" Text="{Binding Name}"
                         Watermark="مثلاً: عکس رادیولوژی، کالای متفرقه…" />
            </StackPanel>
            <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="ci-lbl" Text="مبلغ واحد (تومان)" />
                    <TextBox Classes="ci-inp" Text="{Binding PriceText}" Watermark="۰"
                             TextAlignment="Right" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Classes="ci-lbl" Text="تعداد" />
                    <TextBox Classes="ci-inp" Text="{Binding QuantityText}" TextAlignment="Right"
                             />
                </StackPanel>
            </Grid>
            <Border IsVisible="{Binding HasPreview}" Background="{StaticResource Brand50Brush}"
                    CornerRadius="10" Padding="12,8">
                <TextBlock Text="{Binding PreviewText}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource Brand700Brush}" />
            </Border>
        </StackPanel>

        <!-- foot -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    Margin="20,12,20,18">
            <Button Classes="outline ci-btn" Content="انصراف" Command="{Binding CancelCommand}" />
            <Button Classes="ci-btn" Command="{Binding SubmitCommand}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
                    </Style>
                </Button.Styles>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Width="14" Height="14" Stroke="White"
                          StrokeThickness="2.5" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="افزودن به فاکتور" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
