<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sales="using:Animora.Desktop.Pages.Sales"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Sales.InvoiceViewerView"
             x:Name="Root"
             x:DataType="sales:InvoiceViewerViewModel"
             Width="1040" MaxWidth="1040"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- Section title -->
        <Style Selector="TextBlock.iv-sec">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="LetterSpacing" Value="0.2" />
        </Style>
        <!-- Header meta chip -->
        <Style Selector="Border.iv-chip">
            <Setter Property="Background" Value="#66ffffff" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <!-- A line row -->
        <Style Selector="Border.iv-line">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style Selector="Border.iv-line:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
        </Style>
        <Style Selector="Border.iv-tag">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style Selector="TextBox.iv-in">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- Read-only qty/discount chip -->
        <Style Selector="Border.iv-qty">
            <Setter Property="Background" Value="{StaticResource InsetBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinWidth" Value="54" />
        </Style>
        <!-- Aside card wrapper -->
        <Style Selector="Border.iv-card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <!-- Totals summary row (label → value) -->
        <Style Selector="TextBlock.iv-lbl">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.iv-val">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Timeline (payments + audit) -->
        <Style Selector="Border.iv-dot">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Border.iv-rail">
            <Setter Property="Width" Value="2" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource BgBrush}">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="{StaticResource Brand50Brush}"
                BorderBrush="{StaticResource Brand100Brush}" BorderThickness="0,0,0,1"
                Padding="24,18,20,16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="15"
                            Background="{StaticResource Brand600Brush}">
                        <Path Classes="icon" Width="24" Height="24" Stroke="White"
                              Data="{StaticResource IconReceipt}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="ExtraBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding InvoiceId2}" FontSize="20" FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brand700Brush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5"
                                   Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Top">
                        <controls:Badge Text="{Binding StateLabel}" Tone="{Binding StateTone}" />
                        <Button Width="32" Height="32" Padding="0" CornerRadius="999"
                                Background="#55ffffff" BorderThickness="0"
                                Command="{Binding CloseCommand}" ToolTip.Tip="بستن">
                            <Path Classes="icon" Width="16" Height="16"
                                  Stroke="{StaticResource MutedBrush}"
                                  Data="{StaticResource IconX}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- meta strip: time · source · receipt · doctor · insurance -->
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Classes="iv-chip" IsVisible="{Binding HasTime}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Brand700Brush}"
                                  Data="{StaticResource IconClock}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimeText}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="iv-chip">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Brand700Brush}"
                                  Data="{StaticResource IconTag}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SourceLabel}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="iv-chip" IsVisible="{Binding HasReceipt}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource OkBrush}"
                                  Data="{StaticResource IconFile}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ReceiptText}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="iv-chip" IsVisible="{Binding HasDoctor}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource LilacBrush}"
                                  Data="{StaticResource IconStetho}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DoctorText}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="iv-chip" IsVisible="{Binding HasInsuranceLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource MintBrush}"
                                  Data="{StaticResource IconShield}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding InsuranceLabel}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ BODY : two columns (left = lines · right = totals/editors/history) ═══ -->
        <Grid Grid.Row="1" Margin="20,16,20,14"
              ColumnDefinitions="1.35*,1*" ColumnSpacing="16">

            <!-- ── LEFT : deleted banner + invoice lines ─────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="10">

                <!-- deleted banner -->
                <Border Grid.Row="0" IsVisible="{Binding IsDeleted}" CornerRadius="12" Padding="14,10"
                        Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16"
                              Stroke="{StaticResource DangerBrush}"
                              Data="{StaticResource IconAlert}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DeletedBannerText}" FontSize="12.5"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- lines heading -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Classes="iv-sec" Text="اقلام فاکتور"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource InsetBrush}" CornerRadius="999" Padding="8,2">
                        <TextBlock Text="{Binding ItemCountText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <TextBlock Grid.Column="2" FontSize="11"
                               Foreground="{StaticResource Muted2Brush}"
                               IsVisible="{Binding CanEditMeta}"
                               Text="تعداد و تخفیف هر ردیف قابل ویرایش است"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- lines list (the only left-column scroll region) -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Lines}"
                         Background="Transparent" Padding="0" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,7" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="sales:InvoiceViewerLineViewModel">
                            <Border Classes="iv-line">
                                <Grid ColumnDefinitions="38,*,Auto,Auto,110,Auto,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" Classes="iv-tag"
                                            Background="{Binding TagBackground}">
                                        <Path Classes="icon" Width="18" Height="18"
                                              Stroke="{Binding TagForeground}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UnitText}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>

                                    <!-- editable qty/discount -->
                                    <TextBox Grid.Column="2" Classes="iv-in" Width="62"
                                             IsVisible="{Binding IsEditable}"
                                             Text="{Binding QuantityText, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEditable}"
                                             LostFocus="OnLineFieldCommit" />
                                    <TextBox Grid.Column="3" Classes="iv-in" Width="62"
                                             IsVisible="{Binding IsEditable}"
                                             Text="{Binding DiscountText, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEditable}"
                                             LostFocus="OnLineFieldCommit" />

                                    <!-- read-only qty/discount chips -->
                                    <StackPanel Grid.Column="2" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !IsEditable}">
                                        <Border Classes="iv-qty">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="تعداد" FontSize="9.5"
                                                           Foreground="{StaticResource Muted2Brush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding QuantityText}" FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource InkBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="iv-qty">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="تخفیف٪" FontSize="9.5"
                                                           Foreground="{StaticResource Muted2Brush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding DiscountText}" FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource InkBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{Binding SubtotalText}"
                                               FontSize="13.5" FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Button Grid.Column="5" Classes="outline" Padding="7,5"
                                            FontSize="11" CornerRadius="8"
                                            IsVisible="{Binding CanReturn}"
                                            Click="OnReturnLineClick"
                                            ToolTip.Tip="برگشت این کالا">
                                        <Path Classes="icon" Width="14" Height="14"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconArrowDownLeft}" />
                                    </Button>
                                    <Button Grid.Column="6" Width="30" Height="30" Padding="0"
                                            CornerRadius="8" Background="Transparent"
                                            IsVisible="{Binding IsEditable}"
                                            Click="OnRemoveLineClick"
                                            ToolTip.Tip="حذف ردیف">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Stroke="{StaticResource MutedBrush}"
                                              Data="{StaticResource IconTrash}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ── RIGHT : totals + final amount + editors + payments + audit ─── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- totals summary card -->
                    <StackPanel Spacing="8">
                        <TextBlock Classes="iv-sec" Text="مبالغ فاکتور" />
                        <Border Classes="iv-card">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="iv-lbl" Text="جمع اقلام" />
                                    <TextBlock Grid.Column="1" Classes="iv-val" HorizontalAlignment="Left"
                                               Text="{Binding BaseText}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasDiscount}">
                                    <TextBlock Grid.Column="0" Classes="iv-lbl" Text="تخفیف" />
                                    <TextBlock Grid.Column="1" Classes="iv-val" HorizontalAlignment="Left"
                                               Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding DiscountText}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="iv-lbl" Text="مالیات" />
                                    <TextBlock Grid.Column="1" Classes="iv-val" HorizontalAlignment="Left"
                                               Text="{Binding TaxText}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasInsurance}">
                                    <TextBlock Grid.Column="0" Classes="iv-lbl" Text="سهم بیمه" />
                                    <TextBlock Grid.Column="1" Classes="iv-val" HorizontalAlignment="Left"
                                               Foreground="{StaticResource OkBrush}"
                                               Text="{Binding InsuranceShareText}" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,1" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="iv-lbl" Text="پرداخت‌شده" />
                                    <TextBlock Grid.Column="1" Classes="iv-val" HorizontalAlignment="Left"
                                               Foreground="{StaticResource OkBrush}"
                                               Text="{Binding PaidText}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasDue}">
                                    <TextBlock Grid.Column="0" Classes="iv-lbl" Text="مانده" />
                                    <TextBlock Grid.Column="1" Classes="iv-val" HorizontalAlignment="Left"
                                               Foreground="{StaticResource DangerBrush}"
                                               Text="{Binding DueText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- final amount brand block -->
                    <Border CornerRadius="14" Padding="16,13" Background="{StaticResource Brand600Brush}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Path Grid.Column="0" Classes="icon" Width="18" Height="18" Stroke="#d9ffffff"
                                  Data="{StaticResource IconWallet}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="مبلغ نهایی" FontSize="13" FontWeight="Bold"
                                       Foreground="#d9ffffff" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalText}" FontSize="20"
                                           FontWeight="ExtraBold" Foreground="White" />
                                <TextBlock Text="تومان" FontSize="12" Foreground="#b3ffffff"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- discount / insurance editors (draft/partial only) -->
                    <StackPanel Spacing="8" IsVisible="{Binding CanEditMeta}">
                        <TextBlock Classes="iv-sec" Text="تخفیف و بیمه" />
                        <Border Classes="iv-card">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="iv-lbl" Text="تخفیف سراسری" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <ComboBox Grid.Column="0" MinWidth="82"
                                                  SelectedIndex="{Binding DiscountKindIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="درصد" />
                                            <ComboBoxItem Content="مبلغ" />
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Classes="iv-in"
                                                 Text="{Binding DiscountValueText, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Classes="outline" Padding="10,6"
                                                Command="{Binding ApplyDiscountCommand}">
                                            <TextBlock Text="اعمال" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="iv-lbl" Text="پوشش بیمه" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding Insurers}"
                                              SelectedItem="{Binding SelectedInsurer, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="sales:InsurerOptionViewModel">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- payment history (compact) -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasPayments}">
                        <TextBlock Classes="iv-sec" Text="{Binding PaymentsHeader}" />
                        <Border Classes="iv-card">
                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="9" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sales:InvoicePaymentViewModel">
                                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" CornerRadius="7" Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding MethodBackground}">
                                                <TextBlock Text="{Binding MethodLabel}" FontSize="11"
                                                           FontWeight="ExtraBold"
                                                           Foreground="{Binding MethodForeground}"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding NoteText}" FontSize="12"
                                                       Foreground="{StaticResource Ink2Brush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="13"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{Binding AmountBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- audit trail (timeline) — the second bounded-scroll region -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasAudit}">
                        <TextBlock Classes="iv-sec" Text="{Binding AuditHeader}" />
                        <Border Classes="iv-card" Padding="14,12,10,4">
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Audit}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sales:InvoiceAuditRowViewModel">
                                            <Grid ColumnDefinitions="30,*" ColumnSpacing="12">
                                                <!-- rail + dot -->
                                                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                                                    <Border Grid.Row="0" Classes="iv-dot"
                                                            Background="{Binding BadgeBrush}">
                                                        <Path Classes="icon" Width="16" Height="16"
                                                              Stroke="{Binding BadgeIconBrush}"
                                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Row="1" Classes="iv-rail" Margin="0,2,0,0" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,2,0,14">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding Action}" FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11"
                                                                   Foreground="{StaticResource Muted2Brush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               IsVisible="{Binding HasDetail}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══ FOOTER ACTIONS ═══ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Classes="outline" Padding="14,9" Command="{Binding PrintCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource IconPrinter}" />
                            <TextBlock Text="چاپ" />
                        </StackPanel>
                    </Button>
                    <Button Classes="outline" Padding="14,9"
                            Foreground="{StaticResource DangerBrush}"
                            IsVisible="{Binding ShowVoid}"
                            Command="{Binding VoidInvoiceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="16" Height="16"
                                  Stroke="{StaticResource DangerBrush}"
                                  Data="{StaticResource IconX}" />
                            <TextBlock Text="ابطال" />
                        </StackPanel>
                    </Button>
                    <Button Classes="outline" Padding="14,9"
                            IsVisible="{Binding ShowRefund}"
                            Command="{Binding RefundCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="16" Height="16"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource IconArrowDownLeft}" />
                            <TextBlock Text="عودت وجه" />
                        </StackPanel>
                    </Button>
                    <Button Classes="danger-ghost" Padding="14,9"
                            IsVisible="{Binding CanEdit}"
                            Command="{Binding DeleteInvoiceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="16" Height="16"
                                  Stroke="{StaticResource DangerBrush}"
                                  Data="{StaticResource IconTrash}" />
                            <TextBlock Text="حذف فاکتور" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Padding="18,10"
                        IsVisible="{Binding CanPay}"
                        Command="{Binding TakePaymentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16" Stroke="White"
                              Data="{StaticResource IconWallet}" />
                        <TextBlock Text="ثبت پرداخت" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
