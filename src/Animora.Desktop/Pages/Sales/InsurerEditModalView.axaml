<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sales="using:Animora.Desktop.Pages.Sales"
             x:Class="Animora.Desktop.Pages.Sales.InsurerEditModalView"
             x:DataType="sales:InsurerEditModalViewModel"
             Width="520"
             MaxWidth="520"
             FlowDirection="RightToLeft">

    <!-- Add / edit one insurer. Field styling matches the service-rate modal. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.sm-lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBlock.sm-hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.sm-inp">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sm-btn">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- head -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="22,20,22,8">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13"
                    Background="{StaticResource Brand50Brush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource Brand700Brush}"
                      Data="{StaticResource IconShield}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding HeadTitle}" FontSize="17" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding HeadSubtitle}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <StackPanel Margin="22,4,22,12" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="نام بیمه" />
                <TextBox Classes="sm-inp" Text="{Binding Name}" FontWeight="Bold"
                         PlaceholderText="مثلاً: تأمین اجتماعی، بیمه ایران…" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="درصد پوشش (٪)" />
                <TextBox Classes="sm-inp" Text="{Binding PercentText}" PlaceholderText="۰ تا ۱۰۰"
                         TextAlignment="Right" />
                <TextBlock Classes="sm-hint" Text="سهمی از مبلغ فاکتور که بیمه پرداخت می‌کند." />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="سقف پوشش (تومان)" />
                <TextBox Classes="sm-inp" Text="{Binding CeilingText}" PlaceholderText="بدون سقف"
                         TextAlignment="Right" />
                <TextBlock Classes="sm-hint"
                           Text="بیشترین مبلغی که بیمه برای یک فاکتور می‌پردازد؛ خالی یا ۰ یعنی بدون سقف." />
            </StackPanel>
        </StackPanel>

        <!-- foot -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    Margin="20,12,20,18">
            <Button Classes="outline sm-btn" Content="انصراف" Command="{Binding CancelCommand}" />
            <Button Classes="sm-btn" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSaving}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
                    </Style>
                </Button.Styles>
                <TextBlock Text="{Binding SubmitText}" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
