<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sales="using:Animora.Desktop.Pages.Sales"
             x:Class="Animora.Desktop.Pages.Sales.RefundModalView"
             x:Name="Root"
             x:DataType="sales:RefundModalViewModel"
             Width="480"
             MaxWidth="480"
             FlowDirection="RightToLeft">

    <!-- Refund modal — re-draws Animora-UI/assets/sale-page.js openRefundModal
         (.sw-modal.sw-confirm.sw-modal-refund). Values from sale.css
         (.sw-confirm-head/.sw-refund-presets/.sw-confirm-note/.amount-wrap). -->
    <UserControl.Styles>
        <Style Selector="Button.rf-btn">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.rf-pre">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.rf-pre:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- head -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="22,20,22,12">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13"
                    Background="{StaticResource WarnBgBrush}">
                <Path Classes="icon" Width="20" Height="20"
                      Stroke="{StaticResource WarnBrush}"
                      Data="{StaticResource IconArrowDownLeft}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="عودت وجه فاکتور" FontSize="17" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="حداکثر مبلغ قابل عودت:" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding MaxText}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Ink2Brush}" />
                    <TextBlock Text="تومان" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- body -->
        <StackPanel Margin="22,4,22,12" Spacing="12">
            <TextBlock Text="مبلغ عودت (تومان)" FontSize="11" FontWeight="ExtraBold"
                       Foreground="{StaticResource MutedBrush}" />
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5"
                    CornerRadius="12" Background="{StaticResource PanelBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding AmountText}" MinHeight="0"
                             Padding="48,12,16,12" FontSize="17" FontWeight="ExtraBold"
                             BorderThickness="0" Background="Transparent"
                             TextAlignment="Right" VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="تومان" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="16,0" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="rf-pre" Content="{Binding FullPresetText}"
                        Command="{Binding SetFullCommand}" />
                <Button Classes="rf-pre" Content="{Binding HalfPresetText}"
                        Command="{Binding SetHalfCommand}" />
            </StackPanel>
            <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="12,10">
                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}" LineHeight="1.7"
                           Text="مبلغ عودت از پرداخت‌های ثبت‌شده کسر می‌شود و در تاریخچه با یک ردیف منفی ثبت خواهد شد." />
            </Border>
        </StackPanel>

        <!-- foot -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    Margin="20,12,20,18">
            <Button Classes="outline rf-btn" Content="انصراف" Command="{Binding CancelCommand}" />
            <Button Classes="rf-btn" Command="{Binding SubmitCommand}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
                    </Style>
                </Button.Styles>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" Width="14" Height="14" Stroke="White"
                          StrokeThickness="2.5" Data="{StaticResource IconCheck}" />
                    <TextBlock Text="ثبت عودت" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
