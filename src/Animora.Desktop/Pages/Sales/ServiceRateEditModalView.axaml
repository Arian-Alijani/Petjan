<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sales="using:Animora.Desktop.Pages.Sales"
             x:Class="Animora.Desktop.Pages.Sales.ServiceRateEditModalView"
             x:Name="Root"
             x:DataType="sales:ServiceRateEditModalViewModel"
             Width="520"
             MaxWidth="520"
             FlowDirection="RightToLeft">

    <!-- Add / edit one service rate. Field styling matches the custom-item modal. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.sm-lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBox.sm-inp">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sm-btn">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- head -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="22,20,22,8">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13"
                    Background="{StaticResource Bg2Brush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource MutedBrush}"
                      Data="{StaticResource IconTag}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding HeadTitle}" FontSize="17" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding HeadSubtitle}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <StackPanel Margin="22,4,22,12" Spacing="14">
            <StackPanel Spacing="6" IsVisible="{Binding ShowSourceChooser}">
                <TextBlock Classes="sm-lbl" Text="نوع خدمت" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="hy-chip" Classes.on="{Binding IsClinic}" Content="خدمات کلینیک"
                            Command="{Binding SetSourceCommand}" CommandParameter="clinic" />
                    <Button Classes="hy-chip" Classes.on="{Binding IsBoarding}" Content="خدمات پانسیون"
                            Command="{Binding SetSourceCommand}" CommandParameter="boarding" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="نام خدمت" />
                <TextBox Classes="sm-inp" Text="{Binding Name}" FontWeight="Bold"
                         PlaceholderText="مثلاً: ویزیت عمومی، حمام…" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="نرخ (تومان)" />
                <TextBox Classes="sm-inp" Text="{Binding PriceText}" PlaceholderText="۰" TextAlignment="Right" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding ShowBilling}">
                <TextBlock Classes="sm-lbl" Text="نحوهٔ محاسبه" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="hy-chip" Classes.on="{Binding IsPerUse}" Content="هر بار"
                            Command="{Binding SetBillingCommand}" CommandParameter="use" />
                    <Button Classes="hy-chip" Classes.on="{Binding IsPerDay}" Content="روزانه"
                            Command="{Binding SetBillingCommand}" CommandParameter="day" />
                    <Button Classes="hy-chip" Classes.on="{Binding IsPerStay}" Content="هر اقامت"
                            Command="{Binding SetBillingCommand}" CommandParameter="stay" />
                </StackPanel>
            </StackPanel>

            <CheckBox IsVisible="{Binding IsEdit}" IsChecked="{Binding IsActive}"
                      Content="خدمت فعال است (در لیست‌های انتخاب نمایش داده شود)" />
        </StackPanel>

        <!-- foot -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    Margin="20,12,20,18">
            <Button Classes="outline sm-btn" Content="انصراف" Command="{Binding CancelCommand}" />
            <Button Classes="sm-btn" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSaving}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
                    </Style>
                </Button.Styles>
                <TextBlock Text="{Binding SubmitText}" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
