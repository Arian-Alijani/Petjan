<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ch="using:Animora.Desktop.Pages.Cheques"
             x:Class="Animora.Desktop.Pages.Cheques.ChequesCalendarView"
             x:Name="Root"
             x:DataType="ch:ChequesPageViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- small icon button (.ch-mini) -->
        <Style Selector="Button.ch-mini">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ch-mini:pointerover">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1" CornerRadius="{StaticResource Radius}" ClipToBounds="True">
        <Border.BoxShadow>
            <StaticResource ResourceKey="ShadowCard" />
        </Border.BoxShadow>
        <StackPanel>
            <!-- cal-top -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="18,14">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CalendarTitle}" FontSize="15" FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding CalendarMonthTotal}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Width="9" Height="9" CornerRadius="3" Background="#027a48" VerticalAlignment="Center" />
                        <TextBlock Text="دریافتی" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Width="9" Height="9" CornerRadius="3" Background="#e08a5c" VerticalAlignment="Center" />
                        <TextBlock Text="پرداختی" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="ch-mini" ToolTip.Tip="ماه قبل"
                            Command="{Binding ChangeMonthCommand}" CommandParameter="-1">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconChevronRight}" />
                    </Button>
                    <Button Classes="ch-mini" ToolTip.Tip="ماه جاری"
                            Command="{Binding ChangeMonthCommand}" CommandParameter="0">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconHome}" />
                    </Button>
                    <Button Classes="ch-mini" ToolTip.Tip="ماه بعد"
                            Command="{Binding ChangeMonthCommand}" CommandParameter="1">
                        <Path Classes="icon" Width="15" Height="15" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconChevronLeft}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- cal-grid: 7 dow headers -->
            <ItemsControl ItemsSource="{Binding CalendarDayHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Background="{StaticResource TableHeadBrush}" Padding="0,10"
                                BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- cal-grid: day cells -->
            <ItemsControl ItemsSource="{Binding CalendarCells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ch:ChequeCalendarCellViewModel">
                        <Border MinHeight="104" Padding="7" Background="{Binding Background}"
                                BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,1,1">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Width="24" Height="24" CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        Background="{Binding #Root.((ch:ChequesPageViewModel)DataContext).TodayBadgeBrush}"
                                        IsVisible="{Binding IsToday}">
                                    <TextBlock Text="{Binding DayText}" FontSize="12" FontWeight="ExtraBold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Row="0" Text="{Binding DayText}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource Ink2Brush}" IsVisible="{Binding !IsToday}" />
                                <TextBlock Grid.Row="0" Text="{Binding SumText}" FontSize="9.5" FontWeight="ExtraBold"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Top" IsVisible="{Binding HasSum}" />
                                <StackPanel Grid.Row="1" Spacing="5" Margin="0,5,0,0">
                                    <ItemsControl ItemsSource="{Binding VisibleEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="ch:ChequeCalendarEventViewModel">
                                                <Border CornerRadius="8" Padding="7,4" Background="{Binding Background}"
                                                        BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0"
                                                        Margin="0,0,0,5" ToolTip.Tip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding AmountText}" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{Binding Foreground}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MoreText}" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Brand600Brush}"
                                               IsVisible="{Binding HasMore}" Cursor="Hand" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
