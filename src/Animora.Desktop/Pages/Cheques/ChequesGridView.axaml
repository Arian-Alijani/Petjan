<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ch="using:Animora.Desktop.Pages.Cheques"
             x:Class="Animora.Desktop.Pages.Cheques.ChequesGridView"
             x:Name="Root"
             x:DataType="ch:ChequesPageViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- leaf card (.leaf) -->
        <Style Selector="Button.leaf">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.leaf /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
        </Style>
        <Style Selector="Button.leaf:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
        </Style>

        <!-- status pill (.st) -->
        <Style Selector="Border.st">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- countdown pill (.cd) -->
        <Style Selector="Border.cd">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <!-- pager button (.ch-pager .pages button) -->
        <Style Selector="Button.pg">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pg:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.pg.on">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.pg:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- empty state when nothing matches -->
        <Border IsVisible="{Binding !HasGridRows}" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}" ClipToBounds="True">
            <Border.BoxShadow>
                <StaticResource ResourceKey="ShadowCard" />
            </Border.BoxShadow>
            <StackPanel Margin="20,54">
                <Border Width="92" Height="92" CornerRadius="28" Background="{StaticResource Bg2Brush}"
                        HorizontalAlignment="Center">
                    <Path Classes="icon" Width="40" Height="40" Stroke="{StaticResource Muted2Brush}"
                          Data="{StaticResource IconCheque}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="چکی با این فیلترها پیدا نشد" FontSize="15" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="عبارت جستجو یا فیلترهای وضعیت را تغییر دهید." FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Classes="outline" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconRefresh}" VerticalAlignment="Center" />
                        <TextBlock Text="پاک کردن فیلترها" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- leaf grid (.ch-grid) -->
        <ItemsControl ItemsSource="{Binding GridLeaves}" IsVisible="{Binding HasGridRows}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="7" />
                </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ch:ChequeLeafViewModel">
                    <Button Classes="leaf"
                            Command="{Binding #Root.((ch:ChequesPageViewModel)DataContext).OpenDetailCommand}"
                            CommandParameter="{Binding Id}">
                        <StackPanel>
                            <!-- leaf top (gradient header) -->
                            <Panel>
                                <Border Background="{Binding HeaderBrush}" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="10"
                                                Background="#2EFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                            <TextBlock Text="{Binding BankMarkLabel}" FontSize="9.5" FontWeight="ExtraBold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding BankName}" FontSize="12.5" FontWeight="ExtraBold"
                                                       Foreground="White" />
                                            <TextBlock Text="{Binding Branch}" FontSize="10" Foreground="#CCFFFFFF" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#29FFFFFF" BorderBrush="#40FFFFFF"
                                                BorderThickness="1" CornerRadius="20" Padding="9,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DirectionLabel}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Panel>

                            <!-- leaf mid -->
                            <StackPanel Margin="14" Spacing="0" Background="{StaticResource PanelBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding AmountText}" FontSize="23" FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}" LetterSpacing="-0.6" />
                                    <TextBlock Text="تومان" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                                <TextBlock Text="{Binding WordsText}" FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,12,0,0">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding PartyKey}" FontSize="10"
                                                   Foreground="{StaticResource Muted2Brush}" />
                                        <TextBlock Text="{Binding Party}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Ink2Brush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="تاریخ سررسید" FontSize="10"
                                                   Foreground="{StaticResource Muted2Brush}" />
                                        <TextBlock Text="{Binding DueText}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Ink2Brush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- perforation line (.leaf-perf) -->
                            <Grid Height="12" Background="{StaticResource PanelBrush}" ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="15" Height="15" CornerRadius="50"
                                        Background="{StaticResource BgBrush}" BorderBrush="{StaticResource Line2Brush}"
                                        BorderThickness="1" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                        VerticalAlignment="Top" />
                                <Border Grid.Column="1" Height="1.5" VerticalAlignment="Top"
                                        Background="{StaticResource LineBrush}"
                                        Margin="4,0" />
                                <Border Grid.Column="2" Width="15" Height="15" CornerRadius="50"
                                        Background="{StaticResource BgBrush}" BorderBrush="{StaticResource Line2Brush}"
                                        BorderThickness="1" HorizontalAlignment="Right" Margin="0,0,-8,0"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <!-- leaf foot -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="14,10,14,13"
                                  Background="#fbfcfb">
                                <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" LetterSpacing="0.6"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="cd" Background="{Binding Countdown.Background}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Path Classes="icon" Width="10" Height="10"
                                              Stroke="{Binding Countdown.Foreground}"
                                              Data="{Binding Countdown.IconKey, Converter={StaticResource IconKeyConverter}}"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Countdown.Text}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{Binding Countdown.Foreground}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Classes="st" Background="{Binding Status.Background}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="12" Height="12"
                                              Stroke="{Binding Status.Foreground}"
                                              Data="{Binding Status.IconKey, Converter={StaticResource IconKeyConverter}}"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Status.Label}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding Status.Foreground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- pager card -->
        <Border Classes="ch-card" IsVisible="{Binding HasGridRows}" Margin="0,14,0,0"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
                BorderThickness="1" CornerRadius="{StaticResource Radius}">
            <Border.BoxShadow>
                <StaticResource ResourceKey="ShadowCard" />
            </Border.BoxShadow>
            <Grid ColumnDefinitions="Auto,*" Margin="16,12">
                <TextBlock Grid.Column="0" Text="{Binding Pager.Text}" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                            DataContext="{Binding Pager}">
                    <Button Classes="pg" IsEnabled="{Binding HasPrev}"
                            Command="{Binding #Root.((ch:ChequesPageViewModel)DataContext).GoToPageCommand}"
                            CommandParameter="{Binding PrevPage}">
                        <Path Classes="icon" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconChevronRight}" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ch:ChequePagerButtonViewModel">
                                <Button Classes="pg" Classes.on="{Binding IsActive}" IsEnabled="{Binding IsEnabled}"
                                        Content="{Binding Label}"
                                        Command="{Binding #Root.((ch:ChequesPageViewModel)DataContext).GoToPageCommand}"
                                        CommandParameter="{Binding Page}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="pg" IsEnabled="{Binding HasNext}"
                            Command="{Binding #Root.((ch:ChequesPageViewModel)DataContext).GoToPageCommand}"
                            CommandParameter="{Binding NextPage}">
                        <Path Classes="icon" Width="13" Height="13" Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconChevronLeft}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
