<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ch="using:Animora.Desktop.Pages.Cheques"
             x:Class="Animora.Desktop.Pages.Cheques.ChequesTimelineView"
             x:Name="Root"
             x:DataType="ch:ChequesPageViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- countdown pill (.cd) -->
        <Style Selector="Border.cd">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <!-- direction tag (.dir-tag) -->
        <Style Selector="Border.dir-tag">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <!-- timeline item (.tl-item) -->
        <Style Selector="Button.tl-item">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.tl-item:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <!-- empty state -->
    <Border IsVisible="{Binding !HasTimelineRows}" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
            CornerRadius="{StaticResource Radius}" ClipToBounds="True">
        <Border.BoxShadow>
            <StaticResource ResourceKey="ShadowCard" />
        </Border.BoxShadow>
        <StackPanel Margin="20,54">
            <Border Width="92" Height="92" CornerRadius="28" Background="{StaticResource Bg2Brush}"
                    HorizontalAlignment="Center">
                <Path Classes="icon" Width="40" Height="40" Stroke="{StaticResource Muted2Brush}"
                      Data="{StaticResource IconCheque}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="چکی با این فیلترها پیدا نشد" FontSize="15" FontWeight="ExtraBold"
                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="عبارت جستجو یا فیلترهای وضعیت را تغییر دهید." FontSize="12.5"
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
            <Button Classes="outline" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[Button].Foreground}"
                          Data="{StaticResource IconRefresh}" VerticalAlignment="Center" />
                    <TextBlock Text="پاک کردن فیلترها" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>

    <!-- timeline card (.ch-card > .tl) -->
    <Border IsVisible="{Binding HasTimelineRows}" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
            CornerRadius="{StaticResource Radius}" ClipToBounds="True">
        <Border.BoxShadow>
            <StaticResource ResourceKey="ShadowCard" />
        </Border.BoxShadow>
        <ItemsControl ItemsSource="{Binding TimelineGroups}" Margin="18,8,18,18">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ch:ChequeTimelineGroupViewModel">
                    <Grid ColumnDefinitions="22,*" Margin="0,16,0,0">
                        <!-- tl-dot -->
                        <Border Grid.Column="0" Width="12" Height="12" CornerRadius="50" Background="White"
                                BorderThickness="3" BorderBrush="{Binding DotBrush}" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="0,22,0,0" />
                        <StackPanel Grid.Column="1" Spacing="10">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource Bg2Brush}" CornerRadius="20"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding SumText}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ch:ChequeTimelineItemViewModel">
                                        <Button Classes="tl-item"
                                                Command="{Binding #Root.((ch:ChequesPageViewModel)DataContext).OpenDetailCommand}"
                                                CommandParameter="{Binding Id}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="11">
                                                <Border Grid.Column="0" Width="{Binding BankMark.Size}"
                                                        Height="{Binding BankMark.Size}"
                                                        CornerRadius="{Binding BankMark.CornerRadius}"
                                                        Background="{Binding BankMark.Brush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BankMark.ShortLabel}" FontSize="9"
                                                               FontWeight="ExtraBold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding Party}" FontSize="12.5" FontWeight="Bold"
                                                               Foreground="{StaticResource InkBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SubText}" FontSize="10.5"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="dir-tag"
                                                        Background="{Binding DirectionTagBackground}"
                                                        VerticalAlignment="Center" Margin="8,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Classes="icon" Width="11" Height="11"
                                                              Stroke="{Binding DirectionTagForeground}"
                                                              Data="{Binding DirectionIcon, Converter={StaticResource IconKeyConverter}}"
                                                              VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DirectionLabel}" FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding DirectionTagForeground}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding AmountText}" FontSize="13" FontWeight="ExtraBold"
                                                               Foreground="{Binding AmountForeground}" />
                                                    <TextBlock Text="ت" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                </StackPanel>
                                                <Border Grid.Column="4" Classes="cd" Margin="8,0,0,0"
                                                        Background="{Binding Countdown.Background}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Path Classes="icon" Width="10" Height="10"
                                                              Stroke="{Binding Countdown.Foreground}"
                                                              Data="{Binding Countdown.IconKey, Converter={StaticResource IconKeyConverter}}"
                                                              VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Countdown.Text}" FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding Countdown.Foreground}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
    </Panel>
</UserControl>
