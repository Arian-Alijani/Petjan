<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Animora.Desktop.Pages.Statistics"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Statistics.StatisticsPageView"
             x:Name="Root"
             x:DataType="st:StatisticsPageViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <!-- Segmented section tabs: bg-2 track, white active pill (same look as the cashier tabs). -->
        <Style Selector="Border.st-tabs">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.st-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.st-tab:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.st-tab.on">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <!-- Range picker chips (today / 7d / 30d / 90d / ytd / custom). -->
        <Style Selector="Button.st-chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Button.st-chip:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.st-chip.on">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
        </Style>
        <Style Selector="Button.st-tab.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowChip}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="26,22,26,40" Spacing="18">
        <!-- ═══ Page header ═══ -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="4">
                <TextBlock Text="آمار" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" LetterSpacing="-0.4" />
                <TextBlock Text="تحلیل درآمد، مراجعین و هزینه‌های کلینیک در بازهٔ انتخابی"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="st-tabs" VerticalAlignment="Bottom">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="st:StatisticsTabViewModel">
                            <Button Classes="st-tab" Classes.on="{Binding IsActive}" Content="{Binding Label}"
                                    Command="{Binding #Root.((st:StatisticsPageViewModel)DataContext).ShowSectionCommand}"
                                    CommandParameter="{Binding Section}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- ═══ Range picker: drives every section ═══ -->
        <StackPanel Spacing="8">
            <ItemsControl ItemsSource="{Binding RangeChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="st:StatisticsRangeChipViewModel">
                        <Button Classes="st-chip" Classes.on="{Binding IsActive}" Content="{Binding Label}"
                                Margin="0,0,6,6"
                                Command="{Binding #Root.((st:StatisticsPageViewModel)DataContext).SelectRangeCommand}"
                                CommandParameter="{Binding Id}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomRange}">
                <TextBlock Text="از" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <controls:JalaliDatePicker Width="160" DateValue="{Binding CustomFromDate, Mode=TwoWay}" ToolTip.Tip="از تاریخ" />
                <TextBlock Text="تا" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <controls:JalaliDatePicker Width="160" DateValue="{Binding CustomToDate, Mode=TwoWay}" ToolTip.Tip="تا تاریخ" />
                <TextBlock Text="{Binding CustomRangeHint}" VerticalAlignment="Center"
                           Foreground="{StaticResource DangerBrush}" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <!-- ═══ Current section (resolved to its view by the shell's ViewLocator) ═══ -->
        <ContentControl Content="{Binding CurrentSection}" />
    </StackPanel>
</UserControl>
