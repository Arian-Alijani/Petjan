<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Animora.Desktop.Pages.Statistics"
             x:Class="Animora.Desktop.Pages.Statistics.StatisticsRecurringModalView"
             x:Name="Root"
             x:DataType="st:StatisticsRecurringModalViewModel"
             x:CompileBindings="True"
             Width="560" MaxWidth="560" FlowDirection="RightToLeft">
    <UserControl.Styles>
        <StyleInclude Source="avares://Animora.Desktop/Pages/Statistics/StatisticsModalStyles.axaml" />
    </UserControl.Styles>
    <StackPanel>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="22,20,22,8">
            <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource Bg2Brush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource MutedBrush}"
                      Data="{StaticResource IconReceipt}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding HeadTitle}" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding HeadSubtitle}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
        <StackPanel Margin="22,4,22,12" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="دسته‌بندی" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="st:StatisticsChoice">
                            <Button Classes="hy-chip" Classes.on="{Binding IsSelected}" Content="{Binding Label}" Margin="0,0,6,6"
                                    Command="{Binding #Root.((st:StatisticsRecurringModalViewModel)DataContext).SelectCategoryCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="عنوان" />
                <TextBox Classes="sm-inp" Text="{Binding Title}" FontWeight="Bold" PlaceholderText="مثلاً: اجارهٔ کلینیک" MaxLength="120" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sm-lbl" Text="مبلغ ماهانه (تومان)" />
                    <TextBox Classes="sm-inp" Text="{Binding AmountText}" PlaceholderText="۱۵۰۰۰۰۰۰" TextAlignment="Right" />
                    <TextBlock Text="{Binding AmountPreview}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Brand700Brush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Classes="sm-lbl" Text="روز سررسید در ماه شمسی (۱ تا ۳۱)" />
                    <TextBox Classes="sm-inp" Text="{Binding DayText}" PlaceholderText="۱" TextAlignment="Right" />
                </StackPanel>
            </Grid>
            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="یادداشت (اختیاری)" />
                <TextBox Classes="sm-inp" Text="{Binding Note}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap"
                         PlaceholderText="توضیحات…" MaxLength="400" />
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="20,12,20,18">
            <Button Classes="outline sm-btn" Content="انصراف" Command="{Binding CancelCommand}" />
            <Button Classes="sm-btn sm-primary" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSaving}">
                <TextBlock Text="{Binding SubmitText}" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
