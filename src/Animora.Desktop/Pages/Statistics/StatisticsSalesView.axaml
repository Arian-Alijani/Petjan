<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Animora.Desktop.Pages.Statistics"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Statistics.StatisticsSalesView"
             x:DataType="st:StatisticsSalesViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">
    <StackPanel Spacing="18">
        <st:StatisticsSectionStateView DataContext="{Binding}" />

        <StackPanel Spacing="18" IsVisible="{Binding HasData}">
            <!-- Revenue per bucket -->
            <Border Classes="card">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="18,14,18,12">
                        <TextBlock Classes="card-title" Text="فروش در بازه" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SalesSummary}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="card-header-rule" />
                    <Panel Margin="12,12,12,14" MinHeight="240">
                        <controls:BarChart Height="240" Points="{Binding SalesTrend}" IsVisible="{Binding HasSales}" />
                        <TextBlock Text="فروشی در این بازه ثبت نشده است." HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsVisible="{Binding !HasSales}"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Panel>
                </StackPanel>
            </Border>

            <controls:AdaptiveGrid MinItemWidth="340" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                <!-- Source comparison -->
                <Border Classes="card">
                    <StackPanel>
                        <StackPanel Classes="card-header">
                            <TextBlock Classes="card-title" Text="مقایسهٔ منابع درآمد" />
                        </StackPanel>
                        <Border Classes="card-header-rule" />
                        <TextBlock Text="درآمدی در این بازه ثبت نشده است." Margin="18"
                                   Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasSources}" />
                        <ItemsControl Margin="18,14,18,18" ItemsSource="{Binding SourceBars}" IsVisible="{Binding HasSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="st:StatisticsSourceBarRow">
                                    <StackPanel Spacing="6" Margin="0,6">
                                        <Grid ColumnDefinitions="*,Auto,44" ColumnSpacing="9">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12"
                                                       Foreground="{StaticResource Ink2Brush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Share}" FontSize="12" FontWeight="Bold"
                                                       TextAlignment="End" Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                        <controls:MetricBar Height="9" Fraction="{Binding Fraction}" Fill="{Binding Color}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Paid vs unpaid invoices -->
                <Border Classes="card">
                    <StackPanel>
                        <StackPanel Classes="card-header">
                            <TextBlock Classes="card-title" Text="فاکتورهای تسویه‌شده و باز" />
                        </StackPanel>
                        <Border Classes="card-header-rule" />
                        <TextBlock Text="فاکتوری در این بازه ثبت نشده است." Margin="18"
                                   Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasInvoices}" />
                        <StackPanel Margin="18,16,18,18" Spacing="14" IsVisible="{Binding HasInvoices}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding InvoiceTotal}" FontSize="26" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="فاکتور در بازه" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <controls:SegmentedBar Height="14" Segments="{Binding PaidSegments}" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#4a6cf7" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Ink2Brush}">
                                        <Run Text="تسویه‌شده:" /> <Run Text="{Binding PaidInvoices}" FontWeight="Bold" />
                                        <Run Text="{Binding PaidShare}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="9" Height="9" Fill="#f79009" VerticalAlignment="Center" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Ink2Brush}">
                                        <Run Text="باز / پرداخت‌نشده:" /> <Run Text="{Binding UnpaidInvoices}" FontWeight="Bold" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </controls:AdaptiveGrid>

            <!-- Best-selling products (server-capped, built in one batch) -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="پرفروش‌ترین کالاها" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />
                    <TextBlock Text="فروش کالایی در این بازه ثبت نشده است." Margin="18"
                               Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasProducts}" />
                    <StackPanel Margin="14,8,14,14" IsVisible="{Binding HasProducts}">
                        <Grid ColumnDefinitions="30,*,90,150,70" ColumnSpacing="12" Margin="12,4,12,6">
                            <TextBlock Grid.Column="1" Text="کالا" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="2" Text="تعداد" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="3" Text="درآمد" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="4" Text="حاشیه سود" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="st:StatisticsProductRow">
                                    <Panel Margin="0,3">
                                        <controls:MetricBar Height="40" Fraction="{Binding Fraction}"
                                                            Fill="{StaticResource Brand600Brush}" TrackBrush="Transparent"
                                                            Radius="10" Opacity="0.10" IsHitTestVisible="False" />
                                        <Grid ColumnDefinitions="30,*,90,150,70" ColumnSpacing="12" Margin="12,0" Height="40">
                                            <TextBlock Text="{Binding Rank}" FontWeight="ExtraBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brand700Brush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Ink2Brush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Revenue}" FontWeight="ExtraBold"
                                                       VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Margin}" FontSize="12"
                                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
