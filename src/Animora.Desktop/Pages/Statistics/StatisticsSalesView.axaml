<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Animora.Desktop.Pages.Statistics"
             x:Class="Animora.Desktop.Pages.Statistics.StatisticsSalesView"
             x:DataType="st:StatisticsSalesViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">
    <StackPanel Spacing="18">
        <st:StatisticsSectionStateView DataContext="{Binding}" />
    </StackPanel>
</UserControl>
