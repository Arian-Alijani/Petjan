<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Animora.Desktop.Pages.Statistics"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Statistics.StatisticsExpensesView"
             x:Name="Root"
             x:DataType="st:StatisticsExpensesViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <StyleInclude Source="avares://Animora.Desktop/Pages/Statistics/StatisticsModalStyles.axaml" />
    </UserControl.Styles>
    <StackPanel Spacing="18">
        <st:StatisticsSectionStateView DataContext="{Binding}" />

        <StackPanel Spacing="18" IsVisible="{Binding HasData}">
            <!-- Header: total + comparison + add button -->
            <Border Classes="card" Padding="20,16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="مجموع هزینه‌های بازه" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Total}" FontSize="26" FontWeight="ExtraBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <Border CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                                    Background="{StaticResource Bg2Brush}">
                                <TextBlock Text="{Binding Delta}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource Ink2Brush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                            <Run Text="بازهٔ قبل:" /> <Run Text="{Binding PreviousTotal}" />
                            <Run Text=" · " /> <Run Text="{Binding CountText}" /> <Run Text="هزینه" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="sm-btn sm-primary" VerticalAlignment="Center"
                            Command="{Binding AddExpenseCommand}" IsVisible="{Binding CanPost}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="14" Height="14" Stroke="White" Data="{StaticResource IconPlus}" />
                            <TextBlock Text="ثبت هزینه" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <controls:AdaptiveGrid MinItemWidth="340" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                <!-- Category breakdown -->
                <Border Classes="card">
                    <StackPanel>
                        <StackPanel Classes="card-header">
                            <TextBlock Classes="card-title" Text="هزینه به تفکیک دسته" />
                        </StackPanel>
                        <Border Classes="card-header-rule" />
                        <StackPanel Margin="18,14,18,18" Spacing="14">
                            <Grid Width="180" Height="180" HorizontalAlignment="Center" IsVisible="{Binding HasCategories}">
                                <controls:DonutRing Slices="{Binding CategorySlices}"
                                                    TrackBrush="{StaticResource ChartTrackBrush}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="{Binding Total}" FontSize="12.5" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="کل هزینه" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="هزینه‌ای در این بازه ثبت نشده است." HorizontalAlignment="Center" Margin="0,40"
                                       IsVisible="{Binding !HasCategories}" Foreground="{StaticResource MutedBrush}" />
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="st:StatisticsCategoryRow">
                                        <Panel Margin="0,3">
                                            <controls:MetricBar Height="32" Fraction="{Binding Fraction}" Fill="{Binding Color}"
                                                                TrackBrush="Transparent" Radius="10" Opacity="0.16"
                                                                IsHitTestVisible="False" />
                                            <Grid ColumnDefinitions="9,*,Auto,44,56" ColumnSpacing="9" Margin="10,0" Height="32">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Ink2Brush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Share}" FontSize="12" FontWeight="Bold"
                                                           VerticalAlignment="Center" TextAlignment="End"
                                                           Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Delta}" FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center" TextAlignment="End"
                                                           Foreground="{StaticResource Ink2Brush}"
                                                           ToolTip.Tip="نسبت به بازهٔ قبل" />
                                            </Grid>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fixed (recurring) expenses -->
                <Border Classes="card">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="18,12,18,12">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="card-title" Text="هزینه‌های ثابت" />
                                <TextBlock Text="{Binding RecurringSummary}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarnBrush}" IsVisible="{Binding HasRecurringAttention}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="outline st-act" Command="{Binding AddRecurringCommand}"
                                    IsVisible="{Binding CanPost}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Classes="icon" Width="12" Height="12" Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="افزودن" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Classes="card-header-rule" />
                        <StackPanel Margin="18" Spacing="4" IsVisible="{Binding !HasRecurring}">
                            <TextBlock Text="هنوز هزینهٔ ثابتی تعریف نشده است." Foreground="{StaticResource Ink2Brush}"
                                       FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Text="اجاره، حقوق یا هر هزینهٔ ماهانهٔ دیگر را تعریف کنید تا در سررسید یادآوری شود و با یک کلیک ثبت گردد." />
                        </StackPanel>
                        <ItemsControl Margin="12,8,12,12" ItemsSource="{Binding Recurring}" IsVisible="{Binding HasRecurring}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="st:StatisticsRecurringRowViewModel">
                                    <Border Padding="10,10" Margin="0,2" CornerRadius="12" BorderThickness="1"
                                            BorderBrush="{StaticResource LineBrush}" Opacity="{Binding RowOpacity}">
                                        <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="12">
                                            <Border Width="4" CornerRadius="2" Background="{Binding CategoryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                    <Border CornerRadius="9" Padding="8,2" Background="{Binding StatusBackground}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{Binding StatusForeground}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}">
                                                    <Run Text="{Binding CategoryName}" /> <Run Text=" · " /> <Run Text="{Binding DueText}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Amount}" FontWeight="ExtraBold" FontSize="13"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center"
                                                        IsVisible="{Binding #Root.((st:StatisticsExpensesViewModel)DataContext).CanPost}">
                                                <Button Classes="sm-primary st-act" Content="پرداخت" IsVisible="{Binding CanPay}"
                                                        Command="{Binding #Root.((st:StatisticsExpensesViewModel)DataContext).PayRecurringCommand}"
                                                        CommandParameter="{Binding}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                    <Button Classes="ghost st-act" Content="ویرایش"
                                                            Command="{Binding #Root.((st:StatisticsExpensesViewModel)DataContext).EditRecurringCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="ghost st-act" Content="{Binding ToggleText}"
                                                            Command="{Binding #Root.((st:StatisticsExpensesViewModel)DataContext).ToggleRecurringCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </controls:AdaptiveGrid>

            <!-- Expense trend -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="روند هزینه‌ها" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />
                    <Panel Margin="12,12,12,14" MinHeight="200">
                        <controls:BarChart Height="200" Points="{Binding Trend}" IsVisible="{Binding HasTrend}"
                                           BarBrush="{StaticResource DangerBrush}" />
                        <TextBlock Text="هزینه‌ای در این بازه ثبت نشده است." HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsVisible="{Binding !HasTrend}"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Panel>
                </StackPanel>
            </Border>

            <!-- Ledger (paged) -->
            <Border Classes="card">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="18,14,18,12">
                        <TextBlock Classes="card-title" Text="دفتر هزینه‌ها" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ListSummary}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="card-header-rule" />
                    <ItemsControl Margin="14,10,14,0" ItemsSource="{Binding CategoryFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="st:StatisticsChoice">
                                <Button Classes="hy-chip" Classes.on="{Binding IsSelected}" Content="{Binding Label}" Margin="0,0,6,6"
                                        Command="{Binding #Root.((st:StatisticsExpensesViewModel)DataContext).SelectCategoryCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsListLoading}" Height="3" Margin="14,4" />
                    <TextBlock Text="هزینه‌ای با این فیلتر در بازه ثبت نشده است." Margin="18" Foreground="{StaticResource MutedBrush}"
                               IsVisible="{Binding !HasRows}" />
                    <ItemsControl Margin="14,4,14,8" ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="st:StatisticsExpenseRowViewModel">
                                <Border Padding="10,10" Margin="0,2" CornerRadius="12" BorderThickness="1"
                                        BorderBrush="{StaticResource LineBrush}">
                                    <Grid ColumnDefinitions="4,*,Auto,Auto" ColumnSpacing="12">
                                        <Border Width="4" CornerRadius="2" Background="{Binding CategoryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border CornerRadius="9" Padding="8,2" Background="{StaticResource DangerBgBrush}"
                                                        IsVisible="{Binding HasBadge}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource DangerBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding CategoryName}" /> <Run Text=" · " /> <Run Text="{Binding DateText}" />
                                                <Run Text=" · " /> <Run Text="{Binding Subtitle}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Amount}" FontWeight="ExtraBold" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="ghost st-act" Content="برگشت" VerticalAlignment="Center"
                                                IsVisible="{Binding CanReverse}"
                                                Command="{Binding #Root.((st:StatisticsExpensesViewModel)DataContext).ReverseExpenseCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="outline sm-btn" Content="نمایش موارد بیشتر" HorizontalAlignment="Center" Margin="0,4,0,16"
                            IsVisible="{Binding HasMore}" IsEnabled="{Binding !IsListLoading}"
                            Command="{Binding LoadMoreCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
