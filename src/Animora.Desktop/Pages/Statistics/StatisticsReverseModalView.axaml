<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="using:Animora.Desktop.Pages.Statistics"
             x:Class="Animora.Desktop.Pages.Statistics.StatisticsReverseModalView"
             x:DataType="st:StatisticsReverseModalViewModel"
             x:CompileBindings="True"
             Width="520" MaxWidth="520" FlowDirection="RightToLeft">
    <UserControl.Styles>
        <StyleInclude Source="avares://Animora.Desktop/Pages/Statistics/StatisticsModalStyles.axaml" />
    </UserControl.Styles>
    <StackPanel>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="22,20,22,8">
            <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource DangerBgBrush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource DangerBrush}"
                      Data="{StaticResource IconWallet}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="ExtraBold" TextWrapping="Wrap"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
        <StackPanel Margin="22,4,22,12" Spacing="12">
            <Border Classes="card" Padding="12,10" Background="{StaticResource WarnBgBrush}">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnBrush}"
                           Text="هزینهٔ ثبت‌شده ویرایش نمی‌شود؛ یک هزینهٔ برگشتی هم‌مبلغ ثبت می‌شود که دفتر حسابداری و آمار را اصلاح می‌کند و هزینهٔ اصلی با برچسب «برگشت‌خورده» باقی می‌ماند." />
            </Border>
            <StackPanel Spacing="6">
                <TextBlock Classes="sm-lbl" Text="دلیل برگشت" />
                <TextBox Classes="sm-inp" Text="{Binding Reason}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                         PlaceholderText="مثلاً: مبلغ اشتباه ثبت شده بود" MaxLength="400" />
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="20,12,20,18">
            <Button Classes="outline sm-btn" Content="انصراف" Command="{Binding CancelCommand}" />
            <Button Classes="sm-btn sm-primary" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSaving}">
                <TextBlock Text="ثبت برگشت" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
