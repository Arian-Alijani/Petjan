<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fm="using:Animora.Desktop.Pages.Finance"
             xmlns:ui="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Finance.FinanceExpenseTabView"
             x:Name="Root"
             x:DataType="fm:FinancePageViewModel"
             FlowDirection="RightToLeft">

    <!-- Expense tab panel — re-draws finance-page.js panelExpense
         (keyHighlight + fin-mini-strip + fin-grid-2[mainChartCard, categoriesCard]
         + expenseTableCard). Shared card/list styles live in FinanceStyles.axaml
         (included by the parent FinancePageView and inherited here). -->
    <UserControl.Styles>
        <!-- Expense ledger table (.tbl.fin-tbl + .fin-tbl-cat). -->
        <Style Selector="TextBlock.th">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="16,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.td">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Margin" Value="16,14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.td.strong">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Border.swatch-sm">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- ═══ keyHighlight ═══ -->
        <ContentControl Content="{Binding Highlight}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="fm:FinanceHighlightViewModel">
                    <Border Classes="hl" Margin="0,0,0,16">
                        <Panel>
                            <Border Classes="hl-rail" Background="{Binding RailBrush}" HorizontalAlignment="Right" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" Classes="hl-ic" Background="{Binding IconBackground}">
                                    <Path Classes="icon" Width="20" Height="20" Stroke="{Binding IconForeground}"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="hl-label" Text="{Binding Label}" />
                                    <ui:RichLine Spans="{Binding Spans}" />
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ═══ Mini stat strip ═══ -->
        <ItemsControl ItemsSource="{Binding MiniStats}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="7" />
                </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="fm:FinanceMiniStatViewModel">
                    <Border Classes="mini-card">
                        <Panel>
                            <Border Classes="mini-rail" Background="{Binding RailBrush}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="mini-ic" Background="{Binding IconBackground}">
                                    <Path Classes="icon" Width="19" Height="19" Stroke="{Binding IconForeground}"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="mini-label" Text="{Binding Label}" />
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                                        <TextBlock Classes="mini-value" Text="{Binding Value}" />
                                        <TextBlock Classes="mini-unit" Text="{Binding Unit}" IsVisible="{Binding HasUnit}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Classes="mini-delta" IsVisible="{Binding HasDelta}"
                                        Background="{Binding DeltaBackground}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Path Classes="icon" Width="11" Height="11" Stroke="{Binding DeltaForeground}"
                                              Data="{Binding DeltaIconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Text="{Binding DeltaText}" FontSize="10.5" FontWeight="ExtraBold"
                                                   Foreground="{Binding DeltaForeground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══ Trend chart + category breakdown (.fin-grid-2: 1.55fr 1fr) ═══ -->
        <Grid ColumnDefinitions="1.55*,*" ColumnSpacing="16" Margin="0,16,0,0">
            <Border Grid.Column="0" Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="{Binding ChartEyebrow}" />
                                <TextBlock Text="{Binding ChartHeading}" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="#0d9488" />
                                    <TextBlock Classes="legend-text" Text="درآمد" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="#d92d20" />
                                    <TextBlock Classes="legend-text" Text="هزینه" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="#1570cd" />
                                    <TextBlock Classes="legend-text" Text="سود خالص" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ui:TrendChart Height="250" Margin="14,16,14,14" Points="{Binding TrendPoints}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="تفکیک مخارج" />
                                <TextBlock Text="دسته‌بندی هزینه‌ها" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                          Data="{StaticResource IconReceipt}" />
                                    <TextBlock Classes="fin-chip-text" Text="{Binding CategoriesChipText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding CategoryRows}" Margin="20,8,20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fm:FinanceCategoryRowViewModel">
                                <Border Classes="list-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <Border Grid.Column="0" Classes="list-ic" Background="{Binding IconBackground}">
                                                <Path Classes="icon" Width="16" Height="16" Stroke="{Binding IconForeground}"
                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="list-name" Text="{Binding Label}" />
                                                <ui:MetricBar Height="8" Width="130" HorizontalAlignment="Right"
                                                              Margin="0,7,0,0" Fraction="{Binding Fraction}"
                                                              Fill="{Binding TrackFill}" Radius="20" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="list-amt" Text="{Binding Value}"
                                                       Foreground="{Binding AmountBrush}" HorizontalAlignment="Right" />
                                            <Border Classes="list-chip" Background="{Binding ChipBackground}"
                                                    HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Path Classes="icon" Width="11" Height="11" Stroke="{Binding ChipForeground}"
                                                          Data="{Binding ChipIconKey, Converter={StaticResource IconKeyConverter}}" />
                                                    <TextBlock Text="{Binding DeltaText}" FontSize="11" FontWeight="ExtraBold"
                                                               Foreground="{Binding ChipForeground}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Expense ledger table (expenseTableCard) ═══ -->
        <Border Classes="card" Margin="0,16,0,0">
            <StackPanel>
                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="fin-eyebrow" Text="دفتر مخارج" />
                            <TextBlock Text="آخرین هزینه‌ها" FontSize="15" FontWeight="ExtraBold"
                                       Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center"
                                Command="{Binding AddExpenseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                      Data="{StaticResource IconPlus}" />
                                <TextBlock Text="ثبت هزینه" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- thead (6 columns: شرح / دسته / تاریخ / روش پرداخت / مبلغ / ثبت‌کننده) -->
                <Grid ColumnDefinitions="2*,1.4*,1.1*,1.4*,1.4*,1.3*"
                      Background="{StaticResource TableHeadBrush}">
                    <TextBlock Grid.Column="0" Classes="th" Text="شرح" />
                    <TextBlock Grid.Column="1" Classes="th" Text="دسته" />
                    <TextBlock Grid.Column="2" Classes="th" Text="تاریخ" />
                    <TextBlock Grid.Column="3" Classes="th" Text="روش پرداخت" />
                    <TextBlock Grid.Column="4" Classes="th" Text="مبلغ" />
                    <TextBlock Grid.Column="5" Classes="th" Text="ثبت‌کننده" />
                </Grid>

                <ItemsControl ItemsSource="{Binding ExpenseRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fm:FinanceExpenseRowViewModel">
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1"
                                    Classes.new-row="{Binding IsNew}">
                                <Grid ColumnDefinitions="2*,1.4*,1.1*,1.4*,1.4*,1.3*">
                                    <TextBlock Grid.Column="0" Classes="td strong" Text="{Binding Description}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,14">
                                        <Border Classes="swatch-sm" Background="{Binding Swatch}" />
                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="13"
                                                   Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="td" Text="{Binding Date}" />
                                    <TextBlock Grid.Column="3" Classes="td" Text="{Binding MethodLabel}" />
                                    <TextBlock Grid.Column="4" Classes="td strong" Text="{Binding AmountText}"
                                               Foreground="{Binding AmountBrush}" />
                                    <TextBlock Grid.Column="5" Classes="td" Text="{Binding By}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
