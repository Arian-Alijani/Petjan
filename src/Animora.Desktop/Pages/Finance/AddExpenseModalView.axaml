<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fm="using:Animora.Desktop.Pages.Finance"
             x:Class="Animora.Desktop.Pages.Finance.AddExpenseModalView"
             x:Name="Root"
             x:DataType="fm:AddExpenseModalViewModel"
             Width="520"
             MaxWidth="520"
             FlowDirection="RightToLeft">

    <!-- «ثبت هزینه جدید» modal — re-draws finance-page.js openExpenseModal
         (#fin-modal .modal) with the field/'grid-2'/'fin-quick' markup.
         Values from styles.css (.modal-header/.modal-body/.modal-footer/.field/
         .input/.selectbox/.grid-2) + finance.css (.fin-quick). -->
    <UserControl.Styles>
        <Style Selector="TextBlock.fx-lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox.fx-inp">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.fx-select">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.fx-quick">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.fx-quick:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.fx-quick.on">
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.fx-foot">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- head (.modal-header) -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="22,18,22,6">
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                    Background="{StaticResource Brand50Brush}">
                <Path Classes="icon" Width="18" Height="18" Stroke="{StaticResource Brand700Brush}"
                      Data="{StaticResource IconReceipt}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="مدیریت هزینه‌ها" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Brand600Brush}" />
                <TextBlock Text="ثبت هزینه جدید" FontSize="18" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon-btn" Width="34" Height="34"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding CancelCommand}" ToolTip.Tip="بستن">
                <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource MutedBrush}"
                      Data="{StaticResource IconX}" />
            </Button>
        </Grid>

        <!-- body (.modal-body) -->
        <StackPanel Margin="22,8,22,8">
            <StackPanel Classes="field" Margin="0,0,0,12">
                <TextBlock Classes="fx-lbl" Text="شرح هزینه" />
                <TextBox Classes="fx-inp" Text="{Binding Description}"
                         PlaceholderText="مثلاً خرید سرم و لوازم مصرفی" />
            </StackPanel>

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12" Margin="0,0,0,12">
                <StackPanel Grid.Column="0">
                    <TextBlock Classes="fx-lbl" Text="دسته‌بندی" />
                    <ComboBox Classes="fx-select" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Classes="fx-lbl" Text="روش پرداخت" />
                    <ComboBox Classes="fx-select" ItemsSource="{Binding Methods}"
                              SelectedItem="{Binding SelectedMethod}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Classes="fx-lbl" Text="مبلغ (تومان)" />
                <TextBox Classes="fx-inp" Text="{Binding AmountText}" PlaceholderText="۰"
                         TextAlignment="Right" />
                <ItemsControl ItemsSource="{Binding Quick}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fm:FinanceQuickAmountViewModel">
                            <Button Classes="fx-quick" Classes.on="{Binding IsActive}" Margin="0,0,8,0"
                                    Command="{Binding $parent[ItemsControl].DataContext.PickQuickCommand}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="fx-lbl" Text="تاریخ" />
                <TextBox Classes="fx-inp" Text="{Binding Date}" TextAlignment="Right" />
            </StackPanel>
        </StackPanel>

        <!-- foot (.modal-footer) -->
        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                Padding="22,14,22,20">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="ghost fx-foot" Content="انصراف" Command="{Binding CancelCommand}" />
                <Button Classes="primary fx-foot" Command="{Binding SubmitCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Width="14" Height="14" Stroke="White"
                              Data="{StaticResource IconCheck}" />
                        <TextBlock Text="ثبت هزینه" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
