<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fm="using:Animora.Desktop.Pages.Finance"
             xmlns:ui="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Finance.FinanceProfitTabView"
             x:Name="Root"
             x:DataType="fm:FinancePageViewModel"
             FlowDirection="RightToLeft">

    <!-- Profit tab panel — re-draws finance-page.js panelProfit
         (keyHighlight + fin-mini-strip + fin-grid-2[mainChartCard, profitGaugeCard]
         + fin-grid-2.even[marginLeadersCard, categoriesCard] + insightsRow). -->
    <StackPanel>
        <!-- ═══ keyHighlight ═══ -->
        <ContentControl Content="{Binding Highlight}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="fm:FinanceHighlightViewModel">
                    <Border Classes="hl" Margin="0,0,0,16">
                        <Panel>
                            <Border Classes="hl-rail" Background="{Binding RailBrush}" HorizontalAlignment="Right" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" Classes="hl-ic" Background="{Binding IconBackground}">
                                    <Path Classes="icon" Width="20" Height="20" Stroke="{Binding IconForeground}"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="hl-label" Text="{Binding Label}" />
                                    <ui:RichLine Spans="{Binding Spans}" />
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ═══ Mini stat strip ═══ -->
        <ItemsControl ItemsSource="{Binding MiniStats}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="7" />
                </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="fm:FinanceMiniStatViewModel">
                    <Border Classes="mini-card">
                        <Panel>
                            <Border Classes="mini-rail" Background="{Binding RailBrush}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Classes="mini-ic" Background="{Binding IconBackground}">
                                    <Path Classes="icon" Width="19" Height="19" Stroke="{Binding IconForeground}"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Classes="mini-label" Text="{Binding Label}" />
                                    <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                                        <TextBlock Classes="mini-value" Text="{Binding Value}" />
                                        <TextBlock Classes="mini-unit" Text="{Binding Unit}" IsVisible="{Binding HasUnit}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Classes="mini-delta" IsVisible="{Binding HasDelta}"
                                        Background="{Binding DeltaBackground}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Path Classes="icon" Width="11" Height="11" Stroke="{Binding DeltaForeground}"
                                              Data="{Binding DeltaIconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Text="{Binding DeltaText}" FontSize="10.5" FontWeight="ExtraBold"
                                                   Foreground="{Binding DeltaForeground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══ Trend chart + margin gauge (.fin-grid-2: 1.55fr 1fr) ═══ -->
        <Grid ColumnDefinitions="1.55*,*" ColumnSpacing="16" Margin="0,16,0,0">
            <Border Grid.Column="0" Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="{Binding ChartEyebrow}" />
                                <TextBlock Text="{Binding ChartHeading}" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="#0d9488" />
                                    <TextBlock Classes="legend-text" Text="درآمد" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="#d92d20" />
                                    <TextBlock Classes="legend-text" Text="هزینه" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="#1570cd" />
                                    <TextBlock Classes="legend-text" Text="سود خالص" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ui:TrendChart Height="250" Margin="14,16,14,14" Points="{Binding TrendPoints}" />
                </StackPanel>
            </Border>

            <!-- profitGaugeCard -->
            <Border Grid.Column="1" Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="سلامت سودآوری" />
                                <TextBlock Text="حاشیه سود" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center"
                                    Background="{Binding MarginChipBrush}" IsVisible="{Binding HasMarginChip}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Classes="icon" Width="13" Height="13" Stroke="{Binding MarginChipForeground}"
                                          Data="{Binding MarginChipIcon, Converter={StaticResource IconKeyConverter}}" />
                                    <TextBlock Classes="fin-chip-text" Text="{Binding MarginChipText}"
                                               Foreground="{Binding MarginChipForeground}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- gauge wrap (.fin-gauge-wrap) -->
                    <Grid Margin="20,20,20,6" Height="140" HorizontalAlignment="Center" Width="220">
                        <ui:MarginGauge Percent="{Binding MarginPercent}" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Width="220" Height="132" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,26,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding MarginValueText}" FontSize="30" FontWeight="ExtraBold"
                                           Foreground="#1570cd" LetterSpacing="-0.5" VerticalAlignment="Center" />
                                <TextBlock Text="٪" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Bottom"
                                           Margin="0,0,0,3" />
                            </StackPanel>
                            <TextBlock Text="سهم سود از درآمد" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- gauge legend (.fin-gauge-legend 3-col) -->
                    <ItemsControl ItemsSource="{Binding GaugeLegend}" Margin="20,8,20,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="5" />
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fm:FinanceGaugeLegendViewModel">
                                <Border Classes="gauge-legend-cell">
                                    <StackPanel>
                                        <TextBlock Classes="gauge-legend-k" Text="{Binding Label}" />
                                        <TextBlock Classes="gauge-legend-b" Text="{Binding Value}"
                                                   Foreground="{Binding ValueBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Margin leaders + categories (.fin-grid-2.even) ═══ -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,16,0,0">
            <Border Grid.Column="0" Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="سودآورترین‌ها" />
                                <TextBlock Text="رتبه‌بندی بر اساس حاشیه سود" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                          Data="{StaticResource IconPiggy}" />
                                    <TextBlock Classes="fin-chip-text" Text="{Binding MarginLeadersChipText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding MarginLeaders}" Margin="20,8,20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fm:FinanceMarginLeaderViewModel">
                                <Border Classes="list-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <Border Grid.Column="0" Classes="list-ic" Background="{Binding IconBackground}">
                                                <Path Classes="icon" Width="16" Height="16" Stroke="{Binding IconForeground}"
                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="list-name" Text="{Binding Name}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="3">
                                                    <TextBlock Classes="list-meta" Text="سود ناخالص" Margin="0" />
                                                    <TextBlock Classes="list-meta" Text="{Binding ProfitText}" Margin="0" />
                                                </StackPanel>
                                                <ui:MetricBar Height="8" Width="130" HorizontalAlignment="Right"
                                                              Margin="0,7,0,0" Fraction="{Binding Fraction}"
                                                              Fill="{Binding TrackFill}" Radius="20" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="list-amt" Text="{Binding MarginText}"
                                                       Foreground="{Binding AmountBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Classes="list-sub" Text="حاشیه سود" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="تفکیک مخارج" />
                                <TextBlock Text="دسته‌بندی هزینه‌ها" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                          Data="{StaticResource IconReceipt}" />
                                    <TextBlock Classes="fin-chip-text" Text="{Binding CategoriesChipText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding CategoryRows}" Margin="20,8,20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fm:FinanceCategoryRowViewModel">
                                <Border Classes="list-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <Border Grid.Column="0" Classes="list-ic" Background="{Binding IconBackground}">
                                                <Path Classes="icon" Width="16" Height="16" Stroke="{Binding IconForeground}"
                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="list-name" Text="{Binding Label}" />
                                                <ui:MetricBar Height="8" Width="130" HorizontalAlignment="Right"
                                                              Margin="0,7,0,0" Fraction="{Binding Fraction}"
                                                              Fill="{Binding TrackFill}" Radius="20" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="list-amt" Text="{Binding Value}"
                                                       Foreground="{Binding AmountBrush}" HorizontalAlignment="Right" />
                                            <Border Classes="list-chip" Background="{Binding ChipBackground}"
                                                    HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Path Classes="icon" Width="11" Height="11" Stroke="{Binding ChipForeground}"
                                                          Data="{Binding ChipIconKey, Converter={StaticResource IconKeyConverter}}" />
                                                    <TextBlock Text="{Binding DeltaText}" FontSize="11" FontWeight="ExtraBold"
                                                               Foreground="{Binding ChipForeground}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Insights ═══ -->
        <ItemsControl ItemsSource="{Binding Insights}" Margin="0,16,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
                <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="6" />
                </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="fm:FinanceInsightViewModel">
                    <Border Classes="insight">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Classes="insight-ic" Background="{Binding IconBackground}"
                                    VerticalAlignment="Top">
                                <Path Classes="icon" Width="17" Height="17" Stroke="{Binding IconForeground}"
                                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Classes="insight-text" Text="{Binding Text}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
