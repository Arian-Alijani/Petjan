<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fm="using:Animora.Desktop.Pages.Finance"
             xmlns:ui="using:Animora.Desktop.Controls"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Finance.FinancePageView"
             x:Name="Root"
             x:DataType="fm:FinancePageViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Resources>

        <!-- ═══ Interactive donut body (finance.css .fin-donut-body + .fin-legend) ═══ -->
        <DataTemplate x:Key="DonutTemplate" x:DataType="fm:FinanceDonutViewModel">
            <StackPanel Margin="20,18,20,20">
                <Grid HorizontalAlignment="Center" Width="196" Height="196">
                    <!-- The ring is a single custom control drawn on the
                         DrawingContext (finance.css .fin-donut-wrap: r=42,
                         SW=14, gap 3.2, round caps). A transparent hit-testable
                         border wraps it so the whole disc drives the
                         cross-highlight, mirroring bindDonuts' seg mouseenter. -->
                    <Border Background="Transparent" Cursor="Hand"
                            PointerMoved="OnDonutPointerMoved"
                            PointerExited="OnDonutPointerExited">
                        <ui:DonutRing Slices="{Binding Slices}"
                                      ActiveIndex="{Binding ActiveIndex}"
                                      ViewBox="100" Radius="42" StrokeWidth="14"
                                      GapArc="3.2" ActiveGrow="4" RoundCaps="True" />
                    </Border>
                    <Border CornerRadius="999" Margin="34" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Color="#ffffff" Offset="0.55" />
                                <GradientStop Color="#fbfdfc" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding CenterValue}" FontSize="24" FontWeight="ExtraBold"
                                       Foreground="{Binding CenterBrush}" HorizontalAlignment="Center"
                                       LetterSpacing="-0.5" />
                            <TextBlock Text="{Binding CenterLabel}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Legend}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fm:FinanceLegendRowViewModel">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Command="{Binding $parent[ItemsControl].DataContext.FocusCommand}"
                                    CommandParameter="{Binding Index}">
                                <Border Classes="leg-row" Classes.act="{Binding IsActive}" Background="{Binding FillBrush}">
                                    <Grid ColumnDefinitions="9,*,Auto,Auto" ColumnSpacing="9">
                                        <Border Grid.Column="0" Width="9" Height="9" CornerRadius="999"
                                                Background="{Binding Swatch}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="leg-name" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Classes="leg-val" Text="{Binding Value}" />
                                        <TextBlock Grid.Column="3" Classes="leg-pct" Text="{Binding Pct}" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- ═══ Products card (finance.css productsCard + .fin-prod-sort) ═══ -->
        <DataTemplate x:Key="ProductsCardTemplate" x:DataType="fm:FinancePageViewModel">
            <Border Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="قهرمانان فروش" />
                                <TextBlock Text="پرفروش‌ترین کالا و خدمات" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="fin-seg" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Sorts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="fm:FinanceSortViewModel">
                                            <Button Classes="seg-btn" Classes.is-active="{Binding IsActive}"
                                                    Padding="11,6" FontSize="11.5"
                                                    Command="{Binding $parent[ItemsControl].DataContext.ToggleSortCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding ProductRows}" Margin="20,8,20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="fm:FinanceProductRowViewModel">
                                <Border Classes="list-row">
                                    <Grid ColumnDefinitions="26,Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Classes="rank" Background="{Binding RankBackground}">
                                            <TextBlock Classes="rank-num" Text="{Binding RankText}"
                                                       Foreground="{Binding RankForeground}" />
                                        </Border>
                                        <Border Grid.Column="1" Classes="list-ic" Background="{Binding IconBackground}">
                                            <Path Classes="icon" Width="16" Height="16" Stroke="{Binding IconForeground}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Classes="list-name" Text="{Binding Name}" />
                                                <Border Classes="kind-tag" Background="{Binding KindBackground}">
                                                    <TextBlock Classes="kind-text" Text="{Binding KindLabel}"
                                                               Foreground="{Binding KindForeground}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="list-meta" Text="{Binding Meta}" />
                                            <ui:MetricBar Height="8" Width="130" HorizontalAlignment="Right"
                                                          Margin="0,7,0,0" Fraction="{Binding Fraction}"
                                                          Fill="{Binding TrackFill}" Radius="20" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Classes="list-amt" Text="{Binding Main}"
                                                       Foreground="{Binding MainBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Classes="list-sub" Text="{Binding Sub}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ═══ Service vs product card (finance.css .svp-*) ═══ -->
        <DataTemplate x:Key="ServiceVsProductCardTemplate" x:DataType="fm:FinancePageViewModel">
            <Border Classes="card">
                <StackPanel>
                    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fin-eyebrow" Text="منبع درآمد" />
                                <TextBlock Text="خدمات در برابر کالا" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                          Data="{StaticResource IconScale}" />
                                    <TextBlock Classes="fin-chip-text" Text="تفکیک فروش" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Margin="20,18,20,20">
                        <ui:SegmentedBar Height="14" Segments="{Binding SplitSegments}" Gap="2" />
                        <ItemsControl ItemsSource="{Binding ServiceSplits}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="6" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fm:FinanceServiceSplitViewModel">
                                    <Border Classes="svp-item">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Border Grid.Column="0" Classes="svp-ic" Background="{Binding IconBackground}">
                                                    <Path Classes="icon" Width="16" Height="16" Stroke="{Binding IconForeground}"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Classes="svp-name" Text="{Binding Label}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Classes="svp-share" Text="{Binding Share}"
                                                           Foreground="{Binding ShareBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Classes="svp-value" Text="{Binding Value}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Path Classes="icon" Width="13" Height="13" Opacity="0.8"
                                                          Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconCart}" />
                                                    <TextBlock Classes="svp-metric" Text="{Binding Qty}" />
                                                    <TextBlock Classes="svp-metric" Text="مورد" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Path Classes="icon" Width="13" Height="13" Opacity="0.8"
                                                          Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconPiggy}" />
                                                    <TextBlock Classes="svp-metric" Text="حاشیه" />
                                                    <TextBlock Classes="svp-metric" Text="{Binding Margin}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,40">

            <!-- ═══ Page header (.page-header / .page-eyebrow / .page-title) ═══ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,18">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" LetterSpacing="-0.4" />
                </StackPanel>
                <Button Grid.Column="1" Classes="outline" VerticalAlignment="Bottom"
                        Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="16" Height="16"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Data="{StaticResource IconDownload}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ExportLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══ Toolbar (.pagebar / .fin-toolbar) ═══ -->
            <Border Classes="pagebar" Margin="0,0,0,20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <!-- Tabs (.pb-seg.lg.pb-seg-fill) -->
                    <Border Grid.Column="0" Classes="fin-seg">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fm:FinanceTabViewModel">
                                    <Button Classes="seg-btn lg" Classes.is-active="{Binding IsActive}"
                                            Command="{Binding #Root.((fm:FinancePageViewModel)DataContext).ToggleTabCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                            <Path Classes="icon" Width="16" Height="16"
                                                  Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Range picker (.pb-seg) -->
                    <Border Grid.Column="1" Classes="fin-seg" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Ranges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fm:FinanceRangeViewModel">
                                    <Button Classes="seg-btn" Classes.is-active="{Binding IsActive}"
                                            Command="{Binding #Root.((fm:FinancePageViewModel)DataContext).ToggleRangeCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Tab panels — lazily instantiated: only the active tab is realised ═══ -->
            <controls:LazyTabHost ActiveKey="{Binding ActiveTab}">
                <controls:LazyTab Key="overview">
                    <DataTemplate x:DataType="fm:FinancePageViewModel">
            <StackPanel>
                <ContentControl Content="{Binding Highlight}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="fm:FinanceHighlightViewModel">
                            <Border Classes="hl" Margin="0,0,0,16">
                                <Panel>
                                <Border Classes="hl-rail" Background="{Binding RailBrush}" HorizontalAlignment="Right" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Grid.Column="0" Classes="hl-ic" Background="{Binding IconBackground}">
                                        <Path Classes="icon" Width="20" Height="20"
                                              Stroke="{Binding IconForeground}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="hl-label" Text="{Binding Label}" />
                                        <ui:RichLine Spans="{Binding Spans}" />
                                    </StackPanel>
                                </Grid>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="8" />
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fm:FinanceKpiViewModel">
                            <Border Classes="kpi-card" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="kpi-ic" Background="{Binding IconBackground}">
                                            <Path Classes="icon" Width="18" Height="18" Stroke="{Binding IconForeground}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="2" Classes="kpi-delta" Background="{Binding DeltaBackground}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <Path Classes="icon" Width="12" Height="12"
                                                      Stroke="{Binding DeltaForeground}"
                                                      Data="{Binding DeltaIconKey, Converter={StaticResource IconKeyConverter}}" />
                                                <TextBlock Text="{Binding DeltaText}" FontSize="11" FontWeight="ExtraBold"
                                                           Foreground="{Binding DeltaForeground}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3" Margin="0,12,0,0">
                                        <TextBlock Classes="kpi-value" Text="{Binding Value}" Foreground="{Binding ValueBrush}" />
                                        <TextBlock Classes="kpi-unit" Text="{Binding Unit}" Foreground="{Binding ValueBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Classes="kpi-label" Text="{Binding Label}"
                                               Foreground="{Binding LabelBrush}" />
                                    <TextBlock Grid.Row="3" Classes="kpi-foot" Text="{Binding Foot}"
                                               Foreground="{Binding FootBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Chart + channels donut (.fin-grid-2: 1.55fr 1fr) -->
                <Grid ColumnDefinitions="1.55*,*" ColumnSpacing="16" Margin="0,16,0,0">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="fin-eyebrow" Text="{Binding ChartEyebrow}" />
                                        <TextBlock Text="{Binding ChartHeading}" FontSize="15" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="swatch" Background="#0d9488" />
                                            <TextBlock Classes="legend-text" Text="درآمد" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="swatch" Background="#d92d20" />
                                            <TextBlock Classes="legend-text" Text="هزینه" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="swatch" Background="#1570cd" />
                                            <TextBlock Classes="legend-text" Text="سود خالص" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ui:TrendChart Height="250" Margin="14,16,14,14" Points="{Binding TrendPoints}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="fin-eyebrow" Text="ترکیب درآمد" />
                                        <TextBlock Text="کانال‌های فروش" FontSize="15" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                                  Data="{StaticResource IconPieChart}" />
                                            <TextBlock Classes="fin-chip-text" Text="{Binding ChannelsChipText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <ContentControl Content="{Binding ChannelDonut}" ContentTemplate="{StaticResource DonutTemplate}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Products + service-vs-product (.fin-grid-2.even) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,16,0,0">
                    <ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource ProductsCardTemplate}" />
                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ServiceVsProductCardTemplate}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Insights}" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="6" />
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fm:FinanceInsightViewModel">
                            <Border Classes="insight">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="insight-ic" Background="{Binding IconBackground}"
                                            VerticalAlignment="Top">
                                        <Path Classes="icon" Width="17" Height="17" Stroke="{Binding IconForeground}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="insight-text" Text="{Binding Text}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
                    </DataTemplate>
                </controls:LazyTab>
                <controls:LazyTab Key="income">
                    <DataTemplate x:DataType="fm:FinancePageViewModel">
            <StackPanel>
                <ContentControl Content="{Binding Highlight}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="fm:FinanceHighlightViewModel">
                            <Border Classes="hl" Margin="0,0,0,16">
                                <Panel>
                                <Border Classes="hl-rail" Background="{Binding RailBrush}" HorizontalAlignment="Right" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Grid.Column="0" Classes="hl-ic" Background="{Binding IconBackground}">
                                        <Path Classes="icon" Width="20" Height="20" Stroke="{Binding IconForeground}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="hl-label" Text="{Binding Label}" />
                                        <ui:RichLine Spans="{Binding Spans}" />
                                    </StackPanel>
                                </Grid>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ItemsControl ItemsSource="{Binding MiniStats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="7" />
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fm:FinanceMiniStatViewModel">
                            <Border Classes="mini-card">
                                <Panel>
                                <Border Classes="mini-rail" Background="{Binding RailBrush}" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="mini-ic" Background="{Binding IconBackground}">
                                        <Path Classes="icon" Width="19" Height="19" Stroke="{Binding IconForeground}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="mini-label" Text="{Binding Label}" />
                                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                                            <TextBlock Classes="mini-value" Text="{Binding Value}" />
                                            <TextBlock Classes="mini-unit" Text="{Binding Unit}" IsVisible="{Binding HasUnit}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="mini-delta" IsVisible="{Binding HasDelta}"
                                            Background="{Binding DeltaBackground}">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Path Classes="icon" Width="11" Height="11" Stroke="{Binding DeltaForeground}"
                                                  Data="{Binding DeltaIconKey, Converter={StaticResource IconKeyConverter}}" />
                                            <TextBlock Text="{Binding DeltaText}" FontSize="10.5" FontWeight="ExtraBold"
                                                       Foreground="{Binding DeltaForeground}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="1.55*,*" ColumnSpacing="16" Margin="0,16,0,0">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="fin-eyebrow" Text="{Binding ChartEyebrow}" />
                                        <TextBlock Text="{Binding ChartHeading}" FontSize="15" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="swatch" Background="#0d9488" />
                                            <TextBlock Classes="legend-text" Text="درآمد" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="swatch" Background="#d92d20" />
                                            <TextBlock Classes="legend-text" Text="هزینه" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="swatch" Background="#1570cd" />
                                            <TextBlock Classes="legend-text" Text="سود خالص" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ui:TrendChart Height="250" Margin="14,16,14,14" Points="{Binding TrendPoints}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="fin-eyebrow" Text="ترکیب درآمد" />
                                        <TextBlock Text="کانال‌های فروش" FontSize="15" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                                  Data="{StaticResource IconPieChart}" />
                                            <TextBlock Classes="fin-chip-text" Text="{Binding ChannelsChipText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <ContentControl Content="{Binding ChannelDonut}" ContentTemplate="{StaticResource DonutTemplate}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,16,0,0">
                    <ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource ProductsCardTemplate}" />
                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ServiceVsProductCardTemplate}" />
                </Grid>

                <!-- Channel bars + payment donut (.fin-grid-2.even) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,16,0,0">
                    <Border Grid.Column="0" Classes="card">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="fin-eyebrow" Text="عملکرد کانال‌ها" />
                                        <TextBlock Text="درآمد هر واحد" FontSize="15" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                                  Data="{StaticResource IconLayers}" />
                                            <TextBlock Classes="fin-chip-text" Text="{Binding ChannelBarsChipText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ChannelBars}" Margin="20,8,20,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="fm:FinanceChannelBarViewModel">
                                        <Border Classes="list-row">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                                    <Border Grid.Column="0" Classes="list-ic" Background="{Binding IconBackground}">
                                                        <Path Classes="icon" Width="16" Height="16" Stroke="{Binding IconForeground}"
                                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="list-name" Text="{Binding Label}" />
                                                        <TextBlock Classes="list-meta" Text="{Binding Share}" />
                                                        <ui:MetricBar Height="8" Width="130" HorizontalAlignment="Right"
                                                                      Margin="0,7,0,0" Fraction="{Binding Fraction}"
                                                                      Fill="{Binding TrackFill}" Radius="20" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Classes="list-amt" VerticalAlignment="Center"
                                                           Text="{Binding Value}" Foreground="{Binding AmountBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="fin-eyebrow" Text="جریان نقدی" />
                                        <TextBlock Text="روش‌های پرداخت" FontSize="15" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                                  Data="{StaticResource IconCreditCard}" />
                                            <TextBlock Classes="fin-chip-text" Text="۴ روش" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <ContentControl Content="{Binding PaymentDonut}" ContentTemplate="{StaticResource DonutTemplate}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Species card -->
                <Border Classes="card" Margin="0,16,0,0">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="fin-eyebrow" Text="تحلیل مشتری" />
                                    <TextBlock Text="گونه‌های مراجعه‌کننده" FontSize="15" FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                              Data="{StaticResource IconPaw}" />
                                        <TextBlock Classes="fin-chip-text" Text="{Binding SpeciesChipText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Species}" Margin="20,14,20,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fm:FinanceSpeciesViewModel">
                                    <Grid ColumnDefinitions="74,*,Auto" ColumnSpacing="12" Height="29">
                                        <TextBlock Grid.Column="0" Classes="hbar-lbl" Text="{Binding Label}" />
                                        <ui:MetricBar Grid.Column="1" Height="11" VerticalAlignment="Center"
                                                      Fraction="{Binding Fraction}" Fill="{Binding TrackFill}" Radius="20" />
                                        <TextBlock Grid.Column="2" Classes="hbar-val" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Heatmap card -->
                <Border Classes="card" Margin="0,16,0,0">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="fin-eyebrow" Text="الگوی مراجعه" />
                                    <TextBlock Text="ساعات طلایی کلینیک" FontSize="15" FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="fin-head-chip" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource MutedBrush}"
                                              Data="{StaticResource IconClock}" />
                                        <TextBlock Classes="fin-chip-text" Text="۹ تا ۲۰" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Margin="20,16,20,16" Spacing="4">
                            <Grid ColumnDefinitions="42,*" ColumnSpacing="4">
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding HeatHours}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="heat-lbl" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding HeatRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="fm:FinanceHeatRowViewModel">
                                        <Grid ColumnDefinitions="42,*" ColumnSpacing="4" Height="22">
                                            <TextBlock Grid.Column="0" Classes="heat-lbl" Text="{Binding DayLabel}" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerTheme>
                                                    <ControlTheme TargetType="ContentPresenter">
                                                        <Setter Property="Margin" Value="2" />
                                                    </ControlTheme>
                                                </ItemsControl.ItemContainerTheme>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="fm:FinanceHeatCellViewModel">
                                                        <Border Classes="heat-cell" Background="{Binding Fill}"
                                                                ToolTip.Tip="{Binding Tooltip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                                <TextBlock Grid.Column="0" Text="کم" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding HeatScale}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="heat-scale-sw" Background="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" Text="زیاد" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
                    </DataTemplate>
                </controls:LazyTab>
                <controls:LazyTab Key="expense">
                    <DataTemplate x:DataType="fm:FinancePageViewModel">
                        <fm:FinanceExpenseTabView />
                    </DataTemplate>
                </controls:LazyTab>
                <controls:LazyTab Key="profit">
                    <DataTemplate x:DataType="fm:FinancePageViewModel">
                        <fm:FinanceProfitTabView />
                    </DataTemplate>
                </controls:LazyTab>
            </controls:LazyTabHost>
        </StackPanel>
    </ScrollViewer>
</UserControl>
