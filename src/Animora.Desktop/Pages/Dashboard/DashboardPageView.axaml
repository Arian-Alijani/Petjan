<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Animora.Desktop.Pages.Dashboard"
             xmlns:controls="using:Animora.Desktop.Controls"
             xmlns:contracts="using:Animora.Contracts.Dashboard"
             x:Class="Animora.Desktop.Pages.Dashboard.DashboardPageView"
             x:DataType="dashboard:DashboardPageViewModel">

    <!-- Bottom margin leaves room for the floating refresh button (MainWindow overlay) so it never covers the last card. -->
    <StackPanel Margin="26,22,26,92" Spacing="20">

        <!-- Explicit load state (D28): initial loading / refreshing / empty / stale / error are distinct from a real zero. -->
        <Border Classes="card" Padding="12,10" IsVisible="{Binding IsStateVisible}">
            <StackPanel Spacing="6">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                             AutomationProperties.Name="در حال دریافت اطلاعات داشبورد" />
                <TextBlock Text="{Binding StateText}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <Border Classes="card" Padding="16"
                IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding LoadError}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="تلاش دوباره" IsVisible="{Binding CanRetry}" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <!-- KPI row: Phase 03 StatCard, matching .stats-grid (4 columns). -->
        <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:AdaptiveGrid MinItemWidth="210" MaxColumns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                    <Setter Property="Margin" Value="6,0" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="contracts:DashboardStat">
                    <controls:StatCard Icon="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                        Value="{Binding Value}"
                                        Label="{Binding Label}"
                                        Foot="{Binding Foot}"
                                        Secondary="{Binding Secondary}"
                                        Spark="{Binding Spark}"
                                        Delta="{Binding Delta}"
                                        IsDeltaPositive="{Binding IsDeltaPositive}"
                                        IconTone="{Binding IconTone, Converter={StaticResource ToneConverter}}"
                                        Command="{Binding $parent[UserControl].((dashboard:DashboardPageViewModel)DataContext).OpenStatCommand}"
                                        CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Instantiate only the active role's subtree. IsVisible=false still constructs
             controls, bindings and templates for the other two roles (PERFORMANCE.md §7/§12). -->
        <ContentControl x:Name="RoleContentHost" HorizontalContentAlignment="Stretch" />

        <!-- Quick access strip, matching .quick-grid / .quick-tile (TILES array):
             4 columns, per-tile accent colors, hover icon-chip morph, subtitle
             arrow and Alt+N corner hint. Optional sourced badges remain static. -->
        <Border Classes="card">
            <StackPanel>
                <StackPanel Classes="card-header">
                    <TextBlock Classes="card-title" Text="دسترسی سریع به بخش‌های مهم" />
                </StackPanel>
                <Border Classes="card-header-rule" />

                <ItemsControl Margin="18" ItemsSource="{Binding QuickActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGrid MinItemWidth="190" MaxColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                            <Setter Property="Margin" Value="6" />
                        </Style>
                    </ItemsControl.Styles>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:DashboardQuickAction">
                            <Button Classes="quick-tile"
                                    Command="{Binding $parent[UserControl].((dashboard:DashboardPageViewModel)DataContext).OpenQuickActionCommand}"
                                    CommandParameter="{Binding}">
                                <Border Classes="qt-card">
                                    <Border.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform"
                                                                           Duration="0:0:0.3"
                                                                           Easing="CubicEaseOut" />
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
                                        </Transitions>
                                    </Border.Transitions>

                                    <Grid>
                                        <!-- .qt-key: Alt+N corner hint (top-trailing). -->
                                        <Border Classes="qt-key">
                                            <TextBlock Text="{Binding AltHint}" />
                                        </Border>

                                        <StackPanel Spacing="10">
                                            <!-- .qt-icon chip (+ optional badge). -->
                                            <Panel HorizontalAlignment="Left">
                                                <Border Classes="qt-icon">
                                                    <Border.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform"
                                                                                           Duration="0:0:0.35"
                                                                                           Easing="CubicEaseOut" />
                                                            <BrushTransition Property="Background" Duration="0:0:0.3" />
                                                        </Transitions>
                                                    </Border.Transitions>
                                                    <Path Classes="icon"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                </Border>
                                                <!-- Optional sourced count: static, with no perpetual animation. -->
                                                <Border Classes="qt-badge"
                                                        IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <TextBlock Text="{Binding Badge}" />
                                                </Border>
                                            </Panel>

                                            <StackPanel Spacing="1">
                                                <TextBlock Classes="qt-title" Text="{Binding Label}" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Classes="qt-sub" Text="{Binding Subtitle}" />
                                                    <Path Grid.Column="1"
                                                          Classes="icon qt-arrow"
                                                          Data="{StaticResource IconChevronLeft}">
                                                        <Path.Transitions>
                                                            <Transitions>
                                                                <TransformOperationsTransition Property="RenderTransform"
                                                                                               Duration="0:0:0.3"
                                                                                               Easing="CubicEaseOut" />
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                                                            </Transitions>
                                                        </Path.Transitions>
                                                    </Path>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
