<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Animora.Desktop.Pages.Dashboard"
             xmlns:controls="using:Animora.Desktop.Controls"
             xmlns:contracts="using:Animora.Contracts.Dashboard"
             x:Class="Animora.Desktop.Pages.Dashboard.DashboardPageView"
             x:DataType="dashboard:DashboardPageViewModel">

    <StackPanel Margin="26,22,26,40" Spacing="20">

        <!-- KPI row: Phase 03 StatCard, matching .stats-grid (4 columns). -->
        <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                    <Setter Property="Margin" Value="6,0" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="contracts:DashboardStat">
                    <controls:StatCard Icon="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                        Value="{Binding Value}"
                                        Label="{Binding Label}"
                                        Foot="{Binding Foot}"
                                        Delta="{Binding Delta}"
                                        IsDeltaPositive="{Binding IsDeltaPositive}"
                                        IconTone="{Binding IconTone, Converter={StaticResource ToneConverter}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Role-specific content: one ViewModel, three sub-views selected by
             role (CONVENTIONS.md §3) — mirrors DASH_VIEW_MANAGER/CASHIER/DOCTOR. -->
        <dashboard:ManagerDashboardView IsVisible="{Binding IsManager}" DataContext="{Binding}" />
        <dashboard:CashierDashboardView IsVisible="{Binding IsCashier}" DataContext="{Binding}" />
        <dashboard:DoctorDashboardView IsVisible="{Binding IsDoctor}" DataContext="{Binding}" />

        <!-- Quick access strip, matching .quick-grid / .quick-tile (TILES array):
             4 columns, per-tile accent colors, hover icon-chip morph, subtitle
             arrow, Alt+N corner hint and the red pulse badge on «انبار». -->
        <Border Classes="card">
            <StackPanel>
                <StackPanel Classes="card-header">
                    <TextBlock Classes="card-title" Text="دسترسی سریع به بخش‌های مهم" />
                </StackPanel>
                <Border Classes="card-header-rule" />

                <ItemsControl Margin="18" ItemsSource="{Binding QuickActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                            <Setter Property="Margin" Value="6" />
                        </Style>
                    </ItemsControl.Styles>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:DashboardQuickAction">
                            <Button Classes="quick-tile"
                                    Command="{Binding $parent[UserControl].((dashboard:DashboardPageViewModel)DataContext).OpenQuickActionCommand}"
                                    CommandParameter="{Binding}">
                                <!-- Styles hosted on the tile compile against the item
                                     type, so per-tile accent/soft brushes resolve. -->
                                <Button.Styles>
                                    <!-- .quick-tile tile surface (shadow + lift live here
                                         because Button has no BoxShadow property). -->
                                    <Style Selector="Button.quick-tile">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Top" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                    <!-- Keep the button shell transparent on hover; the
                                         visual surface + lift live on the inner qt-card. -->
                                    <Style Selector="Button.quick-tile:pointerover">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button.quick-tile Border.qt-card">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="16" />
                                        <Setter Property="Padding" Value="14,14,14,13" />
                                        <Setter Property="RenderTransform" Value="translateY(0px)" />
                                    </Style>
                                    <!-- hover: lift + shadow + accent border -->
                                    <Style Selector="Button.quick-tile:pointerover Border.qt-card">
                                        <Setter Property="RenderTransform" Value="translateY(-5px)" />
                                        <Setter Property="BoxShadow" Value="0 14 28 0 #1A101828" />
                                        <Setter Property="BorderBrush" Value="{ReflectionBinding AccentBrush}" />
                                    </Style>

                                    <!-- .qt-icon chip: hover morph to the accent colour -->
                                    <Style Selector="Border.qt-icon">
                                        <Setter Property="Width" Value="38" />
                                        <Setter Property="Height" Value="38" />
                                        <Setter Property="CornerRadius" Value="12" />
                                        <Setter Property="Background" Value="{ReflectionBinding SoftBrush}" />
                                    </Style>
                                    <Style Selector="Button.quick-tile:pointerover Border.qt-icon">
                                        <Setter Property="Background" Value="{ReflectionBinding AccentBrush}" />
                                        <Setter Property="RenderTransform" Value="translateY(-2px) rotate(-6deg) scale(1.06)" />
                                    </Style>
                                    <Style Selector="Border.qt-icon Path.icon">
                                        <Setter Property="Width" Value="18" />
                                        <Setter Property="Height" Value="18" />
                                        <Setter Property="Stroke" Value="{ReflectionBinding AccentBrush}" />
                                    </Style>
                                    <Style Selector="Button.quick-tile:pointerover Border.qt-icon Path.icon">
                                        <Setter Property="Stroke" Value="White" />
                                    </Style>

                                    <!-- .qt-badge pulse -->
                                    <Style Selector="Border.qt-badge">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2.4"
                                                       IterationCount="INFINITE"
                                                       Easing="SineEaseInOut">
                                                <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="scale(1)" /></KeyFrame>
                                                <KeyFrame Cue="50%"><Setter Property="RenderTransform" Value="scale(1.12)" /></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="scale(1)" /></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>

                                    <!-- .qt-arrow: fades/slides in on hover -->
                                    <Style Selector="Path.qt-arrow">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="RenderTransform" Value="translateX(6px)" />
                                    </Style>
                                    <Style Selector="Button.quick-tile:pointerover Path.qt-arrow">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="RenderTransform" Value="translateX(0px)" />
                                        <Setter Property="Stroke" Value="{ReflectionBinding AccentBrush}" />
                                    </Style>
                                </Button.Styles>

                                <Border Classes="qt-card">
                                    <Border.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform"
                                                                           Duration="0:0:0.3"
                                                                           Easing="CubicEaseOut" />
                                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" />
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
                                        </Transitions>
                                    </Border.Transitions>

                                    <Grid>
                                        <!-- .qt-key: Alt+N corner hint (top-trailing). -->
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="#fafbfa"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="5,1">
                                            <TextBlock Text="{Binding AltHint}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Muted2Brush}"
                                                       Opacity="0.75" />
                                        </Border>

                                        <StackPanel Spacing="10">
                                            <!-- .qt-icon chip (+ optional badge). -->
                                            <Panel HorizontalAlignment="Left">
                                                <Border Classes="qt-icon">
                                                    <Border.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform"
                                                                                           Duration="0:0:0.35"
                                                                                           Easing="CubicEaseOut" />
                                                            <BrushTransition Property="Background" Duration="0:0:0.3" />
                                                        </Transitions>
                                                    </Border.Transitions>
                                                    <Path Classes="icon"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                </Border>
                                                <!-- .qt-badge: red circular count (tile 6 only). -->
                                                <Border MinWidth="18"
                                                        Height="18"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="-6,-6,0,0"
                                                        CornerRadius="20"
                                                        Padding="5,0"
                                                        Background="{StaticResource DangerBrush}"
                                                        BoxShadow="0 0 0 2 #FFFFFF"
                                                        IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <TextBlock Text="{Binding Badge}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               FontWeight="ExtraBold"
                                                               Foreground="White" />
                                                </Border>
                                            </Panel>

                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           FontWeight="ExtraBold"
                                                           Foreground="{StaticResource InkBrush}" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Subtitle}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                    <Path Grid.Column="1"
                                                          Classes="icon qt-arrow"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Stroke="{StaticResource Muted2Brush}"
                                                          Data="{StaticResource IconChevronLeft}">
                                                        <Path.Transitions>
                                                            <Transitions>
                                                                <TransformOperationsTransition Property="RenderTransform"
                                                                                               Duration="0:0:0.3"
                                                                                               Easing="CubicEaseOut" />
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                                                            </Transitions>
                                                        </Path.Transitions>
                                                    </Path>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
