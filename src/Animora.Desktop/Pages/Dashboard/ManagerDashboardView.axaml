<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Animora.Desktop.Pages.Dashboard"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Dashboard.ManagerDashboardView"
             x:DataType="dashboard:DashboardPageViewModel">
    <UserControl.Styles>
        <!-- ═══ Species donut (styles.css .species-body / .donut-* / .legend-row) ═══ -->
        <!-- Legend row: a soft, self-sized share fill painted behind the content;
             the active row lifts toward the track with a hairline border
             (reference .legend-row:hover/.on). -->
        <Style Selector="Border.legend-row">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.legend-row.on">
            <Setter Property="Background" Value="#f9fbfa" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        </Style>
        <Style Selector="Border.legend-row.on TextBlock.lg-name">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <!-- Swatch: small dot that grows on the active row. -->
        <Style Selector="Ellipse.swatch">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.lg-name">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.lg-count">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.lg-pct">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="30" />
        </Style>
        <!-- Center disc: the glossy gradient medallion inside the ring. -->
        <Style Selector="TextBlock.dc-val">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="-0.6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.dc-lbl">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.dc-sub">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted2Brush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>


    <!-- Mirrors DASH_VIEW_MANAGER (Animora-UI/assets/dashboard-views.js):
         Row 1 — revenue pulse chart (1.3fr) + doctor workload (1fr).
         Row 2 — live queue + species donut + management alerts (1fr each). -->
    <StackPanel Spacing="16">

        <!-- ============ Row 1: revenue pulse + doctor workload ============ -->
        <Grid ColumnDefinitions="1.3*,1*" ColumnSpacing="16">

            <!-- نبض مالی کلینیک (clinic financial pulse) -->
            <Border Grid.Column="0" Classes="card" Padding="20,18"
                    IsVisible="{Binding RevenuePulse, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="نبض مالی کلینیک"
                                       FontSize="{StaticResource FontSizeMd}"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding RevenuePulse.Value}"
                                           FontSize="{StaticResource FontSizeXl}"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}"
                                           VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding RevenuePulse.Caption}"
                                           FontSize="{StaticResource FontSizeXs}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource OkBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,3" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Range tabs (روز/هفته/ماه/سال) — visual match, inert. -->
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                CornerRadius="10"
                                Padding="3"
                                Background="{StaticResource Brand50Brush}"
                                BorderBrush="{StaticResource Line2Brush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Border CornerRadius="8" Padding="10,4" Background="{StaticResource PanelBrush}">
                                    <TextBlock Text="هفته"
                                               FontSize="{StaticResource FontSizeXs}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brand700Brush}" />
                                </Border>
                                <Border CornerRadius="8" Padding="10,4">
                                    <TextBlock Text="روز"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border CornerRadius="8" Padding="10,4">
                                    <TextBlock Text="ماه"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border CornerRadius="8" Padding="10,4">
                                    <TextBlock Text="سال"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Area + line chart drawn from the normalized pulse series.
                         Canvas is 500×180 to match the reference viewBox. -->
                    <Border CornerRadius="12" ClipToBounds="True" Height="180">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="500" Height="180">
                                <!-- dashed gridlines -->
                                <Line StartPoint="0,40" EndPoint="500,40"
                                      Stroke="{StaticResource Line2Brush}" StrokeThickness="1" StrokeDashArray="3,4" />
                                <Line StartPoint="0,80" EndPoint="500,80"
                                      Stroke="{StaticResource Line2Brush}" StrokeThickness="1" StrokeDashArray="3,4" />
                                <Line StartPoint="0,120" EndPoint="500,120"
                                      Stroke="{StaticResource Line2Brush}" StrokeThickness="1" StrokeDashArray="3,4" />

                                <!-- filled area under the line -->
                                <Path Data="{Binding RevenueAreaGeometry}">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                            <GradientStop Offset="0" Color="#5914B8A6" />
                                            <GradientStop Offset="1" Color="#0014B8A6" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>

                                <!-- revenue trend line -->
                                <Path Data="{Binding RevenueLineGeometry}"
                                      Stroke="#14B8A6"
                                      StrokeThickness="2.5"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- بار کاری پزشکان امروز (doctor workload today) -->
            <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasDoctorWorkload}">
                <StackPanel>
                    <Grid Classes="card-header" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="card-title" Text="بار کاری پزشکان امروز" />
                        <TextBlock Grid.Column="1"
                                   Classes="card-header-meta"
                                   Text="نوبت انجام‌شده / کل" />
                    </Grid>
                    <Border Classes="card-header-rule" />
                    <ItemsControl Margin="18,14,18,18" ItemsSource="{Binding DoctorLoads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:DashboardDoctorLoadViewModel">
                                <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="10"
                                            Background="{Binding TintBrush}">
                                        <TextBlock Text="{Binding Initial}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <!-- progress bar (done/total): the filled
                                             portion is a proportional star column. -->
                                        <Border Height="7"
                                                CornerRadius="4"
                                                Background="{StaticResource Line2Brush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding DoneStar}" />
                                                    <ColumnDefinition Width="{Binding RemainStar}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Height="7"
                                                        CornerRadius="4"
                                                        Background="{Binding AccentBrush}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CountText}"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSm}"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>

        <!-- ======= Row 2: live queue + species donut + alerts ======= -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">

            <!-- صف زندهٔ امروز (today's live queue) -->
            <Border Grid.Column="0" Classes="card">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="{Binding PrimaryListTitle}" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />
                    <ItemsControl Margin="18,14,18,18" ItemsSource="{Binding PrimaryList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:DashboardRowViewModel">
                                <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="10"
                                            Background="{StaticResource Brand50Brush}">
                                        <Path Classes="icon"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{StaticResource Brand700Brush}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <controls:Badge Grid.Column="2" VerticalAlignment="Center" Text="{Binding TagText}" Tone="{Binding Tone}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- بیماران بر اساس گونه (patients by species) -->
            <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasSpecies}">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="بیماران بر اساس گونه" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />

                    <StackPanel Margin="18,14,18,18">
                        <!-- Donut + centre readout (.species-body donut + .donut-center).
                             The ring is a single custom control (DonutRing) drawn
                             directly on the DrawingContext — the previous
                             ItemsControl-of-Paths measured its Canvas panel to zero
                             so the coloured segments never rendered. A transparent,
                             hit-testable border wraps it so the whole disc responds
                             to the pointer for the cross-highlight. -->
                        <Grid Width="200" Height="200" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border Background="Transparent"
                                    Cursor="Hand"
                                    PointerMoved="OnDonutPointerMoved"
                                    PointerExited="OnDonutPointerExited"
                                    PointerPressed="OnDonutPointerPressed">
                                <controls:DonutRing x:Name="DonutRing"
                                                       Slices="{Binding SpeciesSlices}"
                                                       ActiveIndex="{Binding SpeciesActiveIndex}"
                                                       TrackBrush="#f0f4f2" />
                            </Border>

                            <!-- glossy center medallion (.donut-center; inset 34/186 ≈ 36/200) -->
                            <Border Margin="36" CornerRadius="999"
                                    IsHitTestVisible="False"
                                    BorderBrush="#e7ecea" BorderThickness="1"
                                    BoxShadow="0 6 18 0 #0D101828">
                                <Border.Background>
                                    <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%"
                                                         RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="#ffffff" Offset="0.55" />
                                        <GradientStop Color="#fbfdfc" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="dc-val"
                                               Text="{Binding SpeciesTotal}"
                                               Foreground="{Binding SpeciesCenterBrush}" />
                                    <TextBlock Classes="dc-lbl" Text="{Binding SpeciesTotalLabel}" />
                                    <TextBlock Classes="dc-sub" Text="{Binding SpeciesTotalSub}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Legend rows (.species-legend / .legend-row) -->
                        <ItemsControl ItemsSource="{Binding Species}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dashboard:DashboardSpeciesViewModel">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((dashboard:DashboardPageViewModel)DataContext).FocusSpeciesCommand}"
                                            CommandParameter="{Binding Index}">
                                    <Border Classes="legend-row" Classes.on="{Binding IsActive}"
                                            PointerEntered="OnLegendEnter" PointerExited="OnLegendLeave">
                                        <Panel>
                                            <!-- soft share fill painted behind the content (.legend-fill) -->
                                            <controls:MetricBar HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                Fraction="{Binding FillFraction}"
                                                                Fill="{Binding SwatchBrush}" TrackBrush="Transparent"
                                                                Radius="12" Opacity="0.16" IsHitTestVisible="False" />
                                            <Grid ColumnDefinitions="9,*,Auto,Auto" ColumnSpacing="9">
                                                <Ellipse Grid.Column="0" Classes="swatch" Fill="{Binding SwatchBrush}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Path Classes="icon" Width="14" Height="14"
                                                          Stroke="{StaticResource Muted2Brush}" VerticalAlignment="Center"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                    <TextBlock Classes="lg-name" Text="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Classes="lg-count" Text="{Binding CountText}" />
                                                <TextBlock Grid.Column="3" Classes="lg-pct" Text="{Binding PercentText}" />
                                            </Grid>
                                        </Panel>
                                    </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- هشدارهای مدیریتی (management alerts) -->
            <Border Grid.Column="2" Classes="card">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="{Binding SecondaryListTitle}" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />
                    <ItemsControl Margin="18,14,18,18" ItemsSource="{Binding SecondaryList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:DashboardRowViewModel">
                                <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="10"
                                            Background="{StaticResource Brand50Brush}">
                                        <Path Classes="icon"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{StaticResource Brand700Brush}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <controls:Badge Grid.Column="2" VerticalAlignment="Center" Text="{Binding TagText}" Tone="{Binding Tone}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>

    </StackPanel>

</UserControl>
