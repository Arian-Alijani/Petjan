<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Animora.Desktop.Pages.Dashboard"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Dashboard.ManagerDashboardView"
             x:DataType="dashboard:DashboardPageViewModel">
    <UserControl.Styles>
        <!-- ═══ Species donut (styles.css .species-body / .donut-* / .legend-row) ═══ -->
        <!-- Legend row: a soft, self-sized share fill painted behind the content;
             the active row lifts toward the track with a hairline border
             (reference .legend-row:hover/.on). -->
        <Style Selector="Border.legend-row">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.legend-row.on">
            <Setter Property="Background" Value="{StaticResource RowActiveBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        </Style>
        <Style Selector="Border.legend-row.on TextBlock.lg-name">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <!-- Swatch: small dot that grows on the active row. -->
        <Style Selector="Ellipse.swatch">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.lg-name">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.lg-count">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.lg-pct">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="30" />
        </Style>
        <!-- Center disc: the glossy gradient medallion inside the ring. -->
        <Style Selector="TextBlock.dc-val">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="-0.6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.dc-lbl">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.dc-sub">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted2Brush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>


    <!-- Reference-driven layout (minimal blue/indigo dashboard):
         Two-column shell (Weights 2,1). In RTL the first item sits on the RIGHT,
         so the wide main area is on the right and the narrow side column on the left
         — matching the reference image.
           • Main area (wide): top sub-row = [today summary][doctor workload][species donut];
             bottom = revenue pulse chart (full width of the main area).
           • Side column (narrow): management alerts on top + live queue below,
             each half-height so the stacked pair matches the main area height and
             never spills below the viewport. -->
    <controls:AdaptiveGrid MinItemWidth="300" MaxColumns="2" Weights="2,1" ColumnSpacing="16" RowSpacing="16">

        <!-- ================= Main area (wide) ================= -->
        <StackPanel Grid.Column="0" Spacing="16">

            <!-- Top sub-row: today summary + doctor workload + species donut -->
            <controls:AdaptiveGrid MinItemWidth="230" MaxColumns="3" ColumnSpacing="16" RowSpacing="16">

            <!-- بیماران بر اساس گونه (patients by species) — species density donut.
                 Placed first so in RTL it sits on the far-right of the top sub-row. -->
            <Border Grid.Column="0" Classes="card" IsVisible="{Binding HasSpecies}">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="بیماران بر اساس گونه" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />

                    <StackPanel Margin="18,14,18,18">
                        <!-- Donut + centre readout (.species-body donut + .donut-center).
                             The ring is a single custom control (DonutRing) drawn
                             directly on the DrawingContext — the previous
                             ItemsControl-of-Paths measured its Canvas panel to zero
                             so the coloured segments never rendered. A transparent,
                             hit-testable border wraps it so the whole disc responds
                             to the pointer for the cross-highlight. -->
                        <Grid Width="200" Height="200" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <!-- A real Button: Tab-focusable, Enter/Space and left-click only (right/middle never navigate),
                                 with a text equivalent of the chart for screen readers. -->
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Cursor="Hand"
                                    Command="{Binding OpenSpeciesPatientsCommand}"
                                    AutomationProperties.Name="{Binding SpeciesAutomationName}"
                                    PointerMoved="OnDonutPointerMoved"
                                    PointerExited="OnDonutPointerExited"
                                    GotFocus="OnDonutGotFocus"
                                    LostFocus="OnDonutLostFocus"
                                    KeyDown="OnSpeciesKeyDown">
                                <controls:DonutRing x:Name="DonutRing"
                                                       Slices="{Binding SpeciesSlices}"
                                                       ActiveIndex="{Binding SpeciesActiveIndex}"
                                                       TrackBrush="{StaticResource ChartTrackBrush}" />
                            </Button>

                            <!-- glossy center medallion (.donut-center; inset 34/186 ≈ 36/200) -->
                            <Border Margin="36" CornerRadius="999"
                                    IsHitTestVisible="False"
                                    BorderBrush="{StaticResource MedallionLineBrush}" BorderThickness="1"
                                    BoxShadow="{StaticResource ShadowMedallion}">
                                <Border.Background>
                                    <RadialGradientBrush Center="50%,40%" GradientOrigin="50%,40%"
                                                         RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="{StaticResource PanelColor}" Offset="0.55" />
                                        <GradientStop Color="{StaticResource MedallionEdgeColor}" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="dc-val"
                                               Text="{Binding SpeciesTotal}"
                                               Foreground="{Binding SpeciesCenterBrush}" />
                                    <TextBlock Classes="dc-lbl" Text="{Binding SpeciesTotalLabel}" />
                                    <TextBlock Classes="dc-sub" Text="{Binding SpeciesTotalSub}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Legend rows (.species-legend / .legend-row) -->
                        <TextBlock Margin="18,18,18,18" HorizontalAlignment="Center" Text="{Binding EmptyListText}" IsVisible="{Binding ShowSpeciesEmpty}"
                                   Foreground="{StaticResource MutedBrush}" />
                        <ItemsControl ItemsSource="{Binding Species}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dashboard:DashboardSpeciesViewModel">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((dashboard:DashboardPageViewModel)DataContext).FocusSpeciesCommand}"
                                            CommandParameter="{Binding Index}"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            GotFocus="OnLegendGotFocus" LostFocus="OnLegendLostFocus"
                                            KeyDown="OnSpeciesKeyDown">
                                    <Border Classes="legend-row" Classes.on="{Binding IsActive}"
                                            PointerEntered="OnLegendEnter" PointerExited="OnLegendLeave">
                                        <Panel>
                                            <!-- soft share fill painted behind the content (.legend-fill) -->
                                            <controls:MetricBar HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                Fraction="{Binding FillFraction}"
                                                                Fill="{Binding SwatchBrush}" TrackBrush="Transparent"
                                                                Radius="12" Opacity="0.16" IsHitTestVisible="False" />
                                            <Grid ColumnDefinitions="9,*,Auto,Auto" ColumnSpacing="9">
                                                <Ellipse Grid.Column="0" Classes="swatch" Fill="{Binding SwatchBrush}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Path Classes="icon" Width="14" Height="14"
                                                          Stroke="{Binding SwatchBrush}" VerticalAlignment="Center"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                    <TextBlock Classes="lg-name" Text="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Classes="lg-count" Text="{Binding CountText}" />
                                                <TextBlock Grid.Column="3" Classes="lg-pct" Text="{Binding PercentText}" />
                                            </Grid>
                                        </Panel>
                                    </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

                <!-- خلاصهٔ امروز (today summary — new box, built only from existing bindings) -->
                <Border Grid.Column="1" Classes="card">
                    <StackPanel>
                        <StackPanel Classes="card-header">
                            <TextBlock Classes="card-title" Text="خلاصهٔ امروز" />
                        </StackPanel>
                        <Border Classes="card-header-rule" />
                        <StackPanel Margin="18,16,18,18" Spacing="14">
                            <!-- metric 1: total patients (species total) -->
                            <Grid ColumnDefinitions="40,*">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                        VerticalAlignment="Center" Background="{StaticResource Brand50Brush}">
                                    <Path Classes="icon" Width="20" Height="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{StaticResource Brand700Brush}"
                                          Data="{StaticResource IconUsers}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding SpeciesTotal}"
                                               FontSize="{StaticResource FontSizeLg}" FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding SpeciesTotalLabel}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Line2Brush}" />
                            <!-- metric 2: 14-day revenue trend (existing pulse summary string) -->
                            <Grid ColumnDefinitions="40,*">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                        VerticalAlignment="Center" Background="{StaticResource Brand50Brush}">
                                    <Path Classes="icon" Width="20" Height="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{StaticResource Brand700Brush}"
                                          Data="{StaticResource IconTrendUp}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="روند درآمد ۱۴ روز"
                                               FontSize="{StaticResource FontSizeSm}" FontWeight="ExtraBold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding RevenuePulse.Summary}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            <!-- نوبت‌های امروز (today's appointments) — only the appointment list -->
            <Border Grid.Column="2" Classes="card">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="نوبت‌های امروز" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />
                    <TextBlock Margin="18,18,18,18" HorizontalAlignment="Center" Text="{Binding EmptyListText}" IsVisible="{Binding ShowPrimaryEmpty}"
                               Foreground="{StaticResource MutedBrush}" />
                    <ItemsControl Margin="14,12,14,6" ItemsSource="{Binding PrimaryList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:DashboardRowViewModel">
                                <Border Classes="dash-row">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="9"
                                            Background="{Binding IconBgBrush}">
                                        <Path Classes="icon"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding IconBrush}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <controls:Badge Grid.Column="2" VerticalAlignment="Center" Text="{Binding TagText}" Tone="{Binding Tone}" />
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

                        </controls:AdaptiveGrid>
            <!-- end top sub-row -->

            <!-- روند درآمد ۱۴ روز اخیر (revenue pulse) — wide, bottom of the main area.
                 Mirrors the reference "Reports" card. -->
            <Border Classes="card" Padding="20,18"
                    IsVisible="{Binding RevenuePulse, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="روند درآمد ۱۴ روز اخیر"
                               FontSize="{StaticResource FontSizeMd}"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" />
                    <Border CornerRadius="12" ClipToBounds="True" Height="200"
                            AutomationProperties.Name="{Binding RevenuePulse.Summary}">
                        <controls:RevenuePulseChart Pulse="{Binding RevenuePulse}"
                                                    HoverCaption="درآمد" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
        <!-- ================= Side column (narrow): alerts + live queue ================= -->
        <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="16">

            <!-- هشدارهای مدیریتی (management alerts) — maps to the reference «اخطار» box (top) -->
            <Border Grid.Row="0" Classes="card">
                <StackPanel>
                    <StackPanel Classes="card-header">
                        <TextBlock Classes="card-title" Text="{Binding SecondaryListTitle}" />
                    </StackPanel>
                    <Border Classes="card-header-rule" />
                    <TextBlock Margin="18,18,18,18" HorizontalAlignment="Center" Text="{Binding EmptyListText}" IsVisible="{Binding ShowSecondaryEmpty}"
                               Foreground="{StaticResource MutedBrush}" />
                    <ItemsControl Margin="14,12,14,6" ItemsSource="{Binding SecondaryList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:DashboardRowViewModel">
                                <Border Classes="dash-row">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="9"
                                            Background="{Binding IconBgBrush}">
                                        <Path Classes="icon"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding IconBrush}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <controls:Badge Grid.Column="2" VerticalAlignment="Center" Text="{Binding TagText}" Tone="{Binding Tone}" />
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- هشدارهای فوری (urgent alerts) — cheque + recorded-expense alerts, colour-coded by urgency.
                 Empty = a calm «no urgent alerts» state so the layout never jumps. -->
            <Border Grid.Row="1" Classes="card">
                <StackPanel>
                    <Grid Classes="card-header" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <!-- Siren, not a bell: «هشدارهای فوری» is an alarm, and the glyph stays legible at
                             20px where a bell's skirt and clapper merge into a blob. -->
                        <Path Grid.Column="0" Classes="icon" Width="20" Height="20" VerticalAlignment="Center"
                              Stroke="{StaticResource WarnBrush}"
                              Data="{StaticResource IconSiren}" />
                        <TextBlock Grid.Column="1" Classes="card-title" VerticalAlignment="Center" Text="هشدارهای فوری" />
                        <controls:Badge Grid.Column="2" VerticalAlignment="Center" Text="{Binding AlertCountText}"
                                        IsVisible="{Binding HasAlerts}" Tone="Danger" />
                        <Button Grid.Column="3" VerticalAlignment="Center" Content="{Binding AlertOverflowText}"
                                IsVisible="{Binding HasAlertOverflow}" Command="{Binding OpenAlertOverflowCommand}" />
                    </Grid>
                    <Border Classes="card-header-rule" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="18"
                                IsVisible="{Binding ShowAlertsEmpty}" Opacity="0.75">
                        <Path Classes="icon" Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{StaticResource OkBrush}" Data="{StaticResource IconCheck}" />
                        <TextBlock Text="بدون هشدار فوری" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <ItemsControl Margin="14,12,14,6" ItemsSource="{Binding AlertRows}" IsVisible="{Binding HasAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dashboard:DashboardRowViewModel">
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((dashboard:DashboardPageViewModel)DataContext).OpenAlertCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}">
                                <Border Classes="dash-row">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" Classes="alert-edge" Classes.danger="{Binding IsDanger}"
                                            Classes.warn="{Binding IsWarn}" />
                                    <Border Grid.Column="1"
                                            Classes="alert-ico"
                                            Classes.danger="{Binding IsDanger}"
                                            Classes.warn="{Binding IsWarn}"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="9"
                                            Background="{StaticResource Brand50Brush}">
                                        <Path Classes="icon"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{StaticResource Brand700Brush}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <controls:Badge Grid.Column="3" VerticalAlignment="Center" Text="{Binding TagText}" Tone="{Binding Tone}" />
                                </Grid>
                                </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>

    </controls:AdaptiveGrid>

</UserControl>
