<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Animora.Desktop.Pages.Dashboard"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Dashboard.CashierDashboardView"
             x:DataType="dashboard:DashboardPageViewModel">

    <!-- Mirrors DASH_VIEW_CASHIER's "open invoices" + "ready to bill" cards
         (Animora-UI/assets/dashboard-views.js), reduced from a table to the
         same avatar+title+subtitle+tag row shape used across this screen
         (payment-mix breakdown is out of this phase's static-render budget). -->
    <controls:AdaptiveGrid MinItemWidth="320" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">

        <Border Grid.Column="0" Classes="card">
            <StackPanel>
                <StackPanel Classes="card-header">
                    <TextBlock Classes="card-title" Text="{Binding PrimaryListTitle}" />
                </StackPanel>
                <Border Classes="card-header-rule" />
                <TextBlock Margin="18,18,18,18" HorizontalAlignment="Center" Text="{Binding EmptyListText}" IsVisible="{Binding ShowPrimaryEmpty}"
                           Foreground="{StaticResource MutedBrush}" />
                <ItemsControl Margin="14,12,14,6" ItemsSource="{Binding PrimaryList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:DashboardRowViewModel">
                            <Border Classes="dash-row">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        Background="{Binding IconBgBrush}">
                                    <Path Classes="icon"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding IconBrush}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeSm}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <controls:Badge Grid.Column="2" VerticalAlignment="Center" Text="{Binding TagText}" Tone="{Binding Tone}" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
            <StackPanel>
                <StackPanel Classes="card-header">
                    <TextBlock Classes="card-title" Text="{Binding SecondaryListTitle}" />
                </StackPanel>
                <Border Classes="card-header-rule" />
                <TextBlock Margin="18,18,18,18" HorizontalAlignment="Center" Text="{Binding EmptyListText}" IsVisible="{Binding ShowSecondaryEmpty}"
                           Foreground="{StaticResource MutedBrush}" />
                <ItemsControl Margin="14,12,14,6" ItemsSource="{Binding SecondaryList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:DashboardRowViewModel">
                            <Border Classes="dash-row">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        Background="{Binding IconBgBrush}">
                                    <Path Classes="icon"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding IconBrush}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeSm}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <controls:Badge Grid.Column="2" VerticalAlignment="Center" Text="{Binding TagText}" Tone="{Binding Tone}" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </controls:AdaptiveGrid>

</UserControl>
