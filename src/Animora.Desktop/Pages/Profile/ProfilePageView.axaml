<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Animora.Desktop.Controls"
             xmlns:pf="using:Animora.Desktop.Pages.Profile"
             x:Class="Animora.Desktop.Pages.Profile.ProfilePageView"
             x:Name="Root"
             x:DataType="pf:ProfilePageViewModel"
>

    <!-- RTL settings workspace: compact navigation, focused sections and truthful service status. -->
    <UserControl.Styles>
        <!-- ═══ hero identity card (.pf-hero) ═══ -->
        <Style Selector="Border.pf-hero">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #05000000" />
            <Setter Property="Padding" Value="22,20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="Border.pf-hero-rail">
            <Setter Property="Height" Value="4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- .pf-avatar -->
        <Style Selector="Border.pf-avatar">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- .pf-kpis -->
        <Style Selector="Border.pf-kpi">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #05000000" />
            <Setter Property="Padding" Value="15,13" />
        </Style>
        <Style Selector="Border.pf-kpi-ic">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <!-- .pf-quick .pf-q -->
        <Style Selector="Border.pf-q">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="Padding" Value="11,4" />
        </Style>

        <!-- ═══ settings card (.ps-card) ═══ -->
        <Style Selector="Border.ps-card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #05000000" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.ps-card-ic">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="TextBlock.ps-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.ps-sub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.ps-label">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>

        <!-- ═══ text inputs (.ps-input) ═══ -->
        <Style Selector="TextBox.ps-input">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ═══ selects (.pb-select) ═══ -->
        <Style Selector="ComboBox.ps-select">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>

        <!-- ═══ switch row (.switch-row) ═══ -->
        <Style Selector="Border.switch-row">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.sw-title">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBlock.sw-sub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- ═══ team member (.pf-member) ═══ -->
        <Style Selector="Border.pf-member">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Border.pf-member-av">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style Selector="TextBlock.pf-member-name">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.pf-member-sub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- ═══ notification matrix row (.pf-mrow) ═══ -->
        <Style Selector="Border.pf-mrow">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.pf-mn-t">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBlock.pf-mn-s">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.pf-ch-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ═══ working-day chip (.chip) ═══ -->
        <Style Selector="Button.pf-chip">
            <Setter Property="Background" Value="white" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Height" Value="29" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pf-chip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Muted2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.pf-chip.on">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ═══ theme option (.pf-topt) ═══ -->
        <Style Selector="Button.pf-topt">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pf-topt:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.pf-topt.on">
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Border.pf-tg">
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <!-- ═══ session row (.pf-sitem) ═══ -->
        <Style Selector="Border.pf-sitem">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Border.pf-sitem-ic">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="TextBlock.pf-st-t">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBlock.pf-st-s">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- pagebar / segmented subsections (mirror shared .pagebar/.pb-seg) -->
        <Style Selector="Border.pf-pagebar">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #05000000" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="Border.pf-seg">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Button.pf-seg-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pf-seg-btn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.pf-seg-btn.on">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.pf-seg-btn.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{StaticResource ShadowSegment}" />
        </Style>

        <Style Selector="TextBlock.pf-page-title">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- ═══ access management (.pf-staff / .pf-perm) ═══ -->
        <!-- staff roster row (clickable) -->
        <Style Selector="Button.pf-staff">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.pf-staff:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.pf-staff.on">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Border.pf-staff-av">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <!-- permission row -->
        <Style Selector="Border.pf-perm">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Border.pf-perm-ic">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <!-- role summary card -->
        <Style Selector="Border.pf-role">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="12,11" />
        </Style>
        <Style Selector="Border.pf-role-ic">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.settings-nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.settings-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.settings-nav.on">
            <Setter Property="Background" Value="{DynamicResource Brand50Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.settings-shortcut">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.settings-shortcut:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Brand600Brush}" />
            <Setter Property="Background" Value="{DynamicResource Brand50Brush}" />
        </Style>
        <Style Selector="TextBlock.ps-sub">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style Selector="TextBlock.sw-sub">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="24,24,24,32" RowDefinitions="Auto,Auto" RowSpacing="24">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel>
                <TextBlock Classes="pf-page-title" Text="{Binding PageTitle}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding UserName}" FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="{Binding UserRole}" Classes="ps-sub" />
                    <Button Classes="outline" Content="خروج از حساب" Command="{Binding SignOutCommand}"
                            AutomationProperties.Name="خروج از حساب" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="SettingsWorkspace" Grid.Row="1" ColumnDefinitions="196,*" ColumnSpacing="22">
            <Border x:Name="SettingsNavigation" Grid.Column="0" Classes="ps-card" Padding="10,14" VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock Text="بخش‌های تنظیمات" Classes="ps-label" Margin="12,0,12,8" />
                    <ItemsControl x:Name="SectionNavigation" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileTabViewModel">
                                <Button Classes="settings-nav" Classes.on="{Binding IsActive}"
                                        Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).SelectTabCommand}"
                                        CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Label}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Path Classes="icon" Width="17" Height="17" VerticalAlignment="Center"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource Bg2Brush}" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding UserRoleLine}" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Classes="ps-sub" Text="تغییرات هر بخش را با دکمهٔ همان بخش ذخیره کنید." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <StackPanel x:Name="SettingsContent" Grid.Column="1" Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ActiveSectionTitle}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Classes="ps-sub" Text="{Binding ActiveSectionDescription}" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />
                <StackPanel IsVisible="{Binding IsOverviewTab}" Spacing="18">
                    <Grid x:Name="AccountCards" ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Classes="ps-card" Padding="24">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SubscriptionPlan}" Classes="ps-label" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="ps-card-ic" Width="40" Height="40">
                                        <Path Classes="icon" Data="{StaticResource IconShield}" Width="20" Height="20"
                                              Stroke="{DynamicResource Brand700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SubscriptionRemaining}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Classes="ps-sub" Text="{Binding SubscriptionDetail}" MinHeight="44" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="ps-card" Padding="24">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="اعتبار و اشتراک پیامک" Classes="ps-label" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="ps-card-ic" Width="40" Height="40">
                                        <Path Classes="icon" Data="{StaticResource IconSms}" Width="20" Height="20"
                                              Stroke="{DynamicResource Brand700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SmsCredit}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Classes="ps-sub" Text="{Binding SmsDetail}" MinHeight="44" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="{DynamicResource Bg2Brush}" CornerRadius="12" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="ps-sub" Text="{Binding AccountStatusMessage}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="outline" Content="بازخوانی وضعیت" Command="{Binding RefreshAccountStatusCommand}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="تنظیمات پرکاربرد" FontSize="15" FontWeight="Bold" Margin="0,6,0,0" />
                    <Grid x:Name="QuickActions" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                        <Button Classes="settings-shortcut" Command="{Binding SelectTabCommand}" CommandParameter="access">
                            <StackPanel Spacing="8"><TextBlock Text="کاربران و دسترسی‌ها" FontWeight="Bold" FontSize="14" />
                                <TextBlock Classes="ps-sub" Text="افزودن پزشک، پذیرش یا حسابدار و تعیین مجوزها" /></StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="settings-shortcut" Command="{Binding SelectTabCommand}" CommandParameter="sched">
                            <StackPanel Spacing="8"><TextBlock Text="نوبت‌دهی و ساعات کاری" FontWeight="Bold" FontSize="14" />
                                <TextBlock Classes="ps-sub" Text="روزهای کاری، مدت نوبت و فاصلهٔ استراحت" /></StackPanel>
                        </Button>
                        <Button Grid.Row="1" Classes="settings-shortcut" Command="{Binding SelectTabCommand}" CommandParameter="alerts">
                            <StackPanel Spacing="8"><TextBlock Text="اعلان‌ها و یادآوری‌ها" FontWeight="Bold" FontSize="14" />
                                <TextBlock Classes="ps-sub" Text="انتخاب کانال اطلاع‌رسانی و ساعات سکوت" /></StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Classes="settings-shortcut" Command="{Binding SelectTabCommand}" CommandParameter="profile">
                            <StackPanel Spacing="8"><TextBlock Text="اطلاعات حساب کاربری" FontWeight="Bold" FontSize="14" />
                                <TextBlock Classes="ps-sub" Text="اطلاعات تماس و مشاهدهٔ تیم کلینیک" /></StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

        <!-- ═══════════ TAB · پروفایل کاربری ═══════════ -->
        <Grid x:Name="ProfileCards" IsVisible="{Binding IsProfileTab}" ColumnDefinitions="*,*" ColumnSpacing="14" VerticalAlignment="Top">
            <!-- card · اطلاعات شخصی -->
            <Border Grid.Column="0" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconUsers}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="اطلاعات شخصی" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="شماره تماس و ایمیل این حساب؛ نام از اطلاعات ثبت‌شده خوانده می‌شود." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="نام و نام خانوادگی"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="0" Classes="ps-input" Text="{Binding ProfileName}" IsReadOnly="True" ToolTip.Tip="نام ثبت‌شدهٔ حساب؛ این بخش برای ویرایش اطلاعات تماس است." />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="شمارهٔ تماس" VerticalAlignment="Center" />
                        <TextBox controls:InputGuard.Kind="Phone" MaxLength="20" Grid.Column="0" Classes="ps-input" Text="{Binding ProfilePhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="ایمیل کاری" VerticalAlignment="Center" />
                        <TextBox Grid.Column="0" Classes="ps-input" Text="{Binding ProfileEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="شمارهٔ نظام دامپزشکی"
                                   VerticalAlignment="Center" />
                        <TextBox MaxLength="20" Grid.Column="0" Classes="ps-input" Text="{Binding NationalCodeLine}" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- card · تیم کلینیک -->
            <Border Grid.Column="1" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconUsers}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="تیم کلینیک" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="اعضای فعال و شیفت آن‌ها." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Team}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileTeamMemberViewModel">
                                <Border Classes="pf-member">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                        <Border Grid.Column="0" Classes="pf-member-av" Background="{Binding AvatarBrush}">
                                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="ExtraBold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="pf-member-name" Text="{Binding Name}" />
                                            <TextBlock Classes="pf-member-sub" Text="{Binding Subtitle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="20" Padding="10,4"
                                                Background="{Binding RoleBackground}">
                                            <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding RoleForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ TAB · تنظیمات نوبت‌دهی ═══════════ -->
        <Grid x:Name="SchedulingCards" IsVisible="{Binding IsScheduleTab}" ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto"
              VerticalAlignment="Top">
            <!-- card · ساعات و روزهای کاری -->
            <Border Grid.Row="0" Grid.Column="0" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconCalendar}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="ساعات و روزهای کاری" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="بازه‌ای که تقویم برای نوبت‌دهی نمایش می‌دهد." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="ساعت شروع" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding WorkFromOptions.Options}"
                                  SelectedIndex="{Binding WorkFromOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="ساعت پایان" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding WorkToOptions.Options}"
                                  SelectedIndex="{Binding WorkToOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                    <StackPanel Spacing="9">
                        <TextBlock Classes="ps-label" Text="روزهای کاری هفته" />
                        <ItemsControl ItemsSource="{Binding DayChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pf:ProfileDayChipViewModel">
                                    <Button Classes="pf-chip" Classes.on="{Binding IsOn}"
                                            Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).ToggleDayCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- card · قوانین نوبت‌دهی -->
            <Border Grid.Row="0" Grid.Column="1" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconCalendar}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="قوانین نوبت‌دهی" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="مدت و تراکم پیش‌فرض نوبت‌های جدید." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="مدت پیش‌فرض هر نوبت" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding DurationOptions.Options}"
                                  SelectedIndex="{Binding DurationOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="فاصلهٔ استراحت بین نوبت‌ها"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding GapOptions.Options}"
                                  SelectedIndex="{Binding GapOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="حد مجاز هم‌پوشانی هر پزشک"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding OverlapOptions.Options}"
                                  SelectedIndex="{Binding OverlapOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="نمای پیش‌فرض تقویم" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding CalendarViewOptions.Options}"
                                  SelectedIndex="{Binding CalendarViewOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- card · اطلاع‌رسانی به سرپرست -->
            <Border Grid.Row="1" Grid.Column="0" Classes="ps-card" Margin="0,14,0,0">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconSms}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="اطلاع‌رسانی به سرپرست" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="پیام‌های خودکار مرتبط با نوبت." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding OwnerNotifyToggles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="11" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileToggleViewModel">
                                <Border Classes="switch-row" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="11">
                                        <ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" OnContent="" OffContent=""
                                                      VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="sw-title" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="sw-sub" Text="{Binding Sub}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- card · نمایش تقویم -->
            <Border Grid.Row="1" Grid.Column="1" Classes="ps-card" Margin="0,14,0,0">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconCalendar}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="نمایش تقویم" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="چیدمان و عناصر دیداری جدول زمانی." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding CalendarDisplayToggles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="11" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileToggleViewModel">
                                <Border Classes="switch-row" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="11">
                                        <ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" OnContent="" OffContent=""
                                                      VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="sw-title" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="sw-sub" Text="{Binding Sub}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ TAB · اعلان‌ها ═══════════ -->
        <Grid x:Name="AlertCards" IsVisible="{Binding IsAlertsTab}" ColumnDefinitions="*,*" ColumnSpacing="14" VerticalAlignment="Top">
            <!-- card · ماتریس اعلان‌ها -->
            <Border Grid.Column="0" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconBell}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="ماتریس اعلان‌ها" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="برای هر رویداد، کانال‌های ارسال را روشن یا خاموش کنید." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding MatrixRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileMatrixRowViewModel">
                                <Border Classes="pf-mrow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Classes="pf-mn-t" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="pf-mn-s" Text="{Binding Sub}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                                                    VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding Sms, Mode=TwoWay}" Content="پیامک" FontSize="11"
                                                      Foreground="{StaticResource MutedBrush}" />
                                            <CheckBox IsChecked="{Binding InApp, Mode=TwoWay}" Content="درون‌برنامه" FontSize="11"
                                                      Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- card · ساعات سکوت -->
            <Border Grid.Column="1" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconClock}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="ساعات سکوت" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="در این بازه پیامک‌های غیرضرور ارسال نمی‌شوند." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="از ساعت" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding QuietFromOptions.Options}"
                                  SelectedIndex="{Binding QuietFromOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="1" Classes="ps-label" Text="تا ساعت" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="0" Classes="ps-select" ItemsSource="{Binding QuietToOptions.Options}"
                                  SelectedIndex="{Binding QuietToOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding QuietToggles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileToggleViewModel">
                                <Border Classes="switch-row" Margin="0,11,0,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="11">
                                        <ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" OnContent="" OffContent=""
                                                      VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="sw-title" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="sw-sub" Text="{Binding Sub}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ TAB · ظاهر و تم ═══════════ -->
        <Grid x:Name="AppearanceCards" IsVisible="{Binding IsLookTab}" ColumnDefinitions="*,*" ColumnSpacing="14" VerticalAlignment="Top">
            <!-- card · حالت نمایش -->
            <Border Grid.Column="0" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconMoon}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="حالت نمایش" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="تم روشن یا تیره برای همهٔ صفحات." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding ThemeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pf:ProfileThemeOptionViewModel">
                                    <Button Classes="pf-topt" Classes.on="{Binding IsOn}"
                                            Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).PickThemeCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Border Classes="pf-tg" Background="{Binding PreviewBackground}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="ExtraBold"
                                                               Foreground="{StaticResource Ink2Brush}" />
                                                    <TextBlock Text="{Binding Sub}" FontSize="10.5" Margin="0,2,0,0"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                                <Path Grid.Column="1" Classes="icon" Width="15" Height="15"
                                                      Stroke="{StaticResource Brand600Brush}"
                                                      Data="{StaticResource IconCheck}" VerticalAlignment="Top"
                                                      IsVisible="{Binding IsOn}" />
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- card · چیدمان فشرده -->
            <Border Grid.Column="1" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconRows}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="چیدمان فشرده" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="فاصلهٔ کمتر در جدول‌ها برای نمایش بیشتر ردیف‌ها." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding LookToggles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="11" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileToggleViewModel">
                                <Border Classes="switch-row" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="11">
                                        <ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" OnContent="" OffContent=""
                                                      VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="sw-title" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="sw-sub" Text="{Binding Sub}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- «اجرای خودکار هنگام روشن شدن ویندوز» — device-level (not a per-user saved toggle);
                         writes the HKCU Run key instantly. Hidden on non-Windows platforms. -->
                    <Border Classes="switch-row" Cursor="Hand" IsVisible="{Binding IsStartupSupported}">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" OnContent="" OffContent=""
                                          VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="sw-title" Text="اجرای خودکار هنگام روشن شدن ویندوز" TextWrapping="Wrap" />
                                <TextBlock Classes="sw-sub" TextWrapping="Wrap"
                                           Text="برنامه با ورود به ویندوز به‌صورت پنهان در نوار وظیفه اجرا و همگام‌سازی می‌شود." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ TAB · امنیت و نشست‌ها ═══════════ -->
        <StackPanel IsVisible="{Binding IsSecurityTab}" Spacing="14" VerticalAlignment="Top">
        <Grid x:Name="SecurityCards" ColumnDefinitions="*,*" ColumnSpacing="14">
            <!-- card · امنیت حساب -->
            <Border Grid.Column="0" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconShield}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="امنیت حساب" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="گذرواژه و ورود دومرحله‌ای." />
                    </StackPanel>
                    <Border Background="{DynamicResource Bg2Brush}" CornerRadius="10" Padding="14">
                        <TextBlock Classes="ps-sub" Text="احراز هویت محلی فعال است و رمزها به‌صورت هش ذخیره می‌شوند. مدیریت رمز و ورود دومرحله‌ای از این صفحه هنوز در دسترس نیست." />
                    </Border>
                    <ItemsControl ItemsSource="{Binding SecurityToggles}" IsEnabled="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileToggleViewModel">
                                <Border Classes="switch-row" Margin="0,11,0,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="11">
                                        <ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" OnContent="" OffContent=""
                                                      VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="sw-title" Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Classes="sw-sub" Text="{Binding Sub}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- card · نشست‌های فعال -->
            <Border Grid.Column="1" Classes="ps-card">
                <StackPanel Spacing="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="ps-card-ic">
                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconUsers}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="ps-title" Text="نشست‌های فعال" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="دستگاه‌هایی که با حساب شما وارد شده‌اند." />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:ProfileSessionViewModel">
                                <Border Classes="pf-sitem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                        <Border Grid.Column="0" Classes="pf-sitem-ic">
                                            <Path Classes="icon" Width="14" Height="14"
                                                  Stroke="{StaticResource Muted2Brush}"
                                                  Data="{StaticResource IconShield}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="pf-st-t" Text="{Binding Name}" VerticalAlignment="Center" />
                                                <Border Background="{StaticResource OkBgBrush}" CornerRadius="20" Padding="10,4"
                                                        VerticalAlignment="Center" IsVisible="{Binding IsCurrent}">
                                                    <TextBlock Text="این نشست" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource OkBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="pf-st-s" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="outline" Padding="12,6" FontSize="12"
                                                VerticalAlignment="Center" IsVisible="{Binding CanSignOut}"
                                                Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).EndSessionCommand}"
                                                Content="مدیریت از سرور" IsEnabled="False" ToolTip.Tip="مدیریت نشست سایر دستگاه‌ها نیازمند اتصال سرور است." />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

            <!-- card · ناحیهٔ خطر · پاک‌سازی کامل داده‌های محلی و همگام‌سازی دوباره -->
            <Border Classes="ps-card" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource DangerBgBrush}" VerticalAlignment="Top">
                        <Path Classes="icon" Width="17" Height="17" Stroke="{StaticResource DangerBrush}"
                              Data="{StaticResource IconAlert}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="ps-title" Text="پاک‌سازی کامل و همگام‌سازی دوباره"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Classes="ps-sub" TextWrapping="Wrap"
                                   Text="تمام داده‌های محلی این دستگاه بطور کامل پاک و برنامه ریست می‌شود، سپس همهٔ اطلاعات دوباره بطور کامل از سرور دریافت و همگام می‌شود. تغییرات هم‌گام‌نشده از بین می‌رود." />
                    </StackPanel>
                    <Button Grid.Column="2" Padding="16,9" VerticalAlignment="Center"
                            Background="{StaticResource DangerBrush}" Foreground="White"
                            Command="{Binding ResetLocalDataCommand}" IsEnabled="{Binding !IsResettingLocalData}"
                            AutomationProperties.Name="پاک‌سازی کامل و همگام‌سازی دوباره">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                  Data="{StaticResource IconRefresh}" VerticalAlignment="Center"
                                  IsVisible="{Binding !IsResettingLocalData}" />
                            <TextBlock Text="پاک‌سازی و همگام‌سازی" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsResettingLocalData}" />
                            <TextBlock Text="در حال انجام…" VerticalAlignment="Center"
                                       IsVisible="{Binding IsResettingLocalData}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════ TAB · مدیریت دسترسی‌ها ═══════════ -->
        <StackPanel IsVisible="{Binding IsAccessTab}" Spacing="14">

            <Border Background="{DynamicResource Bg2Brush}" CornerRadius="12" Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding StaffSummary}" FontWeight="Bold" />
                        <TextBlock Classes="ps-sub" Text="{Binding SeatUsageSummary}" AutomationProperties.Name="مصرف سهمیهٔ کاربران" />
                        <TextBlock Classes="ps-sub" Text="{Binding AccessMessage}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="بازخوانی کاربران" Classes="outline" Command="{Binding RefreshStaffCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <!-- card · دستگاه‌های کاربران (تأیید / لغو) -->
            <Border Classes="ps-card" IsVisible="{Binding HasDevices}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="ps-title" Text="دستگاه‌های کاربران" />
                    <TextBlock Classes="ps-sub" TextWrapping="Wrap" Text="{Binding DevicesSummary}" />
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pf:StaffDeviceViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="ps-sub" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="ps-sub" VerticalAlignment="Center" Text="{Binding StatusLabel}" />
                                    <Button Grid.Column="2" Classes="primary" Padding="12,6" FontSize="12" Content="تأیید دستگاه"
                                            IsVisible="{Binding IsPending}"
                                            Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).ApproveDeviceCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Classes="outline" Padding="12,6" FontSize="12" Content="لغو دسترسی"
                                            IsVisible="{Binding CanRevoke}"
                                            Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).RevokeDeviceCommand}"
                                            CommandParameter="{Binding}" />
                                    <!-- Mutually exclusive with the revoke button (CanRevoke == !IsRevoked), so it reuses the same column slot. -->
                                    <Button Grid.Column="3" Classes="primary" Padding="12,6" FontSize="12" Content="اجازهٔ نصب مجدد"
                                            IsVisible="{Binding IsRevoked}"
                                            Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).ReinstateDeviceCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- two-column: roster (+add form) · permission editor -->
            <Grid x:Name="AccessCards" ColumnDefinitions="300,*" ColumnSpacing="14" VerticalAlignment="Top">

                <!-- ── left · کاربران + افزودن ── -->
                <StackPanel Grid.Column="0" Spacing="14">

                    <!-- card · افزودن کاربر جدید -->
                    <Border Classes="ps-card">
                        <StackPanel Spacing="11">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Border Classes="ps-card-ic">
                                        <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                              Data="{StaticResource IconPlus}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Classes="ps-title" Text="افزودن کاربر جدید" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="دکتر، منشی یا کاربر جدید را با نقش دلخواه اضافه کنید." />
                            </StackPanel>
                            <StackPanel Spacing="6" IsEnabled="{Binding CanManageUsers}">
                                <TextBlock Classes="ps-label" Text="نام و نام خانوادگی *" />
                                <TextBox Classes="ps-input" Text="{Binding NewMemberName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200" PlaceholderText="نام کامل پزشک یا همکار" AutomationProperties.Name="نام و نام خانوادگی کاربر" />
                                <TextBlock Classes="ps-label" Text="نام کاربری *" Margin="0,6,0,0" />
                                <TextBox Classes="ps-input" Text="{Binding NewMemberUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="128" PlaceholderText="مثلاً doctor.naderi" FlowDirection="LeftToRight" AutomationProperties.Name="نام کاربری ورود" />
                                <TextBlock Classes="ps-sub" Text="شناسهٔ یکتای ورود؛ با نام و نام خانوادگی متفاوت است." />
                                <TextBlock Classes="ps-label" Text="رمز عبور *" Margin="0,6,0,0" />
                                <TextBox Classes="ps-input" Text="{Binding NewMemberPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="256" PasswordChar="●" PlaceholderText="حداقل ۸ کاراکتر، شامل حرف و عدد" FlowDirection="LeftToRight"
                                         AutomationProperties.Name="رمز عبور کاربر جدید" />
                                <TextBlock Classes="ps-label" Text="شمارهٔ تماس" Margin="0,6,0,0" />
                                <TextBox controls:InputGuard.Kind="Phone" Classes="ps-input" Text="{Binding NewMemberPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="30" PlaceholderText="اختیاری" FlowDirection="LeftToRight" />
                                <TextBlock Classes="ps-label" Text="نقش در کلینیک *" Margin="0,6,0,0" />
                                <ComboBox Classes="ps-select" ItemsSource="{Binding NewMemberRoleOptions.Options}"
                                          SelectedIndex="{Binding NewMemberRoleOptions.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Border Background="{DynamicResource Bg2Brush}" CornerRadius="10" Padding="12" IsVisible="{Binding HasNewMemberError}">
                                <TextBlock Text="{Binding NewMemberError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                            </Border>
                            <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding AddStaffCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Path Classes="icon" Width="15" Height="15" Stroke="White"
                                          Data="{StaticResource IconPlus}" VerticalAlignment="Center" />
                                    <TextBlock Text="افزودن به تیم" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- card · کاربران کلینیک -->
                    <Border Classes="ps-card">
                        <StackPanel Spacing="11">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Border Classes="ps-card-ic">
                                        <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Brand700Brush}"
                                              Data="{StaticResource IconUsers}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Classes="ps-title" Text="کاربران کلینیک" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="ps-sub" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="برای مدیریت دسترسی، روی هر کاربر بزنید." />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Staff}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pf:StaffMemberViewModel">
                                        <Button Classes="pf-staff" Classes.on="{Binding IsSelected}"
                                                Command="{Binding #Root.((pf:ProfilePageViewModel)DataContext).SelectStaffCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                                <Border Grid.Column="0" Classes="pf-staff-av" Background="{Binding AvatarBrush}">
                                                    <TextBlock Text="{Binding Initials}" FontSize="12.5" FontWeight="ExtraBold"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="pf-member-name" Text="{Binding Name}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{StaticResource OkBgBrush}" CornerRadius="20"
                                                                Padding="7,2" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsActive}">
                                                            <TextBlock Text="فعال" FontSize="9.5" FontWeight="Bold"
                                                                       Foreground="{StaticResource OkBrush}" />
                                                        </Border>
                                                        <Border Background="{StaticResource Bg2Brush}" CornerRadius="20"
                                                                Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock Text="غیرفعال" FontSize="9.5" FontWeight="Bold"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       IsVisible="{Binding !IsActive}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="pf-member-sub" Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="20" Padding="9,3"
                                                        Background="{Binding RoleBackground}">
                                                    <TextBlock Text="{Binding RoleLabel}" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{Binding RoleForeground}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── right · ویرایش دسترسی کاربر انتخاب‌شده ── -->
                <Border Grid.Column="1" Classes="ps-card">
                    <StackPanel Spacing="13">
                        <!-- header -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding SelectedStaff.Name, FallbackValue='دسترسی‌های کاربر'}" Classes="ps-title" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedStaff.RoleLabel}" Classes="ps-sub" />
                            <TextBlock Classes="ps-sub" Text="{Binding SelectedAccessHint}" />
                            <WrapPanel>
                                <Button Classes="outline" Padding="11,6" FontSize="12" Margin="0,0,8,0"
                                        Command="{Binding ResetPermissionsCommand}" Content="پیش‌فرض نقش" />
                                <Button Classes="outline" Padding="11,6" FontSize="12"
                                        Command="{Binding GrantAllPermissionsCommand}" Content="انتخاب همهٔ مجوزها" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- permission grid (2 columns) -->
                        <ScrollViewer MaxHeight="470" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedStaff.Permissions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pf:StaffPermissionViewModel">
                                    <Border Classes="pf-perm" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                            <Border Grid.Column="0" Classes="pf-perm-ic">
                                                <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Muted2Brush}"
                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="pf-mn-t" Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Classes="pf-mn-s" Text="{Binding Sub}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                          IsEnabled="{Binding #Root.((pf:ProfilePageViewModel)DataContext).CanEditSelected}"
                                                          OnContent="" OffContent="" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <!-- change the selected member's password (users.manage) -->
                        <Border Classes="pf-perm" Padding="12" Margin="0,0,0,10"
                                IsVisible="{Binding CanChangeSelectedPassword}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="ps-label" Text="تغییر رمز عبور کاربر" />
                                <TextBox Classes="ps-input" Text="{Binding StaffNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="256" PasswordChar="●" PlaceholderText="رمز عبور جدید (حداقل ۸ کاراکتر، شامل حرف و عدد)"
                                         FlowDirection="LeftToRight" AutomationProperties.Name="رمز عبور جدید کاربر" />
                                <TextBox Classes="ps-input" Text="{Binding StaffNewPasswordConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="256" PasswordChar="●" PlaceholderText="تکرار رمز عبور جدید"
                                         FlowDirection="LeftToRight" AutomationProperties.Name="تکرار رمز عبور جدید" />
                                <Button Classes="outline" HorizontalAlignment="Left" Command="{Binding ChangeStaffPasswordCommand}"
                                        CommandParameter="{Binding SelectedStaff}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Muted2Brush}"
                                              Data="{StaticResource IconShield}" VerticalAlignment="Center" />
                                        <TextBlock Text="تغییر رمز عبور" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- footer actions -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                              IsVisible="{Binding SelectedStaff, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Button Grid.Column="0" Classes="outline" Command="{Binding RemoveStaffCommand}"
                                    CommandParameter="{Binding SelectedStaff}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource DangerBrush}"
                                          Data="{StaticResource IconShield}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedStatusAction}" Foreground="{StaticResource DangerBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- unsaved-changes indicator: shown only while the grid differs from the stored grants -->
                            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Bg2Brush}" CornerRadius="20" Padding="12,5"
                                    IsVisible="{Binding HasAccessChanges}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="تغییرات ذخیره‌نشده دارید" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="2" Classes="primary" Command="{Binding SaveAccessCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Width="15" Height="15" Stroke="White"
                                          Data="{StaticResource IconCheck}" VerticalAlignment="Center" />
                                    <TextBlock Text="ذخیرهٔ دسترسی‌ها" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

                <Border Classes="ps-card" Padding="16" IsVisible="{Binding IsEditableTab}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="ps-label" Text="{Binding ChangesHint}" />
                            <TextBlock Classes="ps-sub" Text="{Binding SaveMessage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="outline" Content="بازگردانی" Command="{Binding DiscardCommand}" ToolTip.Tip="فرم‌ها از اطلاعات ذخیره‌شده دوباره پر می‌شوند." />
                            <Button Classes="primary" Content="{Binding SaveButtonLabel}" Command="{Binding SaveCurrentChangesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
