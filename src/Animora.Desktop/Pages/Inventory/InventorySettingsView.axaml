<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inv="using:Animora.Desktop.Pages.Inventory"
             x:Class="Animora.Desktop.Pages.Inventory.InventorySettingsView"
             x:Name="Root"
             x:DataType="inv:InventoryPageViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">

    <!-- Settings sub-view — re-draws Animora-UI/assets/inventory.js
         renderSettings(): the «دسته‌بندی کالاها» category-management card and
         the «تنظیمات موجودی» toggles card. Values transcribed from
         inventory.css (.settings-wrap/.settings-card/.settings-hd/
         .cat-settings-list/.cat-setting-row/.tone-picker/.switch-row/
         .settings-foot). -->
    <UserControl.Styles>
        <Style Selector="Border.scard">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.s-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.s-sub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style Selector="Border.cat-count">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </UserControl.Styles>

    <Grid VerticalAlignment="Top">
        <Border Classes="scard">
            <StackPanel>
                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="20,18">
                    <StackPanel>
                        <TextBlock Classes="s-title" Text="دسته‌بندی کالاها" />
                        <TextBlock Classes="s-sub" TextWrapping="Wrap"
                                   Text="دسته جدید اضافه کنید، نام دسته‌ها را ویرایش کنید یا دسته‌های خالی را حذف کنید." />
                    </StackPanel>
                </Border>

                <!-- add category -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="20,16,20,4">
                    <TextBox Grid.Column="0" Text="{Binding NewCategoryName, Mode=TwoWay}" MaxLength="64"
                             PlaceholderText="نام دسته جدید، مثلاً: داروهای ضدانگل" CornerRadius="10" MinHeight="36"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Classes="primary" Command="{Binding AddCategoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                  Data="{StaticResource IconPlus}" VerticalAlignment="Center" />
                            <TextBlock Text="افزودن دسته" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding CategoryRows}" Margin="20,8,20,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="inv:InventoryCategoryRowViewModel">
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                            Background="{Binding ToneBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" IsVisible="{Binding !IsEditing}"
                                               FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBox Grid.Column="1" Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsEditing}"
                                             MaxLength="64" CornerRadius="8" MinHeight="32" VerticalContentAlignment="Center" />
                                    <Border Grid.Column="2" Classes="cat-count" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Ink2Brush}" />
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="ghost" Width="30" Height="30" Padding="6" ToolTip.Tip="ویرایش نام"
                                                IsVisible="{Binding !IsEditing}"
                                                Command="{Binding #Root.((inv:InventoryPageViewModel)DataContext).BeginRenameCategoryCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Ink2Brush}"
                                                  Data="{StaticResource IconEdit}" />
                                        </Button>
                                        <Button Classes="ghost" Width="30" Height="30" Padding="6" ToolTip.Tip="حذف دسته (فقط دسته خالی)"
                                                IsVisible="{Binding !IsEditing}" IsEnabled="{Binding CanDelete}"
                                                Command="{Binding #Root.((inv:InventoryPageViewModel)DataContext).DeleteCategoryCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource DangerBrush}"
                                                  Data="{StaticResource IconTrash}" />
                                        </Button>
                                        <Button Classes="ghost" Width="30" Height="30" Padding="6" ToolTip.Tip="ذخیره"
                                                IsVisible="{Binding IsEditing}"
                                                Command="{Binding #Root.((inv:InventoryPageViewModel)DataContext).SaveRenameCategoryCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Brand700Brush}"
                                                  Data="{StaticResource IconCheck}" />
                                        </Button>
                                        <Button Classes="ghost" Width="30" Height="30" Padding="6" ToolTip.Tip="انصراف"
                                                IsVisible="{Binding IsEditing}"
                                                Command="{Binding #Root.((inv:InventoryPageViewModel)DataContext).CancelRenameCategoryCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource MutedBrush}"
                                                  Data="{StaticResource IconX}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
