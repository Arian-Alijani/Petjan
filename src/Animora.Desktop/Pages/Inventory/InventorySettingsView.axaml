<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inv="using:Animora.Desktop.Pages.Inventory"
             x:Class="Animora.Desktop.Pages.Inventory.InventorySettingsView"
             x:Name="Root"
             x:DataType="inv:InventoryPageViewModel"
             x:CompileBindings="True"
             FlowDirection="RightToLeft">

    <!-- Settings sub-view — re-draws Animora-UI/assets/inventory.js
         renderSettings(): the «دسته‌بندی کالاها» category-management card and
         the «تنظیمات موجودی» toggles card. Values transcribed from
         inventory.css (.settings-wrap/.settings-card/.settings-hd/
         .cat-settings-list/.cat-setting-row/.tone-picker/.switch-row/
         .settings-foot). -->
    <UserControl.Styles>
        <Style Selector="Border.scard">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.s-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.s-sub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style Selector="Border.cat-count">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </UserControl.Styles>

    <Grid VerticalAlignment="Top">

        <!-- ═══ card · دسته‌بندی کالاها ═══ -->
        <Border Classes="scard">
            <StackPanel>
                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="20,18">
                    <StackPanel>
                        <TextBlock Classes="s-title" Text="دسته‌بندی کالاها" />
                        <TextBlock Classes="s-sub" TextWrapping="Wrap"
                                   Text="دسته‌های فعال کالا و تعداد کالاهای هر دسته. مدیریت دسته‌ها در این نسخه فقط‌خواندنی است." />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding CategoryRows}" Margin="20,8,20,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="inv:InventoryCategoryRowViewModel">
                            <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                            Background="{Binding ToneBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5"
                                               FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <Border Classes="cat-count">
                                            <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource Ink2Brush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
