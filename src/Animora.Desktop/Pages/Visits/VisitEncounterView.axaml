<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:visits="using:Animora.Desktop.Pages.Visits"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Visits.VisitEncounterView"
             x:Name="Root"
             x:DataType="visits:VisitEncounterViewModel"
             FlowDirection="RightToLeft">

    <!-- Visits — Clinical Encounter Wizard (Phase 11).
         Re-draws Animora-UI/visits.html #scene-wizard + #scene-done and
         assets/visit.js renderWizard/renderRibbon/renderStepper/renderFoot/
         renderPatientSidebar/renderDone. Every box, chip, badge, avatar,
         number and Persian label the reference renders exists here with the
         exact CSS-derived values (visits.html .wz-* + assets/styles.css base). -->
    <UserControl.Styles>
        <!-- ===== Header ribbon (visits.html .wz-ribbon) ===== -->
        <Style Selector="Border.wz-ribbon">
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,20" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="{StaticResource Brand50Color}" />
                    <GradientStop Offset="0.7" Color="#FFFFFFFF" />
                    <GradientStop Offset="1" Color="#FFFFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.wz-ribbon-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="LetterSpacing" Value="-0.3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wz-back">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.wz-back:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Background" Value="#fbfefd" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Border.badge-lg">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style Selector="TextBlock.badge-lg-text">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge-dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <!-- ===== Wizard grid + card ===== -->
        <Style Selector="Border.wz-card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- ===== Stepper ===== -->
        <Style Selector="ItemsControl.wz-stepper">
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.wz-step-connector">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.wz-step-n">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.wz-step-n.is-active">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BoxShadow" Value="0 6 14 0 #470D9488" />
        </Style>
        <Style Selector="Border.wz-step-n.is-done">
            <Setter Property="Background" Value="{StaticResource OkBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OkBgBrush}" />
        </Style>
        <Style Selector="TextBlock.wz-step-num">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.wz-step-num.is-active">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.wz-step-num.is-done">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.wz-step-label">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="-0.2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.wz-step-label.is-active">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="TextBlock.wz-step-label.is-done">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.wz-step-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- ===== Body + section head ===== -->
        <Style Selector="Border.wz-body">
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="MinHeight" Value="380" />
        </Style>
        <Style Selector="TextBlock.sec-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="-0.3" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.sec-hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Fields (visits.html .fld) ===== -->
        <Style Selector="TextBlock.fld-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBox.fld-input">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="ComboBox.fld-select">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- ===== Vitals (visits.html .vitals/.vital) ===== -->
        <Style Selector="Border.vital">
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="{StaticResource Brand50Color}" />
                    <GradientStop Offset="1" Color="#FFFFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.vital-lbl">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBox.vital-input">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.vital-unit">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- ===== Borderless plain text area (visits.html .fld textarea w/o chrome) ===== -->
        <Style Selector="TextBlock.panel-bold">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- ===== Rx step (visits.html .field-search + inline rx-line) ===== -->
        <Style Selector="Border.field-search">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="240" />
        </Style>
        <Style Selector="ComboBox.rx-add">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.rx-line">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Border.rx-badge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.rx-badge-text">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.rx-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.rx-caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBox.rx-qty">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.rx-rm">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBlock.rx-empty">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="4,8" />
        </Style>

        <!-- ===== Review step ===== -->
        <Style Selector="Border.review-box">
            <Setter Property="Background" Value="#fbfefd" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Border.review-line">
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style Selector="Border.review-note">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.review-totals">
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="{StaticResource Brand50Color}" />
                    <GradientStop Offset="0.7" Color="#FFFFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.review-total-rule">
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="0,10,0,4" />
        </Style>

        <!-- ===== Footer (visits.html .wz-foot) ===== -->
        <Style Selector="Border.wz-foot">
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FFFBFCFB" />
                    <GradientStop Offset="1" Color="#FFFFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.wz-foot-info">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wz-foot-btn">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.wz-foot-btn.ghost:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.wz-foot-btn.outline">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="Button.wz-foot-btn.outline:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.wz-foot-btn.primary">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.wz-foot-btn.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
        </Style>

        <!-- ===== Patient sidebar (visits.html .wz-patient) ===== -->
        <Style Selector="Border.wz-patient">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.wz-av-lg">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="88" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BoxShadow" Value="0 8 20 0 #1A0D9488" />
        </Style>
        <Style Selector="TextBlock.wz-pt-name">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="LetterSpacing" Value="-0.4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.wz-pt-kind">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.pill-tag">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="TextBlock.pill-tag-text">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
        <Style Selector="Border.meta-row">
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style Selector="TextBlock.meta-lbl">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.meta-val">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Border.time-badge">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style Selector="TextBlock.time-badge-text">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.doc-badge">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Border.doc-badge-av">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="TextBlock.doc-badge-ini">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.doc-badge-name">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.doc-badge-spec">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- ===== Done scene (visits.html .success-panel) ===== -->
        <Style Selector="Border.ok-ic">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,22" />
            <Setter Property="BoxShadow" Value="0 12 30 0 #332F8F6A" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FFD5EFE1" />
                    <GradientStop Offset="1" Color="#FFF0F9F4" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.ok-title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="-0.5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.ok-sub">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="460" />
        </Style>
        <Style Selector="Border.sum-cell">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style Selector="TextBlock.sum-lbl">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.sum-val">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Button.wz-done-btn">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.wz-done-btn.primary">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.wz-done-btn.primary:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.wz-done-btn.outline">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.wz-done-btn.outline:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,40">
            <!-- Page header (visits.html .page-header — always visible) -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="پرونده الکترونیک سلامت" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Brand600Brush}" Margin="0,0,0,6" />
                <TextBlock Text="ویزیت و پرونده پزشکی" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="ابتدا پزشک مربوطه را انتخاب کنید، سپس از نوبت‌های رزرو شده امروز یک بیمار را برای ویزیت بردارید یا برای یک مراجعهٔ بدون نوبت، ویزیت جدید ثبت کنید."
                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ===================== Wizard scene ===================== -->
            <StackPanel IsVisible="{Binding IsWorkflowVisible}">

                <!-- Ribbon (renderRibbon) -->
                <Border Classes="wz-ribbon">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <Button Classes="wz-back" Command="{Binding BackToGateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Ink2Brush}"
                                          Data="{StaticResource IconChevronRight}" VerticalAlignment="Center" />
                                    <TextBlock Text="بازگشت به انتخاب" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="wz-ribbon-title" Text="{Binding RibbonTitle}" />
                            <Border Classes="badge-lg">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="badge-dot" Background="{Binding RibbonStatusDot}" VerticalAlignment="Center" />
                                    <TextBlock Classes="badge-lg-text" Text="{Binding RibbonStatusText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                            <Border Classes="badge-lg">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="badge-dot" Background="{Binding RibbonDoctorDot}" VerticalAlignment="Center" />
                                    <TextBlock Classes="badge-lg-text" Text="{Binding RibbonDoctorShort}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,320" ColumnSpacing="18">
                    <!-- Wizard card -->
                    <Border Grid.Column="0" Classes="wz-card" VerticalAlignment="Top">
                        <StackPanel>
                            <!-- Stepper (renderStepper) -->
                            <ItemsControl Classes="wz-stepper" ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="visits:EncounterStepViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Classes="wz-step-connector" IsVisible="{Binding ShowConnector}" />
                                            <Button Classes="wz-step-btn"
                                                    Command="{Binding #Root.((visits:VisitEncounterViewModel)DataContext).GoToStepCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Classes="wz-step-n" Classes.is-active="{Binding IsActive}"
                                                            Classes.is-done="{Binding IsDone}">
                                                        <TextBlock Classes="wz-step-num" Text="{Binding NumberText}"
                                                                   Classes.is-active="{Binding IsActive}"
                                                                   Classes.is-done="{Binding IsDone}" />
                                                    </Border>
                                                    <TextBlock Classes="wz-step-label" Text="{Binding ShortLabel}"
                                                               Classes.is-active="{Binding IsActive}"
                                                               Classes.is-done="{Binding IsDone}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Body (renderBody → step sub-view) -->
                            <Border Classes="wz-body">
                                <!-- steps — lazily instantiated: only the active step is realised -->
                                <controls:LazyTabHost ActiveKey="{Binding CurrentStep}">
                                    <controls:LazyTab Key="Vitals">
                                        <DataTemplate x:DataType="visits:VisitEncounterViewModel">
                                            <visits:VitalsStepView />
                                        </DataTemplate>
                                    </controls:LazyTab>
                                    <controls:LazyTab Key="History">
                                        <DataTemplate x:DataType="visits:VisitEncounterViewModel">
                                            <visits:HistoryStepView />
                                        </DataTemplate>
                                    </controls:LazyTab>
                                    <controls:LazyTab Key="Plan">
                                        <DataTemplate x:DataType="visits:VisitEncounterViewModel">
                                            <visits:PlanStepView />
                                        </DataTemplate>
                                    </controls:LazyTab>
                                    <controls:LazyTab Key="Rx">
                                        <DataTemplate x:DataType="visits:VisitEncounterViewModel">
                                            <visits:RxStepView />
                                        </DataTemplate>
                                    </controls:LazyTab>
                                    <controls:LazyTab Key="Review">
                                        <DataTemplate x:DataType="visits:VisitEncounterViewModel">
                                            <visits:ReviewStepView />
                                        </DataTemplate>
                                    </controls:LazyTab>
                                </controls:LazyTabHost>
                            </Border>

                            <!-- Footer (renderFoot) -->
                            <Border Classes="wz-foot">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Classes="wz-foot-info" Text="{Binding StepInfoText}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Left">
                                        <Button Classes="wz-foot-btn ghost" Command="{Binding PreviousStepCommand}"
                                                IsEnabled="{Binding CanGoPrevious}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Ink2Brush}"
                                                      Data="{StaticResource IconChevronRight}" VerticalAlignment="Center" />
                                                <TextBlock Text="مرحلهٔ قبل" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="wz-foot-btn outline" Command="{Binding SaveDraftCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Ink2Brush}"
                                                      Data="{StaticResource IconDownload}" VerticalAlignment="Center" />
                                                <TextBlock Text="ذخیره پیش‌نویس" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="wz-foot-btn primary" Command="{Binding NextStepCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding NextButtonText}" VerticalAlignment="Center" />
                                                <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                                      Data="{Binding NextButtonIcon, Converter={StaticResource IconKeyConverter}}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Patient sidebar (renderPatientSidebar) -->
                    <Border Grid.Column="1" Classes="wz-patient" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Classes="wz-av-lg" Background="{Binding PatientAvatarBackground}">
                                <Path Classes="icon" Width="40" Height="40" Stroke="{Binding PatientAvatarForeground}"
                                      Data="{Binding PatientIconKey, Converter={StaticResource IconKeyConverter}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Classes="wz-pt-name" Text="{Binding PatientName}" />
                            <TextBlock Classes="wz-pt-kind" Text="{Binding PatientKind}" />

                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,12">
                                <Border Classes="pill-tag" Background="{Binding TypePillBackground}">
                                    <TextBlock Classes="pill-tag-text" Text="{Binding TypePillLabel}"
                                               Foreground="{Binding TypePillForeground}" />
                                </Border>
                                <Border Classes="pill-tag" Background="{StaticResource DangerBgBrush}"
                                        IsVisible="{Binding IsUrgent}">
                                    <TextBlock Classes="pill-tag-text" Text="اورژانس"
                                               Foreground="{StaticResource DangerBrush}" />
                                </Border>
                            </StackPanel>

                            <Border Classes="meta-row">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="meta-lbl" Text="مالک" />
                                    <TextBlock Grid.Column="1" Classes="meta-val" Text="{Binding OwnerName}"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </Border>
                            <Border Classes="meta-row">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="meta-lbl" Text="تماس" />
                                    <TextBlock Grid.Column="1" Classes="meta-val" Text="{Binding OwnerPhone}"
                                               FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </Grid>
                            </Border>
                            <Border Classes="meta-row" BorderThickness="0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="meta-lbl" Text="نوع مراجعه" />
                                    <TextBlock Grid.Column="1" Classes="meta-val" Text="{Binding VisitKindText}"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </Border>
                            <Border Classes="meta-row" BorderThickness="0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Classes="meta-lbl" Text="مدت زمان" />
                                    <TextBlock Grid.Column="1" Classes="meta-val" Text="{Binding DurationText}"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </Border>

                            <Border Classes="time-badge">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Brand700Brush}"
                                          Data="{StaticResource IconClock}" VerticalAlignment="Center" />
                                    <TextBlock Classes="time-badge-text" Text="{Binding TimeText}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="doc-badge">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Grid.Column="0" Classes="doc-badge-av" Background="{Binding DoctorAccent}">
                                        <TextBlock Classes="doc-badge-ini" Text="{Binding DoctorInitials}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Classes="doc-badge-name" Text="{Binding DoctorName}" />
                                        <TextBlock Classes="doc-badge-spec" Text="{Binding DoctorSpecialty}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ===================== Done scene ===================== -->
            <!-- Done scene — lazily instantiated only at the final step -->
            <controls:LazyTabHost ActiveKey="{Binding CurrentStep}">
                <controls:LazyTab Key="Done">
                    <DataTemplate x:DataType="visits:VisitEncounterViewModel">
                        <Border Classes="wz-card">
                            <visits:DoneStepView />
                        </Border>
                    </DataTemplate>
                </controls:LazyTab>
            </controls:LazyTabHost>
        </StackPanel>
    </ScrollViewer>
</UserControl>
