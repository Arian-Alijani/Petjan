<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:visits="using:Animora.Desktop.Pages.Visits"
             xmlns:vcontracts="using:Animora.Contracts.Visits"
             xmlns:vsettings="using:Animora.Desktop.Pages.Visits.Settings"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Visits.VisitsTriagePageView"
             x:Name="Root"
             x:DataType="visits:VisitsTriagePageViewModel"
             FlowDirection="RightToLeft">
    <UserControl.Styles>
        <Style Selector="TextBox.search-input">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.doc-card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.doc-card:pointerover">
            <Setter Property="Background" Value="#fbfefd" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
        </Style>
        <Style Selector="Button.doc-card.is-selected">
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.doc-card.is-selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 6 20 0 #240D9488" />
        </Style>
        <Style Selector="Border.step-num">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
        </Style>
        <Style Selector="Button.mode-tab">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="22,24" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.mode-tab:pointerover">
            <Setter Property="Background" Value="#fbfdfc" />
        </Style>
        <Style Selector="Button.mode-tab.second">
            <Setter Property="BorderThickness" Value="0,0,1,3" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        </Style>
        <Style Selector="Button.mode-tab.is-active">
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.mode-tab.second.is-active">
            <Setter Property="BorderThickness" Value="0,0,1,3" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Border.mode-ic">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Border.mode-ic.act">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Border.mode-ic.mode-new">
            <Setter Property="Background" Value="{StaticResource LilacBgBrush}" />
        </Style>
        <Style Selector="Border.mode-ic.mode-new.act">
            <Setter Property="Background" Value="#7b5cc4" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
        </Style>
        <Style Selector="Button.chip.is-active">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.chip.is-active:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.appt-row">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.form-card">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style Selector="TextBox.fld-input">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.fld-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        </Style>
        <Style Selector="Button.type-opt">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.type-opt:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Background" Value="#fbfefd" />
        </Style>
        <Style Selector="Button.type-opt.is-active">
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.prio-opt">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.prio-opt:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
        </Style>
        <Style Selector="Button.prio-opt.normal.is-active">
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.prio-opt.urgent.is-active">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
        </Style>
        <Style Selector="Button.go-btn">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.go-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 8 20 0 #330D9488" />
        </Style>
        <Style Selector="Button.go-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.go-btn:disabled">
            <Setter Property="Background" Value="{StaticResource Muted2Brush}" />
        </Style>
        <Style Selector="Button.go-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>
        <Style Selector="Button.go-btn.small">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.field-search">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.newpatient-btn">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.newpatient-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand100Brush}" />
        </Style>
        <Style Selector="Button.patient-opt">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.patient-opt:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.row-cta">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
        <Style Selector="Button.row-cta:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.row-cta.urgent">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="Button.row-cta.urgent:pointerover">
            <Setter Property="Background" Value="#b23a2f" />
        </Style>
        <!-- Toolbox segmented switch (visit / settings): soft track + pill tabs,
             same look as the Patients page section switch. -->
        <Style Selector="Border.seg">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Border.segitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Border.segitem.on">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowSegment}" />
        </Style>
        <Style Selector="Button.segtap">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,9" />
        </Style>
        <Style Selector="Button.segtap:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.iconbtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="26,22,26,40">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <TextBlock Grid.Column="0" Text="ویزیت و پرونده پزشکی" FontSize="26" FontWeight="ExtraBold"
                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
            <!-- Toolbox: visit workspace / visits settings -->
            <Border Grid.Column="1" Classes="seg" VerticalAlignment="Center">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                    <Border Grid.Column="0" Classes="segitem" Classes.on="{Binding IsVisitSection}">
                        <Button Classes="segtap" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding SetSectionCommand}" CommandParameter="visit">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="16" Height="16"
                                      Data="{StaticResource IconStetho}" />
                                <TextBlock Text="ویزیت" FontSize="13.5" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Grid.Column="1" Classes="segitem" Classes.on="{Binding IsSettingsSection}">
                        <Button Classes="segtap" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding SetSectionCommand}" CommandParameter="settings"
                                ToolTip.Tip="تنظیمات ویزیت">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Classes="icon" Width="16" Height="16"
                                      Data="{StaticResource IconTag}" />
                                <TextBlock Text="تنظیمات" FontSize="13.5" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings tab: laboratory test types offered by the encounter's lab form -->
        <Border x:Name="SettingsHost" IsVisible="{Binding IsSettingsSection}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                CornerRadius="{StaticResource Radius}"
                BoxShadow="{StaticResource ShadowCard}" Padding="18,16">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource Brand50Brush}">
                        <Path Classes="icon" Width="18" Height="18" Stroke="{StaticResource Brand700Brush}"
                              Data="{StaticResource IconFlask}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="انواع آزمایش" FontSize="15" FontWeight="ExtraBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="آزمایش‌هایی که هنگام ثبت نتیجهٔ آزمایش در ویزیت قابل انتخاب هستند را اضافه یا حذف کنید."
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- add test type: name + usual unit -->
                <Grid ColumnDefinitions="*,170,Auto" ColumnSpacing="10"
                      IsVisible="{Binding Settings.CanEdit}">
                    <Border Grid.Column="0" Background="{StaticResource Bg2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="13,0">
                        <TextBox Text="{Binding Settings.NewLabTypeName}"
                                 PlaceholderText="نام آزمایش جدید (مثلاً کلسترول)…"
                                 FontSize="13" BorderThickness="0" Background="Transparent"
                                 Padding="0,10" VerticalContentAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Bg2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="13,0">
                        <TextBox Text="{Binding Settings.NewLabTypeUnit}"
                                 PlaceholderText="واحد (اختیاری)"
                                 FontSize="13" BorderThickness="0" Background="Transparent"
                                 Padding="0,10" VerticalContentAlignment="Center" />
                    </Border>
                    <Button Grid.Column="2" Classes="primary" Command="{Binding Settings.AddLabTypeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Width="15" Height="15" Stroke="White"
                                  Data="{StaticResource IconPlus}" />
                            <TextBlock Text="افزودن آزمایش" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding Settings.CountText}" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}" />

                <TextBlock Text="هنوز نوع آزمایشی تعریف نشده است." FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           IsVisible="{Binding Settings.IsEmpty}" />

                <ItemsControl ItemsSource="{Binding Settings.LabTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vsettings:LabTestTypeItemViewModel">
                            <Border Background="{StaticResource Bg2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="14,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13.5"
                                               FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="9,3" CornerRadius="999"
                                            Background="{StaticResource Brand50Brush}"
                                            VerticalAlignment="Center" IsVisible="{Binding HasUnit}">
                                        <TextBlock Text="{Binding DefaultUnit}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Brand700Brush}"
                                                   FlowDirection="LeftToRight" />
                                    </Border>
                                    <Button Grid.Column="2" Classes="iconbtn" ToolTip.Tip="حذف نوع آزمایش"
                                            IsVisible="{Binding #Root.((visits:VisitsTriagePageViewModel)DataContext).Settings.CanEdit}"
                                            Command="{Binding RemoveCommand}">
                                        <Path Classes="icon" Width="15" Height="15"
                                              Stroke="{StaticResource DangerBrush}"
                                              Data="{StaticResource IconTrash}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="340,*" ColumnSpacing="18" IsVisible="{Binding IsVisitSection}">
            <!-- ===== Doctor rail ===== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius}" Padding="16"
                    BoxShadow="{StaticResource ShadowCard}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*" Margin="4,4,4,10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Border Width="26" Height="26" CornerRadius="9" Background="{StaticResource Brand600Brush}">
                                <TextBlock Text="۱" FontSize="12" FontWeight="ExtraBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="انتخاب پزشک" FontSize="14" FontWeight="ExtraBold"
                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}">
                            <Run Text="{Binding DoctorCountText}" /><Run Text=" پزشک فعال" />
                        </TextBlock>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Line2Brush}" Margin="4,0,4,10" />

                    <ItemsControl ItemsSource="{Binding Doctors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="visits:DoctorTileViewModel">
                                <Grid Margin="0,0,0,8">
                                    <Button Classes="doc-card" Classes.is-selected="{Binding IsSelected}"
                                            Command="{Binding #Root.((visits:VisitsTriagePageViewModel)DataContext).SelectDoctorCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                                                    Background="{Binding AvatarBrush}">
                                                <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="ExtraBold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="ExtraBold"
                                                               Foreground="{StaticResource InkBrush}" />
                                                    <Border IsVisible="{Binding HasVisitInProgress}" Padding="6,1" CornerRadius="999"
                                                            Background="{StaticResource Brand50Brush}" VerticalAlignment="Center">
                                                        <TextBlock Text="در ویزیت" FontSize="10" FontWeight="ExtraBold"
                                                                   Foreground="{StaticResource Brand700Brush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Specialty}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Padding="10,6" CornerRadius="10"
                                                    Background="{StaticResource Brand50Brush}" MinWidth="56">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding MetricCount}" FontSize="15" FontWeight="ExtraBold"
                                                               Foreground="{StaticResource Brand700Brush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="نوبت امروز" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource Brand700Brush}" Opacity="0.8"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Border Width="24" Height="24" CornerRadius="999" Background="{StaticResource Brand600Brush}"
                                            BoxShadow="0 4 12 0 #590D9488" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="6,6,0,0" IsVisible="{Binding IsSelected}">
                                        <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                              Data="{StaticResource IconCheck}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="12"
                            BorderBrush="{StaticResource Brand100Brush}" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="{StaticResource Brand50Color}" />
                                <GradientStop Offset="1" Color="#FFFFFFFF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Grid.Column="0" Classes="icon" Width="16" Height="16" Stroke="{StaticResource Brand600Brush}"
                                  Data="{StaticResource IconBulb}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="هر پزشک نوبت‌های خاص خود را دارد؛ بعد از انتخاب، سمت راست تنظیم می‌شود."
                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink2Brush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Workspace ===== -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius}" BoxShadow="{StaticResource ShadowCard}"
                    MinHeight="560" ClipToBounds="True" VerticalAlignment="Top">
                <StackPanel>

                    <!-- Empty state -->
                    <Border IsVisible="{Binding HasNoDoctor}" Padding="40,64">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Rectangle Width="132" Height="132" RadiusX="40" RadiusY="40"
                                           Stroke="{StaticResource Brand100Brush}" StrokeThickness="1.5"
                                           StrokeDashArray="4,4" Opacity="0.6" />
                                <Border Width="108" Height="108" CornerRadius="32"
                                        BorderBrush="{StaticResource Brand100Brush}" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="{StaticResource Brand50Color}" />
                                            <GradientStop Offset="0.7" Color="#FFFFFFFF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Classes="icon" Width="52" Height="52" Stroke="{StaticResource Brand600Brush}"
                                          Data="{StaticResource IconUsers}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="یک پزشک را از سمت راست انتخاب کنید" FontSize="20" FontWeight="ExtraBold"
                                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8,0,0" MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="برای شروع فرآیند ویزیت، ابتدا مشخص کنید ویزیت توسط کدام پزشک انجام می‌شود. سپس می‌توانید از میان نوبت‌های رزرو شدهٔ همان پزشک برای امروز یکی را برای شروع ویزیت انتخاب کنید یا یک ویزیت جدید (بدون نوبت) ثبت کنید."
                                       FontSize="13.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            <Border Margin="0,22,0,0" Padding="14,8" CornerRadius="999"
                                    Background="{StaticResource Brand50Brush}" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Brand700Brush}"
                                          Data="{StaticResource IconChevronRight}" VerticalAlignment="Center" />
                                    <TextBlock Text="انتخاب پزشک از رَیل کناری" FontSize="12" FontWeight="ExtraBold"
                                               Foreground="{StaticResource Brand700Brush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Selected workspace -->
                    <StackPanel IsVisible="{Binding HasSelectedDoctor}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="20,16">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="{StaticResource Brand50Color}" />
                                    <GradientStop Offset="0.6" Color="#FFFFFFFF" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13"
                                    Background="{Binding SelectedDoctor.AvatarBrush}">
                                <TextBlock Text="{Binding SelectedDoctor.Initials}" FontSize="18" FontWeight="ExtraBold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding SelectedDoctor.Name}" FontSize="16" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="{Binding BookedCountHint}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Padding="10,6" CornerRadius="999" VerticalAlignment="Center"
                                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Brand100Brush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="در دسترس" FontSize="12" FontWeight="ExtraBold"
                                               Foreground="{StaticResource Brand700Brush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Line2Brush}" />

                        <Border Padding="14,10" Background="#fbfefd" BorderBrush="{StaticResource Brand100Brush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Path Grid.Column="0" Classes="icon" Width="14" Height="14"
                                      Stroke="{StaticResource Brand600Brush}" Data="{StaticResource IconClock}"
                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="مرحلهٔ ۲: نحوهٔ شروع ویزیت را انتخاب کنید"
                                           FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink2Brush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TodayText}" FontSize="12" FontWeight="ExtraBold"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- mode-split -->
                        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Classes="mode-tab second"
                                        Classes.is-active="{Binding IsBookedMode}"
                                        Command="{Binding SetModeCommand}" CommandParameter="appt">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <Border Classes="mode-ic" Classes.act="{Binding IsBookedMode}">
                                            <Path Classes="icon" Width="22" Height="22" Data="{StaticResource IconCalendar}"
                                                  Stroke="{StaticResource Brand700Brush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="گزینهٔ ۱" FontSize="11" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="نوبت از قبل رزرو شده" FontSize="16" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                                       Text="از میان نوبت‌های تأیید شدهٔ امروز این پزشک، یکی را انتخاب کنید و مستقیم وارد ویزیت شوید."
                                                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                            <Border Margin="0,6,0,0" Padding="10,4" CornerRadius="999"
                                                    Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brand600Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModeApptCountText}" FontSize="11.5"
                                                               FontWeight="ExtraBold" Foreground="{StaticResource Ink2Brush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="mode-tab"
                                        Classes.is-active="{Binding IsNewVisitMode}"
                                        Command="{Binding SetModeCommand}" CommandParameter="new">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <Border Classes="mode-ic mode-new" Classes.act="{Binding IsNewVisitMode}">
                                            <Path Classes="icon" Width="22" Height="22" Data="{StaticResource IconPlus}"
                                                  Stroke="#7b5cc4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="گزینهٔ ۲" FontSize="11" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="ویزیت جدید — بدون نوبت" FontSize="16" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                                       Text="مراجعهٔ حضوری بدون رزرو قبلی؛ بیمار موجود را انتخاب یا اطلاعات یک بیمار جدید را وارد کنید."
                                                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                            <Border Margin="0,6,0,0" Padding="10,4" CornerRadius="999"
                                                    Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" Fill="#7b5cc4" VerticalAlignment="Center" />
                                                    <TextBlock Text="پذیرش سریع" FontSize="11.5" FontWeight="ExtraBold"
                                                               Foreground="{StaticResource Ink2Brush}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- booked list -->
                        <StackPanel Margin="24,20,24,24" IsVisible="{Binding IsBookedMode}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,14">
                                <TextBlock Grid.Column="0" Text="{Binding BookedTitle}" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="field-search" MinWidth="240">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                                              Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconSearch}"
                                              VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Classes="search-input" Text="{Binding SearchText}"
                                                 PlaceholderText="جستجو بر اساس نام بیمار، سرپرست یا شماره…" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="visits:VisitTypeChipViewModel">
                                        <Button Classes="chip" Classes.is-active="{Binding IsActive}" Margin="0,0,6,6"
                                                Command="{Binding #Root.((visits:VisitsTriagePageViewModel)DataContext).SetTypeFilterCommand}"
                                                CommandParameter="{Binding FilterId}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding LabelBrush}" />
                                                <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Bold"
                                                           Opacity="0.8" Foreground="{Binding CountBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding BookedRows}" IsVisible="{Binding HasBookedRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="visits:BookedRowViewModel">
                                        <Button Classes="appt-row" Margin="0,0,0,8"
                                                Background="{Binding RowBackground}" BorderBrush="{Binding RowBorder}"
                                                Command="{Binding #Root.((visits:VisitsTriagePageViewModel)DataContext).StartFromTicketCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="72,40,*,Auto" ColumnSpacing="14">
                                                <Border Grid.Column="0" Padding="4,6" CornerRadius="10"
                                                        Background="{Binding TimeBackground}" VerticalAlignment="Center">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding TimeText}" FontSize="15" FontWeight="ExtraBold"
                                                                   Foreground="{Binding TimeForeground}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding DurationText}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{Binding TimeForeground}" Opacity="0.85" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12"
                                                        Background="{Binding PetAvatarBackground}" VerticalAlignment="Center">
                                                    <Path Classes="icon" Width="22" Height="22"
                                                          Stroke="{Binding PetAvatarForeground}"
                                                          Data="{Binding PetIconKey, Converter={StaticResource IconKeyConverter}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding PatientName}" FontSize="14.5" FontWeight="ExtraBold"
                                                                   Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="· " /><Run Text="{Binding PatientKind}" />
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Border Width="8" Height="8" CornerRadius="3" Background="{Binding TypeAccent}" />
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11.5" FontWeight="Bold"
                                                                       Foreground="{StaticResource Ink2Brush}" />
                                                        </StackPanel>
                                                        <controls:Badge Text="اورژانس" Tone="Danger" IsVisible="{Binding IsUrgent}" />
                                                        <controls:Badge Text="{Binding StateText}" Tone="{Binding StateTone}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Path Classes="icon" Width="12" Height="12" Stroke="{StaticResource MutedBrush}"
                                                              Data="{StaticResource IconUsers}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding OwnerName}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding OwnerPhone}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="3" Classes="row-cta" Classes.urgent="{Binding IsUrgent}"
                                                        VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="شروع ویزیت" VerticalAlignment="Center" />
                                                        <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                                              Data="{StaticResource IconChevronRight}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border IsVisible="{Binding IsBookedListEmpty}" Padding="20,40" CornerRadius="14"
                                    Background="#fbfcfb" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Path Classes="icon" Width="28" Height="28" Stroke="{StaticResource MutedBrush}"
                                              Data="{StaticResource IconCalendar}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding EmptyListTitle}" FontSize="15" FontWeight="ExtraBold"
                                               Foreground="{StaticResource Ink2Brush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EmptyListSubtitle}" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14"
                                               HorizontalAlignment="Center" />
                                    <Button Classes="row-cta" HorizontalAlignment="Center"
                                            Command="{Binding SetModeCommand}" CommandParameter="new">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                                  Data="{StaticResource IconPlus}" VerticalAlignment="Center" />
                                            <TextBlock Text="شروع ویزیت جدید بدون نوبت" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- new-visit form -->
                        <StackPanel Margin="24,20,24,24" Spacing="16" IsVisible="{Binding IsNewVisitMode}">
                            <Border Classes="form-card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasNoPickedPatient}">
                                            <Border Classes="step-num">
                                                <TextBlock Text="۱" FontSize="12" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource Brand700Brush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="انتخاب بیمار" FontSize="12.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPickedPatient}">
                                            <Border Classes="step-num">
                                                <TextBlock Text="۱" FontSize="12" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource Brand700Brush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="بیمار انتخاب شد" FontSize="12.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="می‌توانید بیمار موجود یا جدید ثبت کنید"
                                                   FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" IsVisible="{Binding HasNoPickedPatient}" />
                                        <TextBlock Grid.Column="1" Text="از پایگاه بیماران"
                                                   FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" IsVisible="{Binding HasPickedPatient}" />
                                    </Grid>

                                    <StackPanel IsVisible="{Binding HasNoPickedPatient}" Spacing="6">
                                        <Border Classes="field-search" HorizontalAlignment="Stretch" MinWidth="0">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                                                      Stroke="{StaticResource MutedBrush}" Data="{StaticResource IconSearch}"
                                                      VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Classes="search-input" Text="{Binding PatientSearchText}"
                                                         PlaceholderText="جستجوی بیمار: نام حیوان، سرپرست یا شماره تماس (حداقل ۲ حرف)…" />
                                            </Grid>
                                        </Border>
                                        <ProgressBar IsIndeterminate="True" Height="3" MinHeight="0"
                                                     IsVisible="{Binding IsPatientSearching}" />
                                        <TextBlock Text="{Binding PatientResultCount}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{StaticResource MutedBrush}" Margin="4,0"
                                                   IsVisible="{Binding HasPatientMatches}" />
                                        <TextBlock Text="{Binding PatientSearchMessage}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedBrush}" Margin="4,2"
                                                   IsVisible="{Binding ShowPatientSearchMessage}" />
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                                      IsVisible="{Binding HasPatientMatches}">
                                        <ItemsControl ItemsSource="{Binding PatientMatches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vcontracts:VisitPatientRef">
                                                    <Button Classes="patient-opt"
                                                            Command="{Binding #Root.((visits:VisitsTriagePageViewModel)DataContext).PickPatientCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                                                    Background="{StaticResource Brand50Brush}">
                                                                <Path Classes="icon" Width="18" Height="18" Stroke="{StaticResource Brand700Brush}"
                                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="ExtraBold"
                                                                           Foreground="{StaticResource InkBrush}" />
                                                                <TextBlock Text="{Binding Kind}" FontSize="11.5" FontWeight="Bold"
                                                                           Foreground="{StaticResource MutedBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Phone}" FontSize="11.5"
                                                                       FontWeight="Bold" Foreground="{StaticResource Muted2Brush}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>

                                        <Button Classes="newpatient-btn" Margin="0,6,0,0"
                                                Command="{Binding RegisterNewPatientCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Classes="icon" Width="14" Height="14" Stroke="{StaticResource Brand700Brush}"
                                                      Data="{StaticResource IconPlus}" VerticalAlignment="Center" />
                                                <TextBlock Text="ثبت سرپرست و بیمار جدید" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border IsVisible="{Binding HasPickedPatient}" Padding="14,12" CornerRadius="12"
                                            BorderBrush="{StaticResource Brand100Brush}" BorderThickness="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Offset="0" Color="{StaticResource Brand50Color}" />
                                                <GradientStop Offset="1" Color="#FFFFFFFF" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                                                    Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource Brand100Brush}" BorderThickness="1">
                                                <Path Classes="icon" Width="24" Height="24"
                                                      Stroke="{Binding PickedPatientGlyph}"
                                                      Data="{Binding PickedPatientIconKey, Converter={StaticResource IconKeyConverter}}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock FontSize="14.5" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}">
                                                    <Run Text="{Binding PickedPatientName}" /><Run Text=" · " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding PickedPatientKind}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="{StaticResource Ink2Brush}">
                                                    <Run Text="سرپرست: " /><Run Text="{Binding PickedPatientOwner}" FontWeight="Bold" /><Run Text="   " /><Run Text="{Binding PickedPatientPhone}" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="outline" Padding="10,6" FontSize="12"
                                                    VerticalAlignment="Center" Content="تغییر"
                                                    Command="{Binding ChangePatientCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Classes="form-card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="step-num">
                                                <TextBlock Text="۲" FontSize="12" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource Brand700Brush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="نوع ویزیت" FontSize="12.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="با انتخاب نوع، مدت پیش‌فرض تعیین می‌شود"
                                                   FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Types}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="visits:VisitTypeOptionViewModel">
                                                <Button Classes="type-opt" Classes.is-active="{Binding IsSelected}"
                                                        Margin="0,0,8,8"
                                                        Command="{Binding #Root.((visits:VisitsTriagePageViewModel)DataContext).SetTypeCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="32" Height="32" CornerRadius="10" Background="{Binding IconTileBackground}">
                                                            <Path Classes="icon" Width="16" Height="16" Stroke="{Binding IconGlyph}"
                                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="ExtraBold"
                                                                       Foreground="{StaticResource InkBrush}" />
                                                            <TextBlock Text="{Binding DurationText}" FontSize="10.5" FontWeight="Bold"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="form-card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="step-num">
                                                <TextBlock Text="۳" FontSize="12" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource Brand700Brush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="اولویت" FontSize="12.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="اورژانس در صف با علامت هشدار نمایش داده می‌شود"
                                                   FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0" Classes="prio-opt normal"
                                                Classes.is-active="{Binding !IsUrgent}"
                                                Command="{Binding SetPriorityCommand}" CommandParameter="normal">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="عادی" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="در نوبت طبیعی قرار می‌گیرد" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="prio-opt urgent"
                                                Classes.is-active="{Binding IsUrgent}"
                                                Command="{Binding SetPriorityCommand}" CommandParameter="urgent">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="اورژانس" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="در ابتدای صف قرار می‌گیرد" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="form-card">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="step-num">
                                                <TextBlock Text="۴" FontSize="12" FontWeight="ExtraBold"
                                                           Foreground="{StaticResource Brand700Brush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="یادداشت پذیرش (اختیاری)" FontSize="12.5" FontWeight="ExtraBold"
                                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="مثلاً علت مراجعه یا نکاتی که دکتر باید بداند"
                                                   FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBox Classes="fld-input" MinHeight="74" AcceptsReturn="True" TextWrapping="Wrap"
                                             Text="{Binding NoteText}"
                                             PlaceholderText="مثلاً: بی‌اشتهایی از دیروز، تب خفیف در لمس، سابقهٔ حساسیت به آموکسی‌سیلین…" />
                                </StackPanel>
                            </Border>

                            <Button Classes="go-btn" Command="{Binding StartNewCommand}" IsEnabled="{Binding CanStartNew}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Classes="icon" Width="18" Height="18" Stroke="White"
                                          Data="{StaticResource IconPlay}" VerticalAlignment="Center" />
                                    <TextBlock Text="شروع ویزیت جدید" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
