<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:login="using:Animora.Desktop.Pages.Login"
        x:Class="Animora.Desktop.Pages.Login.LoginWindow"
        x:DataType="login:LoginViewModel"
        Icon="avares://Animora.Desktop/Assets/Brand/vetplus.ico"
        Title="ورود — وت‌پلاس"
        Width="960"
        Height="620"
        MinWidth="820"
        MinHeight="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}">

    <Window.Styles>
        <!-- Minimal, brand-aligned input field for the login form.
             Explicit dark ink (Foreground) is set so typed text is readable:
             the LoginWindow is a standalone Window and does not always inherit
             App.axaml's global TextBox foreground, which left the entered text
             white/invisible. -->
        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Brand600Brush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Keep the ink foreground stable across pointer-over / focus template
             states so the text never flips to a theme-default light colour. -->
        <Style Selector="TextBox.field /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="Margin" Value="2,0,2,7" />
        </Style>
    </Window.Styles>

    <!-- Two deterministic physical columns (LeftToRight) so the teal brand
         panel is always on the left and the form on the right, regardless of
         RTL mirroring. Text inside each panel keeps RTL flow. -->
    <Grid ColumnDefinitions="1.05*,1*" FlowDirection="LeftToRight">

        <!-- Brand panel -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="{StaticResource Brand800Color}" Offset="0" />
                    <GradientStop Color="{StaticResource Brand600Color}" Offset="0.55" />
                    <GradientStop Color="{StaticResource Brand500Color}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Panel>
                <!-- soft decorative glow circles -->
                <Ellipse Width="360" Height="360"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-120,-120,0" Opacity="0.16" Fill="White" />
                <Ellipse Width="240" Height="240"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-80,0,0,-80" Opacity="0.12" Fill="White" />

                <StackPanel FlowDirection="RightToLeft"
                            VerticalAlignment="Center"
                            Margin="48,0"
                            Spacing="18">
                    <!-- Brand logo: the VetPlus guardian-shield paw mark. The
                         transparent PNG reads cleanly over the teal panel; a
                         soft frosted plate behind it lifts it off the gradient. -->
                    <Border Width="76" Height="76"
                            CornerRadius="20"
                            Background="#26FFFFFF"
                            HorizontalAlignment="Right"
                            Padding="10">
                        <Image Width="56" Height="56"
                               Stretch="Uniform"
                               Source="avares://Animora.Desktop/Assets/Brand/vetplus-mark-clean-256.png" />
                    </Border>
                    <TextBlock Text="وت‌پلاس"
                               FontSize="34"
                               FontWeight="ExtraBold"
                               Foreground="White" />
                    <TextBlock Text="سامانه هوشمند مدیریت کلینیک دامپزشکی"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Medium"
                               Foreground="#E6FFFFFF" />
                    <TextBlock TextWrapping="Wrap"
                               MaxWidth="360"
                               HorizontalAlignment="Right"
                               FontSize="{StaticResource FontSizeSm}"
                               LineHeight="24"
                               Foreground="#B8FFFFFF"
                               Text="مدیریت پذیرش، پرونده بیماران، نوبت‌دهی، انبار و حسابداری — همه در یک محیط یکپارچه و امن." />
                </StackPanel>
            </Panel>
        </Border>

        <!-- Form panel -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}">
            <StackPanel FlowDirection="RightToLeft"
                        VerticalAlignment="Center"
                        Margin="44,0"
                        Spacing="0">

                <TextBlock Text="ورود به حساب"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="برای ادامه، اطلاعات کاربری خود را وارد کنید."
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,26" />

                <!-- error banner -->
                <Border IsVisible="{Binding HasError}"
                        Background="{StaticResource DangerBgBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12,10"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource DangerBrush}"
                              VerticalAlignment="Center"
                              Data="{StaticResource IconAlert}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Border>

                <!-- username -->
                <TextBlock Classes="label" Text="نام کاربری" />
                <TextBox Classes="field"
                         PlaceholderText="admin"
                         Text="{Binding Username, Mode=TwoWay}" />

                <!-- password -->
                <TextBlock Classes="label" Text="رمز عبور" Margin="2,18,2,7" />
                <TextBox Classes="field"
                         PasswordChar="•"
                         PlaceholderText="••••••"
                         Text="{Binding Password, Mode=TwoWay}" />

                <Button Classes="primary"
                        Content="ورود"
                        Height="46"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="{StaticResource FontSizeMd}"
                        Margin="0,28,0,0"
                        Command="{Binding SignInCommand}"
                        IsDefault="True" />

                <!-- Server connection indicator: lets the user tell an internet/server outage
                     apart from a wrong password before they even try to sign in. -->
                <Border Background="{StaticResource Bg2Brush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12,9"
                        Margin="0,20,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- status dot: one colour visible per state -->
                        <Panel Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource OkBrush}"
                                     IsVisible="{Binding IsServerOnline}" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource DangerBrush}"
                                     IsVisible="{Binding IsServerOffline}" />
                            <Ellipse Width="10" Height="10" Fill="{StaticResource MutedBrush}"
                                     IsVisible="{Binding IsServerChecking}" />
                        </Panel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConnectivityText}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink2Brush}" />

                        <Button Grid.Column="2"
                                Classes="ghost"
                                Content="بررسی مجدد"
                                FontSize="{StaticResource FontSizeXs}"
                                Padding="8,4"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding CheckConnectivityCommand}" />
                    </Grid>
                </Border>

                <!-- Real local authentication: there are no built-in demo credentials. -->
                <Border Background="{StaticResource Bg2Brush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12,10"
                        Margin="0,14,0,0">
                    <TextBlock FontSize="{StaticResource FontSizeXs}"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="با حسابی که در راه‌اندازی اولیه ساخته‌اید وارد شوید؛ حساب یا رمز پیش‌فرض وجود ندارد." />
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>
