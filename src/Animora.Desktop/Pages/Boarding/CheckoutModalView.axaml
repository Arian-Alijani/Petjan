<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:boarding="using:Animora.Desktop.Pages.Boarding"
             x:Class="Animora.Desktop.Pages.Boarding.CheckoutModalView"
             x:Name="Root"
             x:DataType="boarding:CheckoutModalViewModel"
             Width="520"
             MaxWidth="520"
             FlowDirection="RightToLeft">

    <!-- Checkout modal — re-draws Animora-UI/assets/boarding.js
         openCheckoutModal (.modal). Values from boarding.css (.bd-modal-hint/
         .bd-warn-banner) + styles.css (.modal-header/…). -->
    <UserControl.Styles>
        <Style Selector="Button.mclose">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- modal-header -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="22,18,22,6">
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                    Background="{StaticResource Brand50Brush}">
                <Path Classes="icon" Width="20" Height="20" Stroke="{StaticResource Brand700Brush}"
                      Data="{StaticResource IconHome}" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="تخلیه" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Brand600Brush}" />
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="ExtraBold"
                           Foreground="{StaticResource InkBrush}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="mclose" Command="{Binding CancelCommand}"
                    VerticalAlignment="Top" ToolTip.Tip="بستن">
                <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource MutedBrush}"
                      Data="{StaticResource IconX}" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- modal-body -->
        <StackPanel Margin="22,14,22,20">
            <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                       Foreground="{StaticResource Ink2Brush}">
                <Run Text="اتاق " /><Run Text="{Binding RoomText}" FontWeight="ExtraBold" /><Run Text=" آزاد می‌شود و اقامت به بخش «تخلیه‌شده» منتقل می‌گردد." />
            </TextBlock>

            <!-- warning banner (.bd-warn-banner) -->
            <Border Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0"
                    IsVisible="{Binding ShowTransferWarning}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource WarnBrush}"
                          Data="{StaticResource IconAlert}" VerticalAlignment="Center" />
                    <TextBlock Text="فاکتور هنوز به صندوق منتقل نشده است — پس از تخلیه نیز می‌توان انتقال داد."
                               FontSize="12.5" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- modal-footer -->
        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0" Padding="22,14,22,20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Command="{Binding ConfirmCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Width="15" Height="15" Stroke="White"
                              Data="{StaticResource IconCheck}" VerticalAlignment="Center" />
                        <TextBlock Text="تأیید تخلیه" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding CancelCommand}" Content="انصراف" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
