<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:boarding="using:Animora.Desktop.Pages.Boarding"
             x:Class="Animora.Desktop.Pages.Boarding.BoardingCatalogModalView"
             x:Name="Root"
             x:DataType="boarding:BoardingCatalogModalViewModel"
             Width="500"
             MaxWidth="500"
             MaxHeight="720"
             FlowDirection="RightToLeft">

    <!-- Boarding catalog picker — mirrors the Sales catalog modal
         (Pages/Sales/CatalogModalView.axaml) exactly in look and behavior
         (head keyboard hints, Ctrl K search, source filter chips with counts,
         recent strip, highlight-on-search dense rows), fed by the boarding
         selectable-items source and adding each line to the stay/room. -->
    <UserControl.Styles>
        <Style Selector="Button.catf">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.catf:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
        </Style>
        <Style Selector="Button.catf.on">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Border.catf-ct">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <Style Selector="Border.catf-ct.on">
            <Setter Property="Background" Value="#33ffffff" />
        </Style>
        <Style Selector="Button.cat-chip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="6,6,10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cat-chip:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Brand500Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.cat-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.cat-row:pointerover">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
        </Style>
        <Style Selector="Button.cat-row.hl">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ═══ head ═══ -->
        <Border Grid.Row="0" Padding="22,18,22,12"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="افزودن خدمت یا کالا" FontSize="16" FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="↑" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" />
                        </Border>
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="↓" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" />
                        </Border>
                        <TextBlock Text="جابجایی" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{StaticResource Muted2Brush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Enter" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" />
                        </Border>
                        <TextBlock Text="افزودن" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{StaticResource Muted2Brush}"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Esc" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}" />
                        </Border>
                        <TextBlock Text="بستن" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                        Background="{StaticResource BgBrush}" BorderThickness="0" CornerRadius="8"
                        VerticalAlignment="Top" Command="{Binding BackCommand}" Cursor="Hand">
                    <Path Classes="icon" Width="18" Height="18" Stroke="{StaticResource MutedBrush}"
                          Data="{StaticResource IconX}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ═══ search ═══ -->
        <Grid Grid.Row="1" Margin="22,14,22,10">
            <TextBox Text="{Binding Query}" MinHeight="0"
                     Padding="44,11,44,11" FontSize="14" FontWeight="Medium"
                     BorderBrush="{StaticResource Brand400Brush}" BorderThickness="1.5"
                     CornerRadius="12" Background="{StaticResource PanelBrush}"
                     PlaceholderText="جستجوی نام، دستهٔ خدمت یا کالا…"
                     VerticalContentAlignment="Center" />
            <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Muted2Brush}"
                  Data="{StaticResource IconSearch}" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0,0,16,0" IsHitTestVisible="False" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                    Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="7,3">
                <TextBlock Text="Ctrl K" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}" />
            </Border>
        </Grid>

        <!-- ═══ filters ═══ -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" Padding="22,4,22,12">
            <ItemsControl ItemsSource="{Binding Filters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="boarding:BoardingCatalogFilterViewModel">
                        <Button Classes="catf" Classes.on="{Binding IsActive}"
                                Command="{Binding $parent[UserControl].((boarding:BoardingCatalogModalViewModel)DataContext).SetFilterCommand}"
                                CommandParameter="{Binding Key}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                <Border Classes="catf-ct" Classes.on="{Binding IsActive}">
                                    <TextBlock Text="{Binding CountText}" FontSize="10"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource Muted2Brush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══ body ═══ -->
        <ScrollViewer Grid.Row="3" Padding="12,8,12,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- recent strip -->
                <StackPanel IsVisible="{Binding HasRecent}" Margin="10,10,10,6" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Width="11" Height="11" Stroke="{StaticResource MutedBrush}"
                              Data="{StaticResource IconClock}" VerticalAlignment="Center" />
                        <TextBlock Text="اخیراً استفاده شده" FontSize="10" FontWeight="ExtraBold"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="boarding:BoardingCatalogRecentChipViewModel">
                                <Button Classes="cat-chip" Margin="0,0,6,6"
                                        Command="{Binding $parent[UserControl].((boarding:BoardingCatalogModalViewModel)DataContext).AddCommand}"
                                        CommandParameter="{Binding Ref}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="20" Height="20" CornerRadius="6"
                                                Background="{Binding IcoBackground}">
                                            <Path Classes="icon" Width="11" Height="11"
                                                  Stroke="{Binding IcoForeground}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- rows -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="boarding:BoardingCatalogRowViewModel">
                            <Button Classes="cat-row" Classes.hl="{Binding IsHighlighted}"
                                    Command="{Binding $parent[UserControl].((boarding:BoardingCatalogModalViewModel)DataContext).AddCommand}"
                                    CommandParameter="{Binding Ref}">
                                <Grid ColumnDefinitions="36,*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{Binding IcoBackground}">
                                        <Path Classes="icon" Width="16" Height="16"
                                              Stroke="{Binding IcoForeground}"
                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PreText}" FontSize="13.5"
                                                       FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MatchText}" FontSize="13.5"
                                                       FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"
                                                       Background="#73ffcd58" IsVisible="{Binding HasMatch}" />
                                            <TextBlock Text="{Binding PostText}" FontSize="13.5"
                                                       FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{Binding IcoBackground}" CornerRadius="4"
                                                    Padding="6,1">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding IcoForeground}" />
                                            </Border>
                                            <TextBlock Text="{Binding GroupLabel}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceText}" FontSize="13" FontWeight="ExtraBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="ت" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="30" Height="30" CornerRadius="8"
                                            Background="{StaticResource Brand600Brush}"
                                            VerticalAlignment="Center">
                                        <Path Classes="icon" Width="14" Height="14" Stroke="White"
                                              StrokeThickness="2.5" Data="{StaticResource IconPlus}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- empty -->
                <TextBlock IsVisible="{Binding !HasRows}" Text="هیچ آیتمی با این جستجو یافت نشد"
                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="24,60" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ foot ═══ -->
        <Border Grid.Row="4" Padding="22,10" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="{Binding CountText}" FontSize="11"
                           FontWeight="Bold" Foreground="{StaticResource Brand700Brush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Right" TextWrapping="Wrap" Margin="10,0,0,0"
                           Text="می‌تونی چند بار کلیک کنی تا تعداد بیشتری اضافه بشه — یا از داخل اقامت تعداد رو تنظیم کن." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
