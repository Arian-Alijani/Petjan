<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:boarding="using:Animora.Desktop.Pages.Boarding"
             x:Class="Animora.Desktop.Pages.Boarding.BoardingSettingsTabView"
             x:Name="Root"
             x:DataType="boarding:BoardingPageViewModel"
             FlowDirection="RightToLeft">

    <!-- Settings tab — live, editable view of the rooms (with occupancy) and the boarding
         services. Rooms are added/edited through RoomEditModal (Create/UpdateRoomCommand); services
         reuse the shared service-rate editor (Create/UpdateServiceRateCommand, Source=Boarding). -->
    <UserControl.Styles>
        <Style Selector="Border.scard">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
            <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
        </Style>
        <Style Selector="TextBlock.seyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="TextBlock.stitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Border.rate-row">
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Border.room-tile">
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource BgBrush}" />
        </Style>
        <Style Selector="Border.room-tile.off">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.svc-row.off">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.sicon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.room-tile.occupied">
            <Setter Property="BorderBrush" Value="{StaticResource Brand100Brush}" />
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" VerticalAlignment="Top">

        <!-- ═══ card · اتاق‌ها و باکس‌ها ═══ -->
        <Border Grid.Column="0" Classes="scard">
            <StackPanel>
                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Classes="seyebrow" Text="ظرفیت" VerticalAlignment="Center" />
                            <TextBlock Classes="stitle" Text="اتاق‌ها و باکس‌ها" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="hy-pager" HorizontalAlignment="Right"
                                Command="{Binding AddRoomCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Width="13" Height="13" StrokeThickness="2.5"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      Data="{StaticResource IconPlus}" />
                                <TextBlock Text="اتاق جدید" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Margin="18">
                    <ItemsControl ItemsSource="{Binding RoomTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="boarding:BoardingRoomTileViewModel">
                                <Border Classes="room-tile" Classes.occupied="{Binding IsOccupied}" Classes.off="{Binding IsOutOfService}"
                                        Margin="0,0,10,10">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                            <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                                                  Stroke="{StaticResource Brand600Brush}" VerticalAlignment="Center"
                                                  Data="{Binding SpeciesIconKey, Converter={StaticResource IconKeyConverter}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                       FontWeight="ExtraBold" Foreground="{StaticResource InkBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Background="{StaticResource LilacBgBrush}"
                                                    CornerRadius="7" Padding="7,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="#7b5cc4" />
                                            </Border>
                                            <Button Grid.Column="3" Classes="sicon" ToolTip.Tip="ویرایش اتاق"
                                                    Command="{Binding #Root.((boarding:BoardingPageViewModel)DataContext).EditRoomCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Classes="icon" Width="13" Height="13"
                                                      Stroke="{StaticResource MutedBrush}"
                                                      Data="{StaticResource IconEdit}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,0,0,6"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding HasName}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center"
                                                      Data="{StaticResource IconHome}"
                                                      Stroke="{StaticResource Brand700Brush}"
                                                      IsVisible="{Binding IsOccupied}" />
                                                <Path Classes="icon" Width="14" Height="14" VerticalAlignment="Center"
                                                      Data="{StaticResource IconCheck}"
                                                      Stroke="{StaticResource OkBrush}"
                                                      IsVisible="{Binding IsAvailable}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{StaticResource Brand700Brush}"
                                                           VerticalAlignment="Center" IsVisible="{Binding IsOccupied}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{StaticResource OkBrush}"
                                                           VerticalAlignment="Center" IsVisible="{Binding IsAvailable}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Center" IsVisible="{Binding IsOutOfService}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CapacityText}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ card · خدمات اختصاصی پانسیون ═══ -->
        <Border Grid.Column="1" Classes="scard">
            <StackPanel>
                <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1" Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Classes="seyebrow" Text="خدمات" VerticalAlignment="Center" />
                            <TextBlock Classes="stitle" Text="خدمات اختصاصی پانسیون" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="hy-pager" HorizontalAlignment="Right"
                                Command="{Binding AddBoardingServiceCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Width="13" Height="13" StrokeThickness="2.5"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      Data="{StaticResource IconPlus}" />
                                <TextBlock Text="خدمت جدید" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Margin="18">
                    <ItemsControl ItemsSource="{Binding ServiceRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="boarding:BoardingServiceRowViewModel">
                                <Border Classes="svc-row" Classes.off="{Binding IsInactive}"
                                        BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="12.5"
                                                   FontWeight="ExtraBold" Foreground="{StaticResource Brand700Brush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Classes="sicon" ToolTip.Tip="ویرایش خدمت"
                                                Command="{Binding #Root.((boarding:BoardingPageViewModel)DataContext).EditBoardingServiceCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Width="13" Height="13"
                                                  Stroke="{StaticResource MutedBrush}"
                                                  Data="{StaticResource IconEdit}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
