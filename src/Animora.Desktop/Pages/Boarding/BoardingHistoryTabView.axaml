<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:boarding="using:Animora.Desktop.Pages.Boarding"
             xmlns:controls="using:Animora.Desktop.Controls"
             x:Class="Animora.Desktop.Pages.Boarding.BoardingHistoryTabView"
             x:Name="Root"
             x:DataType="boarding:BoardingHistoryViewModel"
             FlowDirection="RightToLeft">
    <!-- Chrome + row visuals come from the app-level unified History styles
         (Resources/Controls/HistoryRow.axaml: .hy-* + HistoryRowTemplate) so this
         tab is pixel-identical to the main History page. -->

    <StackPanel>

        <!-- ═══ Toolbar — mirrors the Sales/History ledger toolbar ═══ -->
        <Border Classes="hy-toolbar">
            <StackPanel Spacing="12">

                <!-- tier 1 · search (start) + range presets (end) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Classes="hy-search">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Path Grid.Column="0" Classes="icon" Width="16" Height="16"
                                  VerticalAlignment="Center"
                                  Stroke="{StaticResource MutedBrush}"
                                  Data="{StaticResource IconSearch}" IsHitTestVisible="False" />
                            <TextBox Grid.Column="1" Classes="hy-search" Text="{Binding SearchText}"
                                     PlaceholderText="{Binding SearchPlaceholder}" />
                            <Button Grid.Column="2" Classes="hy-search-clear"
                                    IsVisible="{Binding HasSearchValue}"
                                    Command="{Binding ClearSearchCommand}">
                                <Path Classes="icon" Width="11" Height="11"
                                      Stroke="{StaticResource Brand700Brush}"
                                      Data="{StaticResource IconX}" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding RangeChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="boarding:BoardingHistoryRangeViewModel">
                                    <Button Classes="hy-chip" Classes.on="{Binding IsActive}"
                                            Content="{Binding Label}"
                                            Command="{Binding #Root.((boarding:BoardingHistoryViewModel)DataContext).SetRangeCommand}"
                                            CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- tier 2 · kind chips (start) + date range + species/sort/page controls (end) -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                    <StackPanel Grid.Column="0">
                        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,-12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <!-- «همه» — activate every kind filter at once. -->
                                <Button Classes="hy-chip" Classes.on="{Binding AreAllKindsActive}"
                                        Margin="0,0,7,0" ToolTip.Tip="فعال‌سازی همهٔ فیلترها"
                                        Command="{Binding SelectAllKindsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Width="14" Height="14"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource IconCheck}"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="همه" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <ItemsControl ItemsSource="{Binding KindChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="boarding:BoardingHistoryKindChipViewModel">
                                            <Button Classes="hy-cat-chip" Classes.on="{Binding IsActive}"
                                                    Margin="0,0,7,0" ToolTip.Tip="{Binding Label}"
                                                    Background="{Binding ChipBackground}"
                                                    BorderBrush="{Binding ChipBorder}"
                                                    Command="{Binding #Root.((boarding:BoardingHistoryViewModel)DataContext).ToggleKindCommand}"
                                                    CommandParameter="{Binding Kind}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Classes="icon" Width="14" Height="14"
                                                          Stroke="{Binding ColorBrush}"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                               Foreground="{Binding LabelBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <!-- free date range -->
                        <controls:JalaliDatePicker Width="140" DateValue="{Binding FromDate, Mode=TwoWay}"
                                                   ToolTip.Tip="از تاریخ" />
                        <TextBlock Text="تا" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <controls:JalaliDatePicker Width="140" DateValue="{Binding ToDate, Mode=TwoWay}"
                                                   ToolTip.Tip="تا تاریخ" />
                        <Button Classes="hy-pager" Padding="10,7" Command="{Binding ClearRangeCommand}"
                                ToolTip.Tip="حذف بازهٔ تاریخ">
                            <Path Classes="icon" Width="12" Height="12"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  Data="{StaticResource IconX}" />
                        </Button>

                        <Border Classes="hy-toolbar-sep" />

                        <!-- species filter (boarding-specific) -->
                        <ComboBox Classes="hy-select" MinWidth="130" SelectedIndex="{Binding SpeciesIndex}"
                                  ToolTip.Tip="فیلتر گونه">
                            <ComboBoxItem Content="همه گونه‌ها" />
                            <ComboBoxItem Content="سگ" />
                            <ComboBoxItem Content="گربه" />
                            <ComboBoxItem Content="پرنده" />
                            <ComboBoxItem Content="خرگوش" />
                        </ComboBox>

                        <ComboBox Classes="hy-select" MinWidth="150" SelectedIndex="{Binding SortIndex}"
                                  ToolTip.Tip="مرتب‌سازی">
                            <ComboBoxItem Content="جدیدترین" />
                            <ComboBoxItem Content="قدیمی‌ترین" />
                            <ComboBoxItem Content="بیشترین مبلغ" />
                            <ComboBoxItem Content="کمترین مبلغ" />
                        </ComboBox>
                        <ComboBox Classes="hy-select" MinWidth="110" SelectedIndex="{Binding PageSizeIndex}"
                                  ToolTip.Tip="تعداد رکورد در صفحه">
                            <ComboBoxItem Content="۲۵ رکورد" />
                            <ComboBoxItem Content="۵۰ رکورد" />
                            <ComboBoxItem Content="۱۰۰ رکورد" />
                        </ComboBox>

                        <Button Classes="hy-pager" Command="{Binding ResetFiltersCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon" Width="13" Height="13"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      Data="{StaticResource IconRefresh}" />
                                <TextBlock Text="بازنشانی" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ Empty state ═══ -->
        <Grid IsVisible="{Binding IsEmpty}">
            <StackPanel>
                <Border Classes="hy-summary" HorizontalAlignment="Stretch">
                    <TextBlock Text="نتیجه‌ای یافت نشد" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" />
                </Border>
                <Border Classes="hy-ledger">
                    <StackPanel Margin="0,64,0,64" HorizontalAlignment="Center" Spacing="10">
                        <Border Classes="hy-empty-icon" HorizontalAlignment="Center">
                            <Path Classes="icon" Width="26" Height="26"
                                  Stroke="{StaticResource Muted2Brush}"
                                  Data="{StaticResource IconTimeline}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="هیچ رویدادی در این بازه یافت نشد" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource Ink2Brush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="بازهٔ تاریخ، نوع رویداد یا عبارت جستجو را تغییر دهید." FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ Populated: summary bar + table + pager ═══ -->
        <StackPanel IsVisible="{Binding HasRows}">
            <Border Classes="hy-summary">
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryCountText}" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Border Classes="hy-summary-sep" />
                    <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                        <Run Text="ورودی: " />
                        <Run Text="{Binding SummaryInflowText}" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                    </TextBlock>
                    <Border Classes="hy-summary-sep" />
                    <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                        <Run Text="خروجی: " />
                        <Run Text="{Binding SummaryOutflowText}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </TextBlock>
                    <Border Classes="hy-summary-sep" />
                    <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                        <Run Text="خالص: " />
                        <Run Text="{Binding SummaryNetText}" FontWeight="Bold" Foreground="{Binding SummaryNetBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Classes="hy-ledger">
                <StackPanel>
                    <ContentControl Template="{StaticResource HistoryLedgerHeadTemplate}" />

                    <ListBox Classes="hy-ledger-body" ItemsSource="{Binding Rows}"
                             ItemTemplate="{StaticResource HistoryRowTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <!-- pager -->
                    <Border Classes="hy-pager-bar">
                        <Grid ColumnDefinitions="*,Auto,Auto,*" ColumnSpacing="10">
                            <Button Grid.Column="1" Classes="hy-pager" Command="{Binding PrevPageCommand}"
                                    IsEnabled="{Binding HasPrev}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{StaticResource IconChevronRight}" />
                                    <TextBlock Text="قبلی" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="2" MinWidth="88" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageText}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{StaticResource Ink2Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="3" Classes="hy-pager" HorizontalAlignment="Left"
                                    Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="بعدی" />
                                    <Path Classes="icon" Width="13" Height="13"
                                          Stroke="{Binding $parent[Button].Foreground}"
                                          Data="{StaticResource IconChevronLeft}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
