<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Animora.Desktop.Controls.StatCard"
             FlowDirection="RightToLeft">

    <!-- KPI stat card, Material-Design-3 outlined style, fully RTL.
         The card is authored RightToLeft so every "Start/leading" edge is the
         RIGHT and every "End/trailing" edge is the LEFT — matching the Persian
         reference (dashboard-views.js .stat-head, justify-content:space-between).
         Header row: delta chip on the leading (right) side, tinted icon tile on
         the trailing (left) side. Value / label / foot are a leading-aligned
         (right) block. -->
    <Border Classes="card" Padding="18,16" MinHeight="132">
        <StackPanel Spacing="14">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Delta chip: leading edge (right in RTL) -->
                <Border x:Name="DeltaChip"
                        Grid.Column="0"
                        CornerRadius="10"
                        Padding="8,3"
                        Background="{StaticResource OkBgBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="DeltaText"
                               FontSize="{StaticResource FontSizeXs}"
                               FontWeight="Bold"
                               Foreground="{StaticResource OkBrush}" />
                </Border>

                <!-- Icon tile: trailing edge (left in RTL) -->
                <Border x:Name="IconTile"
                        Grid.Column="2"
                        Width="42"
                        Height="42"
                        CornerRadius="13"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Background="{StaticResource Brand50Brush}"
                        BorderBrush="{StaticResource Brand100Brush}">
                    <Path x:Name="IconPath"
                          Classes="icon"
                          Width="19"
                          Height="19"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{StaticResource Brand600Brush}" />
                </Border>
            </Grid>

            <StackPanel Spacing="3" HorizontalAlignment="Stretch">
                <TextBlock x:Name="ValueText"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="ExtraBold"
                           TextAlignment="Start"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="LabelText"
                           FontSize="{StaticResource FontSizeSm}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Start"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="FootText"
                           FontSize="{StaticResource FontSizeXs}"
                           TextAlignment="Start"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource Muted2Brush}"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
