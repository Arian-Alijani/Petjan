<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Guarantee the Avalonia XAML compiler always runs for this assembly.
         Without this, a build where CoreCompile is skipped (stale obj/, an
         incremental up-to-date hit, or a design-time build promoted to a real
         one) can emit Animora.Desktop.dll WITHOUT the CompiledAvaloniaXaml
         resource. At runtime AvaloniaXamlLoader.Load(this) in App.Initialize()
         then throws:
           "No precompiled XAML found for Animora.Desktop.App ...".
         Forcing this true makes the CompileAvaloniaXaml target's condition
         ($(EnableAvaloniaXamlCompilation) != false) always satisfied. -->
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
    <!-- AVLN3001: Windows/UserControls in this app are always created through
         the DI container (constructor injection), never via Avalonia's runtime
         XAML loader, so they intentionally have no public parameterless
         constructor. Suppress the "won't be reachable via runtime loader"
         warning so the DI-first design keeps a clean 0-warning build. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Fluent is a separate package in Avalonia 12.x (decoupled from core). -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <!-- DevTools ships inside the core Avalonia package in 12.x; the separate
         Avalonia.Diagnostics package has no 12.x release (see PROGRESS.md log). -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the Vazirmatn font (OFL) as Avalonia resources so it is embedded
         in the assembly and served via avares:// with no runtime CDN.

         Vazirmatn upstream ships a single VARIABLE font (wght 100..900). Avalonia
         does not resolve arbitrary variable-font weights, so any non-Regular
         FontWeight rendered as .notdef boxes (solid black rectangles). We instead
         embed the six OFFICIAL upstream STATIC weight files (see
         scripts/build_vazirmatn_weights.py). They share the preferred family
         "Vazirmatn" (name ID 16) but keep a collision-free legacy naming table
         (RIBBI Regular/Bold + a unique legacy family for each heavier weight), so
         Windows DirectWrite/GDI, macOS CoreText and Linux FreeType all resolve
         every requested FontWeight (400..900) to real outlines — not just Linux.
         Do NOT collapse the heavy weights onto one shared legacy family name:
         that reintroduces a RIBBI collision that only breaks on Windows. -->
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Medium.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-ExtraBold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Black.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animora.Contracts\Animora.Contracts.csproj" />
  </ItemGroup>

  <!-- ===================================================================== -->
  <!-- Safety net: fail the build (with a clear, actionable message) if the   -->
  <!-- produced assembly does NOT contain compiled Avalonia XAML.             -->
  <!--                                                                        -->
  <!-- The Avalonia CompileAvaloniaXaml target only runs as part of           -->
  <!-- CoreCompile. If CoreCompile is skipped (stale obj/bin, a fast          -->
  <!-- up-to-date check on Windows/VS, a corrupted incremental state, etc.)   -->
  <!-- the DLL is emitted WITHOUT the '!AvaloniaResources' embedded resource, -->
  <!-- and the app crashes at startup with                                    -->
  <!--   "No precompiled XAML found for Animora.Desktop.App".                 -->
  <!--                                                                        -->
  <!-- This target inspects the freshly built assembly and turns that silent, -->
  <!-- run-time-only failure into a loud, fixable BUILD error, telling the    -->
  <!-- developer to do a clean rebuild.                                       -->
  <!-- ===================================================================== -->
  <Target Name="VerifyCompiledAvaloniaXaml"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' == 'true'">
    <PropertyGroup>
      <_AnimoraBuiltAssembly>$(TargetDir)$(TargetFileName)</_AnimoraBuiltAssembly>
    </PropertyGroup>
    <!-- The Avalonia resource compiler embeds a manifest resource literally
         named "!AvaloniaResources". Its presence is the definitive proof that
         the XAML was precompiled into this assembly. We read the assembly bytes
         and check for that marker (it appears verbatim in the metadata). -->
    <VerifyAvaloniaXamlEmbedded AssemblyPath="$(_AnimoraBuiltAssembly)" />
  </Target>

  <UsingTask TaskName="VerifyAvaloniaXamlEmbedded"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            // Nothing built (e.g. copy-only build) — don't block.
            bool found = true;
            if (System.IO.File.Exists(AssemblyPath))
            {
                byte[] bytes = System.IO.File.ReadAllBytes(AssemblyPath);
                // Search the raw assembly bytes for the ASCII marker
                // "!AvaloniaResources" — the manifest resource the Avalonia XAML
                // compiler embeds. Its presence proves XAML was precompiled.
                byte[] marker = System.Text.Encoding.ASCII.GetBytes("!AvaloniaResources");
                found = false;
                for (int i = 0; i + marker.Length <= bytes.Length && !found; i++)
                {
                    bool match = true;
                    for (int j = 0; j < marker.Length; j++)
                    {
                        if (bytes[i + j] != marker[j]) { match = false; break; }
                    }
                    found = match;
                }
            }

            if (!found)
            {
                Log.LogError(
                    "Compiled Avalonia XAML is MISSING from '" + AssemblyPath + "'. " +
                    "The app would crash at startup with \"No precompiled XAML found for " +
                    "Animora.Desktop.App\". This is almost always a stale build. " +
                    "Do a CLEAN rebuild: delete the bin/ and obj/ folders (or run " +
                    "'dotnet clean' then 'dotnet build'), and rebuild the whole solution.");
            }
            else
            {
                Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
                    "Verified: compiled Avalonia XAML is embedded in " + AssemblyPath + ".");
            }

            return found;
        }
      ]]></Code>
    </Task>
  </UsingTask>

</Project>
