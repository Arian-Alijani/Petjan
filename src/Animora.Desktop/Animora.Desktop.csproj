<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Guarantee the Avalonia XAML compiler always runs for this assembly.
         Without this, a build where CoreCompile is skipped (stale obj/, an
         incremental up-to-date hit, or a design-time build promoted to a real
         one) can emit Animora.Desktop.dll WITHOUT the CompiledAvaloniaXaml
         resource. At runtime AvaloniaXamlLoader.Load(this) in App.Initialize()
         then throws:
           "No precompiled XAML found for Animora.Desktop.App ...".
         Forcing this true makes the CompileAvaloniaXaml target's condition
         ($(EnableAvaloniaXamlCompilation) != false) always satisfied. -->
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
    <!-- AVLN3001: Windows/UserControls in this app are always created through
         the DI container (constructor injection), never via Avalonia's runtime
         XAML loader, so they intentionally have no public parameterless
         constructor. Suppress the "won't be reachable via runtime loader"
         warning so the DI-first design keeps a clean 0-warning build. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- ===================================================================== -->
  <!-- Release-only performance knobs.                                       -->
  <!--                                                                        -->
  <!-- PublishReadyToRun precompiles IL to native code, removing most of the -->
  <!-- JIT cost during startup (the single biggest startup win for a desktop -->
  <!-- client). It is only consumed by the publish pipeline — a plain        -->
  <!-- `dotnet build` ignores it, so Debug/Release builds stay green — and   -->
  <!-- on publish it needs a RuntimeIdentifier, which is why publish is     -->
  <!-- expected to pass one (via the -r runtime option).                     -->
  <!--                                                                        -->
  <!-- TieredCompilation + TieredPGO: tier-0 quick start, then re-JIT the    -->
  <!-- hot paths with profile-guided optimization for throughput after       -->
  <!-- warm-up.                                                              -->
  <!--                                                                        -->
  <!-- Native AOT is intentionally NOT enabled: STACK.md §435 forbids it      -->
  <!-- because the app targets the EF Core / reflection-based road map,       -->
  <!-- which is not AOT-safe.                                                -->
  <!-- ===================================================================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- ===================================================================== -->
  <!-- runtimeconfig.json knobs (written into Animora.Desktop.runtimeconfig. -->
  <!-- json as System.GC.Server / System.GC.Concurrent).                     -->
  <!--                                                                        -->
  <!-- A desktop client is a small, latency-sensitive UI process: Workstation -->
  <!-- GC is correct (server GC's per-core heaps buy nothing here and cost    -->
  <!-- memory + startup). The concurrent (background) GC stays on so         -->
  <!-- collections don't stall the UI thread.                                -->
  <!--                                                                        -->
  <!-- InvariantGlobalization is deliberately left at its default (false):    -->
  <!-- the Persian/Jalali UI needs ICU (see PR notes / STACK.md).            -->
  <!-- ===================================================================== -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Fluent is a separate package in Avalonia 12.x (decoupled from core). -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <!-- DevTools ships inside the core Avalonia package in 12.x; the separate
         Avalonia.Diagnostics package has no 12.x release (see PROGRESS.md log). -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the official static Vazirmatn faces (OFL) as Avalonia resources.
         They intentionally use different legacy family names for non-RIBBI
         weights. Typography.axaml therefore addresses every file directly and
         App.axaml maps effective FontWeight values to those exact resources. Do
         not replace those per-file URIs with one directory#Vazirmatn URI: that
         reintroduces platform-dependent family grouping and Windows tofu. -->
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Medium.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-ExtraBold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn-Black.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand assets: the VetPlus (وت‌پلاس) logo mark — a modern, minimal teal
         "guardian shield" enclosing a paw whose central pad is a negative-space
         medical cross. The transparent mark works on any surface (white sidebar
         or teal login panel). Bundled as Avalonia resources so it loads via
         avares:// with zero external-Internet dependency (STACK hard rule). -->
    <!-- 1024px master (vetplus-mark.png) is tracked in the repo as the source
         of truth for regenerating sizes, but intentionally NOT bundled as an
         Avalonia resource — the app only ever displays the 512/256/128 sizes. -->
    <AvaloniaResource Include="Assets\Brand\vetplus-mark-512.png" />
    <AvaloniaResource Include="Assets\Brand\vetplus-mark-256.png" />
    <AvaloniaResource Include="Assets\Brand\vetplus-mark-128.png" />
    <AvaloniaResource Include="Assets\Brand\vetplus-logo-white-512.png" />
    <!-- Clean paw-shield mark, derived from the undamaged vetplus-logo-white-512
         source. The vetplus-mark-* variants carry background-removal artefacts
         (cracks across the centre paw pad); the login uses these clean marks. -->
    <AvaloniaResource Include="Assets\Brand\vetplus-mark-clean-512.png" />
    <AvaloniaResource Include="Assets\Brand\vetplus-mark-clean-256.png" />
    <AvaloniaResource Include="Assets\Brand\vetplus.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animora.Contracts\Animora.Contracts.csproj" />
    <ProjectReference Include="..\Animora.Client.Services\Animora.Client.Services.csproj" />
    <ProjectReference Include="..\Animora.Sync.Custom\Animora.Sync.Custom.csproj" />
  </ItemGroup>

  <!-- ===================================================================== -->
  <!-- Safety net: fail the build (with a clear, actionable message) if the   -->
  <!-- produced assembly does NOT contain compiled Avalonia XAML.             -->
  <!--                                                                        -->
  <!-- The Avalonia CompileAvaloniaXaml target only runs as part of           -->
  <!-- CoreCompile. If CoreCompile is skipped (stale obj/bin, a fast          -->
  <!-- up-to-date check on Windows/VS, a corrupted incremental state, etc.)   -->
  <!-- the DLL is emitted WITHOUT the '!AvaloniaResources' embedded resource, -->
  <!-- and the app crashes at startup with                                    -->
  <!--   "No precompiled XAML found for Animora.Desktop.App".                 -->
  <!--                                                                        -->
  <!-- This target inspects the freshly built assembly and turns that silent, -->
  <!-- run-time-only failure into a loud, fixable BUILD error, telling the    -->
  <!-- developer to do a clean rebuild.                                       -->
  <!-- ===================================================================== -->
  <Target Name="VerifyCompiledAvaloniaXaml"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' == 'true'">
    <PropertyGroup>
      <_AnimoraBuiltAssembly>$(TargetDir)$(TargetFileName)</_AnimoraBuiltAssembly>
    </PropertyGroup>
    <!-- The Avalonia resource compiler embeds a manifest resource literally
         named "!AvaloniaResources". Its presence is the definitive proof that
         the XAML was precompiled into this assembly. We read the assembly bytes
         and check for that marker (it appears verbatim in the metadata). -->
    <VerifyAvaloniaXamlEmbedded AssemblyPath="$(_AnimoraBuiltAssembly)" />
  </Target>

  <UsingTask TaskName="VerifyAvaloniaXamlEmbedded"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            // Nothing built (e.g. copy-only build) — don't block.
            bool found = true;
            if (System.IO.File.Exists(AssemblyPath))
            {
                byte[] bytes = System.IO.File.ReadAllBytes(AssemblyPath);
                // Search the raw assembly bytes for the ASCII marker
                // "!AvaloniaResources" — the manifest resource the Avalonia XAML
                // compiler embeds. Its presence proves XAML was precompiled.
                byte[] marker = System.Text.Encoding.ASCII.GetBytes("!AvaloniaResources");
                found = false;
                for (int i = 0; i + marker.Length <= bytes.Length && !found; i++)
                {
                    bool match = true;
                    for (int j = 0; j < marker.Length; j++)
                    {
                        if (bytes[i + j] != marker[j]) { match = false; break; }
                    }
                    found = match;
                }
            }

            if (!found)
            {
                Log.LogError(
                    "Compiled Avalonia XAML is MISSING from '" + AssemblyPath + "'. " +
                    "The app would crash at startup with \"No precompiled XAML found for " +
                    "Animora.Desktop.App\". This is almost always a stale build. " +
                    "Do a CLEAN rebuild: delete the bin/ and obj/ folders (or run " +
                    "'dotnet clean' then 'dotnet build'), and rebuild the whole solution.");
            }
            else
            {
                Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
                    "Verified: compiled Avalonia XAML is embedded in " + AssemblyPath + ".");
            }

            return found;
        }
      ]]></Code>
    </Task>
  </UsingTask>

</Project>
