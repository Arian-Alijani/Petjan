<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: Windows/UserControls in this app are always created through
         the DI container (constructor injection), never via Avalonia's runtime
         XAML loader, so they intentionally have no public parameterless
         constructor. Suppress the "won't be reachable via runtime loader"
         warning so the DI-first design keeps a clean 0-warning build. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Fluent is a separate package in Avalonia 12.x (decoupled from core). -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <!-- DevTools ships inside the core Avalonia package in 12.x; the separate
         Avalonia.Diagnostics package has no 12.x release (see PROGRESS.md log). -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the Vazirmatn font (OFL) as an Avalonia resource so it is
         embedded in the assembly and served via avares:// with no runtime CDN. -->
    <AvaloniaResource Include="Assets\Fonts\Vazirmatn.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animora.Contracts\Animora.Contracts.csproj" />
  </ItemGroup>

</Project>
