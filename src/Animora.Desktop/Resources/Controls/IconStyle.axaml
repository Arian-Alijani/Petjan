<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         Icon rendering — one rule for every glyph in the app.

         The set itself lives in Resources/Theme/Icons.axaml (Lucide v0.460,
         authored on a 24×24 grid with a 2px stroke). Two things are decided here:

         • Direction. The page root is FlowDirection=RightToLeft, which mirrors a
           visual's rendering. Icons are direction-neutral symbols, not text — a
           mirrored tick reads as a cross and a mirrored chevron points the wrong
           way — so every Path renders LTR and the glyph appears exactly as
           authored. Text keeps the RTL flow.
         • Weight. Lucide authors 2px on its 24px grid. Because a geometry is
           pinned to that grid (see Icons.axaml), Stretch scales the glyph but not
           the stroke, so 1.5 is the value that keeps the pack's optical weight at
           the 16–20px sizes the app uses. A consumer that wants emphasis sets its
           own StrokeThickness (e.g. the white plus on a primary button).
         ══════════════════════════════════════════════════════════════════════ -->

    <Style Selector="Path">
        <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>

    <Style Selector="Path.icon">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

</Styles>
