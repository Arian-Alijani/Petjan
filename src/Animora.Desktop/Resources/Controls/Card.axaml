<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card matching Animora-UI/assets/styles.css .card/.card-header/.card-body.
         Usage: <Border Classes="card"><StackPanel Classes="card-header">...
         header content...</StackPanel><ContentPresenter Classes="card-body" .../>
         </Border> — plain style selectors on Border, not a full ControlTheme,
         since "card" composes an existing element rather than a new control. -->

    <!-- Border.card fills its Grid row (VerticalAlignment/HorizontalAlignment
         Stretch) so cards sharing a row line up their top and bottom edges on a
         single horizontal line instead of each sizing to its own content height
         (fixes the staggered card-edge bug). -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
        <Setter Property="BoxShadow" Value="{StaticResource ShadowCard}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!-- Minimal hover: only the shadow + border tint animate, so the lift reads
             as a soft elevation change and never shifts/reflows the card content. -->
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Minimal, consistent hover for every dashboard card: a restrained shadow
         lift and a slightly firmer border. No scale/translate so the layout is stable. -->
    <Style Selector="Border.card:pointerover">
        <Setter Property="BoxShadow" Value="{StaticResource ShadowCardHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    </Style>

    <!-- .card-header: header strip (title, optional right-aligned meta).
         The same 18/16/18 inset is applied to every header container
         (StackPanel-only title, or Grid title+meta) so all card headers line
         up identically; Orientation is only meaningful on a StackPanel. -->
    <Style Selector="StackPanel.card-header">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="18,16,18,0" />
    </Style>
    <Style Selector="Grid.card-header">
        <Setter Property="Margin" Value="18,16,18,0" />
    </Style>
    <Style Selector="Border.card-header-rule">
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Margin" Value="18,12,18,0" />
    </Style>
    <!-- Reference .card-header h3 { font-size:15px; font-weight:800 } — the
         card title is ExtraBold (800), not Bold (700). -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Muted meta text sitting on the right of a card header
         (reference .db-docload / alert header meta: font-weight 700, muted). -->
    <Style Selector="TextBlock.card-header-meta">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .card-body -->
    <Style Selector="ContentPresenter.card-body">
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Panel.card-body">
        <Setter Property="Margin" Value="18" />
    </Style>

    <!-- Dashboard list row (.dash-row): a calm, evenly spaced row inside a card's list.
         Hairline separator between rows, soft hover wash, consistent 8/6 padding. -->
    <Style Selector="Border.dash-row">
        <Setter Property="Padding" Value="8,9" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.dash-row:pointerover">
        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
    </Style>


    <!-- Management alerts (dashboard alert box + list rows): icon tile and leading accent edge take the urgency tone. -->
        <Style Selector="Border.alert-ico.danger">
            <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
        </Style>
        <Style Selector="Border.alert-ico.warn">
            <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
        </Style>
        <Style Selector="Border.alert-ico.danger Path">
            <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="Border.alert-ico.warn Path">
            <Setter Property="Stroke" Value="{StaticResource WarnBrush}" />
        </Style>
        <Style Selector="Border.alert-edge">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.alert-edge.danger">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="Border.alert-edge.warn">
            <Setter Property="Background" Value="{StaticResource WarnBrush}" />
        </Style>
</Styles>
