<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Design tokens: typography.
         Font: Vazirmatn (OFL, bundled; no runtime CDN).

         IMPORTANT: do not address the whole Fonts directory as one family. The
         official static files intentionally have different legacy family names:
         Regular/Bold are "Vazirmatn", while Medium/SemiBold/ExtraBold/Black are
         "Vazirmatn Medium", etc. A directory URI ending in #Vazirmatn therefore
         depends on Avalonia/Skia grouping those separate faces through OpenType
         name ID 16. That grouping is platform-dependent and failed on Windows,
         even though Linux selected the expected face.

         Each resource below instead points to ONE file and its exact internal
         legacy family (name ID 1). App.axaml maps the effective FontWeight to the
         corresponding resource. Face selection is consequently deterministic:
         no family grouping, fallback, synthesis, or installed system font is
         involved. Keep the upstream static files verbatim; see the verifier in
         scripts/build_vazirmatn_weights.py. -->

    <FontFamily x:Key="AppFontFamily">avares://Animora.Desktop/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn</FontFamily>
    <FontFamily x:Key="AppFontFamilyMedium">avares://Animora.Desktop/Assets/Fonts/Vazirmatn-Medium.ttf#Vazirmatn Medium</FontFamily>
    <FontFamily x:Key="AppFontFamilySemiBold">avares://Animora.Desktop/Assets/Fonts/Vazirmatn-SemiBold.ttf#Vazirmatn SemiBold</FontFamily>
    <FontFamily x:Key="AppFontFamilyBold">avares://Animora.Desktop/Assets/Fonts/Vazirmatn-Bold.ttf#Vazirmatn</FontFamily>
    <FontFamily x:Key="AppFontFamilyExtraBold">avares://Animora.Desktop/Assets/Fonts/Vazirmatn-ExtraBold.ttf#Vazirmatn ExtraBold</FontFamily>
    <FontFamily x:Key="AppFontFamilyBlack">avares://Animora.Desktop/Assets/Fonts/Vazirmatn-Black.ttf#Vazirmatn Black</FontFamily>

    <!-- Micro sizes for dense chips (shortcut hint, count badge, tile caption). -->
    <sys:Double x:Key="FontSizeKey">9.5</sys:Double>
    <sys:Double x:Key="FontSizeBadge">10</sys:Double>
    <sys:Double x:Key="FontSizeCaption">10.5</sys:Double>
    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">13</sys:Double>
    <sys:Double x:Key="FontSizeMd">15</sys:Double>
    <sys:Double x:Key="FontSizeLg">19</sys:Double>
    <sys:Double x:Key="FontSizeXl">26</sys:Double>

    <!-- Weight tokens. App.axaml pairs each non-Regular value with its exact
         static font file; do not use these weights without that mapping. -->
    <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <FontWeight x:Key="FontWeightExtraBold">ExtraBold</FontWeight>

</ResourceDictionary>
