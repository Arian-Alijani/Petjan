<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Design tokens: typography.
         Font: Vazirmatn (OFL, bundled as an embedded asset — no runtime CDN),
         matching the reference (Animora-UI) which imports Vazirmatn.

         IMPORTANT: Vazirmatn is bundled as discrete STATIC weight files
         (Regular/Medium/SemiBold/Bold/ExtraBold/Black — see
         scripts/build_vazirmatn_weights.py). Two earlier attempts failed:
           1. Using the upstream VARIABLE font — Avalonia can't weight-resolve it,
              so every non-Regular label rendered as solid black boxes.
           2. Instancing static weights but giving heavy weights their OWN legacy
              family name ("Vazirmatn ExtraBold", ...) while leaving the variable
              STAT axis + fvar instance name records behind. Avalonia then could
              not collapse the six files into one weightable "Vazirmatn" family,
              so ExtraBold/Black still fell back to .notdef (black rectangles).
         Current fix: every file shares ONE legacy+typographic family name
         "Vazirmatn", differs only by usWeightClass (400..900), and all
         variable-font leftovers are stripped. The folder-scoped avares:// URI
         below then exposes a single "Vazirmatn" family with six real weights, so
         every requested FontWeight binds to real outlines.

         Type scale + the weight tokens below mirror the reference's observed
         heading/body sizes and weights (400/500/600/700/800) so all app text is
         standardized to one font and one consistent weight ramp. -->

    <FontFamily x:Key="AppFontFamily">avares://Animora.Desktop/Assets/Fonts#Vazirmatn</FontFamily>

    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">13</sys:Double>
    <sys:Double x:Key="FontSizeMd">15</sys:Double>
    <sys:Double x:Key="FontSizeLg">19</sys:Double>
    <sys:Double x:Key="FontSizeXl">26</sys:Double>

    <!-- Weight tokens: bundled Vazirmatn static weights. Reference maps:
         body=400/500, labels/emphasis=600, headings/values=700, hero=800. -->
    <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <FontWeight x:Key="FontWeightExtraBold">ExtraBold</FontWeight>

</ResourceDictionary>
