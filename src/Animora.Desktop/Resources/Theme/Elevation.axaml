<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens: elevation. BoxShadows converted from the reference's
         CSS box-shadow lists (Animora-UI/assets/styles.css :root).
         Avalonia BoxShadow syntax: offsetX offsetY blur spread color.
         rgba(16,24,40,a) maps to base color #101828 with alpha as #AARRGGBB. -->

    <!-- shadow-card token: 0 1px 2px @.04, 0 1px 3px @.05 (no spread) -->
    <BoxShadows x:Key="ShadowCard">0 1 2 0 #0A101828, 0 1 3 0 #0D101828</BoxShadows>

    <!-- shadow-card-hover: a restrained lift for the minimal card hover effect —
         a touch deeper/softer than the resting card shadow, never a big pop. -->
    <BoxShadows x:Key="ShadowCardHover">0 4 10 -2 #14101828, 0 2 6 -1 #10101828</BoxShadows>

    <!-- shadow-pop token: 0 12px 32px spread=neg8 @.18, 0 4px 10px spread=neg4 @.08 -->
    <BoxShadows x:Key="ShadowPop">0 12 32 -8 #2E101828, 0 4 10 -4 #14101828</BoxShadows>

    <!-- Segmented-control active button: 0 2px 8px rgba(16,24,40,.08) -->
    <BoxShadows x:Key="ShadowSegment">0 2 8 0 #14101828</BoxShadows>

    <!-- Active filter chip: 0 2px 8px rgba(13,148,136,.22) -->
    <BoxShadows x:Key="ShadowChip">0 2 8 0 #380D9488</BoxShadows>

    <!-- Donut centre medallion: 0 6px 18px rgba(16,24,40,.05) -->
    <BoxShadows x:Key="ShadowMedallion">0 6 18 0 #0D101828</BoxShadows>

    <!-- Dashboard quick-tile hover lift: 0 14px 28px rgba(16,24,40,.10) -->
    <BoxShadows x:Key="ShadowTileHover">0 14 28 0 #1A101828</BoxShadows>

    <!-- 2px panel-coloured ring that separates a count badge from its icon chip. -->
    <BoxShadows x:Key="ShadowBadgeRing">0 0 0 2 #FFFFFFFF</BoxShadows>

</ResourceDictionary>
