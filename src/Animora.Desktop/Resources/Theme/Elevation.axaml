<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens: elevation. BoxShadows converted from the reference's
         CSS box-shadow lists (Animora-UI/assets/styles.css :root).
         Avalonia BoxShadow syntax: offsetX offsetY blur spread color.
         rgba(16,24,40,a) maps to base color #101828 with alpha as #AARRGGBB. -->

    <!-- shadow-card token: 0 1px 2px @.04, 0 1px 3px @.05 (no spread) -->
    <BoxShadows x:Key="ShadowCard">0 1 2 0 #0A101828, 0 1 3 0 #0D101828</BoxShadows>

    <!-- shadow-pop token: 0 12px 32px spread=neg8 @.18, 0 4px 10px spread=neg4 @.08 -->
    <BoxShadows x:Key="ShadowPop">0 12 32 -8 #2E101828, 0 4 10 -4 #14101828</BoxShadows>

</ResourceDictionary>
