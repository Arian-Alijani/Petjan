<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens: colors. Values mirror Animora-UI/assets/styles.css :root.
         Each token is exposed as a Color (…Color) and a matching SolidColorBrush
         (…Brush) so both fill scenarios and value binding are covered. -->

    <!-- brand — calm, minimal cornflower-blue / indigo (dashboard redesign) -->
    <Color x:Key="Brand900Color">#1b2559</Color>
    <Color x:Key="Brand800Color">#233072</Color>
    <Color x:Key="Brand700Color">#3a56d4</Color>
    <Color x:Key="Brand600Color">#4a6cf7</Color>
    <Color x:Key="Brand500Color">#5b7cfa</Color>
    <Color x:Key="Brand400Color">#8aa2fb</Color>
    <Color x:Key="Brand100Color">#dbe4fe</Color>
    <Color x:Key="Brand50Color">#eef2fe</Color>

    <SolidColorBrush x:Key="Brand900Brush" Color="{StaticResource Brand900Color}" />
    <SolidColorBrush x:Key="Brand800Brush" Color="{StaticResource Brand800Color}" />
    <SolidColorBrush x:Key="Brand700Brush" Color="{StaticResource Brand700Color}" />
    <SolidColorBrush x:Key="Brand600Brush" Color="{StaticResource Brand600Color}" />
    <SolidColorBrush x:Key="Brand500Brush" Color="{StaticResource Brand500Color}" />
    <SolidColorBrush x:Key="Brand400Brush" Color="{StaticResource Brand400Color}" />
    <SolidColorBrush x:Key="Brand100Brush" Color="{StaticResource Brand100Color}" />
    <SolidColorBrush x:Key="Brand50Brush" Color="{StaticResource Brand50Color}" />

    <!-- surfaces & lines — neutral cool/blue-grey canvas matching the reference -->
    <Color x:Key="BgColor">#f6f8fb</Color>
    <Color x:Key="Bg2Color">#eef1f8</Color>
    <Color x:Key="PanelColor">#ffffff</Color>
    <Color x:Key="LineColor">#e6eaf2</Color>
    <Color x:Key="Line2Color">#eef1f7</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}" />

    <!-- ink & muted text -->
    <Color x:Key="InkColor">#101828</Color>
    <Color x:Key="Ink2Color">#344054</Color>
    <Color x:Key="MutedColor">#667085</Color>
    <Color x:Key="Muted2Color">#98a2b3</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource Ink2Color}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Muted2Brush" Color="{StaticResource Muted2Color}" />

    <!-- semantic: danger / warn / info / ok, each with a soft bg -->
    <Color x:Key="DangerColor">#d92d20</Color>
    <Color x:Key="DangerBgColor">#fef3f2</Color>
    <Color x:Key="WarnColor">#b54708</Color>
    <Color x:Key="WarnBgColor">#fffaeb</Color>
    <Color x:Key="InfoColor">#1570cd</Color>
    <Color x:Key="InfoBgColor">#eff8ff</Color>
    <Color x:Key="OkColor">#027a48</Color>
    <Color x:Key="OkBgColor">#ecfdf3</Color>

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkBgBrush" Color="{StaticResource OkBgColor}" />

    <!-- accents: lilac / peach, each with a soft bg -->
    <Color x:Key="LilacColor">#a48afb</Color>
    <Color x:Key="LilacBgColor">#f4f3ff</Color>
    <Color x:Key="PeachColor">#f0b593</Color>
    <Color x:Key="PeachBgColor">#fdf1e7</Color>

    <SolidColorBrush x:Key="LilacBrush" Color="{StaticResource LilacColor}" />
    <SolidColorBrush x:Key="LilacBgBrush" Color="{StaticResource LilacBgColor}" />
    <SolidColorBrush x:Key="PeachBrush" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="PeachBgBrush" Color="{StaticResource PeachBgColor}" />

    <!-- Patients & Owners accents, from patients.css :root. -->
    <Color x:Key="RoseColor">#c96fa8</Color>
    <Color x:Key="RoseBgColor">#fbe4f1</Color>
    <Color x:Key="MintColor">#3fa48c</Color>
    <Color x:Key="MintBgColor">#ddf0e9</Color>

    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="RoseBgBrush" Color="{StaticResource RoseBgColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="MintBgBrush" Color="{StaticResource MintBgColor}" />

    <!-- Patients directory one-off surfaces, read from patients.css
         (.pt-table thead th bg, .oc-pets/.pk-owner inset, table row hover,
         .pb-search input:hover). -->
    <Color x:Key="TableHeadColor">#fafbfa</Color>
    <Color x:Key="InsetColor">#fcfdfc</Color>
    <Color x:Key="RowHoverColor">#f8fbfa</Color>
    <Color x:Key="InputHoverColor">#f3f7f4</Color>

    <SolidColorBrush x:Key="TableHeadBrush" Color="{StaticResource TableHeadColor}" />
    <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="{StaticResource InputHoverColor}" />

    <!-- Vaccination screen accent, read from vaccination.css :root
         (vx-shot: #6f57c9, vx-shot-bg: #efeafb). -->
    <Color x:Key="ShotColor">#6f57c9</Color>
    <Color x:Key="ShotBgColor">#efeafb</Color>

    <SolidColorBrush x:Key="ShotBrush" Color="{StaticResource ShotColor}" />
    <SolidColorBrush x:Key="ShotBgBrush" Color="{StaticResource ShotBgColor}" />

    <!-- Dashboard semantic surfaces. Dashboard literals were promoted to tokens (D44);
         values are unchanged so the rendered look is identical. -->
    <Color x:Key="RowActiveColor">#f7f9fe</Color>           <!-- active legend row fill -->
    <Color x:Key="ChartTrackColor">#eef1f8</Color>          <!-- donut empty track -->
    <Color x:Key="MedallionLineColor">#e7eaf3</Color>       <!-- donut centre medallion border -->
    <Color x:Key="MedallionEdgeColor">#fbfcff</Color>       <!-- donut centre medallion gradient edge -->
    <Color x:Key="ChartAreaTopColor">#594a6cf7</Color>      <!-- revenue area fill: Brand600 @ 35% -->
    <Color x:Key="ChartAreaBottomColor">#004a6cf7</Color>   <!-- revenue area fill: Brand600 @ 0% -->

    <SolidColorBrush x:Key="RowActiveBrush" Color="{StaticResource RowActiveColor}" />
    <SolidColorBrush x:Key="ChartTrackBrush" Color="{StaticResource ChartTrackColor}" />
    <SolidColorBrush x:Key="MedallionLineBrush" Color="{StaticResource MedallionLineColor}" />

    <!-- Foreground for content drawn on a saturated accent/danger fill (tile hover icon, count badge). -->
    <Color x:Key="OnAccentColor">#ffffff</Color>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

</ResourceDictionary>
