    <!-- Standard checkmark. The app root is FlowDirection=RightToLeft, which
         horizontally mirrors Path geometry; this geometry is authored as the
         mirror image of a conventional tick (short arm bottom-left, long arm
         top-right) so it renders correctly (not reversed) inside the RTL UI. -->
    <StreamGeometry x:Key="IconCheck">
        M20,6.5 L10,17 L5,12
    </StreamGeometry>

    <StreamGeometry x:Key="IconX">
        M18,6 L6,18
        M6,6 L18,18
    </StreamGeometry>

    <!-- Check inside a circle — the canonical "confirm / mark done" row action.
         The tick arm is authored mirror-image (like IconCheck) so it reads
         correctly inside the RTL root. -->
    <StreamGeometry x:Key="IconCheckCircle">
        M12,3 a9,9 0 1 0 0,18 a9,9 0 0 0 0,-18 Z
        M16,9.5 L11,15 L8,12
    </StreamGeometry>

