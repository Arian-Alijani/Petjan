<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Design tokens: corner radii + spacing scale.
         Radii mirror the radius tokens in Animora-UI/assets/styles.css :root.
         Spacing is a consistent 4px-based scale matching the reference's
         observed paddings/gaps (not a literal per-rule enumeration). -->

    <!-- corner radii — tightened a notch for a crisper, more squared card edge
         (sharper corners per dashboard polish): sm 10→8, base 16→12, lg 20→16. -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="Radius">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>

    <!-- 4px-based spacing scale.
         Doubles feed scalar properties: StackPanel.Spacing, Grid gaps, etc.
         A boxed Double CANNOT be assigned to a Thickness property (Padding/
         Margin/BorderThickness) — Avalonia performs a direct cast and throws
         InvalidCastException. For those properties use the PadX tokens below. -->
    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing20">20</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>

    <!-- Uniform Thickness tokens for Padding/Margin (same 4px scale).
         Use these instead of the Double tokens on Thickness properties. -->
    <Thickness x:Key="Pad4">4</Thickness>
    <Thickness x:Key="Pad8">8</Thickness>
    <Thickness x:Key="Pad12">12</Thickness>
    <Thickness x:Key="Pad16">16</Thickness>
    <Thickness x:Key="Pad20">20</Thickness>
    <Thickness x:Key="Pad24">24</Thickness>
    <Thickness x:Key="Pad32">32</Thickness>

</ResourceDictionary>
