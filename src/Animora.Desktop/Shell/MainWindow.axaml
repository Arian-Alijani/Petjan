<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Animora.Desktop.Shell.MainWindow"
        Title="Animora"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <!-- Phase 03: Content is set in code-behind to the (DI-resolved)
         ControlGalleryView — a temporary dev-only host so the new shared
         control library can be visually smoke-tested. Phase 05 replaces
         this window's content with the real app shell. -->
</Window>
