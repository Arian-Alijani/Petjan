<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Animora.Desktop.Shell"
        xmlns:controls="using:Animora.Desktop.Controls"
        x:Class="Animora.Desktop.Shell.MainWindow"
        x:Name="Root"
        x:DataType="shell:MainWindowViewModel"
        Icon="avares://Animora.Desktop/Assets/Brand/vetplus.ico"
        Title="وت‌پلاس — کلینیک هوشمند"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}">

    <!-- App shell: (topbar over scrollable content) column + sidebar column.
         The shell Grid is laid out LeftToRight so its columns are DETERMINISTIC
         physical slots — we do NOT rely on FlowDirection mirroring to place the
         menu, because that mirror flipped the Persian sidebar to the left on
         this platform. The sidebar therefore lives in the last (right) column
         and always renders on the RIGHT edge, as Persian RTL requires. The
         individual child views (SidebarView, TopbarView, pages) keep their own
         FlowDirection=RightToLeft, so all Persian text still flows right-to-left. -->
    <Grid>
        <Grid ColumnDefinitions="*,Auto" FlowDirection="LeftToRight">

        <!-- Sidebar host: width is animated so the topbar fold toggle can
             collapse/expand the menu smoothly. Pinned to the right (last)
             column so the navigation menu sits on the right of the window. -->
        <shell:SidebarView Grid.Column="1"
                           Width="{Binding #Root.((shell:MainWindowViewModel)DataContext).SidebarWidth}"
                           ClipToBounds="True"
                           DataContext="{Binding Sidebar}">
            <shell:SidebarView.Transitions>
                <Transitions>
                    <!-- Smooth, single-authority width tween. A slightly longer
                         duration + CubicEaseOut (fast start, gentle settle)
                         reads as a natural fold rather than a snap, and matches
                         the inner label/badge opacity fades so the whole rail
                         collapses/expands as one motion. -->
                    <DoubleTransition Property="Width"
                                      Duration="0:0:0.30"
                                      Easing="CubicEaseOut" />
                </Transitions>
            </shell:SidebarView.Transitions>
        </shell:SidebarView>

        <DockPanel Grid.Column="0" LastChildFill="True">
            <shell:TopbarView DockPanel.Dock="Top"
                              FlowDirection="RightToLeft"
                              DataContext="{Binding Topbar}" />

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          FlowDirection="RightToLeft">
                <ContentControl Content="{Binding CurrentPage}" />
            </ScrollViewer>
        </DockPanel>
        </Grid>

        <!-- Permanent shell overlays. ViewModels open dialogs/toasts through
             services; no screen owns window or overlay plumbing. The SheetHost
             backs the Patients records' centered "sheet" pattern (owner/pet
             files), above the modal/drawer/toast z-order. -->
        <controls:ToastHost x:Name="Toast" ZIndex="100" IsHitTestVisible="False" />
        <controls:ModalHost x:Name="Modal" ZIndex="110" />
        <controls:DrawerHost x:Name="Drawer" ZIndex="120" />
        <controls:SheetHost x:Name="Sheet" ZIndex="130" />
    </Grid>

</Window>
