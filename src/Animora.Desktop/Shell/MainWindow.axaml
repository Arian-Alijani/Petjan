<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Animora.Desktop.Shell"
        x:Class="Animora.Desktop.Shell.MainWindow"
        x:Name="Root"
        x:DataType="shell:MainWindowViewModel"
        Title="وت‌پلاس — کلینیک هوشمند"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}">

    <!-- App shell: sidebar column + (topbar over scrollable content) column,
         matching the reference's .app / .sidebar / .main / .page structure.
         FlowDirection is pinned here on the Window itself: setting it only via a
         TopLevel style leaves the Window's own default (LeftToRight) as a local
         value that wins over the style, which mirrored the whole shell wrong. -->
    <!-- Grid columns are physical in Avalonia. Keep the menu explicitly in
         the final/right column instead of relying on FlowDirection to mirror
         the shell; this prevents the Persian sidebar from moving left on some
         platforms. -->
    <Grid ColumnDefinitions="*,Auto">

        <!-- Sidebar host: width is animated (0 <-> 264) so the topbar fold
             toggle can collapse/expand the menu smoothly. The explicit second
             column pins it to the right edge in every RTL desktop render. -->
        <shell:SidebarView Grid.Column="1"
                           Width="{Binding #Root.((shell:MainWindowViewModel)DataContext).SidebarWidth}"
                           ClipToBounds="True"
                           DataContext="{Binding Sidebar}">
            <shell:SidebarView.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width"
                                      Duration="0:0:0.24"
                                      Easing="CubicEaseInOut" />
                </Transitions>
            </shell:SidebarView.Transitions>
        </shell:SidebarView>

        <DockPanel Grid.Column="0" LastChildFill="True">
            <shell:TopbarView DockPanel.Dock="Top"
                              DataContext="{Binding Topbar}" />

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentPage}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>

</Window>
