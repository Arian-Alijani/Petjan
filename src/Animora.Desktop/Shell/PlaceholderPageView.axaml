<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Shell.PlaceholderPageView"
             x:DataType="shell:PlaceholderPageViewModel">

    <Border Padding="32">
        <Border Classes="card"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="12"
                        HorizontalAlignment="Center"
                        MaxWidth="420">
                <Border Width="56"
                        Height="56"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Brand50Brush}">
                    <Path Classes="icon"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{StaticResource Brand600Brush}"
                          Data="{StaticResource IconClipboard}" />
                </Border>
                <TextBlock Text="{Binding Title}"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding Message}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>
    </Border>

</UserControl>
