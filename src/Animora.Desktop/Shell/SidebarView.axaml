<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Shell.SidebarView"
             x:DataType="shell:SidebarViewModel"
             FlowDirection="RightToLeft"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Nav item chrome, matching .nav-item / .nav-item.active in
             Animora-UI/assets/styles.css (soft-tinted active state + left
             accent bar via the ActiveBar Border). -->
        <Style Selector="Button.nav-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style Selector="Button.nav-item Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-badge">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-badge-text">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-accent">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Active state -->
        <Style Selector="Button.nav-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.nav-item.active Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-badge">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-badge-text">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- The host control's width is animated between the expanded (288) and
         compact (76) rails by the shell. Letting this Border stretch to fill
         that width (instead of a fixed 288) means the nav content actually
         reflows into the compact rail rather than being clipped, so no
         label-only / icon-less strip is left behind when collapsed. -->
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Stretch"
            Padding="14,18,14,14">
        <DockPanel LastChildFill="True">

            <!-- Brand header: paw logo + brand identity only. The in-sidebar
                 fold toggle was removed — the shell now has a single sidebar
                 fold control, which lives in the topbar's leading slot. -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{StaticResource Line2Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,2,6,16"
                    Margin="0,0,0,10">
                <StackPanel Spacing="10">

                    <!-- Brand identity. Two mutually-exclusive layers so
                         each state is laid out cleanly:
                         • Expanded  → [brand text ... paw logo] hugging the
                           leading (right) edge under RTL.
                         • Collapsed → the paw logo alone, centred in the rail. -->
                    <Panel>
                        <!-- Expanded layer -->
                        <Grid IsVisible="{Binding IsExpanded}"
                              ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="وت‌پلاس"
                                           FontSize="19"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="کلینیک هوشمند"
                                           FontSize="11"
                                           Foreground="{StaticResource Muted2Brush}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                        <GradientStop Offset="1" Color="{StaticResource Brand600Color}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Classes="icon"
                                      Width="22"
                                      Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="White"
                                      Data="{StaticResource IconPaw}" />
                            </Border>
                        </Grid>

                        <!-- Collapsed layer: centred logo -->
                        <Border IsVisible="{Binding IsExpanded, Converter={x:Static shell:SidebarView.InverseBoolConverter}}"
                                Width="40"
                                Height="40"
                                CornerRadius="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                    <GradientStop Offset="1" Color="{StaticResource Brand600Color}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Classes="icon"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="White"
                                  Data="{StaticResource IconPaw}" />
                        </Border>
                    </Panel>
                </StackPanel>
            </Border>

            <!-- Compact-rail footer: just the user avatar, centred, with the
                 sync-active teal dot on its top-outer corner (mirrors the
                 target's collapsed profile chip). -->
            <Border DockPanel.Dock="Bottom"
                    IsVisible="{Binding IsExpanded, Converter={x:Static shell:SidebarView.InverseBoolConverter}}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,2">
                <Panel>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                <GradientStop Offset="1" Color="{StaticResource Brand700Color}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding CurrentUser.Initials}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="ExtraBold"
                                   FontSize="15"
                                   Foreground="White" />
                    </Border>
                    <Ellipse Width="9"
                             Height="9"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="-2,-2,0,0"
                             Stroke="{StaticResource PanelBrush}"
                             StrokeThickness="1.5"
                             Fill="{StaticResource OkBrush}" />
                </Panel>
            </Border>

            <!-- Bottom cluster: sync status + user card. Hidden in compact
                 mode so the navigation icons keep the full rail height. -->
            <StackPanel DockPanel.Dock="Bottom"
                        IsVisible="{Binding IsExpanded}"
                        Spacing="8">
                <!-- Sync status -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="4,4,4,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{StaticResource OkBrush}" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="همگام‌سازی فعال"
                                   FontWeight="Bold"
                                   FontSize="11.5"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="آخرین بروزرسانی: چند ثانیه پیش"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- User card -->
                <Border CornerRadius="12"
                        Padding="10,9"
                        Background="White"
                        BorderBrush="{StaticResource Line2Brush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                    <GradientStop Offset="1" Color="{StaticResource Brand700Color}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding CurrentUser.Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="ExtraBold"
                                       FontSize="14"
                                       Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding CurrentUser.Name}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding CurrentUser.RoleLabel}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Path Grid.Column="2"
                              Classes="icon"
                              VerticalAlignment="Center"
                              Width="15"
                              Height="15"
                              Stroke="{StaticResource Muted2Brush}"
                              Data="{StaticResource IconChevronLeft}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Grouped nav list (fills the middle) -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shell:NavGroupViewModel">
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Title}"
                                           IsVisible="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded}"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource Muted2Brush}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Padding="12,14,12,6" />
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="shell:NavEntryViewModel">
                                            <Button Classes="nav-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Margin="0,1"
                                                    ToolTip.Tip="{Binding Label}"
                                                    Command="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).NavigateCommand}"
                                                    CommandParameter="{Binding}">
                                                <!-- RTL layout, expanded:  [badge | label ...] label right-aligned + icon
                                                     pinned to the leading (right) edge.
                                                     Fixed 3-column grid:  badge(Auto) | label(*) | icon(Auto).
                                                     Because the icon lives in its own fixed trailing column
                                                     (the RTL leading/right edge) on EVERY row, all the tab
                                                     icons line up in one tidy vertical column regardless of
                                                     label length; the labels are right-aligned so they hug
                                                     the icons. In the compact rail the badge + label collapse
                                                     and the icon is re-centered across the whole pill. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Leading accent bar (active only), overlaid on
                                                         the pill's inner (right, RTL leading) edge.
                                                         Negative right margin cancels the button's
                                                         12px horizontal padding so the 4px bar sits
                                                         flush against the pill edge, matching the
                                                         target. -->
                                                    <Border Classes="nav-accent"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="3"
                                                            Width="4"
                                                            Margin="0,-3,-12,-3"
                                                            CornerRadius="4,0,0,4"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="{StaticResource Brand600Brush}" />

                                                    <!-- Badge (leading = far left in RTL) -->
                                                    <Border Grid.Column="0"
                                                            Classes="nav-badge"
                                                            CornerRadius="20"
                                                            Padding="7,1"
                                                            MinWidth="20"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{x:Static shell:SidebarView.AllTrueConverter}">
                                                                <Binding Path="HasBadge" />
                                                                <Binding Path="$parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                        <TextBlock Classes="nav-badge-text"
                                                                   Text="{Binding BadgeText}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>

                                                    <!-- Label: fills the middle column and is right-aligned
                                                         (RTL) so it sits flush against the icon column. Hidden
                                                         in the compact rail. -->
                                                    <TextBlock Grid.Column="1"
                                                               Classes="nav-label"
                                                               IsVisible="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"
                                                               Margin="0,0,12,0"
                                                               TextWrapping="NoWrap"
                                                               Text="{Binding Label}" />

                                                    <!-- Icon-column spacer: reserves the fixed 18px trailing
                                                         column so the label can never slide underneath the
                                                         icon. It keeps the icon column a real, constant width
                                                         on every row → the icons line up vertically. -->
                                                    <Border Grid.Column="2"
                                                            Width="18"
                                                            IsHitTestVisible="False" />

                                                    <!-- Icon: overlaid across all columns. Expanded → pinned
                                                         Right, so it sits in the fixed trailing (RTL leading)
                                                         column and every row's icon aligns vertically. Compact
                                                         → the label + badge collapse and the icon re-centers
                                                         across the whole pill via the alignment converter. -->
                                                    <Panel Grid.Column="0"
                                                           Grid.ColumnSpan="3"
                                                           Width="18"
                                                           Height="18"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded, Converter={x:Static shell:SidebarView.RailAlignmentConverter}}">
                                                        <Path Classes="icon nav-icon"
                                                              Width="18"
                                                              Height="18"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                        <!-- compact-rail notification dot for badged
                                                             entries (numeric badge is shown when expanded) -->
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Top"
                                                                 Margin="-3,-2,0,0"
                                                                 Fill="{StaticResource Brand500Brush}">
                                                            <Ellipse.IsVisible>
                                                                <MultiBinding Converter="{x:Static shell:SidebarView.BadgeDotConverter}">
                                                                    <Binding Path="HasBadge" />
                                                                    <Binding Path="$parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded" />
                                                                </MultiBinding>
                                                            </Ellipse.IsVisible>
                                                        </Ellipse>
                                                    </Panel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
