<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Shell.SidebarView"
             x:DataType="shell:SidebarViewModel"
             FlowDirection="RightToLeft"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Nav item chrome, matching .nav-item / .nav-item.active in
             Animora-UI/assets/styles.css (soft-tinted active state + left
             accent bar via the ActiveBar Border). -->
        <Style Selector="Button.nav-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style Selector="Button.nav-item Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-accent">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Active state -->
        <Style Selector="Button.nav-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.nav-item.active Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- The host control's width is animated between the expanded (248) and
         compact (72) rails by the shell. Letting this Border stretch to fill
         that width (instead of a fixed 248) means the nav content actually
         reflows into the compact rail rather than being clipped, so no
         label-only / icon-less strip is left behind when collapsed. -->
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Stretch"
            Padding="12,16,12,12">
        <DockPanel LastChildFill="True">

            <!-- Brand header: paw logo + brand identity only. The in-sidebar
                 fold toggle was removed — the shell now has a single sidebar
                 fold control, which lives in the topbar's leading slot. -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{StaticResource Line2Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,2,4,14"
                    Margin="0,0,0,10">
                <StackPanel Spacing="10">

                    <!-- Brand identity. Two layers that cross-fade (Opacity
                         transitions) rather than snapping via IsVisible, so the
                         header dissolves between states in step with the width
                         tween — no hard cut:
                         • Expanded  → [brand text ... paw logo] hugging the
                           leading (right) edge under RTL.
                         • Collapsed → the paw logo alone, centred in the rail.
                         The logo sits at the same 40px size / vertical centre in
                         both layers, so the cross-fade reads as one continuous
                         mark, not a jump. -->
                    <Panel>
                        <!-- Expanded layer -->
                        <Grid ColumnDefinitions="*,Auto"
                              IsHitTestVisible="{Binding IsExpanded}"
                              Opacity="{Binding IsExpanded, Converter={x:Static shell:SidebarView.ExpandedOpacityConverter}}">
                            <Grid.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.18"
                                                      Easing="LinearEasing" />
                                </Transitions>
                            </Grid.Transitions>
                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="وت‌پلاس"
                                           FontSize="19"
                                           FontWeight="ExtraBold"
                                           TextWrapping="NoWrap"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="کلینیک هوشمند"
                                           FontSize="11"
                                           TextWrapping="NoWrap"
                                           Foreground="{StaticResource Muted2Brush}" />
                            </StackPanel>
                            <!-- Brand logo mark (expanded rail). The VetPlus
                                 guardian-shield paw already carries the teal
                                 identity, so it stands on its own — no wrapper
                                 gradient box. -->
                            <Image Grid.Column="1"
                                   Width="40"
                                   Height="40"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   Source="avares://Animora.Desktop/Assets/Brand/vetplus-mark-128.png" />
                        </Grid>

                        <!-- Collapsed layer: centred brand logo mark, cross-faded -->
                        <Image Width="40"
                               Height="40"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               IsHitTestVisible="{Binding IsExpanded, Converter={x:Static shell:SidebarView.InverseBoolConverter}}"
                               Opacity="{Binding IsExpanded, Converter={x:Static shell:SidebarView.CollapsedOpacityConverter}}"
                               Source="avares://Animora.Desktop/Assets/Brand/vetplus-mark-128.png">
                            <Image.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity"
                                                      Duration="0:0:0.18"
                                                      Easing="LinearEasing" />
                                </Transitions>
                            </Image.Transitions>
                        </Image>
                    </Panel>
                </StackPanel>
            </Border>

            <!-- Compact-rail footer: just the user avatar, centred, with the
                 sync-active teal dot on its top-outer corner (mirrors the
                 target's collapsed profile chip). -->
            <Border DockPanel.Dock="Bottom"
                    IsVisible="{Binding IsExpanded, Converter={x:Static shell:SidebarView.InverseBoolConverter}}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,2">
                <Panel>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                <GradientStop Offset="1" Color="{StaticResource Brand700Color}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding CurrentUser.Initials}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="ExtraBold"
                                   FontSize="15"
                                   Foreground="White" />
                    </Border>
                    <Ellipse Width="9"
                             Height="9"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="-2,-2,0,0"
                             Stroke="{StaticResource PanelBrush}"
                             StrokeThickness="1.5"
                             Fill="{StaticResource OkBrush}" />
                </Panel>
            </Border>

            <!-- Bottom cluster: user card. Hidden in compact
                 mode so the navigation icons keep the full rail height. -->
            <StackPanel DockPanel.Dock="Bottom"
                        IsVisible="{Binding IsExpanded}"
                        Spacing="8">
                <!-- User card -->
                <Border CornerRadius="12"
                        Padding="10,9"
                        Background="White"
                        BorderBrush="{StaticResource Line2Brush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                    <GradientStop Offset="1" Color="{StaticResource Brand700Color}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding CurrentUser.Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="ExtraBold"
                                       FontSize="14"
                                       Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding CurrentUser.Name}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                        <Path Grid.Column="2"
                              Classes="icon"
                              VerticalAlignment="Center"
                              Width="16"
                              Height="16"
                              Stroke="{StaticResource Muted2Brush}"
                              Data="{StaticResource IconChevronLeft}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Keep wheel/touch scrolling in the rail, without a scrollbar
                 competing with the icons or consuming compact-rail width. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shell:NavGroupViewModel">
                            <StackPanel Margin="0,0,0,4">
                                <!-- Group title (مرکز فرمان، مدیریت کلینیک، کسب و کار…) pinned to the
                                     PHYSICAL right edge. Under the RTL root, HorizontalAlignment="Right"
                                     is mirrored to the physical left, so — exactly like the nav labels
                                     below — the title is hosted in a LeftToRight panel (physical
                                     coordinates) while the TextBlock itself stays RTL for Persian shaping. -->
                                <Panel FlowDirection="LeftToRight"
                                       HorizontalAlignment="Stretch"
                                       IsVisible="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded}">
                                    <TextBlock Text="{Binding Title}"
                                               FlowDirection="RightToLeft"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource Muted2Brush}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Padding="12,14,12,6" />
                                </Panel>
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="shell:NavEntryViewModel">
                                            <Button Classes="nav-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Margin="0,1"
                                                    ToolTip.Tip="{Binding Label}"
                                                    Command="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).NavigateCommand}"
                                                    CommandParameter="{Binding}">
                                                <!-- Fixed physical slots keep the label next to the right-hand icon. -->
                                                <Grid FlowDirection="LeftToRight">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Active accent bar, overlaid flush against the
                                                         pill's inner RIGHT (RTL leading) edge. Negative
                                                         right margin cancels the button's 12px padding so
                                                         the 4px bar sits flush against the pill edge. -->
                                                    <Border Classes="nav-accent"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="3"
                                                            Width="4"
                                                            Margin="0,-3,-12,-3"
                                                            CornerRadius="4,0,0,4"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="{StaticResource Brand600Brush}" />

                                                    <!-- Label: fills the middle column, right-aligned so it
                                                         hugs the icon on the right. FlowDirection is RTL here
                                                         so the Persian text shapes/flows correctly. In the
                                                         compact rail it fades out (Opacity transition) while
                                                         the surrounding column is squeezed away by the width
                                                         tween + ClipToBounds — no abrupt disappearance. -->
                                                    <TextBlock Grid.Column="1"
                                                               Classes="nav-label"
                                                               FlowDirection="RightToLeft"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               TextAlignment="Right"
                                                               Margin="0,0,12,0"
                                                               TextWrapping="NoWrap"
                                                               ClipToBounds="False"
                                                               Text="{Binding Label}"
                                                               Opacity="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded, Converter={x:Static shell:SidebarView.ExpandedOpacityConverter}}">
                                                        <TextBlock.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Opacity"
                                                                                  Duration="0:0:0.18"
                                                                                  Easing="LinearEasing" />
                                                            </Transitions>
                                                        </TextBlock.Transitions>
                                                    </TextBlock>

                                                    <!-- Icon-column spacer: reserves the fixed 18px far-right
                                                         column so the label can never slide underneath the
                                                         icon; keeps the icon column a constant width on every
                                                         row → all icons line up vertically on the right. -->
                                                    <Border Grid.Column="2"
                                                            Width="18"
                                                            IsHitTestVisible="False" />

                                                    <!-- Icon: overlaid across all columns and ALWAYS anchored
                                                         to the fixed far-right column, so every row's icon
                                                         shares one vertical line in both states (no alignment
                                                         swap = no jump). To visually centre it in the compact
                                                         rail we glide it inward with a TranslateTransform whose
                                                         X is tweened by a transform Transition — the icon
                                                         slides smoothly to the rail centre in step with the
                                                         width tween rather than snapping between alignments. -->
                                                    <Panel Grid.Column="0"
                                                           Grid.ColumnSpan="3"
                                                           Width="18"
                                                           Height="18"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           RenderTransform="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded, Converter={x:Static shell:SidebarView.RailIconShiftConverter}}">
                                                        <Panel.Transitions>
                                                            <Transitions>
                                                                <TransformOperationsTransition Property="RenderTransform"
                                                                                               Duration="0:0:0.30"
                                                                                               Easing="CubicEaseOut" />
                                                            </Transitions>
                                                        </Panel.Transitions>
                                                        <Path Classes="icon nav-icon"
                                                              Width="18"
                                                              Height="18"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                        <!-- unread badge (notifications entry only): hangs off the icon's top-right so it
                                                             stays visible in the compact rail too -->
                                                        <Border IsVisible="{Binding HasBadge}"
                                                                MinWidth="16"
                                                                Height="16"
                                                                Padding="4,0"
                                                                CornerRadius="8"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Margin="0,-9,-10,0"
                                                                Background="{StaticResource DangerBrush}"
                                                                BorderBrush="{StaticResource PanelBrush}"
                                                                BorderThickness="1.5"
                                                                IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding BadgeText}"
                                                                       FontSize="9.5"
                                                                       FontWeight="ExtraBold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </Panel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
