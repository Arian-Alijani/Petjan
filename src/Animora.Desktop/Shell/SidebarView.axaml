<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Shell.SidebarView"
             x:DataType="shell:SidebarViewModel"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Nav item chrome, matching .nav-item / .nav-item.active in
             Animora-UI/assets/styles.css (soft-tinted active state + left
             accent bar via the ActiveBar Border). -->
        <Style Selector="Button.nav-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style Selector="Button.nav-item Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-badge">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-badge-text">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-accent">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Active state -->
        <Style Selector="Button.nav-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.nav-item.active Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-badge">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-badge-text">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- The host control's width is animated between the expanded (288) and
         compact (76) rails by the shell. Letting this Border stretch to fill
         that width (instead of a fixed 288) means the nav content actually
         reflows into the compact rail rather than being clipped, so no
         label-only / icon-less strip is left behind when collapsed. -->
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Stretch"
            Padding="14,18,14,14">
        <DockPanel LastChildFill="True">

            <!-- Brand header -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{StaticResource Line2Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4,8,16"
                    Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                IsVisible="{Binding IsExpanded}"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="وت‌پلاس"
                                   FontSize="19"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="کلینیک هوشمند"
                                   FontSize="11"
                                   Foreground="{StaticResource Muted2Brush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            CornerRadius="12"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                <GradientStop Offset="1" Color="{StaticResource Brand600Color}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Classes="icon"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="White"
                              Data="{StaticResource IconShield}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom cluster: sync status + user card. Hidden in compact
                 mode so the navigation icons keep the full rail height. -->
            <StackPanel DockPanel.Dock="Bottom"
                        IsVisible="{Binding IsExpanded}"
                        Spacing="8">
                <!-- Sync status -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="4,4,4,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{StaticResource OkBrush}" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="همگام‌سازی فعال"
                                   FontWeight="Bold"
                                   FontSize="11.5"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="آخرین بروزرسانی: چند ثانیه پیش"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- User card -->
                <Border CornerRadius="12"
                        Padding="10,9"
                        Background="White"
                        BorderBrush="{StaticResource Line2Brush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                    <GradientStop Offset="1" Color="{StaticResource Brand700Color}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding CurrentUser.Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="ExtraBold"
                                       FontSize="14"
                                       Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding CurrentUser.Name}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding CurrentUser.RoleLabel}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Path Grid.Column="2"
                              Classes="icon"
                              VerticalAlignment="Center"
                              Width="15"
                              Height="15"
                              Stroke="{StaticResource Muted2Brush}"
                              Data="{StaticResource IconChevronLeft}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Grouped nav list (fills the middle) -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shell:NavGroupViewModel">
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Title}"
                                           IsVisible="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded}"
                                           Foreground="{StaticResource Muted2Brush}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Padding="12,14,12,6" />
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="shell:NavEntryViewModel">
                                            <Button Classes="nav-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Margin="0,1"
                                                    ToolTip.Tip="{Binding Label}"
                                                    Command="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).NavigateCommand}"
                                                    CommandParameter="{Binding}">
                                                <!-- RTL layout: [accent overlay] icon | label | badge.
                                                     The accent rail is an OVERLAY (own layer, pinned to
                                                     the leading/right edge) so it never shifts the icon.
                                                     The icon column stretches and centers its content,
                                                     so in the compact rail the icon stays perfectly
                                                     centered with no icon-less strip left over. The
                                                     label + badge collapse (IsVisible + zero layout size)
                                                     when the sidebar is compact. -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <!-- Leading accent bar (active only), overlaid -->
                                                    <Border Classes="nav-accent"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Width="3"
                                                            Margin="0,2"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Background="{StaticResource Brand600Brush}" />

                                                    <!-- Icon + label share the first (stretching) column.
                                                         When expanded the row is right-aligned (RTL);
                                                         when compact only the icon shows, centered. -->
                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="12"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded, Converter={x:Static shell:SidebarView.RailAlignmentConverter}}">
                                                        <Path Classes="icon nav-icon"
                                                              Width="18"
                                                              Height="18"
                                                              VerticalAlignment="Center"
                                                              Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                        <TextBlock Classes="nav-label"
                                                                   IsVisible="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="NoWrap"
                                                                   Text="{Binding Label}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Classes="nav-badge"
                                                            CornerRadius="20"
                                                            Padding="7,1"
                                                            MinWidth="20"
                                                            Margin="4,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{x:Static shell:SidebarView.AllTrueConverter}">
                                                                <Binding Path="HasBadge" />
                                                                <Binding Path="$parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                        <TextBlock Classes="nav-badge-text"
                                                                   Text="{Binding BadgeText}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
