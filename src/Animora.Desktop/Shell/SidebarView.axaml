<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Shell.SidebarView"
             x:DataType="shell:SidebarViewModel"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Nav item chrome, matching .nav-item / .nav-item.active in
             Animora-UI/assets/styles.css (soft-tinted active state + left
             accent bar via the ActiveBar Border). -->
        <Style Selector="Button.nav-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style Selector="Button.nav-item Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-badge">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
        </Style>
        <Style Selector="Button.nav-item TextBlock.nav-badge-text">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav-item Border.nav-accent">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Active state -->
        <Style Selector="Button.nav-item.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource Brand700Brush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.nav-item.active Path.nav-icon">
            <Setter Property="Stroke" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-badge">
            <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
        </Style>
        <Style Selector="Button.nav-item.active TextBlock.nav-badge-text">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.nav-item.active Border.nav-accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Border Width="288"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1,0,0,0"
            Padding="14,18,14,14">
        <DockPanel LastChildFill="True">

            <!-- Brand header -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{StaticResource Line2Brush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4,8,16"
                    Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                IsVisible="{Binding IsExpanded}"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="وت‌پلاس"
                                   FontSize="19"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="کلینیک هوشمند"
                                   FontSize="11"
                                   Foreground="{StaticResource Muted2Brush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            CornerRadius="12"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                <GradientStop Offset="1" Color="{StaticResource Brand600Color}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Classes="icon"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="White"
                              Data="{StaticResource IconShield}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom cluster: sync status + user card. Hidden in compact
                 mode so the navigation icons keep the full rail height. -->
            <StackPanel DockPanel.Dock="Bottom"
                        IsVisible="{Binding IsExpanded}"
                        Spacing="8">
                <!-- Sync status -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="4,4,4,0">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{StaticResource OkBrush}" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="همگام‌سازی فعال"
                                   FontWeight="Bold"
                                   FontSize="11.5"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="آخرین بروزرسانی: چند ثانیه پیش"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- User card -->
                <Border CornerRadius="12"
                        Padding="10,9"
                        Background="White"
                        BorderBrush="{StaticResource Line2Brush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="{StaticResource Brand500Color}" />
                                    <GradientStop Offset="1" Color="{StaticResource Brand700Color}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding CurrentUser.Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="ExtraBold"
                                       FontSize="14"
                                       Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding CurrentUser.Name}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding CurrentUser.RoleLabel}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Path Grid.Column="2"
                              Classes="icon"
                              VerticalAlignment="Center"
                              Width="15"
                              Height="15"
                              Stroke="{StaticResource Muted2Brush}"
                              Data="{StaticResource IconChevronLeft}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Grouped nav list (fills the middle) -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shell:NavGroupViewModel">
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Title}"
                                           IsVisible="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded}"
                                           Foreground="{StaticResource Muted2Brush}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Padding="12,14,12,6" />
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="shell:NavEntryViewModel">
                                            <Button Classes="nav-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Margin="0,1"
                                                    ToolTip.Tip="{Binding Label}"
                                                    Command="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).NavigateCommand}"
                                                    CommandParameter="{Binding}">
                                                <!-- RTL layout: accent rail | icon | label | badge.
                                                     Each element sits in its own column so nothing
                                                     overlaps. In RTL the accent rail renders at the
                                                     leading (right) edge of the item. -->
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                    <!-- Leading accent bar (active only) -->
                                                    <Border Classes="nav-accent"
                                                            Grid.Column="0"
                                                            Width="3"
                                                            Margin="0,2,9,2"
                                                            CornerRadius="3"
                                                            VerticalAlignment="Stretch"
                                                            Background="{StaticResource Brand600Brush}" />
                                                    <Path Grid.Column="1"
                                                          Classes="icon nav-icon"
                                                          Width="18"
                                                          Height="18"
                                                          VerticalAlignment="Center"
                                                          Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}" />
                                                    <TextBlock Grid.Column="2"
                                                               Classes="nav-label"
                                                               IsVisible="{Binding $parent[UserControl].((shell:SidebarViewModel)DataContext).IsExpanded}"
                                                               VerticalAlignment="Center"
                                                               Margin="12,2,4,2"
                                                               TextWrapping="NoWrap"
                                                               Text="{Binding Label}" />
                                                    <Border Grid.Column="3"
                                                            Classes="nav-badge"
                                                            IsVisible="{Binding HasBadge}"
                                                            CornerRadius="20"
                                                            Padding="7,1"
                                                            MinWidth="20"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Classes="nav-badge-text"
                                                                   Text="{Binding BadgeText}"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

</UserControl>
