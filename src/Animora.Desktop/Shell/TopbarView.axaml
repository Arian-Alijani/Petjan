<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Shell.TopbarView"
             x:DataType="shell:TopbarViewModel">

    <UserControl.Styles>
        <!-- Sync glyph spin: a continuous 360° rotation while a sync is running
             (mirrors the fold-rotation pattern above, driven by a class so the
             animation only runs in the syncing state). -->
        <Style Selector="Path.sync-glyph">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Path.sync-glyph.spinning">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="0,0,0,1"
            Padding="24,12">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- Leading cluster: sidebar fold toggle + brand logo mark. The
                 small VetPlus logo sits at the top of the app at all times
                 (independent of the sidebar's expand/collapse state), so the
                 brand identity is always present in the app chrome. -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">

                <!-- Animated menu toggle. This is now the SINGLE sidebar fold
                     control for the whole shell (the duplicate in-sidebar toggle
                     was removed). It uses the fold (double-chevron ») glyph so the
                     former in-sidebar icon now lives here, in the topbar's leading
                     slot, and smoothly rotates to flip direction as the sidebar
                     collapses/expands. -->
                <Button Classes="ghost"
                        Command="{Binding ToggleSidebarCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding SidebarToggleToolTip}">
                    <Path Classes="icon"
                          Width="18"
                          Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="50%,50%"
                          Stroke="{StaticResource Ink2Brush}"
                          Data="{StaticResource IconFold}">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding ToggleIconRotation}">
                                <RotateTransform.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Angle"
                                                          Duration="0:0:0.28"
                                                          Easing="CubicEaseInOut" />
                                    </Transitions>
                                </RotateTransform.Transitions>
                            </RotateTransform>
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <!-- Brand logo mark + wordmark, always visible at the top. -->
                <StackPanel Orientation="Horizontal"
                            Spacing="9"
                            VerticalAlignment="Center">
                    <Image Width="30"
                           Height="30"
                           Stretch="Uniform"
                           Source="avares://Animora.Desktop/Assets/Brand/vetplus-mark-128.png" />
                    <TextBlock Text="وت‌پلاس"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Title block: accent rail + heading -->
            <Grid Grid.Column="1"
                  Margin="14,0,0,0"
                  ColumnDefinitions="Auto,*"
                  VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Width="3"
                        Height="28"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Background="{StaticResource Brand600Brush}" />
                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="1">
                    <TextBlock Text="{Binding CurrentPage.Title}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               FontSize="21"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" />
                </StackPanel>
            </Grid>

            <!-- Trailing actions -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">

                <!-- Search (visual-only trigger) -->
                <Button Command="{Binding OpenSearchCommand}"
                        Padding="0"
                        Width="232"
                        Height="42"
                        Background="{StaticResource Bg2Brush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand"
                        HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0" ClipToBounds="True">
                        <Path Grid.Column="0"
                              Classes="icon"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource MutedBrush}"
                              Data="{StaticResource IconSearch}" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="جستجو در همه بخش‌ها…" />
                        <Border Grid.Column="2"
                                CornerRadius="6"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{StaticResource Bg2Brush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1">
                            <TextBlock Text="Ctrl+K"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Sync status box (design-only widget; driven by ISyncStatusService
                     so a future sync engine can update it with zero view changes). -->
                <Button Command="{Binding SyncNowCommand}"
                        Padding="0"
                        Width="196"
                        Height="42"
                        HorizontalContentAlignment="Stretch"
                        Background="{Binding SyncBoxBackground}"
                        BorderBrush="{Binding SyncBoxBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand"
                        ToolTip.Tip="{Binding SyncToolTip}">
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="10,0" ClipToBounds="True">
                        <Ellipse Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{Binding SyncStateBrush}" />

                        <!-- Sync glyph: rotates continuously while a sync is running. -->
                        <Path Grid.Column="1"
                              Classes="icon sync-glyph"
                              Classes.spinning="{Binding IsSyncing}"
                              Width="16"
                              Height="16"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="50%,50%"
                              Stroke="{StaticResource Ink2Brush}"
                              Data="{StaticResource IconSync}">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>

                        <StackPanel Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding SyncStatusText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding SyncRelativeText}"
                                       FontSize="10"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Manual refresh of the current page (fallback to the automatic refresh on entry). -->
                <Button Classes="ghost"
                        Command="{Binding CurrentPage.LoadStatus.RefreshCommand}"
                        IsVisible="{Binding CurrentPage.LoadStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        ToolTip.Tip="تازه‌سازی صفحه"
                        AutomationProperties.Name="تازه‌سازی اطلاعات صفحه">
                    <Path Classes="icon"
                          Width="18"
                          Height="18"
                          Stroke="{StaticResource Ink2Brush}"
                          Data="{StaticResource IconRefresh}" />
                </Button>

                <!-- Theme toggle (moon) — inert stub, matching the reference. -->
                <Button Classes="ghost"
                        Command="{Binding ToggleThemeCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        ToolTip.Tip="تم روشن/تیره">
                    <Path Classes="icon"
                          Width="18"
                          Height="18"
                          Stroke="{StaticResource Ink2Brush}"
                          Data="{StaticResource IconMoon}" />
                </Button>

                <!-- Notification bell (inert stub, red dot) -->
                <Button Classes="ghost"
                        Command="{Binding OpenNotificationsCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        ToolTip.Tip="اعلان‌ها">
                    <Panel>
                        <Path Classes="icon"
                              Width="18"
                              Height="18"
                              Stroke="{StaticResource Ink2Brush}"
                              Data="{StaticResource IconBell}" />
                        <Ellipse Width="7"
                                 Height="7"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,0,0,0"
                                 Stroke="{StaticResource PanelBrush}"
                                 StrokeThickness="1"
                                 Fill="{StaticResource DangerBrush}" />
                    </Panel>
                </Button>

                <!-- User chip -->
                <Border CornerRadius="12"
                        Padding="4,4,10,4"
                        Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="9"
                                Background="{StaticResource Brand50Brush}"
                                BorderBrush="{StaticResource Brand100Brush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding CurrentUser.Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brand700Brush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding CurrentUser.Name}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding CurrentUser.RoleLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
