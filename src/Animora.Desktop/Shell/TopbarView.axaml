<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Animora.Desktop.Shell"
             x:Class="Animora.Desktop.Shell.TopbarView"
             x:DataType="shell:TopbarViewModel">

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="0,0,0,1"
            Padding="24,12">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- Animated menu toggle. A single chevron/arrow that smoothly
                 rotates to flip its direction as the sidebar collapses/expands,
                 leaving the compact icon navigation rail available. -->
            <Button Grid.Column="0"
                    Classes="ghost"
                    Command="{Binding ToggleSidebarCommand}"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding SidebarToggleToolTip}">
                <Path Classes="icon"
                      Width="18"
                      Height="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="50%,50%"
                      Stroke="{StaticResource Ink2Brush}"
                      Data="{StaticResource IconChevronRight}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="{Binding ToggleIconRotation}">
                            <RotateTransform.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Angle"
                                                      Duration="0:0:0.28"
                                                      Easing="CubicEaseInOut" />
                                </Transitions>
                            </RotateTransform.Transitions>
                        </RotateTransform>
                    </Path.RenderTransform>
                </Path>
            </Button>

            <!-- Title block: accent rail + breadcrumbs + heading -->
            <Grid Grid.Column="1"
                  Margin="14,0,0,0"
                  ColumnDefinitions="Auto,*"
                  VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Width="3"
                        Height="28"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Background="{StaticResource Brand600Brush}" />
                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="1">
                    <ItemsControl ItemsSource="{Binding CurrentPage.Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding CurrentPage.Title}"
                               FontSize="17"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource InkBrush}" />
                </StackPanel>
            </Grid>

            <!-- Trailing actions -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">

                <!-- Search (visual-only trigger) -->
                <Button Command="{Binding OpenSearchCommand}"
                        Padding="0"
                        Width="320"
                        Background="{StaticResource Bg2Brush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand"
                        HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,9">
                        <Path Grid.Column="0"
                              Classes="icon"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource MutedBrush}"
                              Data="{StaticResource IconSearch}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="جستجو در بیماران، نوبت‌ها، فاکتورها..." />
                        <Border Grid.Column="2"
                                CornerRadius="6"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{StaticResource Bg2Brush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1">
                            <TextBlock Text="Ctrl+K"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Quick-create -->
                <Button Classes="primary"
                        Command="{Binding CreateNewCommand}"
                        ToolTip.Tip="ایجاد جدید">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon"
                              Width="15"
                              Height="15"
                              Stroke="White"
                              Data="{StaticResource IconPlus}" />
                        <TextBlock Text="ایجاد جدید" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Theme toggle (moon) — inert stub, matching the reference. -->
                <Button Classes="ghost"
                        Command="{Binding ToggleThemeCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        ToolTip.Tip="تم روشن/تیره">
                    <Path Classes="icon"
                          Width="18"
                          Height="18"
                          Stroke="{StaticResource Ink2Brush}"
                          Data="{StaticResource IconMoon}" />
                </Button>

                <!-- Notification bell (inert stub, red dot) -->
                <Button Classes="ghost"
                        Command="{Binding OpenNotificationsCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        ToolTip.Tip="اعلان‌ها">
                    <Panel>
                        <Path Classes="icon"
                              Width="18"
                              Height="18"
                              Stroke="{StaticResource Ink2Brush}"
                              Data="{StaticResource IconBell}" />
                        <Ellipse Width="8"
                                 Height="8"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,2,2,0"
                                 Fill="{StaticResource DangerBrush}" />
                    </Panel>
                </Button>

                <!-- User chip -->
                <Border CornerRadius="12"
                        Padding="4,4,10,4"
                        Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="9"
                                Background="{StaticResource Brand50Brush}"
                                BorderBrush="{StaticResource Brand100Brush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding CurrentUser.Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource Brand700Brush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding CurrentUser.Name}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding CurrentUser.RoleLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
