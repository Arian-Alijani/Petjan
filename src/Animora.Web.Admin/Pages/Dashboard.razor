@page "/admin"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminStatusReader Reader
<h1>Dashboard</h1><a href="/admin">Refresh</a><FormError Code="@Error" />
@if (Status is not null) {
<p>Version @Status.Version · uptime @Status.UptimeSeconds.ToString("F0") seconds</p>
<table><caption>Readiness</caption><thead><tr><th scope="col">Probe</th><th scope="col">Status</th></tr></thead><tbody>
@foreach (var probe in Status.Readiness) { <tr><td>@probe.Name</td><td><StatusBadge Status="@probe.Status" /></td></tr> }
</tbody></table>
<table><caption>Workers</caption><thead><tr><th scope="col">Worker</th><th scope="col">Last success age (s)</th></tr></thead><tbody>
@foreach (var worker in Status.Workers) { <tr><td>@worker.Name</td><td>@worker.LastSuccessAgeSeconds.ToString("F0")</td></tr> }</tbody></table>
<dl><dt>Commands running</dt><dd>@Status.Counters.CommandsInProgress</dd><dt>Outbox pending</dt><dd>@Status.Counters.OutboxPending</dd>
<dt>Dead letters</dt><dd><a href="/admin/tenants?status=dead-lettered">@Status.Counters.OutboxDeadLettered</a></dd>
<dt>Expiring within 14 days</dt><dd><a href="/admin/tenants?status=expiring">@Status.ExpiringSoon</a></dd>
<dt>Past due / grace</dt><dd><a href="/admin/tenants?status=past-due">@Status.PastDue</a></dd>
<dt>PG active / pool max</dt><dd>@Status.Pg.PoolInUse / @Status.Pg.PoolMax</dd></dl>
}
@code { private AdminStatus? Status; protected override async Task OnInitializedAsync()=>Status=Capture(await Reader.GetStatusAsync(Cancellation)); }
