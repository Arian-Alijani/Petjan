@page "/admin"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminStatusReader Reader
@inject IAdminInsightStatus Insight
@inject IAdminTenantQueries Tenants
<div class="dash-head"><h1>@Loc.T("dash.title")</h1><a class="ghost-link" href="/admin">@Loc.T("common.refresh")</a></div>
<FormError Code="@Error" />
<nav class="quick" aria-label="@Loc.T("dash.quick")"><a href="/admin/tenants">@Loc.T("nav.tenants")</a><a href="/admin/tenants/new">@Loc.T("nav.newTenant")</a></nav>

@* ── headline counts ─────────────────────────────────────────────── *@
<div class="cards" role="list">
<a class="card hero" role="listitem" href="/admin/tenants"><strong>@TotalClinics.ToString("N0")</strong><span>@Loc.T("dash.clinics")</span></a>
<a class="card hero" role="listitem" href="/admin/tenants?status=Active"><strong>@ActiveClinics.ToString("N0")</strong><span>@Loc.T("dash.activeClinics")</span></a>
@if (Status is not null) {
<a class="card@(Status.ExpiringSoon > 0 ? " warn" : "")" role="listitem" href="/admin/tenants?status=expiring"><strong>@Status.ExpiringSoon</strong><span>@Loc.T("dash.expiring")</span></a>
<a class="card@(Status.PastDue > 0 ? " warn" : "")" role="listitem" href="/admin/tenants?status=past-due"><strong>@Status.PastDue</strong><span>@Loc.T("dash.pastDue")</span></a>
}
</div>

@if (Status is not null) {
@* ── one-line overall health + secondary counters ─────────────────── *@
<div class="health"><span class="health-chip @(Healthy ? "ok" : "bad")">@Loc.T(Healthy ? "dash.healthy" : "dash.unhealthy")</span>
<span class="health-meta">@Loc.T("dash.version") @Status.Version · @Loc.T("dash.uptime") @FormatUptime(Status.UptimeSeconds)</span></div>
<div class="cards" role="list">
<a class="card@(Status.Counters.OutboxDeadLettered > 0 ? " bad" : "")" role="listitem" href="/admin/tenants?status=dead-lettered"><strong>@Status.Counters.OutboxDeadLettered</strong><span>@Loc.T("dash.dead")</span></a>
<div class="card" role="listitem"><strong>@Status.Counters.CommandsInProgress</strong><span>@Loc.T("dash.commands")</span></div>
<div class="card" role="listitem"><strong>@Status.Counters.OutboxPending</strong><span>@Loc.T("dash.outbox")</span></div>
<div class="card" role="listitem"><strong>@Status.Pg.PoolInUse / @Status.Pg.PoolMax</strong><span>@Loc.T("dash.pg")</span></div>
</div>

@* ── full probe/worker detail, collapsed by default to stay minimal ── *@
<details class="dash-details">
<summary>@Loc.T("dash.details")</summary>
<table><caption>@Loc.T("dash.readiness")</caption><thead><tr><th scope="col">@Loc.T("dash.probe")</th><th scope="col">@Loc.T("common.status")</th></tr></thead><tbody>
@foreach (var probe in Status.Readiness) { <tr><td>@probe.Name</td><td><StatusBadge Status="@probe.Status" /></td></tr> }
</tbody></table>
<table><caption>@Loc.T("dash.workers")</caption><thead><tr><th scope="col">@Loc.T("dash.worker")</th><th scope="col">@Loc.T("dash.lastSuccess")</th></tr></thead><tbody>
@foreach (var worker in Status.Workers) { <tr><td>@worker.Name</td><td>@worker.LastSuccessAgeSeconds.ToString("F0")</td></tr> }</tbody></table>
</details>
}
<LiveStatusPanel Lang="@Loc.Code" />
@if (InsightState is not null)
{
<p class="hint">@Loc.T("dash.insight"): @Loc.T(InsightState.Enabled ? "dash.enabled" : InsightState.HasConsentAdr ? "dash.disabled" : "dash.disabledNoAdr")</p>
}
@code {
    private AdminStatus? Status;
    private InsightStatus? InsightState;
    private long TotalClinics;
    private long ActiveClinics;
    // A probe whose status is anything other than a healthy marker flips overall health to unhealthy.
    private bool Healthy => Status is not null && Status.Readiness.All(p => IsHealthy(p.Status)) && Status.Counters.OutboxDeadLettered == 0;
    private static bool IsHealthy(string s) => string.Equals(s, "Healthy", StringComparison.OrdinalIgnoreCase)
        || string.Equals(s, "Ok", StringComparison.OrdinalIgnoreCase) || string.Equals(s, "Up", StringComparison.OrdinalIgnoreCase);
    protected override async Task OnInitializedAsync()
    {
        Status = Capture(await Reader.GetStatusAsync(Cancellation));
        var statusError = Error;
        // Cheap totals: PageSize=1 returns a COUNT + a single tiny row, never the whole directory.
        var all = Capture(await Tenants.ListAsync(new(null, null, 1, 1), Cancellation)); TotalClinics = all?.Total ?? 0;
        var active = Capture(await Tenants.ListAsync(new("Active", null, 1, 1), Cancellation)); ActiveClinics = active?.Total ?? 0;
        InsightState = Capture(await Insight.GetAsync(Cancellation));
        Error ??= statusError;
    }
    private static string FormatUptime(double seconds)
    {
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalDays >= 1 ? $"{(int)t.TotalDays}d {t.Hours}h" : t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : $"{t.Minutes}m";
    }
}
