@page "/admin"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminStatusReader Reader
@inject IAdminInsightStatus Insight
<h1>@Loc.T("dash.title")</h1><a href="/admin">@Loc.T("common.refresh")</a><FormError Code="@Error" />
@if (Status is not null) {
<p>@Loc.T("dash.version") @Status.Version · @Loc.T("dash.uptime") @Status.UptimeSeconds.ToString("F0") @Loc.T("dash.seconds")</p>
<table><caption>@Loc.T("dash.readiness")</caption><thead><tr><th scope="col">@Loc.T("dash.probe")</th><th scope="col">@Loc.T("common.status")</th></tr></thead><tbody>
@foreach (var probe in Status.Readiness) { <tr><td>@probe.Name</td><td><StatusBadge Status="@probe.Status" /></td></tr> }
</tbody></table>
<table><caption>@Loc.T("dash.workers")</caption><thead><tr><th scope="col">@Loc.T("dash.worker")</th><th scope="col">@Loc.T("dash.lastSuccess")</th></tr></thead><tbody>
@foreach (var worker in Status.Workers) { <tr><td>@worker.Name</td><td>@worker.LastSuccessAgeSeconds.ToString("F0")</td></tr> }</tbody></table>
<dl><dt>@Loc.T("dash.commands")</dt><dd>@Status.Counters.CommandsInProgress</dd><dt>@Loc.T("dash.outbox")</dt><dd>@Status.Counters.OutboxPending</dd>
<dt>@Loc.T("dash.dead")</dt><dd><a href="/admin/tenants?status=dead-lettered">@Status.Counters.OutboxDeadLettered</a></dd>
<dt>@Loc.T("dash.expiring")</dt><dd><a href="/admin/tenants?status=expiring">@Status.ExpiringSoon</a></dd>
<dt>@Loc.T("dash.pastDue")</dt><dd><a href="/admin/tenants?status=past-due">@Status.PastDue</a></dd>
<dt>@Loc.T("dash.pg")</dt><dd>@Status.Pg.PoolInUse / @Status.Pg.PoolMax</dd></dl>
}
<LiveStatusPanel Lang="@Loc.Code" />
@if (InsightState is not null)
{
<p>@Loc.T("dash.insight"): @Loc.T(InsightState.Enabled ? "dash.enabled" : InsightState.HasConsentAdr ? "dash.disabled" : "dash.disabledNoAdr")</p>
}
@code {
    private AdminStatus? Status;
    private InsightStatus? InsightState;
    protected override async Task OnInitializedAsync()
    {
        Status = Capture(await Reader.GetStatusAsync(Cancellation));
        var statusError = Error;
        InsightState = Capture(await Insight.GetAsync(Cancellation));
        Error ??= statusError;
    }
}
