@page "/admin/tenants"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminTenantQueries Queries
<h1>@Loc.T("tenants.title")</h1><FormError Code="@Error" /><p><a href="/admin/tenants/new">@Loc.T("tenants.create")</a></p>
<form method="get" class="filters"><label>@Loc.T("tenants.search") <input name="search" value="@Search" maxlength="200" /></label>
<label>@Loc.T("common.status") <select name="status"><option value="">@Loc.T("common.all")</option>
@foreach (var s in StatusFilters) { <option value="@s" selected="@(string.Equals(Status, s, StringComparison.OrdinalIgnoreCase))">@Loc.T("tfilter." + s)</option> }
</select></label><button type="submit">@Loc.T("common.filter")</button></form>
@if (Rows is not null) {
@if (Rows.Items.Count == 0) { <p class="empty">@Loc.T("common.none")</p> } else {
<div class="table-wrap"><table><caption>@Loc.T("tenants.directory") (@Rows.Total)</caption><thead><tr><th scope="col">@Loc.T("common.name")</th><th scope="col">@Loc.T("common.code")</th><th scope="col">@Loc.T("common.status")</th><th scope="col">@Loc.T("common.action")</th></tr></thead><tbody>
@foreach (var row in Rows.Items) { <tr><td><a href="@($"/admin/tenants/{row.Id}")">@(string.IsNullOrWhiteSpace(row.Name) ? row.Code : row.Name)</a></td><td dir="ltr">@row.Code</td><td><StatusBadge Status="@row.Status" /></td>
<td><a href="@($"/admin/tenants/{row.Id}/staff")">@Loc.T("tenant.staffLink")</a> · <a href="@($"/admin/tenants/{row.Id}/products")">@Loc.T("tenant.productsLink")</a></td></tr> }
</tbody></table></div>
}
<Pager Page="Rows.Page" PageSize="Rows.PageSize" Total="Rows.Total" BaseUrl="@FilterUrl" />
}
@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public int Page { get; set; }=1;
    [SupplyParameterFromQuery] public int PageSize { get; set; }=50;
    private static readonly string[] StatusFilters=["Active","Suspended","Closed","expiring","past-due","dead-lettered"];
    private AdminPage<TenantSummary>? Rows;
    private string FilterUrl=>$"/admin/tenants?search={Uri.EscapeDataString(Search??"")}&status={Uri.EscapeDataString(Status??"")}";
    protected override async Task OnParametersSetAsync()=>Rows=Capture(await Queries.ListAsync(new(Status,Search,Page,PageSize),Cancellation));
}
