@page "/admin/tenants/{Id}/licenses"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminLicenseCommands Commands
<h1>@Loc.T("licences.title")</h1><FormError Code="@Error" />
@if (Rows is not null) {
<p><a href="@($"/admin/tenants/{Id}")">@Loc.T("staff.backToTenant")</a></p>
@if (Rows.Items.Count == 0) { <p class="empty">@Loc.T("common.none")</p> } else {
<div class="table-wrap"><table><caption>@Loc.T("licences.caption")</caption><thead><tr><th scope="col">@Loc.T("licences.device")</th><th scope="col">@Loc.T("common.status")</th><th scope="col">@Loc.T("licences.expires")</th><th scope="col">@Loc.T("licences.revoke")</th></tr></thead><tbody>
@foreach (var row in Rows.Items) { <tr><td dir="ltr">@row.DeviceId</td><td><StatusBadge Status="@row.Status" /></td><td dir="ltr">@row.ExpiresUtc.ToString("yyyy-MM-dd HH:mm") UTC</td><td>
<EditForm Model="Form" FormName="@($"revoke-{row.Id}")" method="post" OnSubmit="Revoke">
<input type="hidden" name="Form.LicenseId" value="@row.Id" /><input type="hidden" name="Form.Stamp" value="@row.Sequence" />
<label>@Loc.T("op.reason") <InputText @bind-Value="Form!.Reason" maxlength="200" /></label><ConfirmCheckbox Name="Form.Confirmed" /><button type="submit" class="danger">@Loc.T("licences.revoke")</button></EditForm>
</td></tr> }</tbody></table></div>
}
<Pager Page="Rows.Page" PageSize="Rows.PageSize" Total="Rows.Total" BaseUrl="@($"/admin/tenants/{Id}/licenses")" />
<EditForm Model="Form" FormName="recheck" method="post" OnSubmit="Recheck">
<input type="hidden" name="Form.Stamp" value="@Rows.Stamp" /><button type="submit" class="secondary">@Loc.T("licences.recheck")</button></EditForm>
}
@code {
    [Parameter] public string Id { get; set; }="";
    [SupplyParameterFromQuery] public int Page { get; set; }=1;
    [SupplyParameterFromForm] public LicenseActionForm? Form { get; set; }
    private AdminPage<LicenseSummary>? Rows;
    protected override async Task OnInitializedAsync() { Form??=new(); Rows=Capture(await Commands.ListAsync(Id,Page,50,Cancellation)); }
    private async Task Revoke(EditContext _) { Capture(await Commands.RevokeAsync(Id,Form!,Cancellation)); }
    private async Task Recheck(EditContext _) { Capture(await Commands.RecheckAsync(Id,Form!.Stamp,Cancellation)); }
}
