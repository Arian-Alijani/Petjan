@page "/admin/audit"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminAuditQueries Queries
<h1>@Loc.T("audit.title")</h1><FormError Code="@Error" />
<nav class="quick" aria-label="@Loc.T("audit.source")"><a href="/admin/audit?tab=operator">@Loc.T("audit.operator")</a> <a href="/admin/audit?tab=tenant">@Loc.T("audit.tenant")</a></nav>
<form method="get" class="filters"><input type="hidden" name="tab" value="@Tab" />
<label>@Loc.T("audit.tenantId") <input name="tenantId" value="@TenantId" maxlength="26" required="@(Tab == "tenant")" /></label>
<label>@Loc.T("common.action") <input name="action" value="@Action" maxlength="64" /></label>
@if (Tab == "tenant") { <label>@Loc.T("audit.actorId") <input name="actorId" value="@ActorId" maxlength="26" dir="ltr" /></label> }
<label>@Loc.T("audit.from") <input type="date" name="from" value="@From?.ToString("yyyy-MM-dd")" required="@(Tab == "tenant")" /></label>
<label>@Loc.T("audit.to") <input type="date" name="to" value="@To?.ToString("yyyy-MM-dd")" required="@(Tab == "tenant")" /></label>
<button type="submit">@Loc.T("common.filter")</button></form>
@if (Tab == "tenant") { <p class="hint">@Loc.T("audit.tenantHint")</p> }
@if (Rows is not null)
{
@if (Rows.Items.Count == 0) { <p class="empty">@Loc.T("common.none")</p> } else {
<div class="table-wrap"><table><caption>@Loc.T(Tab == "tenant" ? "audit.tenant" : "audit.operator")</caption><thead><tr><th scope="col">UTC</th><th scope="col">@Loc.T("audit.actor")</th><th scope="col">@Loc.T("audit.tenantCol")</th><th scope="col">@Loc.T("common.action")</th><th scope="col">@Loc.T("audit.outcome")</th><th scope="col">@Loc.T("audit.correlation")</th><th scope="col">@Loc.T("audit.detail")</th></tr></thead><tbody>
@foreach (var row in Rows.Items)
{
<tr><td dir="ltr">@row.OccurredUtc</td><td dir="ltr">@row.ActorId</td><td dir="ltr">@row.TenantId</td><td dir="ltr">@row.Action</td><td><StatusBadge Status="@row.Outcome" /></td><td>@row.CorrelationId</td><td><pre>@row.Detail</pre></td></tr>
}
</tbody></table></div>
}
<Pager Page="Rows.Page" PageSize="Rows.PageSize" Total="Rows.Total" BaseUrl="@FilterUrl" />
}
@code {
    [SupplyParameterFromQuery] public string Tab { get; set; } = "operator";
    [SupplyParameterFromQuery] public string? TenantId { get; set; }
    [SupplyParameterFromQuery] public string? Action { get; set; }
    [SupplyParameterFromQuery] public string? ActorId { get; set; }
    [SupplyParameterFromQuery] public DateTime? From { get; set; }
    [SupplyParameterFromQuery] public DateTime? To { get; set; }
    [SupplyParameterFromQuery] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery] public int PageSize { get; set; } = 50;
    private AdminPage<AuditSummary>? Rows;
    private static DateTimeOffset? Utc(DateTime? value) => value is { } date ? new DateTimeOffset(DateTime.SpecifyKind(date, DateTimeKind.Utc)) : null;
    private string FilterUrl => $"/admin/audit?tab={Uri.EscapeDataString(Tab)}&tenantId={Uri.EscapeDataString(TenantId ?? "")}&action={Uri.EscapeDataString(Action ?? "")}&actorId={Uri.EscapeDataString(ActorId ?? "")}&from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}";
    protected override async Task OnInitializedAsync()
    {
        var query = new AdminAuditQuery(TenantId, Action, Utc(From), Utc(To), Page, PageSize, ActorId);
        if (Tab == "tenant")
        {
            if (string.IsNullOrWhiteSpace(TenantId) || From is null || To is null) return;
            Rows = Capture(await Queries.TenantAsync(query, Cancellation));
        }
        else if (Tab == "operator") Rows = Capture(await Queries.OperatorAsync(query, Cancellation));
        else Error = ErrorCodes.ValidationFailed.Code;
    }
}
