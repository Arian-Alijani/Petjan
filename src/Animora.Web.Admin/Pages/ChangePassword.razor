@page "/admin/account/change-password"
@attribute [Authorize(Policy="AdminOnly")]
<h1>@Loc.T("pwd.title")</h1>
@if (Error is not null) { <FormError Code="@ErrorCodes.PasswordPolicyViolation.Code" /> }
<form method="post" action="/admin/account/change-password"><AntiforgeryToken />
<label>@Loc.T("pwd.current") <input name="oldPassword" type="password" autocomplete="current-password" required maxlength="1024" /></label>
<label>@Loc.T("pwd.new") <input name="newPassword" type="password" autocomplete="new-password" required maxlength="1024" /></label>
<button type="submit">@Loc.T("pwd.submit")</button></form>
@code { [SupplyParameterFromQuery(Name="error")] public string? Error { get; set; } }
