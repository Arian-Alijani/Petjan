@page "/admin/account/change-password"
@attribute [Authorize(Policy="AdminOnly")]
<h1>Change operator password</h1>
@if (Error is not null) { <FormError Code="@ErrorCodes.PasswordPolicyViolation.Code" /> }
<form method="post" action="/admin/account/change-password"><AntiforgeryToken />
<label>Current password <input name="oldPassword" type="password" autocomplete="current-password" required maxlength="1024" /></label>
<label>New password <input name="newPassword" type="password" autocomplete="new-password" required maxlength="1024" /></label>
<button type="submit">Change password and sign out</button></form>
@code { [SupplyParameterFromQuery(Name="error")] public string? Error { get; set; } }
