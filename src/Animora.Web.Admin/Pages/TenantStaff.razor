@page "/admin/tenants/{Id}/staff"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminStaffQueries Queries
@inject IAdminStaffCommands Commands
<h1>@Loc.T("staff.title")</h1><FormError Code="@Error" />
<p><a href="@($"/admin/tenants/{Id}")">@Loc.T("staff.backToTenant")</a></p>
@if (Receipt?.TemporaryPassword is { } password) { <p class="secret">@Loc.T("staff.tempPassword"): <code>@password</code></p> }
<form method="get"><label>@Loc.T("staff.search") <input name="search" value="@Search" maxlength="100" /></label>
<label>@Loc.T("staff.role") <select name="role"><option value="">@Loc.T("staff.allRoles")</option>
@foreach (var r in Roles) { <option value="@r" selected="@(string.Equals(Role, r, StringComparison.OrdinalIgnoreCase))">@Loc.T("role." + r)</option> }
</select></label><button type="submit">@Loc.T("common.filter")</button></form>
@if (Rows is not null) {
<table><caption>@Loc.T("staff.caption")</caption><thead><tr><th scope="col">@Loc.T("staff.name")</th><th scope="col">@Loc.T("staff.username")</th><th scope="col">@Loc.T("staff.role")</th>
<th scope="col">@Loc.T("common.status")</th><th scope="col">@Loc.T("staff.devices")</th><th scope="col">@Loc.T("staff.resetPassword")</th></tr></thead><tbody>
@foreach (var row in Rows.Items) {
<tr><td>@row.Name</td><td dir="ltr">@row.UserName</td><td>@Loc.T("role." + row.Role)</td>
<td><StatusBadge Status="@(row.Active ? Loc.T("staff.active") : Loc.T("staff.inactive"))" /></td><td>@row.Devices</td>
<td><EditForm Model="ResetForm" FormName="@($"reset-{row.UserId}")" method="post" OnSubmit="Reset">
<input type="hidden" name="ResetForm.UserId" value="@row.UserId" />
<ConfirmCheckbox Name="ResetForm.Confirmed" /><button type="submit" title="@Loc.T("staff.resetHint")">@Loc.T("staff.resetPassword")</button></EditForm></td></tr>
}
</tbody></table><Pager Page="Rows.Page" PageSize="Rows.PageSize" Total="Rows.Total" BaseUrl="@FilterUrl" />
}
<h2>@Loc.T("staff.create")</h2>
<EditForm Model="CreateForm" FormName="create-staff" method="post" OnSubmit="Create">
<label>@Loc.T("staff.createName") <InputText @bind-Value="CreateForm!.Name" maxlength="200" /></label>
<label>@Loc.T("staff.createUser") <InputText @bind-Value="CreateForm.UserName" maxlength="64" dir="ltr" /></label>
<label>@Loc.T("staff.createRole") <InputSelect @bind-Value="CreateForm.Role">@foreach (var r in Roles) { <option value="@r">@Loc.T("role." + r)</option> }</InputSelect></label>
<ConfirmCheckbox Name="CreateForm.Confirmed" /><button type="submit">@Loc.T("staff.createSubmit")</button></EditForm>
@code {
    [Parameter] public string Id { get; set; }="";
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Role { get; set; }
    [SupplyParameterFromQuery] public int Page { get; set; }=1;
    [SupplyParameterFromQuery] public int PageSize { get; set; }=50;
    [SupplyParameterFromForm] public CreateStaffAdminForm? CreateForm { get; set; }
    [SupplyParameterFromForm] public ResetStaffPasswordForm? ResetForm { get; set; }
    private static readonly string[] Roles=["Manager","Doctor","Receptionist","Cashier","Accountant"];
    private AdminPage<StaffAccountSummary>? Rows; private MutationReceipt? Receipt;
    private string FilterUrl=>$"/admin/tenants/{Id}/staff?search={Uri.EscapeDataString(Search??"")}&role={Uri.EscapeDataString(Role??"")}";
    protected override async Task OnInitializedAsync() { CreateForm??=new(); ResetForm??=new(); await Load(); }
    private async Task Load() { var captured=Error; Rows=Capture(await Queries.ListAsync(Id,new(Role,Search,Page,PageSize),Cancellation)); Error??=captured; }
    private async Task Create(EditContext _)
    {
        Receipt=Capture(await Commands.CreateStaffAsync(Id,CreateForm!,Cancellation));
        var failure=Error; await Load(); Error=failure??Error;
    }
    private async Task Reset(EditContext _)
    {
        Receipt=Capture(await Commands.ResetStaffPasswordAsync(Id,ResetForm!,Cancellation));
        var failure=Error; await Load(); Error=failure??Error;
    }
}
