@page "/admin/plans"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminPlanCommands Commands
<div class="dash-head"><h1>@Loc.T("plans.title")</h1></div><FormError Code="@Error" />
@if (SeedSummary is { } seed) { <p class="hint" role="status" aria-live="polite">@Loc.T("plans.seedResult"): @seed</p> }
@if (Rows is not null) {
<div class="table-wrap"><table><caption>@Loc.T("plans.caption")</caption><thead><tr><th scope="col">@Loc.T("common.code")</th><th scope="col">@Loc.T("common.name")</th><th scope="col">@Loc.T("plans.seats")</th><th scope="col">@Loc.T("plans.amount")</th><th scope="col">@Loc.T("plans.trialDays")</th><th scope="col">@Loc.T("common.status")</th><th scope="col">@Loc.T("common.action")</th></tr></thead><tbody>
@if (Rows.Items.Count == 0) { <tr><td colspan="7" class="empty">@Loc.T("common.none")</td></tr> }
@foreach (var row in Rows.Items) { <tr><td dir="ltr">@row.Code</td><td>@row.Name</td><td>@row.Seats</td><td dir="ltr">@row.MonthlyAmountMinor.ToString("N0")</td><td>@row.TrialDays</td><td><StatusBadge Status="@Loc.T(row.Active ? "staff.active" : "staff.inactive")" Tone="@(row.Active ? "ok" : "bad")" /></td><td>
@if(row.Active) { <EditForm Model="Action" FormName="@($"deactivate-{row.Id}")" method="post" OnSubmit="Deactivate">
<input type="hidden" name="Action.Id" value="@row.Id" /><input type="hidden" name="Action.Stamp" value="@row.Stamp" /><button type="submit" class="danger">@Loc.T("plans.deactivate")</button></EditForm> }</td></tr> }
</tbody></table></div><Pager Page="Rows.Page" PageSize="Rows.PageSize" Total="Rows.Total" BaseUrl="/admin/plans" />
}
<h2>@Loc.T("plans.new")</h2>
<EditForm Model="Form" FormName="create-plan" method="post" Enhance OnSubmit="Create">
<fieldset class="form-grid"><legend>@Loc.T("plans.new")</legend>
<label>@Loc.T("common.code") <InputText @bind-Value="Form!.Code" maxlength="32" dir="ltr" required="required" /></label>
<label>@Loc.T("common.name") <InputText @bind-Value="Form.Name" maxlength="100" required="required" /></label>
<label>@Loc.T("plans.seats") <InputNumber @bind-Value="Form.Seats" min="1" max="1000" /></label>
<label>@Loc.T("plans.amountInput") <InputNumber @bind-Value="Form.AmountMinor" min="0" /></label>
<label>@Loc.T("plans.trialDays") <InputNumber @bind-Value="Form.TrialDays" min="0" max="365" /></label>
<p class="hint">@Loc.T("plans.amountHint")</p></fieldset>
<button type="submit" class="btn-primary">@Loc.T("plans.create")</button></EditForm>
<h2>@Loc.T("plans.presets")</h2><p class="hint">@Loc.T("plans.presetsHint")</p>
<div class="table-wrap"><table><thead><tr><th scope="col">@Loc.T("common.code")</th><th scope="col">@Loc.T("common.name")</th><th scope="col">@Loc.T("plans.seats")</th><th scope="col">@Loc.T("plans.amount")</th><th scope="col">@Loc.T("plans.trialDays")</th></tr></thead><tbody>
@foreach (var p in Presets) { <tr><td dir="ltr">@p.Code</td><td>@p.Name</td><td>@p.Seats</td><td dir="ltr">@p.AmountMinor.ToString("N0")</td><td>@p.TrialDays</td></tr> }
</tbody></table></div>
<EditForm Model="Seed" FormName="seed-plans" method="post" Enhance OnSubmit="SeedDefaults">
<ConfirmCheckbox Name="Seed.Confirmed" /><button type="submit" class="secondary">@Loc.T("plans.seedDefaults")</button></EditForm>
@code {
    [SupplyParameterFromQuery] public int Page { get; set; }=1;
    [SupplyParameterFromForm] public CreatePlanForm? Form { get; set; }
    [SupplyParameterFromForm] public PlanActionForm? Action { get; set; }
    [SupplyParameterFromForm] public SeedPlansForm? Seed { get; set; }
    private AdminPage<PlanSummary>? Rows;
    private string? SeedSummary;
    /// <summary>
    /// Standard marketing presets. Plans carry no duration (monthly-amount based); trial length and user limit are the plan-level knobs,
    /// custom days/users are applied per clinic at creation. Amounts are sensible defaults in the plan currency's minor unit.
    /// </summary>
    private static readonly CreatePlanForm[] Presets=
    [
        new() { Code="trial",Name="آزمایشی (دمو)",Seats=2,AmountMinor=0,TrialDays=14 },
        new() { Code="starter",Name="پایه",Seats=3,AmountMinor=490_000,TrialDays=7 },
        new() { Code="standard",Name="استاندارد",Seats=6,AmountMinor=890_000,TrialDays=7 },
        new() { Code="pro",Name="حرفه‌ای",Seats=12,AmountMinor=1_490_000,TrialDays=7 },
        new() { Code="clinic-plus",Name="کلینیک پلاس",Seats=25,AmountMinor=2_490_000,TrialDays=7 },
        new() { Code="enterprise",Name="سازمانی",Seats=100,AmountMinor=4_990_000,TrialDays=0 },
    ];
    protected override async Task OnInitializedAsync() { Form??=new(); Action??=new(); Seed??=new(); await LoadAsync(); }
    private async Task LoadAsync() => Rows=Capture(await Commands.ListAsync(Page,50,Cancellation));
    private async Task Create(EditContext _) { var failed=Capture(await Commands.CreateAsync(Form!,Cancellation)) is null; var err=Error; await LoadAsync(); if(failed) Error=err; }
    private async Task Deactivate(EditContext _) { Capture(await Commands.DeactivateAsync(Action!.Id,Action.Stamp,Cancellation)); var err=Error; await LoadAsync(); Error??=err; }
    /// <summary>Idempotent: a preset whose code already exists answers <c>ConcurrencyConflict</c> and is simply skipped; any other failure stops with its code.</summary>
    private async Task SeedDefaults(EditContext _)
    {
        if(Seed is not { Confirmed: true }) { Error=ErrorCodes.ValidationFailed.Code; return; }
        int created=0, existing=0; string? failure=null;
        foreach(var preset in Presets)
        {
            var result=await Commands.CreateAsync(preset,Cancellation);
            if(result.IsSuccess) created++;
            else if(result.Error==ErrorCodes.ConcurrencyConflict) existing++;
            else { failure=result.Error.Code; break; }
        }
        SeedSummary=$"{created} / {existing}";
        await LoadAsync();
        Error=failure;
    }
}
