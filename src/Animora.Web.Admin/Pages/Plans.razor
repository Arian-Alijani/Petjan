@page "/admin/plans"
@attribute [Authorize(Policy="AdminOnly")]
@inherits AdminPageComponent
@inject IAdminPlanCommands Commands
<h1>@Loc.T("plans.title")</h1><FormError Code="@Error" />
@if (Rows is not null) {
<div class="table-wrap"><table><caption>@Loc.T("plans.caption")</caption><thead><tr><th scope="col">@Loc.T("common.code")</th><th scope="col">@Loc.T("common.name")</th><th scope="col">@Loc.T("plans.seats")</th><th scope="col">@Loc.T("plans.amount")</th><th scope="col">@Loc.T("common.status")</th><th scope="col">@Loc.T("common.action")</th></tr></thead><tbody>
@foreach (var row in Rows.Items) { <tr><td dir="ltr">@row.Code</td><td>@row.Name</td><td>@row.Seats</td><td dir="ltr">@row.MonthlyAmountMinor.ToString("N0")</td><td><StatusBadge Status="@Loc.T(row.Active ? "staff.active" : "staff.inactive")" Tone="@(row.Active ? "ok" : "bad")" /></td><td>
@if(row.Active) { <EditForm Model="Action" FormName="@($"deactivate-{row.Id}")" method="post" OnSubmit="Deactivate">
<input type="hidden" name="Action.Id" value="@row.Id" /><input type="hidden" name="Action.Stamp" value="@row.Stamp" /><button type="submit" class="danger">@Loc.T("plans.deactivate")</button></EditForm> }</td></tr> }
</tbody></table></div><Pager Page="Rows.Page" PageSize="Rows.PageSize" Total="Rows.Total" BaseUrl="/admin/plans" />
}
<h2>@Loc.T("plans.new")</h2><EditForm Model="Form" FormName="create-plan" method="post" Enhance OnSubmit="Create">
<label>@Loc.T("common.code") <InputText @bind-Value="Form!.Code" maxlength="32" dir="ltr" /></label><label>@Loc.T("common.name") <InputText @bind-Value="Form.Name" maxlength="100" /></label>
<label>@Loc.T("plans.seats") <InputNumber @bind-Value="Form.Seats" /></label><label>@Loc.T("plans.amountInput") <InputNumber @bind-Value="Form.AmountMinor" /></label>
<label>@Loc.T("plans.trialDays") <InputNumber @bind-Value="Form.TrialDays" /></label><button type="submit">@Loc.T("plans.create")</button></EditForm>
@code {
    [SupplyParameterFromQuery] public int Page { get; set; }=1;
    [SupplyParameterFromForm] public CreatePlanForm? Form { get; set; }
    [SupplyParameterFromForm] public PlanActionForm? Action { get; set; }
    private AdminPage<PlanSummary>? Rows;
    protected override async Task OnInitializedAsync() { Form??=new(); Action??=new(); Rows=Capture(await Commands.ListAsync(Page,50,Cancellation)); }
    private async Task Create(EditContext _) { Capture(await Commands.CreateAsync(Form!,Cancellation)); }
    private async Task Deactivate(EditContext _) { Capture(await Commands.DeactivateAsync(Action!.Id,Action.Stamp,Cancellation)); }
}
