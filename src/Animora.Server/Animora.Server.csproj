<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Phase S01 — server host scaffold. One ASP.NET Core 10 / Kestrel process.
    Layering (ARCHITECTURE.md §6): Animora.Server -> Application + Domain +
    Contracts.Wire only. Persistence.PostgreSql (S02) is referenced for DI wiring only; a client
    project is NEVER referenced (enforced by ServerLayeringTests).
  -->
  <PropertyGroup>
    <!--
      PERF-MC-01 (multi-core): Server GC is deliberate. It creates one managed heap +
      one background GC thread PER LOGICAL CPU, so managed allocation/collection scales
      across every core instead of serializing through the single Workstation-GC heap
      (the prior <ServerGarbageCollection>false</> was the primary reason the process
      pegged one core while the rest sat idle). Background (concurrent) Server GC keeps
      pause times short. The System.GC.HeapHardLimitPercent/ConserveMemory host options
      below bound the per-core heaps to the 2/4 GiB memory profile, so multi-core
      throughput never breaches the container memory cap.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimitPercent" Value="70" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Animora.Web.Admin\Animora.Web.Admin.csproj" />
    <ProjectReference Include="..\Animora.Server.Licensing\Animora.Server.Licensing.csproj" />
    <ProjectReference Include="..\Animora.Domain\Animora.Domain.csproj" />
    <ProjectReference Include="..\Animora.Application\Animora.Application.csproj" />
    <ProjectReference Include="..\Animora.Contracts.Wire\Animora.Contracts.Wire.csproj" />
    <ProjectReference Include="..\Animora.Persistence.PostgreSql\Animora.Persistence.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- First-party OpenAPI (Development / opt-in only). Pinned centrally. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Animora.Server.Tests" />
  </ItemGroup>

</Project>
