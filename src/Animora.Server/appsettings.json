{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "_note": "ConnectionString is env-only (Database__ConnectionString); never put it in JSON.",
    "ProfileGiB": 2,
    "OltpWriteMax": 6,
    "OltpReadMax": 3,
    "KeyRingMax": 1,
    "WorkerMax": 2,
    "PoolWaitSeconds": 5
  },
  "Server": {
    "EnableOpenApi": false,
    "AuthCache": { "TtlSeconds": 10, "MaxEntries": 10000 },
    "QueryBudget": { "ReportingMax": 0, "WaitSeconds": 10 },
    "Tls": { "Termination": "App", "PublicHttpsPort": 443 },
    "Health": { "ReadinessCacheSeconds": 5 },
    "Workers": { "OutboxClaimBatch": 10, "OutboxConsumers": 4, "RecoveryPerTenantCap": 10, "RecoveryTotalCap": 200, "RecoveryParallelism": 4 },
    "Files": { "MaxConcurrentUploads": 16, "UploadWaitSeconds": 5 },
    "RateLimits": {
      "auth": { "PermitLimit": 10, "WindowSeconds": 60 },
      "commands": { "PermitLimit": 120, "WindowSeconds": 60 },
      "sync": { "PermitLimit": 60, "WindowSeconds": 60 },
      "files": { "PermitLimit": 60, "WindowSeconds": 60 },
      "operator": { "PermitLimit": 30, "WindowSeconds": 60 }
    }
  }
}
