# .NET build output
bin/
obj/

# Test output
**/TestResults/

# CI desktop publish output (scripts/ci/ci-publish-desktop.sh)
publish/

# CI control file — generated/pushed by scripts/ci/gh-ci.sh onto ci/** branches
# only. It must NOT be committed to main/genspark_ai_developer. The helper
# force-adds it into a throwaway index when pushing, so ignoring it here is safe.
# (The tracked template is ci.params.example.)
/ci.params

# Python read-only backup extractor cache
__pycache__/
*.py[cod]

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user

# NuGet
packages/
*.nupkg

# Local NuGet/build temp
.tmp/

# Sandbox scripts scratch (SDK-local nuget cache, logs, tmp) — see scripts/sandbox
.sandbox/
.dotnet/

# Native core dumps
core
core.*

# SQL Server sample backup — binary, 11MB, never read by any agent/tool
# (see AGENTS.md: "Database-Sampel/" — Never read). Kept on disk, not in git.
Database-Sampel/*.bak

# Design-tool source-map artifacts for the Animora-UI reference prototype —
# no product information beyond the corresponding .html (see Animora-UI/README.md).
Animora-UI/*.srcmap.json
.sandbox-sdk-install.log
.sandbox-reinstall.log

# Local agent workspace data (session memory, caches) — never part of the product.
.workbuddy-ai/
