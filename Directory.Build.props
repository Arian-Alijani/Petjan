<Project>

  <!-- Solution-wide build settings (Phase 01 scaffold). See STACK.md §2. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Backend track (Phase A01). Build must stay 0 warnings; analyzers/audit on. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Supply-chain hardening (G09 release engineering). Lock-file mode makes restore
         deterministic and reproducible; make-release-manifest.sh now passes under
         MANIFEST_REQUIRE_LOCKFILE=1. First restore regenerates packages.lock.json;
         CI must restore in locked mode (the dotnet restore locked-mode switch) so the
         lock file can never drift silently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
